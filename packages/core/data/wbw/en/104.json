{"104:1":[["Woe","waylun"],["to every","likulli"],["slanderer","humazatin"],["backbiter","lumazatin"]],"104:2":[["The one who","alladhī"],["collects","jamaʿa"],["wealth","mālan"],["and counts it","waʿaddadahu"]],"104:3":[["Thinking","yaḥsabu"],["that","anna"],["his wealth","mālahu"],["will make him immortal","akhladahu"]],"104:4":[["Nay","kallā"],["Surely he will be thrown","layunbadhanna"],["in","fī"],["the Crusher","l-ḥuṭamati"]],"104:5":[["And what","wamā"],["will make you know","adrāka"],["what","mā"],["the Crusher (is)","l-ḥuṭamatu"]],"104:6":[["A Fire","nāru"],["Allah","l-lahi"],["kindled","l-mūqadatu"]],"104:7":[["Which","allatī"],["mounts up","taṭṭaliʿu"],["to","ʿalā"],["the hearts","l-afidati"]],"104:8":[["Indeed, it","innahā"],["(will be) upon them","ʿalayhim"],["closed over","mu'ṣadatun"]],"104:9":[["In","fī"],["columns","ʿamadin"],["extended","mumaddadatin"]]}