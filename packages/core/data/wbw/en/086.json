{"86:1":[["By the sky","wal-samāi"],["and the night comer","wal-ṭāriqi"]],"86:2":[["And what","wamā"],["can make you know","adrāka"],["what","mā"],["the night comer (is)","l-ṭāriqu"]],"86:3":[["(It is) the star","al-najmu"],["the piercing","l-thāqibu"]],"86:4":[["Not","in"],["(is) every","kullu"],["soul","nafsin"],["but","lammā"],["over it","ʿalayhā"],["(is) a protector","ḥāfiẓun"]],"86:5":[["So let see","falyanẓuri"],["man","l-insānu"],["from what","mimma"],["he is created","khuliqa"]],"86:6":[["He is created","khuliqa"],["from","min"],["a water","māin"],["ejected","dāfiqin"]],"86:7":[["Coming forth","yakhruju"],["from","min"],["between","bayni"],["the backbone","l-ṣul'bi"],["and the ribs","wal-tarāibi"]],"86:8":[["Indeed, He","innahu"],["to","ʿalā"],["return him","rajʿihi"],["(is) Able","laqādirun"]],"86:9":[["(The) Day","yawma"],["will be tested","tub'lā"],["the secrets","l-sarāiru"]],"86:10":[["Then not","famā"],["(is) for him","lahu"],["any","min"],["power","quwwatin"],["and not","walā"],["any helper","nāṣirin"]],"86:11":[["By the sky","wal-samāi"],["which","dhāti"],["returns","l-rajʿi"]],"86:12":[["And the earth","wal-arḍi"],["which","dhāti"],["cracks open","l-ṣadʿi"]],"86:13":[["Indeed, it","innahu"],["(is) surely a Word","laqawlun"],["decisive","faṣlun"]],"86:14":[["And not","wamā"],["it","huwa"],["(is) for amusement","bil-hazli"]],"86:15":[["Indeed, they","innahum"],["are plotting","yakīdūna"],["a plot","kaydan"]],"86:16":[["But I am planning","wa-akīdu"],["a plan","kaydan"]],"86:17":[["So give respite","famahhili"],["(to) the disbelievers","l-kāfirīna"],["Give respite to them ","amhil'hum"],["little","ruwaydan"]]}