{"95:1":[["By the fig","wal-tīni"],["and the olive","wal-zaytūni"]],"95:2":[["And (the) Mount","waṭūri"],["Sinai","sīnīna"]],"95:3":[["And this","wahādhā"],["[the] city","l-baladi"],["[the] secure","l-amīni"]],"95:4":[["Indeed","laqad"],["We created","khalaqnā"],["man","l-insāna"],["in","fī"],["(the) best","aḥsani"],["mould","taqwīmin"]],"95:5":[["Then","thumma"],["We returned him","radadnāhu"],["(to the) lowest","asfala"],["(of the) low","sāfilīna"]],"95:6":[["Except","illā"],["those who","alladhīna"],["believe","āmanū"],["and do","waʿamilū"],["righteous deeds","l-ṣāliḥāti"],["then for them","falahum"],["(is a) reward","ajrun"],["never","ghayru"],["ending","mamnūnin"]],"95:7":[["Then what","famā"],["causes you to deny","yukadhibuka"],["after (this)","baʿdu"],["the judgment","bil-dīni"]],"95:8":[["Is not","alaysa"],["Allah","l-lahu"],["(the) Most Just","bi-aḥkami"],["(of) the Judges","l-ḥākimīna"]]}