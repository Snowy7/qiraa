{"1:1":[["In (the) name","bis'mi"],["(of) Allah","l-lahi"],["the Most Gracious","l-raḥmāni"],["the Most Merciful","l-raḥīmi"]],"1:2":[["All praises and thanks","al-ḥamdu"],["(be) to Allah","lillahi"],["the Lord","rabbi"],["of the universe","l-ʿālamīna"]],"1:3":[["The Most Gracious","al-raḥmāni"],["the Most Merciful","l-raḥīmi"]],"1:4":[["(The) Master","māliki"],["(of the) Day","yawmi"],["(of the) Judgment","l-dīni"]],"1:5":[["You Alone","iyyāka"],["we worship","naʿbudu"],["and You Alone","wa-iyyāka"],["we ask for help","nastaʿīnu"]],"1:6":[["Guide us","ih'dinā"],["(to) the path","l-ṣirāṭa"],["the straight","l-mus'taqīma"]],"1:7":[["(The) path","ṣirāṭa"],["(of) those","alladhīna"],["You have bestowed (Your) Favors","anʿamta"],["on them","ʿalayhim"],["not (of)","ghayri"],["those who earned (Your) wrath","l-maghḍūbi"],["on themselves","ʿalayhim"],["and not","walā"],["(of) those who go astray","l-ḍālīna"]]}