{"81:1":[["When","idhā"],["the sun","l-shamsu"],["is wrapped up","kuwwirat"]],"81:2":[["And when","wa-idhā"],["the stars","l-nujūmu"],["fall, losing their luster","inkadarat"]],"81:3":[["And when","wa-idhā"],["the mountains","l-jibālu"],["are moved away","suyyirat"]],"81:4":[["And when","wa-idhā"],["the full-term she-camels","l-ʿishāru"],["(are) left untended","ʿuṭṭilat"]],"81:5":[["And when","wa-idhā"],["the wild beasts","l-wuḥūshu"],["are gathered","ḥushirat"]],"81:6":[["And when","wa-idhā"],["the seas","l-biḥāru"],["are made to overflow","sujjirat"]],"81:7":[["And when","wa-idhā"],["the souls","l-nufūsu"],["are paired","zuwwijat"]],"81:8":[["And when","wa-idhā"],["the female infant buried alive","l-mawūdatu"],["is asked","su-ilat"]],"81:9":[["For what","bi-ayyi"],["sin","dhanbin"],["she was killed","qutilat"]],"81:10":[["And when","wa-idhā"],["the pages","l-ṣuḥufu"],["are laid open","nushirat"]],"81:11":[["And when","wa-idhā"],["the sky","l-samāu"],["is stripped away","kushiṭat"]],"81:12":[["And when","wa-idhā"],["the Hellfire","l-jaḥīmu"],["is set ablaze","suʿʿirat"]],"81:13":[["And when","wa-idhā"],["Paradise","l-janatu"],["is brought near","uz'lifat"]],"81:14":[["Will know","ʿalimat"],["a soul","nafsun"],["what","mā"],["it has brought","aḥḍarat"]],"81:15":[["But nay","falā"],["I swear","uq'simu"],["by the retreating planets","bil-khunasi"]],"81:16":[["Those that run","al-jawāri"],["(and) disappear","l-kunasi"]],"81:17":[["And the night","wa-al-layli"],["when","idhā"],["it departs","ʿasʿasa"]],"81:18":[["And the dawn","wal-ṣub'ḥi"],["when","idhā"],["it breathes","tanaffasa"]],"81:19":[["Indeed, it","innahu"],["(is) surely a word","laqawlu"],["(of) a Messenger","rasūlin"],["noble","karīmin"]],"81:20":[["Possessor of","dhī"],["power","quwwatin"],["with","ʿinda"],["(the) Owner of","dhī"],["the Throne","l-ʿarshi"],["secure","makīnin"]],"81:21":[["One to be obeyed","muṭāʿin"],["and","thamma"],["trustworthy","amīnin"]],"81:22":[["And not","wamā"],["(is) your companion","ṣāḥibukum"],["mad","bimajnūnin"]],"81:23":[["And certainly","walaqad"],["he saw him","raāhu"],["in the horizon","bil-ufuqi"],["the clear","l-mubīni"]],"81:24":[["And not","wamā"],["he (is)","huwa"],["on","ʿalā"],["the unseen","l-ghaybi"],["a withholder","biḍanīnin"]],"81:25":[["And not","wamā"],["it","huwa"],["(is the) word","biqawli"],["(of) Shaitaan","shayṭānin"],["accursed","rajīmin"]],"81:26":[["So where","fa-ayna"],["are you going","tadhhabūna"]],"81:27":[["Not","in"],["it","huwa"],["(is) except","illā"],["a reminder","dhik'run"],["to the worlds","lil'ʿālamīna"]],"81:28":[["For whoever","liman"],["wills","shāa"],["among you","minkum"],["to","an"],["take a straight way","yastaqīma"]],"81:29":[["And not","wamā"],["you will","tashāūna"],["except","illā"],["that","an"],["wills","yashāa"],["Allah","l-lahu"],["Lord","rabbu"],["(of) the worlds","l-ʿālamīna"]]}