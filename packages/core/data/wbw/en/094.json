{"94:1":[["Have not","alam"],["We expanded","nashraḥ"],["for you","laka"],["your breast","ṣadraka"]],"94:2":[["And We removed","wawaḍaʿnā"],["from you","ʿanka"],["your burden","wiz'raka"]],"94:3":[["Which","alladhī"],["weighed upon","anqaḍa"],["your back","ẓahraka"]],"94:4":[["And We raised high","warafaʿnā"],["for you","laka"],["your reputation","dhik'raka"]],"94:5":[["So indeed","fa-inna"],["with","maʿa"],["the hardship","l-ʿus'ri"],["(is) ease","yus'ran"]],"94:6":[["Indeed","inna"],["with","maʿa"],["the hardship","l-ʿus'ri"],["(is) ease","yus'ran"]],"94:7":[["So when","fa-idhā"],["you have finished","faraghta"],["then labor hard","fa-inṣab"]],"94:8":[["And to","wa-ilā"],["your Lord","rabbika"],["turn your attention","fa-ir'ghab"]]}