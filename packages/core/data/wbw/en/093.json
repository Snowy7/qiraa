{"93:1":[["By the morning brightness","wal-ḍuḥā"]],"93:2":[["And the night","wa-al-layli"],["when","idhā"],["it covers with darkness","sajā"]],"93:3":[["Not","mā"],["has forsaken you","waddaʿaka"],["your Lord","rabbuka"],["and not","wamā"],["He is displeased","qalā"]],"93:4":[["And surely the Hereafter","walalākhiratu"],["(is) better","khayrun"],["for you","laka"],["than","mina"],["the first","l-ūlā"]],"93:5":[["And soon","walasawfa"],["will give you","yuʿ'ṭīka"],["your Lord","rabbuka"],["then you will be satisfied","fatarḍā"]],"93:6":[["Did not","alam"],["He find you","yajid'ka"],["an orphan","yatīman"],["and give shelter","faāwā"]],"93:7":[["And He found you","wawajadaka"],["lost","ḍāllan"],["so He guided","fahadā"]],"93:8":[["And He found you","wawajadaka"],["in need","ʿāilan"],["so He made self-sufficient","fa-aghnā"]],"93:9":[["So as for","fa-ammā"],["the orphan","l-yatīma"],["then (do) not","falā"],["oppress","taqhar"]],"93:10":[["And as for","wa-ammā"],["one who asks","l-sāila"],["then (do) not","falā"],["repel","tanhar"]],"93:11":[["But as for","wa-ammā"],["(the) Favor","biniʿ'mati"],["(of) your Lord","rabbika"],["narrate","faḥaddith"]]}