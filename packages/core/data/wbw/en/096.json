{"96:1":[["Read","iq'ra"],["in (the) name","bi-is'mi"],["(of) your Lord","rabbika"],["the One Who","alladhī"],["created ","khalaqa"]],"96:2":[["He created","khalaqa"],["man","l-insāna"],["from","min"],["a clinging substance","ʿalaqin"]],"96:3":[["Read","iq'ra"],["and your Lord","warabbuka"],["(is) the Most Generous","l-akramu"]],"96:4":[["The One Who","alladhī"],["taught","ʿallama"],["by the pen","bil-qalami"]],"96:5":[["Taught","ʿallama"],["man","l-insāna"],["what","mā"],["not","lam"],["he knew","yaʿlam"]],"96:6":[["Nay","kallā"],["Indeed","inna"],["man","l-insāna"],["surely transgresses","layaṭghā"]],"96:7":[["That","an"],["he sees himself","raāhu"],["self-sufficient","is'taghnā"]],"96:8":[["Indeed","inna"],["to","ilā"],["your Lord","rabbika"],["(is) the return","l-ruj'ʿā"]],"96:9":[["Have you seen","ara-ayta"],["the one who","alladhī"],["forbids","yanhā"]],"96:10":[["A slave","ʿabdan"],["when","idhā"],["he prays","ṣallā"]],"96:11":[["Have you seen","ara-ayta"],["if","in"],["he is","kāna"],["upon","ʿalā"],["[the] guidance","l-hudā"]],"96:12":[["Or","aw"],["he enjoins","amara"],["[of the] righteousness","bil-taqwā"]],"96:13":[["Have you seen","ara-ayta"],["if","in"],["he denies","kadhaba"],["and turns away","watawallā"]],"96:14":[["Does not","alam"],["he know","yaʿlam"],["that","bi-anna"],["Allah","l-laha"],["sees","yarā"]],"96:15":[["Nay","kallā"],["If","la-in"],["not","lam"],["he desists","yantahi"],["surely We will drag him","lanasfaʿan"],["by the forelock","bil-nāṣiyati"]],"96:16":[["A forelock","nāṣiyatin"],["lying","kādhibatin"],["sinful","khāṭi-atin"]],"96:17":[["Then let him call","falyadʿu"],["his associates","nādiyahu"]],"96:18":[["We will call","sanadʿu"],["the Angels of Hell","l-zabāniyata"]],"96:19":[["Nay","kallā"],["(Do) not","lā"],["obey him","tuṭiʿ'hu"],["But prostrate","wa-us'jud"],["and draw near (to Allah)","wa-iq'tarib"]]}