{"91:1":[["By the sun","wal-shamsi"],["and its brightness","waḍuḥāhā"]],"91:2":[["And the moon","wal-qamari"],["when","idhā"],["it follows it","talāhā"]],"91:3":[["And the day","wal-nahāri"],["when","idhā"],["it displays it","jallāhā"]],"91:4":[["And the night","wa-al-layli"],["when","idhā"],["it covers it","yaghshāhā"]],"91:5":[["And the heaven","wal-samāi"],["and (He) Who","wamā"],["constructed it","banāhā"]],"91:6":[["And the earth","wal-arḍi"],["and by (He) Who","wamā"],["spread it","ṭaḥāhā"]],"91:7":[["And (the) soul","wanafsin"],["and (He) Who","wamā"],["proportioned it","sawwāhā"]],"91:8":[["And He inspired it","fa-alhamahā"],["(to distinguish) its wickedness","fujūrahā"],["and its righteousness","wataqwāhā"]],"91:9":[["Indeed","qad"],["he succeeds","aflaḥa"],["who","man"],["purifies it","zakkāhā"]],"91:10":[["And indeed","waqad"],["he fails","khāba"],["who","man"],["buries it","dassāhā"]],"91:11":[["Denied","kadhabat"],["Thamud","thamūdu"],["by their transgression","biṭaghwāhā"]],"91:12":[["When","idhi"],["(was) sent forth","inbaʿatha"],["(the) most wicked of them","ashqāhā"]],"91:13":[["But said","faqāla"],["to them","lahum"],["(the) Messenger","rasūlu"],["(of) Allah","l-lahi"],["(It is the) she-camel","nāqata"],["(of) Allah","l-lahi"],["and her drink","wasuq'yāhā"]],"91:14":[["But they denied him","fakadhabūhu"],["and they hamstrung her","faʿaqarūhā"],["So destroyed","fadamdama"],["them","ʿalayhim"],["their Lord","rabbuhum"],["for their sin","bidhanbihim"],["and leveled them","fasawwāhā"]],"91:15":[["And not","walā"],["He fears","yakhāfu"],["its consequences","ʿuq'bāhā"]]}