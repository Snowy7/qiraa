{"107:1":[["Have you seen","ara-ayta"],["the one who","alladhī"],["denies","yukadhibu"],["the Judgment","bil-dīni"]],"107:2":[["Then that","fadhālika"],["(is) the one who","alladhī"],["repulses","yaduʿʿu"],["the orphan","l-yatīma"]],"107:3":[["And (does) not","walā"],["feel the urge","yaḥuḍḍu"],["to","ʿalā"],["feed","ṭaʿāmi"],["the poor","l-mis'kīni"]],"107:4":[["So woe","fawaylun"],["to those who pray","lil'muṣallīna"]],"107:5":[["Those who","alladhīna"],["[they]","hum"],["about","ʿan"],["their prayers","ṣalātihim"],["(are) neglectful","sāhūna"]],"107:6":[["Those who","alladhīna"],["[they]","hum"],["make show","yurāūna"]],"107:7":[["And they deny","wayamnaʿūna"],["[the] small kindnesses","l-māʿūna"]]}