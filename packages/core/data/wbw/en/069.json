{"69:1":[["The Inevitable Reality","al-ḥāqatu"]],"69:2":[["What","mā"],["(is) the Inevitable Reality","l-ḥāqatu"]],"69:3":[["And what","wamā"],["will make you know","adrāka"],["what","mā"],["(is) the Inevitable Reality","l-ḥāqatu"]],"69:4":[["Denied","kadhabat"],["Thamud","thamūdu"],["and Aad","waʿādun"],["the Striking Calamity","bil-qāriʿati"]],"69:5":[["So as for","fa-ammā"],["Thamud","thamūdu"],["they were destroyed","fa-uh'likū"],["by the overpowering (blast)","bil-ṭāghiyati"]],"69:6":[["And as for","wa-ammā"],["Aad","ʿādun"],["they were destroyed","fa-uh'likū"],["by a wind","birīḥin"],["screaming","ṣarṣarin"],["violent","ʿātiyatin"]],"69:7":[["Which He imposed","sakharahā"],["upon them","ʿalayhim"],["(for) seven","sabʿa"],["nights","layālin"],["and eight","wathamāniyata"],["days","ayyāmin"],["(in) succession","ḥusūman"],["so you would see","fatarā"],["the people","l-qawma"],["therein","fīhā"],["fallen","ṣarʿā"],["as if they were","ka-annahum"],["trunks","aʿjāzu"],["(of) date-palms","nakhlin"],["hollow","khāwiyatin"]],"69:8":[["Then do","fahal"],["you see","tarā"],["of them","lahum"],["any","min"],["remains","bāqiyatin"]],"69:9":[["And came","wajāa"],["Firaun","fir'ʿawnu"],["and (those)","waman"],["before him","qablahu"],["and the overturned cities","wal-mu'tafikātu"],["with sin","bil-khāṭi-ati"]],"69:10":[["And they disobeyed","faʿaṣaw"],["(the) Messenger","rasūla"],["(of) their Lord","rabbihim"],["so He seized them","fa-akhadhahum"],["(with) a seizure","akhdhatan"],["exceeding","rābiyatan"]],"69:11":[["Indeed, We","innā"],["when","lammā"],["overflowed","ṭaghā"],["the water","l-māu"],["We carried you","ḥamalnākum"],["in","fī"],["the sailing (ship)","l-jāriyati"]],"69:12":[["That We might make it","linajʿalahā"],["for you","lakum"],["a reminder","tadhkiratan"],["and would be conscious of it","wataʿiyahā"],["an ear","udhunun"],["conscious","wāʿiyatun"]],"69:13":[["Then when","fa-idhā"],["is blown","nufikha"],["in","fī"],["the trumpet ","l-ṣūri"],["a blast","nafkh