{"92:1":[["By the night","wa-al-layli"],["when","idhā"],["it covers","yaghshā"]],"92:2":[["And the day","wal-nahāri"],["when","idhā"],["it shines in brightness","tajallā"]],"92:3":[["And He Who","wamā"],["created","khalaqa"],["the male","l-dhakara"],["and the female","wal-unthā"]],"92:4":[["Indeed","inna"],["your efforts","saʿyakum"],["(are) surely diverse","lashattā"]],"92:5":[["Then as for","fa-ammā"],["(him) who","man"],["gives","aʿṭā"],["and fears","wa-ittaqā"]],"92:6":[["And believes","waṣaddaqa"],["in the best","bil-ḥus'nā"]],"92:7":[["Then We will ease him","fasanuyassiruhu"],["towards [the] ease","lil'yus'rā"]],"92:8":[["But as for","wa-ammā"],["(him) who","man"],["withholds","bakhila"],["and considers himself free from need","wa-is'taghnā"]],"92:9":[["And denies","wakadhaba"],["the best","bil-ḥus'nā"]],"92:10":[["Then We will ease him","fasanuyassiruhu"],["towards [the] difficulty","lil'ʿus'rā"]],"92:11":[["And not","wamā"],["will avail","yugh'nī"],["him","ʿanhu"],["his wealth","māluhu"],["when","idhā"],["he falls","taraddā"]],"92:12":[["Indeed","inna"],["upon Us","ʿalaynā"],["(is) the guidance","lalhudā"]],"92:13":[["And indeed","wa-inna"],["for Us","lanā"],["(is) the Hereafter","lalākhirata"],["and the first (life)","wal-ūlā"]],"92:14":[["So I warn you","fa-andhartukum"],["(of) a Fire","nāran"],["blazing","talaẓẓā"]],"92:15":[["Not","lā"],["will burn (in) it","yaṣlāhā"],["except","illā"],["the most wretched","l-ashqā"]],"92:16":[["The one who","alladhī"],["denied","kadhaba"],["and turned away","watawallā"]],"92:17":[["But will be removed from it","wasayujannabuhā"],["the righteous","l-atqā"]],"92:18":[["The one who","alladhī"],["gives","yu'tī"],["his wealth","mālahu"],["(to) purify himself","yatazakkā"]],"92:19":[["And not","wamā"],["for anyone","li-aḥadin"],["with him","ʿindahu"],["any","min"],["favor","niʿ'matin"],["to be recompensed","tuj'zā"]],"92:20":[["Except","illā"],["seeking","ib'tighāa"],["(the) Countenance","wajhi"],["(of) his Lord","rabbihi"],