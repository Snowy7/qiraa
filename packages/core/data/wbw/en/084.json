{"84:1":[["When","idhā"],["the sky","l-samāu"],["is split asunder","inshaqqat"]],"84:2":[["And has listened","wa-adhinat"],["to its Lord","lirabbihā"],["and was obligated","waḥuqqat"]],"84:3":[["And when","wa-idhā"],["the earth","l-arḍu"],["is spread","muddat"]],"84:4":[["And has cast out","wa-alqat"],["what","mā"],["(is) in it","fīhā"],["and becomes empty","watakhallat"]],"84:5":[["And has listened","wa-adhinat"],["to its Lord","lirabbihā"],["and was obligated","waḥuqqat"]],"84:6":[["O","yāayyuhā"],["mankind","l-insānu"],["Indeed, you","innaka"],["(are) laboring","kādiḥun"],["to","ilā"],["your Lord","rabbika"],["(with) exertion","kadḥan"],["and you (will) meet Him","famulāqīhi"]],"84:7":[["Then as for","fa-ammā"],["(him) who","man"],["is given","ūtiya"],["his record","kitābahu"],["in his right (hand)","biyamīnihi"]],"84:8":[["Then soon","fasawfa"],["his account will be taken","yuḥāsabu"],["an account","ḥisāban"],["easy","yasīran"]],"84:9":[["And he will return","wayanqalibu"],["to","ilā"],["his people","ahlihi"],["happily","masrūran"]],"84:10":[["But as for","wa-ammā"],["(him) who","man"],["is given","ūtiya"],["his record","kitābahu"],["behind","warāa"],["his back","ẓahrihi"]],"84:11":[["Then soon","fasawfa"],["he will call","yadʿū"],["(for) destruction","thubūran"]],"84:12":[["And he will burn","wayaṣlā"],["(in) a Blaze","saʿīran"]],"84:13":[["Indeed, he","innahu"],["had been","kāna"],["among","fī"],["his people","ahlihi"],["happy","masrūran"]],"84:14":[["Indeed, he","innahu"],["(had) thought","ẓanna"],["that","an"],["never","lan"],["he would return","yaḥūra"]],"84:15":[["Yes","balā"],["Indeed","inna"],["his Lord","rabbahu"],["was","kāna"],["of him","bihi"],["All-Seer","baṣīran"]],"84:16":[["But nay","falā"],["I swear","uq'simu"],["by the twilight glow","bil-shafaqi"]],"84:17":[["And the night","wa-al-layli"],["and what","wamā"],["it envelops","wasaqa"]],"84:18":[["And the moon","wal-qamari"],["when","idhā"],["it becomes full","ittasaqa"]],"84:19":[["You will surely embark","latarkabunna"],["(to) stage","ṭabaqan"],["from","ʿan"],["stage","ṭabaqin"]],"84:20":[["So what","famā"],["(is) for them","lahum"],["not","lā"],["they believe","yu'minūna"]],"84:21":[["And when","wa-idhā"],["is recited","quri-a"],["to them","ʿalayhimu"],["the Quran","l-qur'ānu"],["not","lā"],["they prostrate","yasjudūna"]],"84:22":[["Nay","bali"],["Those who","alladhīna"],["disbelieved","kafarū"],["deny","yukadhibūna"]],"84:23":[["And Allah","wal-lahu"],["(is) most knowing","aʿlamu"],["of what","bimā"],["they keep within themselves","yūʿūna"]],"84:24":[["so give them tidings","fabashir'hum"],["of a punishment","biʿadhābin"],["painful","alīmin"]],"84:25":[["Except","illā"],["those who","alladhīna"],["believe","āmanū"],["and do","waʿamilū"],["righteous deeds","l-ṣāliḥāti"],["For them","lahum"],["(is) a reward","ajrun"],["never","ghayru"],["ending","mamnūnin"]]}