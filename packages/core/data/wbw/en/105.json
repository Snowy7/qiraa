{"105:1":[["Have not","alam"],["you seen","tara"],["how","kayfa"],["dealt","faʿala"],["your Lord","rabbuka"],["with (the) Companions","bi-aṣḥābi"],["(of the) Elephant","l-fīli"]],"105:2":[["Did not","alam"],["He make","yajʿal"],["their plan","kaydahum"],["go","fī"],["astray","taḍlīlin"]],"105:3":[["And He sent","wa-arsala"],["against them","ʿalayhim"],["birds","ṭayran"],["(in) flocks","abābīla"]],"105:4":[["Striking them","tarmīhim"],["with stones","biḥijāratin"],["of","min"],["baked clay","sijjīlin"]],"105:5":[["Then He made them","fajaʿalahum"],["like straw","kaʿaṣfin"],["eaten up","makūlin"]]}