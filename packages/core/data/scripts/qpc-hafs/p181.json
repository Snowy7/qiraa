,"فَضۡلِهِۦٓ"]]]],[5,[["9:28",["إِن","شَآءَۚ","إِنَّ","ٱللَّهَ","عَلِيمٌ","حَكِيمٞ"],"٢٨"],["9:29",["قَٰتِلُواْ","ٱلَّذِينَ"]]]],[6,[["9:29",["لَا","يُؤۡمِنُونَ","بِٱللَّهِ","وَلَا","بِٱلۡيَوۡمِ","ٱلۡأٓخِرِ","وَلَا","يُحَرِّمُونَ"]]]],[7,[["9:29",["مَا","حَرَّمَ","ٱللَّهُ","وَرَسُولُهُۥ","وَلَا","يَدِينُونَ","دِينَ","ٱلۡحَقِّ","مِنَ"]]]],[8,[["9:29",["ٱلَّذِينَ","أُوتُواْ","ٱلۡكِتَٰبَ","حَتَّىٰ","يُعۡطُواْ","ٱلۡجِزۡيَةَ","عَن","يَدٖ"]]]],[9,[["9:29",["وَهُمۡ","صَٰغِرُونَ"],"٢٩"],["9:30",["وَقَالَتِ","ٱلۡيَهُودُ","عُزَيۡرٌ","ٱبۡنُ","ٱللَّهِ"]]]],[10,[["9:30",["وَقَالَتِ","ٱلنَّصَٰرَى","ٱلۡمَسِيحُ","ٱبۡنُ","ٱللَّهِۖ","ذَٰلِكَ","قَوۡلُهُم"]]]],[11,[["9:30",["بِأَفۡوَٰهِهِمۡۖ","يُضَٰهِـُٔونَ","قَوۡلَ","ٱلَّذِينَ","كَفَرُواْ","مِن","قَبۡلُۚ"]]]],[12,[["9:30",["قَٰتَلَهُمُ","ٱللَّهُۖ","أَنَّىٰ","يُؤۡفَكُونَ"],"٣٠"],["9:31",["ٱتَّخَذُوٓاْ","أَحۡبَارَهُمۡ"]]]],[13,[["9:31",["وَرُهۡبَٰنَهُمۡ","أَرۡبَابٗا","مِّن","دُونِ","ٱللَّهِ","وَٱلۡمَسِيحَ","ٱبۡنَ"]]]],[14,[["9:31",["مَرۡيَمَ","وَمَآ","أُمِرُوٓاْ","إِلَّا","لِيَعۡبُدُوٓاْ","إِلَٰهٗا","وَٰحِدٗاۖ"]]]],[15,[["9:31",["لَّآ","إِلَٰهَ","إِلَّا","هُوَۚ","سُبۡحَٰنَهُۥ","عَمَّا","يُشۡرِكُونَ"],"٣١"]]]],"192":[[1,[["9:32",["يُرِيدُونَ","أَن","يُطۡفِـُٔواْ","نُورَ","ٱللَّهِ","بِأَفۡوَٰهِهِمۡ","وَيَأۡبَى","ٱللَّهُ","إِلَّآ","أَن"]]]],[2,[["9:32",["يُتِمَّ","نُورَهُۥ","وَلَوۡ","كَرِهَ","ٱلۡكَٰفِرُونَ"],"٣٢"],["9:33",["هُوَ","ٱلَّذِيٓ","أَرۡسَلَ"]]]],[3,[["9:33",["رَسُولَهُۥ","بِٱلۡهُدَىٰ","وَدِينِ","ٱلۡحَقِّ","لِيُظۡهِرَهُۥ","عَلَى","ٱلدِّينِ"]]]],[4,[["9:33",["كُلِّهِۦ","وَلَوۡ","كَرِهَ","ٱلۡمُشۡرِكُونَ"],"٣٣"],["9:34",["۞ يَٰٓأَيُّهَا","ٱلَّذِينَ"]]]],[5,[["9:34",["ءَامَنُوٓاْ","إِنَّ","كَثِيرٗا","مِّنَ","ٱلۡأَحۡبَارِ","وَٱلرُّهۡبَانِ","لَيَأۡكُلُونَ"]]]],[6,[["9:34",["أَمۡوَٰلَ","ٱلنَّاسِ","بِٱلۡبَٰطِلِ","وَيَصُدُّونَ","عَن","سَبِيلِ","ٱللَّهِۗ","وَٱلَّذِينَ"]]]],[7,[["9:34",["يَكۡنِزُونَ","ٱلذَّهَبَ","وَٱلۡفِضَّةَ","وَلَا","يُنفِقُونَهَا","فِي"]]]],[8,[["9:34",["سَبِيلِ","ٱللَّهِ","فَبَشِّرۡهُم","بِعَذَابٍ","أَلِيمٖ"],"٣٤"],["9:35",["يَوۡمَ","يُحۡمَىٰ","عَلَيۡهَا"]]]],[9,[["9:35",["فِي","نَارِ","جَهَنَّمَ","فَتُكۡوَىٰ","بِهَا","جِبَاهُهُمۡ","وَجُنُوبُهُمۡ"]]]],[10,[["9:35",["وَظُهُورُهُمۡۖ","هَٰذَا","مَا","كَنَزۡتُمۡ","لِأَنفُسِكُمۡ","فَذُوقُواْ","مَا","كُنتُمۡ"]]]],[11,[["9:35",["تَكۡنِزُونَ"],"٣٥"],["9:36",["إِنَّ","عِدَّةَ","ٱلشُّهُورِ","عِندَ","ٱللَّهِ","ٱثۡنَا","عَشَرَ"]]]],[12,[["9:36",["شَهۡرٗا","فِي","كِتَٰبِ","ٱللَّهِ","يَوۡمَ","خَلَقَ","ٱلسَّمَٰوَٰتِ","وَٱلۡأَرۡضَ","مِنۡهَآ"]]]],[13,[["9:36",["أَرۡبَعَةٌ","حُرُمٞۚ","ذَٰلِكَ","ٱلدِّينُ","ٱلۡقَيِّمُۚ","فَلَا","تَظۡلِمُواْ","فِيهِنَّ"]]]],[14,[["9:36",["أَنفُسَكُمۡۚ","وَقَٰتِلُواْ","ٱلۡمُشۡرِكِينَ","كَآفَّةٗ","كَمَا"]]]],[15,[["9:36",["يُقَٰتِلُونَكُمۡ","كَآفَّةٗۚ","وَٱعۡلَمُوٓاْ","أَنَّ","ٱللَّهَ","مَعَ","ٱلۡمُتَّقِينَ"],"٣٦"]]]],"193":[[1,[["9:37",["إِنَّمَا","ٱلنَّسِيٓءُ","زِيَادَةٞ","فِي","ٱلۡكُفۡرِۖ","يُضَلُّ","بِهِ","ٱلَّذِينَ"]]]],[2,[["9:37",["كَفَرُواْ","يُحِلُّونَهُۥ","عَامٗا","وَيُحَرِّمُونَهُۥ","عَامٗا","لِّيُوَاطِـُٔواْ"]]]],[3,[["9:37",["عِدَّةَ","مَا","حَرَّمَ","ٱللَّهُ","فَيُحِلُّواْ","مَا","حَرَّمَ","ٱللَّهُۚ","زُيِّنَ","لَهُمۡ"]]]],[4,[["9:37",["سُوٓءُ","أَعۡمَٰلِهِمۡۗ","وَٱللَّهُ","لَا","يَهۡدِي","ٱلۡقَوۡمَ","ٱلۡكَٰفِرِينَ"]]]],[5,[["9:37",[],"٣٧"],["9:38",["يَٰٓأَيُّهَا","ٱلَّذِينَ","ءَامَنُواْ","مَا","لَكُمۡ","إِذَا","قِيلَ","لَكُمُ"]]]],[6,[["9:38",["ٱنفِرُواْ","فِي","سَبِيلِ","ٱللَّهِ","ٱثَّاقَلۡتُمۡ","إِلَى","ٱلۡأَرۡضِۚ","أَرَضِيتُم"]]]],[7,[["9:38",["بِٱلۡحَيَوٰةِ","ٱلدُّنۡيَا","مِنَ","ٱلۡأٓخِرَةِۚ","فَمَا","مَتَٰعُ","ٱلۡحَيَوٰةِ"]]]],[8,[["9:38",["ٱلدُّنۡيَا","فِي","ٱلۡأٓخِرَةِ","إِلَّا","قَلِيلٌ"],"٣٨"],["9:39",["إِلَّا","تَنفِرُواْ","يُعَذِّبۡكُمۡ"]]]],[9,[["9:39",["عَذَابًا","أَلِيمٗا","وَيَسۡتَبۡدِلۡ","قَوۡمًا","غَيۡرَكُمۡ","وَلَا","تَضُرُّوهُ"]]]],[10,[["9:39",["شَيۡـٔٗاۗ","وَٱللَّهُ","عَلَىٰ","كُلِّ","شَيۡءٖ","قَدِيرٌ"],"٣٩"],["9:40",["إِلَّا","تَنصُرُوهُ"]]]],[11,[["9:40",["فَقَدۡ","نَصَرَهُ","ٱللَّهُ","إِذۡ","أَخۡرَجَهُ","ٱلَّذِينَ","كَفَرُواْ","ثَانِيَ","ٱثۡنَيۡنِ"]]]],[12,[["9:40",["إِذۡ","ه