{"181":[[1,[["8:34",["وَمَا","لَهُمۡ","أَلَّا","يُعَذِّبَهُمُ","ٱللَّهُ","وَهُمۡ","يَصُدُّونَ","عَنِ","ٱلۡمَسۡجِدِ"]]]],[2,[["8:34",["ٱلۡحَرَامِ","وَمَا","كَانُوٓاْ","أَوۡلِيَآءَهُۥٓۚ","إِنۡ","أَوۡلِيَآؤُهُۥٓ","إِلَّا","ٱلۡمُتَّقُونَ"]]]],[3,[["8:34",["وَلَٰكِنَّ","أَكۡثَرَهُمۡ","لَا","يَعۡلَمُونَ"],"٣٤"],["8:35",["وَمَا","كَانَ","صَلَاتُهُمۡ"]]]],[4,[["8:35",["عِندَ","ٱلۡبَيۡتِ","إِلَّا","مُكَآءٗ","وَتَصۡدِيَةٗۚ","فَذُوقُواْ","ٱلۡعَذَابَ"]]]],[5,[["8:35",["بِمَا","كُنتُمۡ","تَكۡفُرُونَ"],"٣٥"],["8:36",["إِنَّ","ٱلَّذِينَ","كَفَرُواْ","يُنفِقُونَ"]]]],[6,[["8:36",["أَمۡوَٰلَهُمۡ","لِيَصُدُّواْ","عَن","سَبِيلِ","ٱللَّهِۚ","فَسَيُنفِقُونَهَا","ثُمَّ","تَكُونُ"]]]],[7,[["8:36",["عَلَيۡهِمۡ","حَسۡرَةٗ","ثُمَّ","يُغۡلَبُونَۗ","وَٱلَّذِينَ","كَفَرُوٓاْ","إِلَىٰ","جَهَنَّمَ"]]]],[8,[["8:36",["يُحۡشَرُونَ"],"٣٦"],["8:37",["لِيَمِيزَ","ٱللَّهُ","ٱلۡخَبِيثَ","مِنَ","ٱلطَّيِّبِ","وَيَجۡعَلَ"]]]],[9,[["8:37",["ٱلۡخَبِيثَ","بَعۡضَهُۥ","عَلَىٰ","بَعۡضٖ","فَيَرۡكُمَهُۥ","جَمِيعٗا","فَيَجۡعَلَهُۥ"]]]],[10,[["8:37",["فِي","جَهَنَّمَۚ","أُوْلَٰٓئِكَ","هُمُ","ٱلۡخَٰسِرُونَ"],"٣٧"],["8:38",["قُل","لِّلَّذِينَ"]]]],[11,[["8:38",["كَفَرُوٓاْ","إِن","يَنتَهُواْ","يُغۡفَرۡ","لَهُم","مَّا","قَدۡ","سَلَفَ","وَإِن","يَعُودُواْ"]]]],[12,[["8:38",["فَقَدۡ","مَضَتۡ","سُنَّتُ","ٱلۡأَوَّلِينَ"],"٣٨"],["8:39",["وَقَٰتِلُوهُمۡ","حَتَّىٰ"]]]],[13,[["8:39",["لَا","تَكُونَ","فِتۡنَةٞ","وَيَكُونَ","ٱلدِّينُ","كُلُّهُۥ","لِلَّهِۚ","فَإِنِ"]]]],[14,[["8:39",["ٱنتَهَوۡاْ","فَإِنَّ","ٱللَّهَ","بِمَا","يَعۡمَلُونَ","بَصِيرٞ"],"٣٩"],["8:40",["وَإِن","تَوَلَّوۡاْ"]]]],[15,[["8:40",["فَٱعۡلَمُوٓاْ","أَنَّ","ٱللَّهَ","مَوۡلَىٰكُمۡۚ","نِعۡمَ","ٱلۡمَوۡلَىٰ","وَنِعۡمَ","ٱلنَّصِيرُ"],"٤٠"]]]],"182":[[1,[["8:41",["۞ وَٱعۡلَمُوٓاْ","أَنَّمَا","غَنِمۡتُم","مِّن","شَيۡءٖ","فَأَنَّ","لِلَّهِ","خُمُسَهُۥ","وَلِلرَّسُولِ"]]]],[2,[["8:41",["وَلِذِي","ٱلۡقُرۡبَىٰ","وَٱلۡيَتَٰمَىٰ","وَٱلۡمَسَٰكِينِ","وَٱبۡنِ","ٱلسَّبِيلِ","إِن"]]]],[3,[["8:41",["كُنتُمۡ","ءَامَنتُم","بِٱللَّهِ","وَمَآ","أَنزَلۡنَا","عَلَىٰ","عَبۡدِنَا","ي