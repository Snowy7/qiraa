],[9,[["9:70",["أَنفُسَهُمۡ","يَظۡلِمُونَ"],"٧٠"],["9:71",["وَٱلۡمُؤۡمِنُونَ","وَٱلۡمُؤۡمِنَٰتُ","بَعۡضُهُمۡ"]]]],[10,[["9:71",["أَوۡلِيَآءُ","بَعۡضٖۚ","يَأۡمُرُونَ","بِٱلۡمَعۡرُوفِ","وَيَنۡهَوۡنَ","عَنِ","ٱلۡمُنكَرِ"]]]],[11,[["9:71",["وَيُقِيمُونَ","ٱلصَّلَوٰةَ","وَيُؤۡتُونَ","ٱلزَّكَوٰةَ","وَيُطِيعُونَ","ٱللَّهَ"]]]],[12,[["9:71",["وَرَسُولَهُۥٓۚ","أُوْلَٰٓئِكَ","سَيَرۡحَمُهُمُ","ٱللَّهُۗ","إِنَّ","ٱللَّهَ","عَزِيزٌ","حَكِيمٞ"]]]],[13,[["9:71",[],"٧١"],["9:72",["وَعَدَ","ٱللَّهُ","ٱلۡمُؤۡمِنِينَ","وَٱلۡمُؤۡمِنَٰتِ","جَنَّٰتٖ","تَجۡرِي","مِن","تَحۡتِهَا"]]]],[14,[["9:72",["ٱلۡأَنۡهَٰرُ","خَٰلِدِينَ","فِيهَا","وَمَسَٰكِنَ","طَيِّبَةٗ","فِي","جَنَّٰتِ","عَدۡنٖۚ"]]]],[15,[["9:72",["وَرِضۡوَٰنٞ","مِّنَ","ٱللَّهِ","أَكۡبَرُۚ","ذَٰلِكَ","هُوَ","ٱلۡفَوۡزُ","ٱلۡعَظِيمُ"],"٧٢"]]]],"199":[[1,[["9:73",["يَٰٓأَيُّهَا","ٱلنَّبِيُّ","جَٰهِدِ","ٱلۡكُفَّارَ","وَٱلۡمُنَٰفِقِينَ","وَٱغۡلُظۡ","عَلَيۡهِمۡۚ"]]]],[2,[["9:73",["وَمَأۡوَىٰهُمۡ","جَهَنَّمُۖ","وَبِئۡسَ","ٱلۡمَصِيرُ"],"٧٣"],["9:74",["يَحۡلِفُونَ","بِٱللَّهِ","مَا","قَالُواْ"]]]],[3,[["9:74",["وَلَقَدۡ","قَالُواْ","كَلِمَةَ","ٱلۡكُفۡرِ","وَكَفَرُواْ","بَعۡدَ","إِسۡلَٰمِهِمۡ","وَهَمُّواْ"]]]],[4,[["9:74",["بِمَا","لَمۡ","يَنَالُواْۚ","وَمَا","نَقَمُوٓاْ","إِلَّآ","أَنۡ","أَغۡنَىٰهُمُ","ٱللَّهُ","وَرَسُولُهُۥ"]]]],[5,[["9:74",["مِن","فَضۡلِهِۦۚ","فَإِن","يَتُوبُواْ","يَكُ","خَيۡرٗا","لَّهُمۡۖ","وَإِن","يَتَوَلَّوۡاْ","يُعَذِّبۡهُمُ"]]]],[6,[["9:74",["ٱللَّهُ","عَذَابًا","أَلِيمٗا","فِي","ٱلدُّنۡيَا","وَٱلۡأٓخِرَةِۚ","وَمَا","لَهُمۡ","فِي","ٱلۡأَرۡضِ"]]]],[7,[["9:74",["مِن","وَلِيّٖ","وَلَا","نَصِيرٖ"],"٧٤"],["9:75",["۞ وَمِنۡهُم","مَّنۡ","عَٰهَدَ","ٱللَّهَ","لَئِنۡ","ءَاتَىٰنَا"]]]],[8,[["9:75",["مِن","فَضۡلِهِۦ","لَنَصَّدَّقَنَّ","وَلَنَكُونَنَّ","مِنَ","ٱلصَّٰلِحِينَ"]]]],[9,[["9:75",[],"٧٥"],["9:76",["فَلَمَّآ","ءَاتَىٰهُم","مِّن","فَضۡلِهِۦ","بَخِلُواْ","بِهِۦ","وَتَوَلَّواْ","وَّهُم"]]]],[10,[["9:76",["مُّعۡرِضُونَ"],"٧٦"],["9:77",["فَأَعۡقَبَهُمۡ","نِفَاقٗا","فِي","قُلُوبِهِمۡ","إِلَىٰ","يَوۡمِ","يَلۡقَوۡنَهُۥ"]]]],[11,[["9:77",["بِمَآ","أَخۡلَفُواْ","ٱللَّهَ","مَا","وَعَدُوهُ","وَبِمَا","كَانُواْ","يَكۡذِبُونَ"],"٧٧"]]],[12,[["9:78",["أَلَمۡ","يَعۡلَمُوٓاْ","أَنَّ","ٱللَّهَ","يَعۡلَمُ","سِرَّهُمۡ","وَنَجۡوَىٰهُمۡ","وَأَنَّ","ٱللَّهَ"]]]],[13,[["9:78",["عَلَّٰمُ","ٱلۡغُيُوبِ"],"٧٨"],["9:79",["ٱلَّذِينَ","يَلۡمِزُونَ","ٱلۡمُطَّوِّعِينَ","مِنَ"]]]],[14,[["9:79",["ٱلۡمُؤۡمِنِينَ","فِي","ٱلصَّدَقَٰتِ","وَٱلَّذِينَ","لَا","يَجِدُونَ","إِلَّا","جُهۡدَهُمۡ"]]]],[15,[["9:79",["فَيَسۡخَرُونَ","مِنۡهُمۡ","سَخِرَ","ٱللَّهُ","مِنۡهُمۡ","وَلَهُمۡ","عَذَابٌ","أَلِيمٌ"],"٧٩"]]]],"200":[[1,[["9:80",["ٱسۡتَغۡفِرۡ","لَهُمۡ","أَوۡ","لَا","تَسۡتَغۡفِرۡ","لَهُمۡ","إِن","تَسۡتَغۡفِرۡ","لَهُمۡ","سَبۡعِينَ","مَرَّةٗ"]]]],[2,[["9:80",["فَلَن","يَغۡفِرَ","ٱللَّهُ","لَهُمۡۚ","ذَٰلِكَ","بِأَنَّهُمۡ","كَفَرُواْ","بِٱللَّهِ","وَرَسُولِهِۦۗ"]]]],[3,[["9:80",["وَٱللَّهُ","لَا","يَهۡدِي","ٱلۡقَوۡمَ","ٱلۡفَٰسِقِينَ"],"٨٠"],["9:81",["فَرِحَ","ٱلۡمُخَلَّفُونَ","بِمَقۡعَدِهِمۡ"]]]],[4,[["9:81",["خِلَٰفَ","رَسُولِ","ٱللَّهِ","وَكَرِهُوٓاْ","أَن","يُجَٰهِدُواْ","بِأَمۡوَٰلِهِمۡ","وَأَنفُسِهِمۡ"]]]],[5,[["9:81",["فِي","سَبِيلِ","ٱللَّهِ","وَقَالُواْ","لَا","تَنفِرُواْ","فِي","ٱلۡحَرِّۗ","قُلۡ","نَارُ","جَهَنَّمَ","أَشَدُّ","حَرّٗاۚ"]]]],[6,[["9:81",["لَّوۡ","كَانُواْ","يَفۡقَهُونَ"],"٨١"],["9:82",["فَلۡيَضۡحَكُواْ","قَلِيلٗا","وَلۡيَبۡكُواْ","كَثِيرٗا","جَزَآءَۢ"]]]],[7,[["9:82",["بِمَا","كَانُواْ","يَكۡسِبُونَ"],"٨٢"],["9:83",["فَإِن","رَّجَعَكَ","ٱللَّهُ","إِلَىٰ","طَآئِفَةٖ"]]]],[8,[["9:83",["مِّنۡهُمۡ","فَٱسۡتَـٔۡذَنُوكَ","لِلۡخُرُوجِ","فَقُل","لَّن","تَخۡرُجُواْ","مَعِيَ","أَبَدٗا","وَلَن"]]]],[9,[["9:83",["تُقَٰتِلُواْ","مَعِيَ","عَدُوًّاۖ","إِنَّكُمۡ","رَضِيتُم","بِٱلۡقُعُودِ","أَوَّلَ","مَرَّةٖ","فَٱقۡعُدُواْ"]]]],[10,[["9:83",["مَعَ","ٱلۡخَٰلِفِينَ"],"٨٣"],["9:84",["وَلَا","تُصَلِّ","عَلَىٰٓ","أَحَدٖ","مِّنۡهُم","مَّاتَ","أَبَدٗا","وَلَا","تَقُمۡ"]]]],[11,[["9:84",["عَلَىٰ","قَبۡرِهِۦٓۖ","إِنَّهُمۡ","كَفَرُواْ","بِٱللَّهِ","وَرَسُولِهِۦ","وَمَاتُواْ","وَهُمۡ","فَٰسِقُونَ"]]]],[12,[["9:84",[],"٨٤"],["9:85",["وَلَا","تُعۡجِبۡكَ","أَمۡوَٰلُهُمۡ","وَأَوۡلَٰدُهُمۡۚ","إِنَّمَا","يُرِيدُ","ٱللَّهُ","أَن","يُعَذِّبَهُم"]]]],[13,[["9:85",["بِهَا","فِي","ٱلدُّنۡيَا","وَتَزۡهَقَ","أَنفُسُهُمۡ","وَهُمۡ","كَٰفِرُونَ"],"٨٥"],["9:86",["وَإِذَآ"]]]],[14,[["9:86",["أُنزِلَتۡ","سُورَةٌ","أَنۡ","ءَامِنُواْ","بِٱللَّهِ","وَجَٰهِدُواْ","مَعَ","رَسُولِهِ","ٱسۡتَـٔۡذَنَكَ"]]]],[15,[["9:86",["أُوْلُواْ","ٱلطَّوۡلِ","مِنۡهُمۡ","وَقَالُواْ","ذَرۡنَا","نَكُن","مَّعَ","ٱلۡقَٰعِدِينَ"],"٨٦"]]]]}