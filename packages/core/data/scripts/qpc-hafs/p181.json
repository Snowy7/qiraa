","ضَعۡفٗاۚ","فَإِن","يَكُن","مِّنكُم","مِّاْئَةٞ"]]]],[10,[["8:66",["صَابِرَةٞ","يَغۡلِبُواْ","مِاْئَتَيۡنِۚ","وَإِن","يَكُن","مِّنكُمۡ","أَلۡفٞ","يَغۡلِبُوٓاْ"]]]],[11,[["8:66",["أَلۡفَيۡنِ","بِإِذۡنِ","ٱللَّهِۗ","وَٱللَّهُ","مَعَ","ٱلصَّٰبِرِينَ"],"٦٦"],["8:67",["مَا","كَانَ","لِنَبِيٍّ"]]]],[12,[["8:67",["أَن","يَكُونَ","لَهُۥٓ","أَسۡرَىٰ","حَتَّىٰ","يُثۡخِنَ","فِي","ٱلۡأَرۡضِۚ","تُرِيدُونَ","عَرَضَ"]]]],[13,[["8:67",["ٱلدُّنۡيَا","وَٱللَّهُ","يُرِيدُ","ٱلۡأٓخِرَةَۗ","وَٱللَّهُ","عَزِيزٌ","حَكِيمٞ"],"٦٧"],["8:68",["لَّوۡلَا","كِتَٰبٞ"]]]],[14,[["8:68",["مِّنَ","ٱللَّهِ","سَبَقَ","لَمَسَّكُمۡ","فِيمَآ","أَخَذۡتُمۡ","عَذَابٌ","عَظِيمٞ"],"٦٨"],["8:69",["فَكُلُواْ"]]]],[15,[["8:69",["مِمَّا","غَنِمۡتُمۡ","حَلَٰلٗا","طَيِّبٗاۚ","وَٱتَّقُواْ","ٱللَّهَۚ","إِنَّ","ٱللَّهَ","غَفُورٞ","رَّحِيمٞ"],"٦٩"]]]],"186":[[1,[["8:70",["يَٰٓأَيُّهَا","ٱلنَّبِيُّ","قُل","لِّمَن","فِيٓ","أَيۡدِيكُم","مِّنَ","ٱلۡأَسۡرَىٰٓ","إِن","يَعۡلَمِ","ٱللَّهُ"]]]],[2,[["8:70",["فِي","قُلُوبِكُمۡ","خَيۡرٗا","يُؤۡتِكُمۡ","خَيۡرٗا","مِّمَّآ","أُخِذَ","مِنكُمۡ","وَيَغۡفِرۡ","لَكُمۡۚ"]]]],[3,[["8:70",["وَٱللَّهُ","غَفُورٞ","رَّحِيمٞ"],"٧٠"],["8:71",["وَإِن","يُرِيدُواْ","خِيَانَتَكَ","فَقَدۡ","خَانُواْ","ٱللَّهَ"]]]],[4,[["8:71",["مِن","قَبۡلُ","فَأَمۡكَنَ","مِنۡهُمۡۗ","وَٱللَّهُ","عَلِيمٌ","حَكِيمٌ"],"٧١"],["8:72",["إِنَّ","ٱلَّذِينَ"]]]],[5,[["8:72",["ءَامَنُواْ","وَهَاجَرُواْ","وَجَٰهَدُواْ","بِأَمۡوَٰلِهِمۡ","وَأَنفُسِهِمۡ","فِي","سَبِيلِ"]]]],[6,[["8:72",["ٱللَّهِ","وَٱلَّذِينَ","ءَاوَواْ","وَّنَصَرُوٓاْ","أُوْلَٰٓئِكَ","بَعۡضُهُمۡ","أَوۡلِيَآءُ","بَعۡضٖۚ","وَٱلَّذِينَ"]]]],[7,[["8:72",["ءَامَنُواْ","وَلَمۡ","يُهَاجِرُواْ","مَا","لَكُم","مِّن","وَلَٰيَتِهِم","مِّن","شَيۡءٍ","حَتَّىٰ","يُهَاجِرُواْۚ"]]]],[8,[["8:72",["وَإِنِ","ٱسۡتَنصَرُوكُمۡ","فِي","ٱلدِّينِ","فَعَلَيۡكُمُ","ٱلنَّصۡرُ","إِلَّا","عَلَىٰ","قَوۡمِۭ"]]]],[9,[["8:72",["بَيۡنَكُمۡ","وَبَيۡنَهُم","مِّيثَٰقٞۗ","وَٱللَّهُ","بِمَا","تَعۡمَلُونَ","بَصِيرٞ"],"٧٢"],["8:73",["وَٱلَّذِينَ"]]]],[10,[["8:73",["كَفَرُواْ","بَعۡضُهُمۡ","أَوۡلِيَآءُ","بَعۡضٍۚ","إِلَّا","تَفۡعَلُوهُ","تَكُن","فِتۡنَةٞ","فِي"]]]],[11,[["8:73",["ٱلۡأَرۡضِ","وَفَسَادٞ","كَبِيرٞ"],"٧٣"],["8:74",["وَٱلَّذِينَ","ءَامَنُواْ","وَهَاجَرُواْ","وَجَٰهَدُواْ"]]]],[12,[["8:74",["فِي","سَبِيلِ","ٱللَّهِ","وَٱلَّذِينَ","ءَاوَواْ","وَّنَصَرُوٓاْ","أُوْلَٰٓئِكَ","هُمُ","ٱلۡمُؤۡمِنُونَ"]]]],[13,[["8:74",["حَقّٗاۚ","لَّهُم","مَّغۡفِرَةٞ","وَرِزۡقٞ","كَرِيمٞ"],"٧٤"],["8:75",["وَٱلَّذِينَ","ءَامَنُواْ","مِنۢ","بَعۡدُ"]]]],[14,[["8:75",["وَهَاجَرُواْ","وَجَٰهَدُواْ","مَعَكُمۡ","فَأُوْلَٰٓئِكَ","مِنكُمۡۚ","وَأُوْلُواْ","ٱلۡأَرۡحَامِ"]]]],[15,[["8:75",["بَعۡضُهُمۡ","أَوۡلَىٰ","بِبَعۡضٖ","فِي","كِتَٰبِ","ٱللَّهِۚ","إِنَّ","ٱللَّهَ","بِكُلِّ","شَيۡءٍ","عَلِيمُۢ"],"٧٥"]]]],"187":[[2,[["9:1",["بَرَآءَةٞ","مِّنَ","ٱللَّهِ","وَرَسُولِهِۦٓ","إِلَى","ٱلَّذِينَ","عَٰهَدتُّم","مِّنَ","ٱلۡمُشۡرِكِينَ"],"١"]]],[3,[["9:2",["فَسِيحُواْ","فِي","ٱلۡأَرۡضِ","أَرۡبَعَةَ","أَشۡهُرٖ","وَٱعۡلَمُوٓاْ","أَنَّكُمۡ","غَيۡرُ","مُعۡجِزِي"]]]],[4,[["9:2",["ٱللَّهِ","وَأَنَّ","ٱللَّهَ","مُخۡزِي","ٱلۡكَٰفِرِينَ"],"٢"],["9:3",["وَأَذَٰنٞ","مِّنَ","ٱللَّهِ","وَرَسُولِهِۦٓ"]]]],[5,[["9:3",["إِلَى","ٱلنَّاسِ","يَوۡمَ","ٱلۡحَجِّ","ٱلۡأَكۡبَرِ","أَنَّ","ٱللَّهَ","بَرِيٓءٞ","مِّنَ","ٱلۡمُشۡرِكِينَ"]]]],[6,[["9:3",["وَرَسُولُهُۥۚ","فَإِن","تُبۡتُمۡ","فَهُوَ","خَيۡرٞ","لَّكُمۡۖ","وَإِن","تَوَلَّيۡتُمۡ","فَٱعۡلَمُوٓاْ"]]]],[7,[["9:3",["أَنَّكُمۡ","غَيۡرُ","مُعۡجِزِي","ٱللَّهِۗ","وَبَشِّرِ","ٱلَّذِينَ","كَفَرُواْ","بِعَذَابٍ","أَلِيمٍ"]]]],[8,[["9:3",[],"٣"],["9:4",["إِلَّا","ٱلَّذِينَ","عَٰهَدتُّم","مِّنَ","ٱلۡمُشۡرِكِينَ","ثُمَّ","لَمۡ","يَنقُصُوكُمۡ","شَيۡـٔٗا"]]]],[9,[["9:4",["وَلَمۡ","يُظَٰهِرُواْ","عَلَيۡكُمۡ","أَحَدٗا","فَأَتِمُّوٓاْ","إِلَيۡهِمۡ","عَهۡدَهُمۡ","إِلَىٰ","مُدَّتِهِمۡۚ"]]]],[10,[["9:4",["إِنَّ","ٱللَّهَ","يُحِبُّ","ٱلۡمُتَّقِينَ"],"٤"],["9:5",["فَإِذَا","ٱنسَلَخَ","ٱلۡأَشۡهُرُ","ٱلۡحُرُمُ"]]]],[11,[["9:5",["فَٱقۡتُلُواْ","ٱلۡمُشۡرِكِينَ","حَيۡثُ","وَجَدتُّمُوهُمۡ","وَخُذُوهُمۡ","وَٱحۡصُرُوهُمۡ"]]]],[12,[["9:5",["وَٱقۡعُدُواْ","لَهُمۡ","كُلَّ","مَرۡصَدٖۚ","فَإِن","تَابُواْ","وَأَقَامُواْ","ٱلصَّلَوٰةَ","وَءَاتَوُاْ"]]]],[13,[["9:5",["ٱلزَّكَوٰةَ","فَخَلُّواْ","سَبِيلَهُمۡۚ","إِنَّ","ٱللَّهَ","غَفُورٞ","رَّحِيمٞ"],"٥"],["9:6",["وَإِنۡ","أَحَدٞ"]]]],[14,[["9:6",["مِّنَ","ٱلۡمُشۡرِكِينَ","ٱسۡتَجَارَكَ","فَأَجِرۡهُ","حَتَّىٰ","يَسۡمَعَ","كَلَٰمَ"]]]],[15,[["9:6",["ٱللَّهِ","ثُمَّ","أَبۡلِغۡهُ","مَأۡمَنَهُۥۚ","ذَٰلِكَ","بِأَنَّهُمۡ","قَوۡمٞ","لَّا","يَعۡلَمُونَ"],"٦"]]]],"188":[[1,[["9:7",["كَيۡفَ","يَكُونُ","لِلۡمُشۡرِكِينَ","عَهۡدٌ","عِندَ","ٱللَّهِ","وَعِندَ","رَسُولِهِۦٓ"]]]],[2,[["9:7",["إِلَّا","ٱلَّذِينَ","عَٰهَدتُّمۡ","عِندَ","ٱلۡمَسۡجِدِ","ٱلۡحَرَامِۖ","فَمَا","ٱسۡتَقَٰمُواْ"]]]],[3,[["9:7",["لَكُمۡ","فَٱسۡتَقِيمُواْ","لَهُمۡۚ","إِنَّ","ٱللَّهَ","يُحِبُّ","ٱلۡمُتَّقِينَ"],"٧"]]],[4,[["9:8",["كَيۡفَ","وَإِن","يَظۡهَرُواْ","عَلَيۡكُمۡ","لَا","يَرۡقُبُواْ","فِيكُمۡ","إِلّٗا","وَلَا"]]]],[5,[["9:8",["ذِمَّةٗۚ","يُرۡضُونَكُم","بِأَفۡوَٰهِهِمۡ","وَتَأۡبَىٰ","قُلُوبُهُمۡ","وَأَكۡثَرُهُمۡ"]]]],[6,[["9:8",["فَٰسِقُونَ"],"٨"],["9:9",["ٱشۡتَرَوۡاْ","بِـَٔايَٰتِ","ٱللَّهِ","ثَمَنٗا","قَلِيلٗا","فَصَدُّواْ","عَن"]]]],[7,[["9:9",["سَبِيلِهِۦٓۚ","إِنَّهُمۡ","سَآءَ","مَا","كَانُواْ","يَعۡمَلُونَ"],"٩"],["9:10",["لَا","يَرۡقُبُونَ"]]]],[8,[["9:10",["فِي","مُؤۡمِنٍ","إِلّٗا","وَلَا","ذِمَّةٗۚ","وَأُوْلَٰٓئِكَ","هُمُ","ٱلۡمُعۡتَدُونَ"],"١٠"],["9:11",["فَإِن"]]]],[9,[["9:11",["تَابُواْ","وَأَقَامُواْ","ٱلصَّلَوٰةَ","وَءَاتَوُاْ","ٱلزَّكَوٰةَ","فَإِخۡوَٰنُكُمۡ","فِي"]]]],[10,[["9:11",["ٱلدِّينِۗ","وَنُفَصِّلُ","ٱلۡأٓيَٰتِ","لِقَوۡمٖ","يَعۡلَمُونَ"],"١١"],["9:12",["وَإِن"]]]],[11,[["9:12",["نَّكَثُوٓاْ","أَيۡمَٰنَهُم","مِّنۢ","بَعۡدِ","عَهۡدِهِمۡ","وَطَعَنُواْ","فِي","دِينِكُمۡ"]]]],[12,[["9:12",["فَقَٰتِلُوٓاْ","أَئِمَّةَ","ٱلۡكُفۡرِ","إِنَّهُمۡ","لَآ","أَيۡمَٰنَ","لَهُمۡ","لَعَلَّهُمۡ"]]]],[13,[["9:12",["يَنتَهُونَ"],"١٢"],["9:13",["أَلَا","تُقَٰتِلُونَ","قَوۡمٗا","نَّكَثُوٓاْ","أَيۡمَٰنَهُمۡ"]]]],[14,[["9:13",["وَهَمُّواْ","بِإِخۡرَاجِ","ٱلرَّسُولِ","وَهُم","بَدَءُوكُمۡ","أَوَّلَ","مَرَّةٍۚ"]]]],[15,[["9:13",["أَتَخۡشَوۡنَهُمۡۚ","فَٱللَّهُ","أَحَقُّ","أَن","تَخۡشَوۡهُ","إِن","كُنتُم","مُّؤۡمِنِينَ"],"١٣"]]]],"189":[[1,[["9:14",["قَٰتِلُوهُمۡ","يُعَذِّبۡهُمُ","ٱللَّهُ","بِأَيۡدِيكُمۡ","وَيُخۡزِهِمۡ","وَيَنصُرۡكُمۡ"]]]],[2,[["9:14",["عَلَيۡهِمۡ","وَيَشۡفِ","صُدُورَ","قَوۡمٖ","مُّؤۡمِنِينَ"],"١٤"],["9:15",["وَيُذۡهِبۡ","غَيۡظَ"]]]],[3,[["9:15",["قُلُوبِهِمۡۗ","وَيَتُوبُ","ٱللَّهُ","عَلَىٰ","مَن","يَشَآءُۗ","وَٱللَّهُ","عَلِيمٌ","حَكِيمٌ"],"١٥"]]],[4,[["9:16",["أَمۡ","حَسِبۡتُمۡ","أَن","تُتۡرَكُواْ","وَلَمَّا","يَعۡلَمِ","ٱللَّهُ","ٱلَّذِينَ","جَٰهَدُواْ","مِنكُمۡ"]]]],[5,[["9:16",["وَلَمۡ","يَتَّخِذُواْ","مِن","دُونِ","ٱللَّهِ","وَلَا","رَسُولِهِۦ","وَلَا","ٱلۡمُؤۡمِنِينَ","وَلِيجَةٗۚ"]]]],[6,[["9:16",["وَٱللَّهُ","خَبِيرُۢ","بِمَا","تَعۡمَلُونَ"],"١٦"],["9:17",["مَا","كَانَ","لِلۡمُشۡرِكِينَ","أَن","يَعۡمُرُواْ","مَسَٰجِدَ"]]]],[7,[["9:17",["ٱللَّهِ","شَٰهِدِينَ","عَلَىٰٓ","أَنفُسِهِم","بِٱلۡكُفۡرِۚ","أُوْلَٰٓئِكَ","حَبِطَتۡ"]]]],[8,[["9:17",["أَعۡمَٰلُهُمۡ","وَفِي","ٱلنَّارِ","هُمۡ","خَٰلِدُونَ"],"١٧"],["9:18",["إِنَّمَا","يَعۡمُرُ","مَسَٰجِدَ"]]]],[9,[["9:18",["ٱللَّهِ","مَنۡ","ءَامَنَ","بِٱللَّهِ","وَٱلۡيَوۡمِ","ٱلۡأٓخِرِ","وَأَقَامَ","ٱلصَّلَوٰةَ","وَءَاتَى"]]]],[10,[["9:18",["ٱلزَّكَوٰةَ","وَلَمۡ","يَخۡشَ","إِلَّا","ٱللَّهَۖ","فَعَسَىٰٓ","أُوْلَٰٓئِكَ","أَن","يَكُونُواْ","مِنَ"]]]],[11,[["9:18",["ٱلۡمُهۡتَدِينَ"],"١٨"],["9:19",["۞ أَجَعَلۡتُمۡ","سِقَايَةَ","ٱلۡحَآجِّ","وَعِمَارَةَ","ٱلۡمَسۡجِدِ"]]]],[12,[["9:19",["ٱلۡحَرَامِ","كَمَنۡ","ءَامَنَ","بِٱللَّهِ","وَٱلۡيَوۡمِ","ٱلۡأٓخِرِ","وَجَٰهَدَ","فِي","سَبِيلِ"]]]],[13,[["9:19",["ٱللَّهِۚ","لَا","يَسۡتَوُۥنَ","عِندَ","ٱللَّهِۗ","وَٱللَّهُ","لَا","يَهۡدِي","ٱلۡقَوۡمَ","ٱلظَّٰلِمِينَ"]]]],[14,[["9:19",[],"١٩"],["9:20",["ٱلَّذِينَ","ءَامَنُواْ","وَهَاجَرُواْ","وَجَٰهَدُواْ","فِي","سَبِيلِ","ٱللَّهِ","بِأَمۡوَٰلِهِمۡ"]]]],[15,[["9:20",["وَأَنفُسِهِمۡ","أَعۡظَمُ","دَرَجَةً","عِندَ","ٱللَّهِۚ","وَأُوْلَٰٓئِكَ","هُمُ","ٱلۡفَآئِزُونَ"],"٢٠"]]]],"190":[[1,[["9:21",["يُبَشِّرُهُمۡ","رَبُّهُم","بِرَحۡمَةٖ","مِّنۡهُ","وَرِضۡوَٰنٖ","وَجَنَّٰتٖ","لَّهُمۡ","فِيه