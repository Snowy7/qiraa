َةَ","وَفِيكُمۡ","سَمَّٰعُونَ","لَهُمۡۗ","وَٱللَّهُ","عَلِيمُۢ","بِٱلظَّٰلِمِينَ"],"٤٧"]]]],"195":[[1,[["9:48",["لَقَدِ","ٱبۡتَغَوُاْ","ٱلۡفِتۡنَةَ","مِن","قَبۡلُ","وَقَلَّبُواْ","لَكَ","ٱلۡأُمُورَ","حَتَّىٰ"]]]],[2,[["9:48",["جَآءَ","ٱلۡحَقُّ","وَظَهَرَ","أَمۡرُ","ٱللَّهِ","وَهُمۡ","كَٰرِهُونَ"],"٤٨"],["9:49",["وَمِنۡهُم"]]]],[3,[["9:49",["مَّن","يَقُولُ","ٱئۡذَن","لِّي","وَلَا","تَفۡتِنِّيٓۚ","أَلَا","فِي","ٱلۡفِتۡنَةِ","سَقَطُواْۗ","وَإِنَّ"]]]],[4,[["9:49",["جَهَنَّمَ","لَمُحِيطَةُۢ","بِٱلۡكَٰفِرِينَ"],"٤٩"],["9:50",["إِن","تُصِبۡكَ"]]]],[5,[["9:50",["حَسَنَةٞ","تَسُؤۡهُمۡۖ","وَإِن","تُصِبۡكَ","مُصِيبَةٞ","يَقُولُواْ","قَدۡ"]]]],[6,[["9:50",["أَخَذۡنَآ","أَمۡرَنَا","مِن","قَبۡلُ","وَيَتَوَلَّواْ","وَّهُمۡ","فَرِحُونَ"],"٥٠"],["9:51",["قُل"]]]],[7,[["9:51",["لَّن","يُصِيبَنَآ","إِلَّا","مَا","كَتَبَ","ٱللَّهُ","لَنَا","هُوَ","مَوۡلَىٰنَاۚ","وَعَلَى"]]]],[8,[["9:51",["ٱللَّهِ","فَلۡيَتَوَكَّلِ","ٱلۡمُؤۡمِنُونَ"],"٥١"],["9:52",["قُلۡ","هَلۡ","تَرَبَّصُونَ","بِنَآ","إِلَّآ"]]]],[9,[["9:52",["إِحۡدَى","ٱلۡحُسۡنَيَيۡنِۖ","وَنَحۡنُ","نَتَرَبَّصُ","بِكُمۡ","أَن","يُصِيبَكُمُ","ٱللَّهُ"]]]],[10,[["9:52",["بِعَذَابٖ","مِّنۡ","عِندِهِۦٓ","أَوۡ","بِأَيۡدِينَاۖ","فَتَرَبَّصُوٓاْ","إِنَّا","مَعَكُم"]]]],[11,[["9:52",["مُّتَرَبِّصُونَ"],"٥٢"],["9:53",["قُلۡ","أَنفِقُواْ","طَوۡعًا","أَوۡ","كَرۡهٗا","لَّن","يُتَقَبَّلَ"]]]],[12,[["9:53",["مِنكُمۡ","إِنَّكُمۡ","كُنتُمۡ","قَوۡمٗا","فَٰسِقِينَ"],"٥٣"],["9:54",["وَمَا"]]]],[13,[["9:54",["مَنَعَهُمۡ","أَن","تُقۡبَلَ","مِنۡهُمۡ","نَفَقَٰتُهُمۡ","إِلَّآ","أَنَّهُمۡ","كَفَرُواْ"]]]],[14,[["9:54",["بِٱللَّهِ","وَبِرَسُولِهِۦ","وَلَا","يَأۡتُونَ","ٱلصَّلَوٰةَ","إِلَّا","وَهُمۡ"]]]],[15,[["9:54",["كُسَالَىٰ","وَلَا","يُنفِقُونَ","إِلَّا","وَهُمۡ","كَٰرِهُونَ"],"٥٤"]]]],"196":[[1,[["9:55",["فَلَا","تُعۡجِبۡكَ","أَمۡوَٰلُهُمۡ","وَلَآ","أَوۡلَٰدُهُمۡۚ","إِنَّمَا","يُرِيدُ","ٱللَّهُ","لِيُعَذِّبَهُم"]]]],[2,[["9:55",["بِهَا","فِي","ٱلۡحَيَوٰةِ","ٱلدُّنۡيَا","وَتَزۡهَقَ","أَنفُسُهُمۡ","وَهُمۡ","كَٰفِرُونَ"]]]],[3,[["9:55",[],"٥٥"],["9:56