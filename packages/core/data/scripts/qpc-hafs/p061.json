"سَعِيرٗا"],"١٠"],["4:11",["يُوصِيكُمُ","ٱللَّهُ","فِيٓ"]]]],[9,[["4:11",["أَوۡلَٰدِكُمۡۖ","لِلذَّكَرِ","مِثۡلُ","حَظِّ","ٱلۡأُنثَيَيۡنِۚ","فَإِن","كُنَّ","نِسَآءٗ"]]]],[10,[["4:11",["فَوۡقَ","ٱثۡنَتَيۡنِ","فَلَهُنَّ","ثُلُثَا","مَا","تَرَكَۖ","وَإِن","كَانَتۡ","وَٰحِدَةٗ","فَلَهَا"]]]],[11,[["4:11",["ٱلنِّصۡفُۚ","وَلِأَبَوَيۡهِ","لِكُلِّ","وَٰحِدٖ","مِّنۡهُمَا","ٱلسُّدُسُ","مِمَّا","تَرَكَ","إِن"]]]],[12,[["4:11",["كَانَ","لَهُۥ","وَلَدٞۚ","فَإِن","لَّمۡ","يَكُن","لَّهُۥ","وَلَدٞ","وَوَرِثَهُۥٓ","أَبَوَاهُ","فَلِأُمِّهِ","ٱلثُّلُثُۚ","فَإِن"]]]],[13,[["4:11",["كَانَ","لَهُۥٓ","إِخۡوَةٞ","فَلِأُمِّهِ","ٱلسُّدُسُۚ","مِنۢ","بَعۡدِ","وَصِيَّةٖ","يُوصِي","بِهَآ"]]]],[14,[["4:11",["أَوۡ","دَيۡنٍۗ","ءَابَآؤُكُمۡ","وَأَبۡنَآؤُكُمۡ","لَا","تَدۡرُونَ","أَيُّهُمۡ","أَقۡرَبُ","لَكُمۡ"]]]],[15,[["4:11",["نَفۡعٗاۚ","فَرِيضَةٗ","مِّنَ","ٱللَّهِۗ","إِنَّ","ٱللَّهَ","كَانَ","عَلِيمًا","حَكِيمٗا"],"١١"]]]],"79":[[1,[["4:12",["۞ وَلَكُمۡ","نِصۡفُ","مَا","تَرَكَ","أَزۡوَٰجُكُمۡ","إِن","لَّمۡ","يَكُن"]]]],[2,[["4:12",["لَّهُنَّ","وَلَدٞۚ","فَإِن","كَانَ","لَهُنَّ","وَلَدٞ","فَلَكُمُ","ٱلرُّبُعُ","مِمَّا"]]]],[3,[["4:12",["تَرَكۡنَۚ","مِنۢ","بَعۡدِ","وَصِيَّةٖ","يُوصِينَ","بِهَآ","أَوۡ","دَيۡنٖۚ"]]]],[4,[["4:12",["وَلَهُنَّ","ٱلرُّبُعُ","مِمَّا","تَرَكۡتُمۡ","إِن","لَّمۡ","يَكُن","لَّكُمۡ","وَلَدٞۚ"]]]],[5,[["4:12",["فَإِن","كَانَ","لَكُمۡ","وَلَدٞ","فَلَهُنَّ","ٱلثُّمُنُ","مِمَّا","تَرَكۡتُمۚ"]]]],[6,[["4:12",["مِّنۢ","بَعۡدِ","وَصِيَّةٖ","تُوصُونَ","بِهَآ","أَوۡ","دَيۡنٖۗ","وَإِن","كَانَ"]]]],[7,[["4:12",["رَجُلٞ","يُورَثُ","كَلَٰلَةً","أَوِ","ٱمۡرَأَةٞ","وَلَهُۥٓ","أَخٌ","أَوۡ","أُخۡتٞ","فَلِكُلِّ"]]]],[8,[["4:12",["وَٰحِدٖ","مِّنۡهُمَا","ٱلسُّدُسُۚ","فَإِن","كَانُوٓاْ","أَكۡثَرَ","مِن","ذَٰلِكَ"]]]],[9,[["4:12",["فَهُمۡ","شُرَكَآءُ","فِي","ٱلثُّلُثِۚ","مِنۢ","بَعۡدِ","وَصِيَّةٖ","يُوصَىٰ"]]]],[10,[["4:12",["بِهَآ","أَوۡ","دَيۡنٍ","غَيۡرَ","مُضَآرّٖۚ","وَصِيَّةٗ","مِّنَ","ٱللَّهِۗ","وَٱللَّهُ"]]]],[11,[["4:12",["عَلِيمٌ","حَلِيمٞ"],"١٢"],["4:13",["تِلۡكَ","حُدُودُ","ٱللَّهِۚ