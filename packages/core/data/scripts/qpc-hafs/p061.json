,"ثَوَابٗا","مِّنۡ","عِندِ","ٱللَّهِۚ","وَٱللَّهُ","عِندَهُۥ","حُسۡنُ","ٱلثَّوَابِ"],"١٩٥"]]],[6,[["3:196",["لَا","يَغُرَّنَّكَ","تَقَلُّبُ","ٱلَّذِينَ","كَفَرُواْ","فِي","ٱلۡبِلَٰدِ"],"١٩٦"],["3:197",["مَتَٰعٞ","قَلِيلٞ"]]]],[7,[["3:197",["ثُمَّ","مَأۡوَىٰهُمۡ","جَهَنَّمُۖ","وَبِئۡسَ","ٱلۡمِهَادُ"],"١٩٧"],["3:198",["لَٰكِنِ","ٱلَّذِينَ","ٱتَّقَوۡاْ"]]]],[8,[["3:198",["رَبَّهُمۡ","لَهُمۡ","جَنَّٰتٞ","تَجۡرِي","مِن","تَحۡتِهَا","ٱلۡأَنۡهَٰرُ","خَٰلِدِينَ","فِيهَا"]]]],[9,[["3:198",["نُزُلٗا","مِّنۡ","عِندِ","ٱللَّهِۗ","وَمَا","عِندَ","ٱللَّهِ","خَيۡرٞ","لِّلۡأَبۡرَارِ"],"١٩٨"],["3:199",["وَإِنَّ","مِنۡ"]]]],[10,[["3:199",["أَهۡلِ","ٱلۡكِتَٰبِ","لَمَن","يُؤۡمِنُ","بِٱللَّهِ","وَمَآ","أُنزِلَ","إِلَيۡكُمۡ"]]]],[11,[["3:199",["وَمَآ","أُنزِلَ","إِلَيۡهِمۡ","خَٰشِعِينَ","لِلَّهِ","لَا","يَشۡتَرُونَ","بِـَٔايَٰتِ","ٱللَّهِ"]]]],[12,[["3:199",["ثَمَنٗا","قَلِيلًاۚ","أُوْلَٰٓئِكَ","لَهُمۡ","أَجۡرُهُمۡ","عِندَ","رَبِّهِمۡۗ","إِنَّ","ٱللَّهَ"]]]],[13,[["3:199",["سَرِيعُ","ٱلۡحِسَابِ"],"١٩٩"],["3:200",["يَٰٓأَيُّهَا","ٱلَّذِينَ","ءَامَنُواْ","ٱصۡبِرُواْ"]]]],[14,[["3:200",["وَصَابِرُواْ","وَرَابِطُواْ","وَٱتَّقُواْ","ٱللَّهَ","لَعَلَّكُمۡ","تُفۡلِحُونَ"],"٢٠٠"]]]],"77":[[2,[["4:1",["يَٰٓأَيُّهَا","ٱلنَّاسُ","ٱتَّقُواْ","رَبَّكُمُ","ٱلَّذِي","خَلَقَكُم","مِّن","نَّفۡسٖ","وَٰحِدَةٖ","وَخَلَقَ","مِنۡهَا"]]]],[3,[["4:1",["زَوۡجَهَا","وَبَثَّ","مِنۡهُمَا","رِجَالٗا","كَثِيرٗا","وَنِسَآءٗۚ","وَٱتَّقُواْ","ٱللَّهَ","ٱلَّذِي","تَسَآءَلُونَ"]]]],[4,[["4:1",["بِهِۦ","وَٱلۡأَرۡحَامَۚ","إِنَّ","ٱللَّهَ","كَانَ","عَلَيۡكُمۡ","رَقِيبٗا"],"١"],["4:2",["وَءَاتُواْ","ٱلۡيَتَٰمَىٰٓ","أَمۡوَٰلَهُمۡۖ"]]]],[5,[["4:2",["وَلَا","تَتَبَدَّلُواْ","ٱلۡخَبِيثَ","بِٱلطَّيِّبِۖ","وَلَا","تَأۡكُلُوٓاْ","أَمۡوَٰلَهُمۡ","إِلَىٰٓ","أَمۡوَٰلِكُمۡۚ","إِنَّهُۥ"]]]],[6,[["4:2",["كَانَ","حُوبٗا","كَبِيرٗا"],"٢"],["4:3",["وَإِنۡ","خِفۡتُمۡ","أَلَّا","تُقۡسِطُواْ","فِي","ٱلۡيَتَٰمَىٰ","فَٱنكِحُواْ"]]]],[7,[["4:3",["مَا","طَابَ","لَكُم","مِّنَ","ٱلنِّسَآءِ","مَثۡنَىٰ","وَثُلَٰثَ","وَرُبَٰعَۖ","فَإِنۡ","خِفۡتُمۡ"