"4:12",18,["تَرَكۡنَۚ","مِنۢ","بَعۡدِ","وَصِيَّةٖ","يُوصِينَ","بِهَآ","أَوۡ","دَيۡنٖۚ"]]]],[4,[["4:12",26,["وَلَهُنَّ","ٱلرُّبُعُ","مِمَّا","تَرَكۡتُمۡ","إِن","لَّمۡ","يَكُن","لَّكُمۡ","وَلَدٞۚ"]]]],[5,[["4:12",35,["فَإِن","كَانَ","لَكُمۡ","وَلَدٞ","فَلَهُنَّ","ٱلثُّمُنُ","مِمَّا","تَرَكۡتُمۚ"]]]],[6,[["4:12",43,["مِّنۢ","بَعۡدِ","وَصِيَّةٖ","تُوصُونَ","بِهَآ","أَوۡ","دَيۡنٖۗ","وَإِن","كَانَ"]]]],[7,[["4:12",52,["رَجُلٞ","يُورَثُ","كَلَٰلَةً","أَوِ","ٱمۡرَأَةٞ","وَلَهُۥٓ","أَخٌ","أَوۡ","أُخۡتٞ","فَلِكُلِّ"]]]],[8,[["4:12",62,["وَٰحِدٖ","مِّنۡهُمَا","ٱلسُّدُسُۚ","فَإِن","كَانُوٓاْ","أَكۡثَرَ","مِن","ذَٰلِكَ"]]]],[9,[["4:12",70,["فَهُمۡ","شُرَكَآءُ","فِي","ٱلثُّلُثِۚ","مِنۢ","بَعۡدِ","وَصِيَّةٖ","يُوصَىٰ"]]]],[10,[["4:12",78,["بِهَآ","أَوۡ","دَيۡنٍ","غَيۡرَ","مُضَآرّٖۚ","وَصِيَّةٗ","مِّنَ","ٱللَّهِۗ","وَٱللَّهُ"]]]],[11,[["4:12",87,["عَلِيمٌ","حَلِيمٞ"],"١٢"],["4:13",1,["تِلۡكَ","حُدُودُ","ٱللَّهِۚ","وَمَن","يُطِعِ","ٱللَّهَ"]]]],[12,[["4:13",7,["وَرَسُولَهُۥ","يُدۡخِلۡهُ","جَنَّٰتٖ","تَجۡرِي","مِن","تَحۡتِهَا"]]]],[13,[["4:13",13,["ٱلۡأَنۡهَٰرُ","خَٰلِدِينَ","فِيهَاۚ","وَذَٰلِكَ","ٱلۡفَوۡزُ","ٱلۡعَظِيمُ"]]]],[14,[["4:13",19,[],"١٣"],["4:14",1,["وَمَن","يَعۡصِ","ٱللَّهَ","وَرَسُولَهُۥ","وَيَتَعَدَّ","حُدُودَهُۥ"]]]],[15,[["4:14",7,["يُدۡخِلۡهُ","نَارًا","خَٰلِدٗا","فِيهَا","وَلَهُۥ","عَذَابٞ","مُّهِينٞ"],"١٤"]]]],"80":[[1,[["4:15",1,["وَٱلَّٰتِي","يَأۡتِينَ","ٱلۡفَٰحِشَةَ","مِن","نِّسَآئِكُمۡ","فَٱسۡتَشۡهِدُواْ","عَلَيۡهِنَّ"]]]],[2,[["4:15",8,["أَرۡبَعَةٗ","مِّنكُمۡۖ","فَإِن","شَهِدُواْ","فَأَمۡسِكُوهُنَّ","فِي","ٱلۡبُيُوتِ"]]]],[3,[["4:15",15,["حَتَّىٰ","يَتَوَفَّىٰهُنَّ","ٱلۡمَوۡتُ","أَوۡ","يَجۡعَلَ","ٱللَّهُ","لَهُنَّ","سَبِيلٗا"],"١٥"]]],[4,[["4:16",1,["وَٱلَّذَانِ","يَأۡتِيَٰنِهَا","مِنكُمۡ","فَـَٔاذُوهُمَاۖ","فَإِن","تَابَا","وَأَصۡلَحَا"]]]],[5,[["4:16",8,["فَأَعۡرِضُواْ","عَنۡهُمَآۗ","إِنَّ","ٱللَّهَ","كَانَ","تَوَّابٗا","رَّحِيمًا"],"١٦"]]],[6,[["4:17",1,["إِنَّمَا","ٱلتَّوۡبَةُ","عَلَى","ٱللَّهِ","لِلَّذِينَ","يَعۡمَلُونَ","ٱلسُّوٓءَ","بِجَهَٰلَةٖ"]]]],[7,[["4:17",9,["ثُمَّ","يَتُوبُونَ","مِن","قَرِيبٖ","فَأُوْلَٰٓئِكَ","يَتُوبُ","ٱللَّهُ","عَلَيۡهِمۡۗ"]]]],[8,[["4:17",17,["وَكَانَ","ٱللَّهُ","عَلِيمًا","حَكِيمٗا"],"١٧"],["4:18",1,["وَلَيۡسَتِ","ٱلتَّوۡبَةُ","لِلَّذِينَ"]]]],[9,[["4:18",4,["يَعۡمَلُونَ","ٱلسَّيِّـَٔاتِ","حَتَّىٰٓ","إِذَا","حَضَرَ","أَحَدَهُمُ","ٱلۡمَوۡتُ"]]]],[10,[["4:18",11,["قَالَ","إِنِّي","تُبۡتُ","ٱلۡـَٰٔنَ","وَلَا","ٱلَّذِينَ","يَمُوتُونَ","وَهُمۡ","كُفَّارٌۚ"]]]],[11,[["4:18",20,["أُوْلَٰٓئِكَ","أَعۡتَدۡنَا","لَهُمۡ","عَذَابًا","أَلِيمٗا"],"١٨"],["4:19",1,["يَٰٓأَيُّهَا","ٱلَّذِينَ"]]]],[12,[["4:19",3,["ءَامَنُواْ","لَا","يَحِلُّ","لَكُمۡ","أَن","تَرِثُواْ","ٱلنِّسَآءَ","كَرۡهٗاۖ","وَلَا","تَعۡضُلُوهُنَّ"]]]],[13,[["4:19",13,["لِتَذۡهَبُواْ","بِبَعۡضِ","مَآ","ءَاتَيۡتُمُوهُنَّ","إِلَّآ","أَن","يَأۡتِينَ","بِفَٰحِشَةٖ"]]]],[14,[["4:19",21,["مُّبَيِّنَةٖۚ","وَعَاشِرُوهُنَّ","بِٱلۡمَعۡرُوفِۚ","فَإِن","كَرِهۡتُمُوهُنَّ","فَعَسَىٰٓ"]]]],[15,[["4:19",27,["أَن","تَكۡرَهُواْ","شَيۡـٔٗا","وَيَجۡعَلَ","ٱللَّهُ","فِيهِ","خَيۡرٗا","كَثِيرٗا"],"١٩"]]]]}