َامَنُواْ","لَا","تَتَّخِذُواْ","بِطَانَةٗ","مِّن","دُونِكُمۡ","لَا","يَأۡلُونَكُمۡ","خَبَالٗا"]]]],[7,[["3:118",["وَدُّواْ","مَا","عَنِتُّمۡ","قَدۡ","بَدَتِ","ٱلۡبَغۡضَآءُ","مِنۡ","أَفۡوَٰهِهِمۡ","وَمَا","تُخۡفِي"]]]],[8,[["3:118",["صُدُورُهُمۡ","أَكۡبَرُۚ","قَدۡ","بَيَّنَّا","لَكُمُ","ٱلۡأٓيَٰتِۖ","إِن","كُنتُمۡ","تَعۡقِلُونَ"]]]],[9,[["3:118",[],"١١٨"],["3:119",["هَٰٓأَنتُمۡ","أُوْلَآءِ","تُحِبُّونَهُمۡ","وَلَا","يُحِبُّونَكُمۡ","وَتُؤۡمِنُونَ","بِٱلۡكِتَٰبِ"]]]],[10,[["3:119",["كُلِّهِۦ","وَإِذَا","لَقُوكُمۡ","قَالُوٓاْ","ءَامَنَّا","وَإِذَا","خَلَوۡاْ","عَضُّواْ","عَلَيۡكُمُ"]]]],[11,[["3:119",["ٱلۡأَنَامِلَ","مِنَ","ٱلۡغَيۡظِۚ","قُلۡ","مُوتُواْ","بِغَيۡظِكُمۡۗ","إِنَّ","ٱللَّهَ","عَلِيمُۢ","بِذَاتِ"]]]],[12,[["3:119",["ٱلصُّدُورِ"],"١١٩"],["3:120",["إِن","تَمۡسَسۡكُمۡ","حَسَنَةٞ","تَسُؤۡهُمۡ","وَإِن","تُصِبۡكُمۡ"]]]],[13,[["3:120",["سَيِّئَةٞ","يَفۡرَحُواْ","بِهَاۖ","وَإِن","تَصۡبِرُواْ","وَتَتَّقُواْ","لَا","يَضُرُّكُمۡ","كَيۡدُهُمۡ"]]]],[14,[["3:120",["شَيۡـًٔاۗ","إِنَّ","ٱللَّهَ","بِمَا","يَعۡمَلُونَ","مُحِيطٞ"],"١٢٠"],["3:121",["وَإِذۡ","غَدَوۡتَ","مِنۡ","أَهۡلِكَ"]]]],[15,[["3:121",["تُبَوِّئُ","ٱلۡمُؤۡمِنِينَ","مَقَٰعِدَ","لِلۡقِتَالِۗ","وَٱللَّهُ","سَمِيعٌ","عَلِيمٌ"],"١٢١"]]]],"66":[[1,[["3:122",["إِذۡ","هَمَّت","طَّآئِفَتَانِ","مِنكُمۡ","أَن","تَفۡشَلَا","وَٱللَّهُ","وَلِيُّهُمَاۗ","وَعَلَى","ٱللَّهِ"]]]],[2,[["3:122",["فَلۡيَتَوَكَّلِ","ٱلۡمُؤۡمِنُونَ"],"١٢٢"],["3:123",["وَلَقَدۡ","نَصَرَكُمُ","ٱللَّهُ","بِبَدۡرٖ","وَأَنتُمۡ","أَذِلَّةٞۖ"]]]],[3,[["3:123",["فَٱتَّقُواْ","ٱللَّهَ","لَعَلَّكُمۡ","تَشۡكُرُونَ"],"١٢٣"],["3:124",["إِذۡ","تَقُولُ","لِلۡمُؤۡمِنِينَ"]]]],[4,[["3:124",["أَلَن","يَكۡفِيَكُمۡ","أَن","يُمِدَّكُمۡ","رَبُّكُم","بِثَلَٰثَةِ","ءَالَٰفٖ","مِّنَ","ٱلۡمَلَٰٓئِكَةِ"]]]],[5,[["3:124",["مُنزَلِينَ"],"١٢٤"],["3:125",["بَلَىٰٓۚ","إِن","تَصۡبِرُواْ","وَتَتَّقُواْ","وَيَأۡتُوكُم","مِّن","فَوۡرِهِمۡ"]]]],[6,[["3:125",["هَٰذَا","يُمۡدِدۡكُمۡ","رَبُّكُم","بِخَمۡسَةِ","ءَالَٰفٖ","مِّنَ","ٱلۡمَلَٰٓئِكَةِ","مُسَوِّمِينَ"]]]],[7,[["3:125",[],"١٢٥"],["3:126",["وَمَا","جَعَلَهُ","ٱللَّهُ","إِلَّا","بُشۡرَىٰ","لَكُمۡ","وَلِتَطۡمَئِنَّ","قُلُوبُكُم","بِهِۦۗ"]]]],[8,[["3:126",["وَمَا","ٱلنَّصۡرُ","إِلَّا","مِنۡ","عِندِ","ٱللَّهِ","ٱلۡعَزِيزِ","ٱلۡحَكِيمِ"],"١٢٦"],["3:127",["لِيَقۡطَعَ","طَرَفٗا"]]]],[9,[["3:127",["مِّنَ","ٱلَّذِينَ","كَفَرُوٓاْ","أَوۡ","يَكۡبِتَهُمۡ","فَيَنقَلِبُواْ","خَآئِبِينَ"],"١٢٧"]]],[10,[["3:128",["لَيۡسَ","لَكَ","مِنَ","ٱلۡأَمۡرِ","شَيۡءٌ","أَوۡ","يَتُوبَ","عَلَيۡهِمۡ","أَوۡ","يُعَذِّبَهُمۡ","فَإِنَّهُمۡ"]]]],[11,[["3:128",["ظَٰلِمُونَ"],"١٢٨"],["3:129",["وَلِلَّهِ","مَا","فِي","ٱلسَّمَٰوَٰتِ","وَمَا","فِي","ٱلۡأَرۡضِۚ","يَغۡفِرُ","لِمَن"]]]],[12,[["3:129",["يَشَآءُ","وَيُعَذِّبُ","مَن","يَشَآءُۚ","وَٱللَّهُ","غَفُورٞ","رَّحِيمٞ"],"١٢٩"],["3:130",["يَٰٓأَيُّهَا"]]]],[13,[["3:130",["ٱلَّذِينَ","ءَامَنُواْ","لَا","تَأۡكُلُواْ","ٱلرِّبَوٰٓاْ","أَضۡعَٰفٗا","مُّضَٰعَفَةٗۖ"]]]],[14,[["3:130",["وَٱتَّقُواْ","ٱللَّهَ","لَعَلَّكُمۡ","تُفۡلِحُونَ"],"١٣٠"],["3:131",["وَٱتَّقُواْ","ٱلنَّارَ","ٱلَّتِيٓ","أُعِدَّتۡ"]]]],[15,[["3:131",["لِلۡكَٰفِرِينَ"],"١٣١"],["3:132",["وَأَطِيعُواْ","ٱللَّهَ","وَٱلرَّسُولَ","لَعَلَّكُمۡ","تُرۡحَمُونَ"],"١٣٢"]]]],"67":[[1,[["3:133",["۞ وَسَارِعُوٓاْ","إِلَىٰ","مَغۡفِرَةٖ","مِّن","رَّبِّكُمۡ","وَجَنَّةٍ","عَرۡضُهَا"]]]],[2,[["3:133",["ٱلسَّمَٰوَٰتُ","وَٱلۡأَرۡضُ","أُعِدَّتۡ","لِلۡمُتَّقِينَ"],"١٣٣"],["3:134",["ٱلَّذِينَ","يُنفِقُونَ"]]]],[3,[["3:134",["فِي","ٱلسَّرَّآءِ","وَٱلضَّرَّآءِ","وَٱلۡكَٰظِمِينَ","ٱلۡغَيۡظَ","وَٱلۡعَافِينَ"]]]],[4,[["3:134",["عَنِ","ٱلنَّاسِۗ","وَٱللَّهُ","يُحِبُّ","ٱلۡمُحۡسِنِينَ"],"١٣٤"],["3:135",["وَٱلَّذِينَ","إِذَا","فَعَلُواْ"]]]],[5,[["3:135",["فَٰحِشَةً","أَوۡ","ظَلَمُوٓاْ","أَنفُسَهُمۡ","ذَكَرُواْ","ٱللَّهَ","فَٱسۡتَغۡفَرُواْ"]]]],[6,[["3:135",["لِذُنُوبِهِمۡ","وَمَن","يَغۡفِرُ","ٱلذُّنُوبَ","إِلَّا","ٱللَّهُ","وَلَمۡ","يُصِرُّواْ","عَلَىٰ","مَا"]]]],[7,[["3:135",["فَعَلُواْ","وَهُمۡ","يَعۡلَمُونَ"],"١٣٥"],["3:136",["أُوْلَٰٓئِكَ","جَزَآؤُهُم","مَّغۡفِرَةٞ","مِّن"]]]],[8,[["3:136",["رَّبِّهِمۡ","وَجَنَّٰتٞ","تَجۡرِي","مِن","تَحۡت