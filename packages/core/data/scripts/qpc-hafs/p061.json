{"61":[[1,[["3:84",["قُلۡ","ءَامَنَّا","بِٱللَّهِ","وَمَآ","أُنزِلَ","عَلَيۡنَا","وَمَآ","أُنزِلَ","عَلَىٰٓ","إِبۡرَٰهِيمَ"]]]],[2,[["3:84",["وَإِسۡمَٰعِيلَ","وَإِسۡحَٰقَ","وَيَعۡقُوبَ","وَٱلۡأَسۡبَاطِ","وَمَآ","أُوتِيَ","مُوسَىٰ"]]]],[3,[["3:84",["وَعِيسَىٰ","وَٱلنَّبِيُّونَ","مِن","رَّبِّهِمۡ","لَا","نُفَرِّقُ","بَيۡنَ","أَحَدٖ","مِّنۡهُمۡ"]]]],[4,[["3:84",["وَنَحۡنُ","لَهُۥ","مُسۡلِمُونَ"],"٨٤"],["3:85",["وَمَن","يَبۡتَغِ","غَيۡرَ","ٱلۡإِسۡلَٰمِ","دِينٗا","فَلَن"]]]],[5,[["3:85",["يُقۡبَلَ","مِنۡهُ","وَهُوَ","فِي","ٱلۡأٓخِرَةِ","مِنَ","ٱلۡخَٰسِرِينَ"],"٨٥"],["3:86",["كَيۡفَ"]]]],[6,[["3:86",["يَهۡدِي","ٱللَّهُ","قَوۡمٗا","كَفَرُواْ","بَعۡدَ","إِيمَٰنِهِمۡ","وَشَهِدُوٓاْ","أَنَّ"]]]],[7,[["3:86",["ٱلرَّسُولَ","حَقّٞ","وَجَآءَهُمُ","ٱلۡبَيِّنَٰتُۚ","وَٱللَّهُ","لَا","يَهۡدِي","ٱلۡقَوۡمَ"]]]],[8,[["3:86",["ٱلظَّٰلِمِينَ"],"٨٦"],["3:87",["أُوْلَٰٓئِكَ","جَزَآؤُهُمۡ","أَنَّ","عَلَيۡهِمۡ","لَعۡنَةَ","ٱللَّهِ"]]]],[9,[["3:87",["وَٱلۡمَلَٰٓئِكَةِ","وَٱلنَّاسِ","أَجۡمَعِينَ"],"٨٧"],["3:88",["خَٰلِدِينَ","فِيهَا","لَا","يُخَفَّفُ"]]]],[10,[["3:88",["عَنۡهُمُ","ٱلۡعَذَابُ","وَلَا","هُمۡ","يُنظَرُونَ"],"٨٨"],["3:89",["إِلَّا","ٱلَّذِينَ","تَابُواْ","مِنۢ"]]]],[11,[["3:89",["بَعۡدِ","ذَٰلِكَ","وَأَصۡلَحُواْ","فَإِنَّ","ٱللَّهَ","غَفُورٞ","رَّحِيمٌ"],"٨٩"],["3:90",["إِنَّ","ٱلَّذِينَ"]]]],[12,[["3:90",["كَفَرُواْ","بَعۡدَ","إِيمَٰنِهِمۡ","ثُمَّ","ٱزۡدَادُواْ","كُفۡرٗا","لَّن","تُقۡبَلَ","تَوۡبَتُهُمۡ"]]]],[13,[["3:90",["وَأُوْلَٰٓئِكَ","هُمُ","ٱلضَّآلُّونَ"],"٩٠"],["3:91",["إِنَّ","ٱلَّذِينَ","كَفَرُواْ","وَمَاتُواْ","وَهُمۡ"]]]],[14,[["3:91",["كُفَّارٞ","فَلَن","يُقۡبَلَ","مِنۡ","أَحَدِهِم","مِّلۡءُ","ٱلۡأَرۡضِ","ذَهَبٗا","وَلَوِ"]]]],[15,[["3:91",["ٱفۡتَدَىٰ","بِهِۦٓۗ","أُوْلَٰٓئِكَ","لَهُمۡ","عَذَابٌ","أَلِيمٞ","وَمَا","لَهُم","مِّن","نَّٰصِرِينَ"],"٩١"]]]],"62":[[1,[["3:92",["لَن","تَنَالُواْ","ٱلۡبِرَّ","حَتَّىٰ","تُنفِقُواْ","مِمَّا","تُحِبُّونَۚ","وَمَا","تُنفِقُواْ","مِن","شَيۡءٖ"]]]],[2,[["3:92",["فَإِنَّ","ٱللَّهَ","بِهِۦ","عَلِيمٞ"],"٩٢"],["3:93",["۞ كُلُّ","ٱ