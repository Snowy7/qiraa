{"281":[[1,[["16:119",["ثُمَّ","إِنَّ","رَبَّكَ","لِلَّذِينَ","عَمِلُواْ","ٱلسُّوٓءَ","بِجَهَٰلَةٖ","ثُمَّ","تَابُواْ","مِنۢ","بَعۡدِ"]]]],[2,[["16:119",["ذَٰلِكَ","وَأَصۡلَحُوٓاْ","إِنَّ","رَبَّكَ","مِنۢ","بَعۡدِهَا","لَغَفُورٞ","رَّحِيمٌ"],"١١٩"],["16:120",["إِنَّ"]]]],[3,[["16:120",["إِبۡرَٰهِيمَ","كَانَ","أُمَّةٗ","قَانِتٗا","لِّلَّهِ","حَنِيفٗا","وَلَمۡ","يَكُ","مِنَ","ٱلۡمُشۡرِكِينَ"]]]],[4,[["16:120",[],"١٢٠"],["16:121",["شَاكِرٗا","لِّأَنۡعُمِهِۚ","ٱجۡتَبَىٰهُ","وَهَدَىٰهُ","إِلَىٰ","صِرَٰطٖ","مُّسۡتَقِيمٖ"]]]],[5,[["16:121",[],"١٢١"],["16:122",["وَءَاتَيۡنَٰهُ","فِي","ٱلدُّنۡيَا","حَسَنَةٗۖ","وَإِنَّهُۥ","فِي","ٱلۡأٓخِرَةِ","لَمِنَ","ٱلصَّٰلِحِينَ"]]]],[6,[["16:122",[],"١٢٢"],["16:123",["ثُمَّ","أَوۡحَيۡنَآ","إِلَيۡكَ","أَنِ","ٱتَّبِعۡ","مِلَّةَ","إِبۡرَٰهِيمَ","حَنِيفٗاۖ","وَمَا","كَانَ"]]]],[7,[["16:123",["مِنَ","ٱلۡمُشۡرِكِينَ"],"١٢٣"],["16:124",["إِنَّمَا","جُعِلَ","ٱلسَّبۡتُ","عَلَى","ٱلَّذِينَ","ٱخۡتَلَفُواْ"]]]],[8,[["16:124",["فِيهِۚ","وَإِنَّ","رَبَّكَ","لَيَحۡكُمُ","بَيۡنَهُمۡ","يَوۡمَ","ٱلۡقِيَٰمَةِ","فِيمَا"]]]],[9,[["16:124",["كَانُواْ","فِيهِ","يَخۡتَلِفُونَ"],"١٢٤"],["16:125",["ٱدۡعُ","إِلَىٰ","سَبِيلِ","رَبِّكَ","بِٱلۡحِكۡمَةِ"]]]],[10,[["16:125",["وَٱلۡمَوۡعِظَةِ","ٱلۡحَسَنَةِۖ","وَجَٰدِلۡهُم","بِٱلَّتِي","هِيَ","أَحۡسَنُۚ","إِنَّ"]]]],[11,[["16:125",["رَبَّكَ","هُوَ","أَعۡلَمُ","بِمَن","ضَلَّ","عَن","سَبِيلِهِۦ","وَهُوَ","أَعۡلَمُ","بِٱلۡمُهۡتَدِينَ"]]]],[12,[["16:125",[],"١٢٥"],["16:126",["وَإِنۡ","عَاقَبۡتُمۡ","فَعَاقِبُواْ","بِمِثۡلِ","مَا","عُوقِبۡتُم","بِهِۦۖ","وَلَئِن"]]]],[13,[["16:126",["صَبَرۡتُمۡ","لَهُوَ","خَيۡرٞ","لِّلصَّٰبِرِينَ"],"١٢٦"],["16:127",["وَٱصۡبِرۡ","وَمَا","صَبۡرُكَ"]]]],[14,[["16:127",["إِلَّا","بِٱللَّهِۚ","وَلَا","تَحۡزَنۡ","عَلَيۡهِمۡ","وَلَا","تَكُ","فِي","ضَيۡقٖ","مِّمَّا","يَمۡكُرُونَ"]]]],[15,[["16:127",[],"١٢٧"],["16:128",["إِنَّ","ٱللَّهَ","مَعَ","ٱلَّذِينَ","ٱتَّقَواْ","وَّٱلَّذِينَ","هُم","مُّحۡسِنُونَ"],"١٢٨"]]]],"282":[[3,[["17:1",["سُبۡحَٰنَ","ٱلَّذِيٓ","أَسۡرَىٰ","بِعَبۡدِهِۦ","لَيۡلٗا","مِّنَ","ٱل