2,[["18:1",["ٱلۡحَمۡدُ","لِلَّهِ","ٱلَّذِيٓ","أَنزَلَ","عَلَىٰ","عَبۡدِهِ","ٱلۡكِتَٰبَ","وَلَمۡ","يَجۡعَل","لَّهُۥ","عِوَجَاۜ"]]]],[13,[["18:1",[],"١"],["18:2",["قَيِّمٗا","لِّيُنذِرَ","بَأۡسٗا","شَدِيدٗا","مِّن","لَّدُنۡهُ","وَيُبَشِّرَ","ٱلۡمُؤۡمِنِينَ"]]]],[14,[["18:2",["ٱلَّذِينَ","يَعۡمَلُونَ","ٱلصَّٰلِحَٰتِ","أَنَّ","لَهُمۡ","أَجۡرًا","حَسَنٗا"],"٢"]]],[15,[["18:3",["مَّٰكِثِينَ","فِيهِ","أَبَدٗا"],"٣"],["18:4",["وَيُنذِرَ","ٱلَّذِينَ","قَالُواْ","ٱتَّخَذَ","ٱللَّهُ","وَلَدٗا"],"٤"]]]],"294":[[1,[["18:5",["مَّا","لَهُم","بِهِۦ","مِنۡ","عِلۡمٖ","وَلَا","لِأٓبَآئِهِمۡۚ","كَبُرَتۡ","كَلِمَةٗ","تَخۡرُجُ","مِنۡ"]]]],[2,[["18:5",["أَفۡوَٰهِهِمۡۚ","إِن","يَقُولُونَ","إِلَّا","كَذِبٗا"],"٥"],["18:6",["فَلَعَلَّكَ","بَٰخِعٞ","نَّفۡسَكَ"]]]],[3,[["18:6",["عَلَىٰٓ","ءَاثَٰرِهِمۡ","إِن","لَّمۡ","يُؤۡمِنُواْ","بِهَٰذَا","ٱلۡحَدِيثِ","أَسَفًا"],"٦"],["18:7",["إِنَّا"]]]],[4,[["18:7",["جَعَلۡنَا","مَا","عَلَى","ٱلۡأَرۡضِ","زِينَةٗ","لَّهَا","لِنَبۡلُوَهُمۡ","أَيُّهُمۡ","أَحۡسَنُ","عَمَلٗا"]]]],[5,[["18:7",[],"٧"],["18:8",["وَإِنَّا","لَجَٰعِلُونَ","مَا","عَلَيۡهَا","صَعِيدٗا","جُرُزًا"],"٨"],["18:9",["أَمۡ","حَسِبۡتَ"]]]],[6,[["18:9",["أَنَّ","أَصۡحَٰبَ","ٱلۡكَهۡفِ","وَٱلرَّقِيمِ","كَانُواْ","مِنۡ","ءَايَٰتِنَا","عَجَبًا"],"٩"]]],[7,[["18:10",["إِذۡ","أَوَى","ٱلۡفِتۡيَةُ","إِلَى","ٱلۡكَهۡفِ","فَقَالُواْ","رَبَّنَآ","ءَاتِنَا","مِن","لَّدُنكَ"]]]],[8,[["18:10",["رَحۡمَةٗ","وَهَيِّئۡ","لَنَا","مِنۡ","أَمۡرِنَا","رَشَدٗا"],"١٠"],["18:11",["فَضَرَبۡنَا","عَلَىٰٓ","ءَاذَانِهِمۡ"]]]],[9,[["18:11",["فِي","ٱلۡكَهۡفِ","سِنِينَ","عَدَدٗا"],"١١"],["18:12",["ثُمَّ","بَعَثۡنَٰهُمۡ","لِنَعۡلَمَ","أَيُّ"]]]],[10,[["18:12",["ٱلۡحِزۡبَيۡنِ","أَحۡصَىٰ","لِمَا","لَبِثُوٓاْ","أَمَدٗا"],"١٢"],["18:13",["نَّحۡنُ","نَقُصُّ","عَلَيۡكَ","نَبَأَهُم"]]]],[11,[["18:13",["بِٱلۡحَقِّۚ","إِنَّهُمۡ","فِتۡيَةٌ","ءَامَنُواْ","بِرَبِّهِمۡ","وَزِدۡنَٰهُمۡ","هُدٗى"],"١٣"]]],[12,[["18:14",["وَرَبَطۡنَا","عَلَىٰ","قُلُوبِهِمۡ","إِذۡ","قَامُواْ","فَقَالُواْ","رَبُّنَا","رَبُّ","ٱلسَّمَٰوَٰتِ"]]]],[13,[["18:14",["وَٱلۡأَرۡضِ","لَن","نَّدۡعُوَاْ","مِن","دُونِهِۦٓ","إِلَٰهٗاۖ","لَّقَدۡ","قُلۡنَآ","إِذٗا","شَطَطًا"],"١٤"]]],[14,[["18:15",["هَٰٓؤُلَآءِ","قَوۡمُنَا","ٱتَّخَذُواْ","مِن","دُونِهِۦٓ","ءَالِهَةٗۖ","لَّوۡلَا","يَأۡتُونَ","عَلَيۡهِم"]]]],[15,[["18:15",["بِسُلۡطَٰنِۭ","بَيِّنٖۖ","فَمَنۡ","أَظۡلَمُ","مِمَّنِ","ٱفۡتَرَىٰ","عَلَى","ٱللَّهِ","كَذِبٗا"],"١٥"]]]],"295":[[1,[["18:16",["وَإِذِ","ٱعۡتَزَلۡتُمُوهُمۡ","وَمَا","يَعۡبُدُونَ","إِلَّا","ٱللَّهَ","فَأۡوُۥٓاْ","إِلَى","ٱلۡكَهۡفِ"]]]],[2,[["18:16",["يَنشُرۡ","لَكُمۡ","رَبُّكُم","مِّن","رَّحۡمَتِهِۦ","وَيُهَيِّئۡ","لَكُم","مِّنۡ","أَمۡرِكُم","مِّرۡفَقٗا"]]]],[3,[["18:16",[],"١٦"],["18:17",["۞ وَتَرَى","ٱلشَّمۡسَ","إِذَا","طَلَعَت","تَّزَٰوَرُ","عَن","كَهۡفِهِمۡ","ذَاتَ"]]]],[4,[["18:17",["ٱلۡيَمِينِ","وَإِذَا","غَرَبَت","تَّقۡرِضُهُمۡ","ذَاتَ","ٱلشِّمَالِ","وَهُمۡ","فِي","فَجۡوَةٖ"]]]],[5,[["18:17",["مِّنۡهُۚ","ذَٰلِكَ","مِنۡ","ءَايَٰتِ","ٱللَّهِۗ","مَن","يَهۡدِ","ٱللَّهُ","فَهُوَ","ٱلۡمُهۡتَدِۖ","وَمَن"]]]],[6,[["18:17",["يُضۡلِلۡ","فَلَن","تَجِدَ","لَهُۥ","وَلِيّٗا","مُّرۡشِدٗا"],"١٧"],["18:18",["وَتَحۡسَبُهُمۡ","أَيۡقَاظٗا"]]]],[7,[["18:18",["وَهُمۡ","رُقُودٞۚ","وَنُقَلِّبُهُمۡ","ذَاتَ","ٱلۡيَمِينِ","وَذَاتَ","ٱلشِّمَالِۖ","وَكَلۡبُهُم"]]]],[8,[["18:18",["بَٰسِطٞ","ذِرَاعَيۡهِ","بِٱلۡوَصِيدِۚ","لَوِ","ٱطَّلَعۡتَ","عَلَيۡهِمۡ","لَوَلَّيۡتَ","مِنۡهُمۡ"]]]],[9,[["18:18",["فِرَارٗا","وَلَمُلِئۡتَ","مِنۡهُمۡ","رُعۡبٗا"],"١٨"],["18:19",["وَكَذَٰلِكَ","بَعَثۡنَٰهُمۡ"]]]],[10,[["18:19",["لِيَتَسَآءَلُواْ","بَيۡنَهُمۡۚ","قَالَ","قَآئِلٞ","مِّنۡهُمۡ","كَمۡ","لَبِثۡتُمۡۖ","قَالُواْ","لَبِثۡنَا"]]]],[11,[["18:19",["يَوۡمًا","أَوۡ","بَعۡضَ","يَوۡمٖۚ","قَالُواْ","رَبُّكُمۡ","أَعۡلَمُ","بِمَا","لَبِثۡتُمۡ","فَٱبۡعَثُوٓاْ"]]]],[12,[["18:19",["أَحَدَكُم","بِوَرِقِكُمۡ","هَٰذِهِۦٓ","إِلَى","ٱلۡمَدِينَةِ","فَلۡيَنظُرۡ","أَيُّهَآ","أَزۡكَىٰ"]]]],[13,[["18:19",["طَعَامٗا","فَلۡيَأۡتِكُم","بِرِزۡقٖ","مِّنۡهُ","وَلۡيَتَلَطَّفۡ","وَلَا","يُشۡعِرَنَّ"]]]],[14,[["18:19",["بِكُمۡ","أَحَدًا"],"١٩"],["18:20",["إِنَّهُمۡ","إِن","يَظۡهَرُواْ","عَلَيۡكُمۡ","يَرۡجُمُوكُمۡ"]]]],[15,[["18:20",["أَوۡ","يُعِيدُوكُمۡ","فِي","مِلَّتِهِمۡ","وَلَن","تُفۡلِحُوٓاْ","إِذًا","أَبَدٗا"],"٢٠"]]]],"296":[[1,[["18:21",["وَكَذَٰلِكَ","أَعۡثَرۡنَا","عَلَيۡهِمۡ","لِيَعۡلَمُوٓاْ","أَنَّ","وَعۡدَ","ٱللَّهِ","حَقّٞ","وَأَنَّ"]]]],[2,[["18:21",["ٱلسَّاعَةَ","لَا","رَيۡبَ","فِيهَآ","إِذۡ","يَتَنَٰزَعُونَ","بَيۡنَهُمۡ","أَمۡرَهُمۡۖ","فَقَالُواْ"]]]],[3,[["18:21",["ٱبۡنُواْ","عَلَيۡهِم","بُنۡيَٰنٗاۖ","رَّبُّهُمۡ","أَعۡلَمُ","بِهِمۡۚ","قَالَ","ٱلَّذِينَ","غَلَبُواْ","عَلَىٰٓ"]]]],[4,[["18:21",["أَمۡرِهِمۡ","لَنَتَّخِذَنَّ","عَلَيۡهِم","مَّسۡجِدٗا"],"٢١"],["18:22",["سَيَقُولُونَ","ثَلَٰثَةٞ"]]]],[5,[["18:22",["رَّابِعُهُمۡ","كَلۡبُهُمۡ","وَيَقُولُونَ","خَمۡسَةٞ","سَادِسُهُمۡ","كَلۡبُهُمۡ"]]]],[6,[["18:22",["رَجۡمَۢا","بِٱلۡغَيۡبِۖ","وَيَقُولُونَ","سَبۡعَةٞ","وَثَامِنُهُمۡ","كَلۡبُهُمۡۚ","قُل","رَّبِّيٓ"]]]],[7,[["18:22",["أَعۡلَمُ","بِعِدَّتِهِم","مَّا","يَعۡلَمُهُمۡ","إِلَّا","قَلِيلٞۗ","فَلَا","تُمَارِ","فِيهِمۡ","إِلَّا","مِرَآءٗ"]]]],[8,[["18:22",["ظَٰهِرٗا","وَلَا","تَسۡتَفۡتِ","فِيهِم","مِّنۡهُمۡ","أَحَدٗا"],"٢٢"],["18:23",["وَلَا","تَقُولَنَّ","لِشَاْيۡءٍ"]]]],[9,[["18:23",["إِنِّي","فَاعِلٞ","ذَٰلِكَ","غَدًا"],"٢٣"],["18:24",["إِلَّآ","أَن","يَشَآءَ","ٱللَّهُۚ","وَٱذۡكُر","رَّبَّكَ"]]]],[10,[["18:24",["إِذَا","نَسِيتَ","وَقُلۡ","عَسَىٰٓ","أَن","يَهۡدِيَنِ","رَبِّي","لِأَقۡرَبَ","مِنۡ","هَٰذَا","رَشَدٗا"]]]],[11,[["18:24",[],"٢٤"],["18:25",["وَلَبِثُواْ","فِي","كَهۡفِهِمۡ","ثَلَٰثَ","مِاْئَةٖ","سِنِينَ","وَٱزۡدَادُواْ","تِسۡعٗا"]]]],[12,[["18:25",[],"٢٥"],["18:26",["قُلِ","ٱللَّهُ","أَعۡلَمُ","بِمَا","لَبِثُواْۖ","لَهُۥ","غَيۡبُ","ٱلسَّمَٰوَٰتِ","وَٱلۡأَرۡضِۖ"]]]],[13,[["18:26",["أَبۡصِرۡ","بِهِۦ","وَأَسۡمِعۡۚ","مَا","لَهُم","مِّن","دُونِهِۦ","مِن","وَلِيّٖ","وَلَا","يُشۡرِكُ"]]]],[14,[["18:26",["فِي","حُكۡمِهِۦٓ","أَحَدٗا"],"٢٦"],["18:27",["وَٱتۡلُ","مَآ","أُوحِيَ","إِلَيۡكَ","مِن","كِتَابِ"]]]],[15,[["18:27",["رَبِّكَۖ","لَا","مُبَدِّلَ","لِكَلِمَٰتِهِۦ","وَلَن","تَجِدَ","مِن","دُونِهِۦ","مُلۡتَحَدٗا"],"٢٧"]]]],"297":[[1,[["18:28",["وَٱصۡبِرۡ","نَفۡسَكَ","مَعَ","ٱلَّذِينَ","يَدۡعُونَ","رَبَّهُم","بِٱلۡغَدَوٰةِ","وَٱلۡعَشِيِّ"]]]],[2,[["18:28",["يُرِيدُونَ","وَجۡهَهُۥۖ","وَلَا","تَعۡدُ","عَيۡنَاكَ","عَنۡهُمۡ","تُرِيدُ","زِينَةَ","ٱلۡحَيَوٰةِ"]]]],[3,[["18:28",["ٱلدُّنۡيَاۖ","وَلَا","تُطِعۡ","مَنۡ","أَغۡفَلۡنَا","قَلۡبَهُۥ","عَن","ذِكۡرِنَا","وَٱتَّبَعَ","هَوَىٰهُ","وَكَانَ"]]]],[4,[["18:28",["أَمۡرُهُۥ","فُرُطٗا"],"٢٨"],["18:29",["وَقُلِ","ٱلۡحَقُّ","مِن","رَّبِّكُمۡۖ","فَمَن","شَآءَ","فَلۡيُؤۡمِن","وَمَن"]]]],[5,[["18:29",["شَآءَ","فَلۡيَكۡفُرۡۚ","إِنَّآ","أَعۡتَدۡنَا","لِلظَّٰلِمِينَ","نَارًا","أَحَاطَ","بِهِمۡ","سُرَادِقُهَاۚ"]]]],[6,[["18:29",["وَإِن","يَسۡتَغِيثُواْ","يُغَاثُواْ","بِمَآءٖ","كَٱلۡمُهۡلِ","يَشۡوِي","ٱلۡوُجُوهَۚ","بِئۡسَ"]]]],[7,[["18:29",["ٱلشَّرَابُ","وَسَآءَتۡ","مُرۡتَفَقًا"],"٢٩"],["18:30",["إِنَّ","ٱلَّذِينَ","ءَامَنُواْ","وَعَمِلُواْ"]]]],[8,[["18:30",["ٱلصَّٰلِحَٰتِ","إِنَّا","لَا","نُضِيعُ","أَجۡرَ","مَنۡ","أَحۡسَنَ","عَمَلًا"],"٣٠"],["18:31",["أُوْلَٰٓئِكَ"]]]],[9,[["18:31",["لَهُمۡ","جَنَّٰتُ","عَدۡنٖ","تَجۡرِي","مِن","تَحۡتِهِمُ","ٱلۡأَنۡهَٰرُ","يُحَلَّوۡنَ","فِيهَا","مِنۡ","أَسَاوِرَ"]]]],[10,[["18:31",["مِن","ذَهَبٖ","وَيَلۡبَسُونَ","ثِيَابًا","خُضۡرٗا","مِّن","سُندُسٖ","وَإِسۡتَبۡرَقٖ","مُّتَّكِـِٔينَ"]]]],[11,[["18:31",["فِيهَا","عَلَى","ٱلۡأَرَآئِكِۚ","نِعۡمَ","ٱلثَّوَابُ","وَحَسُنَتۡ","مُرۡتَفَقٗا"],"٣١"],["18:32",["۞ وَٱضۡرِبۡ"]]]],[12,[["18:32",["لَهُم","مَّثَلٗا","رَّجُلَيۡنِ","جَعَلۡنَا","لِأَحَدِهِمَا","جَنَّتَيۡنِ","مِنۡ","أَعۡنَٰبٖ","وَحَفَفۡنَٰهُمَا"]]]],[13,[["18:32",["بِنَخۡلٖ","وَجَعَلۡنَا","بَيۡنَهُمَا","زَرۡعٗا"],"٣٢"],["18:33",["كِلۡتَا","ٱلۡجَنَّتَيۡنِ","ءَاتَتۡ","أُكُلَهَا","وَلَمۡ"]]]],[14,[["18:33",["تَظۡلِم","مِّنۡهُ","شَيۡـٔٗاۚ","وَفَجَّرۡنَا","خِلَٰلَهُمَا","نَهَرٗا"],"٣٣"],["18:34",["وَكَانَ","لَهُۥ","ثَمَرٞ","فَقَالَ"]]]],[15,[["18:34",["لِصَٰحِبِهِۦ","وَهُوَ","يُحَاوِرُهُۥٓ","أَنَا۠","أَكۡثَرُ","مِنكَ","مَالٗا","وَأَعَزُّ","نَفَرٗا"],"٣٤"]]]],"298":[[1,[["18:35",["وَدَخَلَ","جَنَّتَهُۥ","وَهُوَ","ظَالِمٞ","لِّنَفۡسِه