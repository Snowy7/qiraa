{"141":[[1,[["6:102",["ذَٰلِكُمُ","ٱللَّهُ","رَبُّكُمۡۖ","لَآ","إِلَٰهَ","إِلَّا","هُوَۖ","خَٰلِقُ","كُلِّ","شَيۡءٖ","فَٱعۡبُدُوهُۚ"]]]],[2,[["6:102",["وَهُوَ","عَلَىٰ","كُلِّ","شَيۡءٖ","وَكِيلٞ"],"١٠٢"],["6:103",["لَّا","تُدۡرِكُهُ","ٱلۡأَبۡصَٰرُ","وَهُوَ"]]]],[3,[["6:103",["يُدۡرِكُ","ٱلۡأَبۡصَٰرَۖ","وَهُوَ","ٱللَّطِيفُ","ٱلۡخَبِيرُ"],"١٠٣"],["6:104",["قَدۡ","جَآءَكُم"]]]],[4,[["6:104",["بَصَآئِرُ","مِن","رَّبِّكُمۡۖ","فَمَنۡ","أَبۡصَرَ","فَلِنَفۡسِهِۦۖ","وَمَنۡ","عَمِيَ","فَعَلَيۡهَاۚ"]]]],[5,[["6:104",["وَمَآ","أَنَا۠","عَلَيۡكُم","بِحَفِيظٖ"],"١٠٤"],["6:105",["وَكَذَٰلِكَ","نُصَرِّفُ","ٱلۡأٓيَٰتِ"]]]],[6,[["6:105",["وَلِيَقُولُواْ","دَرَسۡتَ","وَلِنُبَيِّنَهُۥ","لِقَوۡمٖ","يَعۡلَمُونَ"],"١٠٥"],["6:106",["ٱتَّبِعۡ"]]]],[7,[["6:106",["مَآ","أُوحِيَ","إِلَيۡكَ","مِن","رَّبِّكَۖ","لَآ","إِلَٰهَ","إِلَّا","هُوَۖ","وَأَعۡرِضۡ","عَنِ","ٱلۡمُشۡرِكِينَ"]]]],[8,[["6:106",[],"١٠٦"],["6:107",["وَلَوۡ","شَآءَ","ٱللَّهُ","مَآ","أَشۡرَكُواْۗ","وَمَا","جَعَلۡنَٰكَ","عَلَيۡهِمۡ","حَفِيظٗاۖ"]]]],[9,[["6:107",["وَمَآ","أَنتَ","عَلَيۡهِم","بِوَكِيلٖ"],"١٠٧"],["6:108",["وَلَا","تَسُبُّواْ","ٱلَّذِينَ","يَدۡعُونَ"]]]],[10,[["6:108",["مِن","دُونِ","ٱللَّهِ","فَيَسُبُّواْ","ٱللَّهَ","عَدۡوَۢا","بِغَيۡرِ","عِلۡمٖۗ","كَذَٰلِكَ","زَيَّنَّا","لِكُلِّ","أُمَّةٍ"]]]],[11,[["6:108",["عَمَلَهُمۡ","ثُمَّ","إِلَىٰ","رَبِّهِم","مَّرۡجِعُهُمۡ","فَيُنَبِّئُهُم","بِمَا","كَانُواْ","يَعۡمَلُونَ"]]]],[12,[["6:108",[],"١٠٨"],["6:109",["وَأَقۡسَمُواْ","بِٱللَّهِ","جَهۡدَ","أَيۡمَٰنِهِمۡ","لَئِن","جَآءَتۡهُمۡ","ءَايَةٞ","لَّيُؤۡمِنُنَّ"]]]],[13,[["6:109",["بِهَاۚ","قُلۡ","إِنَّمَا","ٱلۡأٓيَٰتُ","عِندَ","ٱللَّهِۖ","وَمَا","يُشۡعِرُكُمۡ","أَنَّهَآ","إِذَا","جَآءَتۡ"]]]],[14,[["6:109",["لَا","يُؤۡمِنُونَ"],"١٠٩"],["6:110",["وَنُقَلِّبُ","أَفۡـِٔدَتَهُمۡ","وَأَبۡصَٰرَهُمۡ","كَمَا","لَمۡ"]]]],[15,[["6:110",["يُؤۡمِنُواْ","بِهِۦٓ","أَوَّلَ","مَرَّةٖ","وَنَذَرُهُمۡ","فِي","طُغۡيَٰنِهِمۡ","يَعۡمَهُونَ"],"١١٠"]]]],"142":[[1,[["6:111",["۞ وَلَوۡ","أَنَّنَا","نَزَّلۡنَآ","إِلَيۡهِمُ","ٱلۡمَلَٰٓئِكَةَ"