:75",1,["قَالَ","ٱلۡمَلَأُ","ٱلَّذِينَ","ٱسۡتَكۡبَرُواْ","مِن"]]]],[5,[["7:75",6,["قَوۡمِهِۦ","لِلَّذِينَ","ٱسۡتُضۡعِفُواْ","لِمَنۡ","ءَامَنَ","مِنۡهُمۡ","أَتَعۡلَمُونَ"]]]],[6,[["7:75",13,["أَنَّ","صَٰلِحٗا","مُّرۡسَلٞ","مِّن","رَّبِّهِۦۚ","قَالُوٓاْ","إِنَّا","بِمَآ","أُرۡسِلَ","بِهِۦ"]]]],[7,[["7:75",23,["مُؤۡمِنُونَ"],"٧٥"],["7:76",1,["قَالَ","ٱلَّذِينَ","ٱسۡتَكۡبَرُوٓاْ","إِنَّا","بِٱلَّذِيٓ"]]]],[8,[["7:76",6,["ءَامَنتُم","بِهِۦ","كَٰفِرُونَ"],"٧٦"],["7:77",1,["فَعَقَرُواْ","ٱلنَّاقَةَ","وَعَتَوۡاْ","عَنۡ"]]]],[9,[["7:77",5,["أَمۡرِ","رَبِّهِمۡ","وَقَالُواْ","يَٰصَٰلِحُ","ٱئۡتِنَا","بِمَا","تَعِدُنَآ","إِن","كُنتَ"]]]],[10,[["7:77",14,["مِنَ","ٱلۡمُرۡسَلِينَ"],"٧٧"],["7:78",1,["فَأَخَذَتۡهُمُ","ٱلرَّجۡفَةُ","فَأَصۡبَحُواْ","فِي","دَارِهِمۡ"]]]],[11,[["7:78",6,["جَٰثِمِينَ"],"٧٨"],["7:79",1,["فَتَوَلَّىٰ","عَنۡهُمۡ","وَقَالَ","يَٰقَوۡمِ","لَقَدۡ","أَبۡلَغۡتُكُمۡ"]]]],[12,[["7:79",7,["رِسَالَةَ","رَبِّي","وَنَصَحۡتُ","لَكُمۡ","وَلَٰكِن","لَّا","تُحِبُّونَ","ٱلنَّٰصِحِينَ"]]]],[13,[["7:79",15,[],"٧٩"],["7:80",1,["وَلُوطًا","إِذۡ","قَالَ","لِقَوۡمِهِۦٓ","أَتَأۡتُونَ","ٱلۡفَٰحِشَةَ","مَا","سَبَقَكُم"]]]],[14,[["7:80",9,["بِهَا","مِنۡ","أَحَدٖ","مِّنَ","ٱلۡعَٰلَمِينَ"],"٨٠"],["7:81",1,["إِنَّكُمۡ","لَتَأۡتُونَ","ٱلرِّجَالَ"]]]],[15,[["7:81",4,["شَهۡوَةٗ","مِّن","دُونِ","ٱلنِّسَآءِۚ","بَلۡ","أَنتُمۡ","قَوۡمٞ","مُّسۡرِفُونَ"],"٨١"]]]]}