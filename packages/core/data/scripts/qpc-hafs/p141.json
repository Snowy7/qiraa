يۡتَةً","أَوۡ","دَمٗا","مَّسۡفُوحًا","أَوۡ","لَحۡمَ","خِنزِيرٖ","فَإِنَّهُۥ","رِجۡسٌ","أَوۡ"]]]],[11,[["6:145",25,["فِسۡقًا","أُهِلَّ","لِغَيۡرِ","ٱللَّهِ","بِهِۦۚ","فَمَنِ","ٱضۡطُرَّ","غَيۡرَ","بَاغٖ","وَلَا","عَادٖ"]]]],[12,[["6:145",36,["فَإِنَّ","رَبَّكَ","غَفُورٞ","رَّحِيمٞ"],"١٤٥"],["6:146",1,["وَعَلَى","ٱلَّذِينَ","هَادُواْ","حَرَّمۡنَا"]]]],[13,[["6:146",5,["كُلَّ","ذِي","ظُفُرٖۖ","وَمِنَ","ٱلۡبَقَرِ","وَٱلۡغَنَمِ","حَرَّمۡنَا","عَلَيۡهِمۡ"]]]],[14,[["6:146",13,["شُحُومَهُمَآ","إِلَّا","مَا","حَمَلَتۡ","ظُهُورُهُمَآ","أَوِ","ٱلۡحَوَايَآ","أَوۡ","مَا","ٱخۡتَلَطَ"]]]],[15,[["6:146",23,["بِعَظۡمٖۚ","ذَٰلِكَ","جَزَيۡنَٰهُم","بِبَغۡيِهِمۡۖ","وَإِنَّا","لَصَٰدِقُونَ"],"١٤٦"]]]],"148":[[1,[["6:147",1,["فَإِن","كَذَّبُوكَ","فَقُل","رَّبُّكُمۡ","ذُو","رَحۡمَةٖ","وَٰسِعَةٖ","وَلَا","يُرَدُّ"]]]],[2,[["6:147",10,["بَأۡسُهُۥ","عَنِ","ٱلۡقَوۡمِ","ٱلۡمُجۡرِمِينَ"],"١٤٧"],["6:148",1,["سَيَقُولُ","ٱلَّذِينَ","أَشۡرَكُواْ"]]]],[3,[["6:148",4,["لَوۡ","شَآءَ","ٱللَّهُ","مَآ","أَشۡرَكۡنَا","وَلَآ","ءَابَآؤُنَا","وَلَا","حَرَّمۡنَا","مِن","شَيۡءٖۚ"]]]],[4,[["6:148",15,["كَذَٰلِكَ","كَذَّبَ","ٱلَّذِينَ","مِن","قَبۡلِهِمۡ","حَتَّىٰ","ذَاقُواْ","بَأۡسَنَاۗ"]]]],[5,[["6:148",23,["قُلۡ","هَلۡ","عِندَكُم","مِّنۡ","عِلۡمٖ","فَتُخۡرِجُوهُ","لَنَآۖ","إِن","تَتَّبِعُونَ","إِلَّا"]]]],[6,[["6:148",33,["ٱلظَّنَّ","وَإِنۡ","أَنتُمۡ","إِلَّا","تَخۡرُصُونَ"],"١٤٨"],["6:149",1,["قُلۡ","فَلِلَّهِ","ٱلۡحُجَّةُ","ٱلۡبَٰلِغَةُۖ"]]]],[7,[["6:149",5,["فَلَوۡ","شَآءَ","لَهَدَىٰكُمۡ","أَجۡمَعِينَ"],"١٤٩"],["6:150",1,["قُلۡ","هَلُمَّ","شُهَدَآءَكُمُ"]]]],[8,[["6:150",4,["ٱلَّذِينَ","يَشۡهَدُونَ","أَنَّ","ٱللَّهَ","حَرَّمَ","هَٰذَاۖ","فَإِن","شَهِدُواْ","فَلَا","تَشۡهَدۡ"]]]],[9,[["6:150",14,["مَعَهُمۡۚ","وَلَا","تَتَّبِعۡ","أَهۡوَآءَ","ٱلَّذِينَ","كَذَّبُواْ","بِـَٔايَٰتِنَا","وَٱلَّذِينَ"]]]],[10,[["6:150",22,["لَا","يُؤۡمِنُونَ","بِٱلۡأٓخِرَةِ","وَهُم","بِرَبِّهِمۡ","يَعۡدِلُونَ"],"١٥٠"],["6:151",1,["۞ قُلۡ"]]]],[11,[["6:151",2,["تَعَالَوۡاْ","أَتۡلُ","مَا","حَرَّمَ","رَبُّكُمۡ","عَلَيۡكُمۡۖ","أَلَّا","تُشۡرِكُواْ"]]]],[12,[["6:151",10,["بِهِۦ","شَيۡـٔٗاۖ","وَبِٱلۡوَٰلِدَيۡنِ","إِحۡسَٰنٗاۖ","وَلَا","تَقۡتُلُوٓاْ","أَوۡلَٰدَكُم"]]]],[13,[["6:151",17,["مِّنۡ","إِمۡلَٰقٖ","نَّحۡنُ","نَرۡزُقُكُمۡ","وَإِيَّاهُمۡۖ","وَلَا","تَقۡرَبُواْ","ٱلۡفَوَٰحِشَ"]]]],[14,[["6:151",25,["مَا","ظَهَرَ","مِنۡهَا","وَمَا","بَطَنَۖ","وَلَا","تَقۡتُلُواْ","ٱلنَّفۡسَ","ٱلَّتِي","حَرَّمَ","ٱللَّهُ"]]]],[15,[["6:151",36,["إِلَّا","بِٱلۡحَقِّۚ","ذَٰلِكُمۡ","وَصَّىٰكُم","بِهِۦ","لَعَلَّكُمۡ","تَعۡقِلُونَ"],"١٥١"]]]],"149":[[1,[["6:152",1,["وَلَا","تَقۡرَبُواْ","مَالَ","ٱلۡيَتِيمِ","إِلَّا","بِٱلَّتِي","هِيَ","أَحۡسَنُ","حَتَّىٰ","يَبۡلُغَ","أَشُدَّهُۥۚ"]]]],[2,[["6:152",12,["وَأَوۡفُواْ","ٱلۡكَيۡلَ","وَٱلۡمِيزَانَ","بِٱلۡقِسۡطِۖ","لَا","نُكَلِّفُ","نَفۡسًا","إِلَّا"]]]],[3,[["6:152",20,["وُسۡعَهَاۖ","وَإِذَا","قُلۡتُمۡ","فَٱعۡدِلُواْ","وَلَوۡ","كَانَ","ذَا","قُرۡبَىٰۖ","وَبِعَهۡدِ"]]]],[4,[["6:152",29,["ٱللَّهِ","أَوۡفُواْۚ","ذَٰلِكُمۡ","وَصَّىٰكُم","بِهِۦ","لَعَلَّكُمۡ","تَذَكَّرُونَ"],"١٥٢"]]],[5,[["6:153",1,["وَأَنَّ","هَٰذَا","صِرَٰطِي","مُسۡتَقِيمٗا","فَٱتَّبِعُوهُۖ","وَلَا","تَتَّبِعُواْ","ٱلسُّبُلَ"]]]],[6,[["6:153",9,["فَتَفَرَّقَ","بِكُمۡ","عَن","سَبِيلِهِۦۚ","ذَٰلِكُمۡ","وَصَّىٰكُم","بِهِۦ","لَعَلَّكُمۡ"]]]],[7,[["6:153",17,["تَتَّقُونَ"],"١٥٣"],["6:154",1,["ثُمَّ","ءَاتَيۡنَا","مُوسَى","ٱلۡكِتَٰبَ","تَمَامًا","عَلَى","ٱلَّذِيٓ"]]]],[8,[["6:154",8,["أَحۡسَنَ","وَتَفۡصِيلٗا","لِّكُلِّ","شَيۡءٖ","وَهُدٗى","وَرَحۡمَةٗ","لَّعَلَّهُم","بِلِقَآءِ"]]]],[9,[["6:154",16,["رَبِّهِمۡ","يُؤۡمِنُونَ"],"١٥٤"],["6:155",1,["وَهَٰذَا","كِتَٰبٌ","أَنزَلۡنَٰهُ","مُبَارَكٞ","فَٱتَّبِعُوهُ"]]]],[10,[["6:155",6,["وَٱتَّقُواْ","لَعَلَّكُمۡ","تُرۡحَمُونَ"],"١٥٥"],["6:156",1,["أَن","تَقُولُوٓاْ","إِنَّمَآ","أُنزِلَ","ٱلۡكِتَٰبُ"]]]],[11,[["6:156",6,["عَلَىٰ","طَآئِفَتَيۡنِ","مِن","قَبۡلِنَا","وَإِن","كُنَّا","عَن","دِرَاسَتِهِمۡ","لَغَٰفِلِينَ"]]]],[12,[["6:156",15,[],"١٥٦"],["6:157",1,["أَوۡ","تَقُولُواْ","لَوۡ","أَنَّآ","أُنزِلَ","عَلَيۡنَا","ٱلۡكِتَٰبُ","لَكُنَّآ","أَهۡدَىٰ"]]]],[13,[["6:157",10,["مِنۡهُمۡۚ","فَقَدۡ","جَآءَكُم","بَيِّنَةٞ","مِّن","رَّبِّكُمۡ","وَهُدٗى","وَرَحۡمَةٞۚ"]]]],[14,[["6:157",18,["فَمَنۡ","أَظۡلَمُ","مِمَّن","كَذَّبَ","بِـَٔايَٰتِ","ٱللَّهِ","وَصَدَفَ","عَنۡهَاۗ","سَنَجۡزِي","ٱلَّذِينَ"]]]],[15,[["6:157",28,["يَصۡدِفُونَ","عَنۡ","ءَايَٰتِنَا","سُوٓءَ","ٱلۡعَذَابِ","بِمَا","كَانُواْ","يَصۡدِفُونَ"],"١٥٧"]]]],"150":[[1,[["6:158",1,["هَلۡ","يَنظُرُونَ","إِلَّآ","أَن","تَأۡتِيَهُمُ","ٱلۡمَلَٰٓئِكَةُ","أَوۡ","يَأۡتِيَ","رَبُّكَ","أَوۡ","يَأۡتِيَ","بَعۡضُ"]]]],[2,[["6:158",13,["ءَايَٰتِ","رَبِّكَۗ","يَوۡمَ","يَأۡتِي","بَعۡضُ","ءَايَٰتِ","رَبِّكَ","لَا","يَنفَعُ","نَفۡسًا","إِيمَٰنُهَا"]]]],[3,[["6:158",24,["لَمۡ","تَكُنۡ","ءَامَنَتۡ","مِن","قَبۡلُ","أَوۡ","كَسَبَتۡ","فِيٓ","إِيمَٰنِهَا","خَيۡرٗاۗ","قُلِ","ٱنتَظِرُوٓاْ"]]]],[4,[["6:158",36,["إِنَّا","مُنتَظِرُونَ"],"١٥٨"],["6:159",1,["إِنَّ","ٱلَّذِينَ","فَرَّقُواْ","دِينَهُمۡ","وَكَانُواْ","شِيَعٗا","لَّسۡتَ"]]]],[5,[["6:159",8,["مِنۡهُمۡ","فِي","شَيۡءٍۚ","إِنَّمَآ","أَمۡرُهُمۡ","إِلَى","ٱللَّهِ","ثُمَّ","يُنَبِّئُهُم","بِمَا","كَانُواْ","يَفۡعَلُونَ"]]]],[6,[["6:159",20,[],"١٥٩"],["6:160",1,["مَن","جَآءَ","بِٱلۡحَسَنَةِ","فَلَهُۥ","عَشۡرُ","أَمۡثَالِهَاۖ","وَمَن","جَآءَ","بِٱلسَّيِّئَةِ"]]]],[7,[["6:160",10,["فَلَا","يُجۡزَىٰٓ","إِلَّا","مِثۡلَهَا","وَهُمۡ","لَا","يُظۡلَمُونَ"],"١٦٠"],["6:161",1,["قُلۡ","إِنَّنِي","هَدَىٰنِي","رَبِّيٓ"]]]],[8,[["6:161",5,["إِلَىٰ","صِرَٰطٖ","مُّسۡتَقِيمٖ","دِينٗا","قِيَمٗا","مِّلَّةَ","إِبۡرَٰهِيمَ","حَنِيفٗاۚ","وَمَا","كَانَ"]]]],[9,[["6:161",15,["مِنَ","ٱلۡمُشۡرِكِينَ"],"١٦١"],["6:162",1,["قُلۡ","إِنَّ","صَلَاتِي","وَنُسُكِي","وَمَحۡيَايَ","وَمَمَاتِي","لِلَّهِ"]]]],[10,[["6:162",8,["رَبِّ","ٱلۡعَٰلَمِينَ"],"١٦٢"],["6:163",1,["لَا","شَرِيكَ","لَهُۥۖ","وَبِذَٰلِكَ","أُمِرۡتُ","وَأَنَا۠","أَوَّلُ","ٱلۡمُسۡلِمِينَ"]]]],[11,[["6:163",9,[],"١٦٣"],["6:164",1,["قُلۡ","أَغَيۡرَ","ٱللَّهِ","أَبۡغِي","رَبّٗا","وَهُوَ","رَبُّ","كُلِّ","شَيۡءٖۚ","وَلَا","تَكۡسِبُ","كُلُّ"]]]],[12,[["6:164",13,["نَفۡسٍ","إِلَّا","عَلَيۡهَاۚ","وَلَا","تَزِرُ","وَازِرَة