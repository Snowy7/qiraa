َعۡرَافِ","رِجَالٞ","يَعۡرِفُونَ","كُلَّۢا","بِسِيمَىٰهُمۡۚ","وَنَادَوۡاْ"]]]],[6,[["7:46",["أَصۡحَٰبَ","ٱلۡجَنَّةِ","أَن","سَلَٰمٌ","عَلَيۡكُمۡۚ","لَمۡ","يَدۡخُلُوهَا","وَهُمۡ","يَطۡمَعُونَ"],"٤٦"]]],[7,[["7:47",["۞ وَإِذَا","صُرِفَتۡ","أَبۡصَٰرُهُمۡ","تِلۡقَآءَ","أَصۡحَٰبِ","ٱلنَّارِ","قَالُواْ","رَبَّنَا","لَا","تَجۡعَلۡنَا"]]]],[8,[["7:47",["مَعَ","ٱلۡقَوۡمِ","ٱلظَّٰلِمِينَ"],"٤٧"],["7:48",["وَنَادَىٰٓ","أَصۡحَٰبُ","ٱلۡأَعۡرَافِ","رِجَالٗا","يَعۡرِفُونَهُم"]]]],[9,[["7:48",["بِسِيمَىٰهُمۡ","قَالُواْ","مَآ","أَغۡنَىٰ","عَنكُمۡ","جَمۡعُكُمۡ","وَمَا","كُنتُمۡ","تَسۡتَكۡبِرُونَ"],"٤٨"]]],[10,[["7:49",["أَهَٰٓؤُلَآءِ","ٱلَّذِينَ","أَقۡسَمۡتُمۡ","لَا","يَنَالُهُمُ","ٱللَّهُ","بِرَحۡمَةٍۚ","ٱدۡخُلُواْ","ٱلۡجَنَّةَ"]]]],[11,[["7:49",["لَا","خَوۡفٌ","عَلَيۡكُمۡ","وَلَآ","أَنتُمۡ","تَحۡزَنُونَ"],"٤٩"],["7:50",["وَنَادَىٰٓ","أَصۡحَٰبُ","ٱلنَّارِ","أَصۡحَٰبَ"]]]],[12,[["7:50",["ٱلۡجَنَّةِ","أَنۡ","أَفِيضُواْ","عَلَيۡنَا","مِنَ","ٱلۡمَآءِ","أَوۡ","مِمَّا","رَزَقَكُمُ","ٱللَّهُۚ","قَالُوٓاْ"]]]],[13,[["7:50",["إِنَّ","ٱللَّهَ","حَرَّمَهُمَا","عَلَى","ٱلۡكَٰفِرِينَ"],"٥٠"],["7:51",["ٱلَّذِينَ","ٱتَّخَذُواْ","دِينَهُمۡ","لَهۡوٗا"]]]],[14,[["7:51",["وَلَعِبٗا","وَغَرَّتۡهُمُ","ٱلۡحَيَوٰةُ","ٱلدُّنۡيَاۚ","فَٱلۡيَوۡمَ","نَنسَىٰهُمۡ","كَمَا","نَسُواْ"]]]],[15,[["7:51",["لِقَآءَ","يَوۡمِهِمۡ","هَٰذَا","وَمَا","كَانُواْ","بِـَٔايَٰتِنَا","يَجۡحَدُونَ"],"٥١"]]]],"157":[[1,[["7:52",["وَلَقَدۡ","جِئۡنَٰهُم","بِكِتَٰبٖ","فَصَّلۡنَٰهُ","عَلَىٰ","عِلۡمٍ","هُدٗى","وَرَحۡمَةٗ"]]]],[2,[["7:52",["لِّقَوۡمٖ","يُؤۡمِنُونَ"],"٥٢"],["7:53",["هَلۡ","يَنظُرُونَ","إِلَّا","تَأۡوِيلَهُۥۚ","يَوۡمَ","يَأۡتِي","تَأۡوِيلُهُۥ"]]]],[3,[["7:53",["يَقُولُ","ٱلَّذِينَ","نَسُوهُ","مِن","قَبۡلُ","قَدۡ","جَآءَتۡ","رُسُلُ","رَبِّنَا","بِٱلۡحَقِّ"]]]],[4,[["7:53",["فَهَل","لَّنَا","مِن","شُفَعَآءَ","فَيَشۡفَعُواْ","لَنَآ","أَوۡ","نُرَدُّ","فَنَعۡمَلَ","غَيۡرَ","ٱلَّذِي"]]]],[5,[["7:53",["كُنَّا","نَعۡمَلُۚ","قَدۡ","خَسِرُوٓاْ","أَنفُسَهُمۡ","وَضَلَّ","عَنۡهُم","مَّا","كَانُواْ"]]]],[6,[["7:53",["يَفۡتَرُونَ"],"٥٣"],["7:54",["إِنَّ","رَبَّكُمُ","ٱللَّهُ","ٱلَّذِي","خَلَقَ","ٱلسَّمَٰوَٰتِ","وَٱلۡأَرۡضَ"]]]],[7,[["7:54",["فِي","سِتَّةِ","أَيَّامٖ","ثُمَّ","ٱسۡتَوَىٰ","عَلَى","ٱلۡعَرۡشِۖ","يُغۡشِي","ٱلَّيۡلَ","ٱلنَّهَارَ"]]]],[8,[["7:54",["يَطۡلُبُهُۥ","حَثِيثٗا","وَٱلشَّمۡسَ","وَٱلۡقَمَرَ","وَٱلنُّجُومَ","مُسَخَّرَٰتِۭ"]]]],[9,[["7:54",["بِأَمۡرِهِۦٓۗ","أَلَا","لَهُ","ٱلۡخَلۡقُ","وَٱلۡأَمۡرُۗ","تَبَارَكَ","ٱللَّهُ","رَبُّ","ٱلۡعَٰلَمِينَ"],"٥٤"]]],[10,[["7:55",["ٱدۡعُواْ","رَبَّكُمۡ","تَضَرُّعٗا","وَخُفۡيَةًۚ","إِنَّهُۥ","لَا","يُحِبُّ","ٱلۡمُعۡتَدِينَ"],"٥٥"]]],[11,[["7:56",["وَلَا","تُفۡسِدُواْ","فِي","ٱلۡأَرۡضِ","بَعۡدَ","إِصۡلَٰحِهَا","وَٱدۡعُوهُ","خَوۡفٗا","وَطَمَعًاۚ"]]]],[12,[["7:56",["إِنَّ","رَحۡمَتَ","ٱللَّهِ","قَرِيبٞ","مِّنَ","ٱلۡمُحۡسِنِينَ"],"٥٦"],["7:57",["وَهُوَ","ٱلَّذِي","يُرۡسِلُ"]]]],[13,[["7:57",["ٱلرِّيَٰحَ","بُشۡرَۢا","بَيۡنَ","يَدَيۡ","رَحۡمَتِهِۦۖ","حَتَّىٰٓ","إِذَآ","أَقَلَّتۡ","سَحَابٗا","ثِقَالٗا"]]]],[14,[["7:57",["سُقۡنَٰهُ","لِبَلَدٖ","مَّيِّتٖ","فَأَنزَلۡنَا","بِهِ","ٱلۡمَآءَ","فَأَخۡرَجۡنَا","بِهِۦ","مِن","كُلِّ"]]]],[15,[["7:57",["ٱلثَّمَرَٰتِۚ","كَذَٰلِكَ","نُخۡرِجُ","ٱلۡمَوۡتَىٰ","لَعَلَّكُمۡ","تَذَكَّرُونَ"],"٥٧"]]]],"158":[[1,[["7:58",["وَٱلۡبَلَدُ","ٱلطَّيِّبُ","يَخۡرُجُ","نَبَاتُهُۥ","بِإِذۡنِ","رَبِّهِۦۖ","وَٱلَّذِي","خَبُثَ","لَا","يَخۡرُجُ"]]]],[2,[["7:58",["إِلَّا","نَكِدٗاۚ","كَذَٰلِكَ","نُصَرِّفُ","ٱلۡأٓيَٰتِ","لِقَوۡمٖ","يَشۡكُرُونَ"],"٥٨"]]],[3,[["7:59",["لَقَدۡ","أَرۡسَلۡنَا","نُوحًا","إِلَىٰ","قَوۡمِهِۦ","فَقَالَ","يَٰقَوۡمِ","ٱعۡبُدُواْ","ٱللَّهَ","مَا","لَكُم"]]]],[4,[["7:59",["مِّنۡ","إِلَٰهٍ","غَيۡرُهُۥٓ","إِنِّيٓ","أَخَافُ","عَلَيۡكُمۡ","عَذَابَ","يَوۡمٍ","عَظِيمٖ"],"٥٩"]]],[5,[["7:60",["قَالَ","ٱلۡمَلَأُ","مِن","قَوۡمِهِۦٓ","إِنَّا","لَنَرَىٰكَ","فِي","ضَلَٰلٖ","مُّبِينٖ"],"٦٠"],["7:61",["قَالَ","يَٰقَوۡمِ"]]]],[6,[["7:61",["لَيۡسَ","بِي","ضَلَٰلَةٞ","وَلَٰكِنِّي","رَسُولٞ","مِّن","رَّبِّ","ٱلۡعَٰلَمِينَ"],"٦١"]]],[7,[["7:62",["أُبَلِّغُكُمۡ","رِسَٰلَٰتِ","رَبِّي","وَأَنصَحُ","لَكُمۡ","وَأَعۡلَمُ","مِنَ","ٱللَّهِ