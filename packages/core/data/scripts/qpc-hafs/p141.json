"158":[[1,[["7:58",1,["وَٱلۡبَلَدُ","ٱلطَّيِّبُ","يَخۡرُجُ","نَبَاتُهُۥ","بِإِذۡنِ","رَبِّهِۦۖ","وَٱلَّذِي","خَبُثَ","لَا","يَخۡرُجُ"]]]],[2,[["7:58",11,["إِلَّا","نَكِدٗاۚ","كَذَٰلِكَ","نُصَرِّفُ","ٱلۡأٓيَٰتِ","لِقَوۡمٖ","يَشۡكُرُونَ"],"٥٨"]]],[3,[["7:59",1,["لَقَدۡ","أَرۡسَلۡنَا","نُوحًا","إِلَىٰ","قَوۡمِهِۦ","فَقَالَ","يَٰقَوۡمِ","ٱعۡبُدُواْ","ٱللَّهَ","مَا","لَكُم"]]]],[4,[["7:59",12,["مِّنۡ","إِلَٰهٍ","غَيۡرُهُۥٓ","إِنِّيٓ","أَخَافُ","عَلَيۡكُمۡ","عَذَابَ","يَوۡمٍ","عَظِيمٖ"],"٥٩"]]],[5,[["7:60",1,["قَالَ","ٱلۡمَلَأُ","مِن","قَوۡمِهِۦٓ","إِنَّا","لَنَرَىٰكَ","فِي","ضَلَٰلٖ","مُّبِينٖ"],"٦٠"],["7:61",1,["قَالَ","يَٰقَوۡمِ"]]]],[6,[["7:61",3,["لَيۡسَ","بِي","ضَلَٰلَةٞ","وَلَٰكِنِّي","رَسُولٞ","مِّن","رَّبِّ","ٱلۡعَٰلَمِينَ"],"٦١"]]],[7,[["7:62",1,["أُبَلِّغُكُمۡ","رِسَٰلَٰتِ","رَبِّي","وَأَنصَحُ","لَكُمۡ","وَأَعۡلَمُ","مِنَ","ٱللَّهِ"]]]],[8,[["7:62",9,["مَا","لَا","تَعۡلَمُونَ"],"٦٢"],["7:63",1,["أَوَعَجِبۡتُمۡ","أَن","جَآءَكُمۡ","ذِكۡرٞ","مِّن","رَّبِّكُمۡ"]]]],[9,[["7:63",7,["عَلَىٰ","رَجُلٖ","مِّنكُمۡ","لِيُنذِرَكُمۡ","وَلِتَتَّقُواْ","وَلَعَلَّكُمۡ","تُرۡحَمُونَ"]]]],[10,[["7:63",14,[],"٦٣"],["7:64",1,["فَكَذَّبُوهُ","فَأَنجَيۡنَٰهُ","وَٱلَّذِينَ","مَعَهُۥ","فِي","ٱلۡفُلۡكِ","وَأَغۡرَقۡنَا","ٱلَّذِينَ"]]]],[11,[["7:64",9,["كَذَّبُواْ","بِـَٔايَٰتِنَآۚ","إِنَّهُمۡ","كَانُواْ","قَوۡمًا","عَمِينَ"],"٦٤"],["7:65",1,["۞ وَإِلَىٰ"]]]],[12,[["7:65",2,["عَادٍ","أَخَاهُمۡ","هُودٗاۚ","قَالَ","يَٰقَوۡمِ","ٱعۡبُدُواْ","ٱللَّهَ","مَا","لَكُم","مِّنۡ","إِلَٰهٍ"]]]],[13,[["7:65",13,["غَيۡرُهُۥٓۚ","أَفَلَا","تَتَّقُونَ"],"٦٥"],["7:66",1,["قَالَ","ٱلۡمَلَأُ","ٱلَّذِينَ","كَفَرُواْ","مِن","قَوۡمِهِۦٓ"]]]],[14,[["7:66",7,["إِنَّا","لَنَرَىٰكَ","فِي","سَفَاهَةٖ","وَإِنَّا","لَنَظُنُّكَ","مِنَ","ٱلۡكَٰذِبِينَ"],"٦٦"]]],[15,[["7:67",1,["قَالَ","يَٰقَوۡمِ","لَيۡسَ","بِي","سَفَاهَةٞ","وَلَٰكِنِّي","رَسُولٞ","مِّن","رَّبِّ","ٱلۡعَٰلَمِينَ"],"٦٧"]]]],"159":[[1,[["7:68",1,["أُبَلِّغُكُمۡ","رِسَٰلَٰتِ","رَبِّي","وَأَنَا۠","لَكُمۡ","نَاصِحٌ","أَمِينٌ"],"٦٨"],["7:69",1,["أَوَعَجِبۡتُمۡ