["ٱعۡمَلُواْ","عَلَىٰ","مَكَانَتِكُمۡ","إِنِّي","عَامِلٞۖ","فَسَوۡفَ","تَعۡلَمُونَ"]]]],[8,[["6:135",["مَن","تَكُونُ","لَهُۥ","عَٰقِبَةُ","ٱلدَّارِۚ","إِنَّهُۥ","لَا","يُفۡلِحُ","ٱلظَّٰلِمُونَ"],"١٣٥"]]],[9,[["6:136",["وَجَعَلُواْ","لِلَّهِ","مِمَّا","ذَرَأَ","مِنَ","ٱلۡحَرۡثِ","وَٱلۡأَنۡعَٰمِ","نَصِيبٗا"]]]],[10,[["6:136",["فَقَالُواْ","هَٰذَا","لِلَّهِ","بِزَعۡمِهِمۡ","وَهَٰذَا","لِشُرَكَآئِنَاۖ","فَمَا","كَانَ"]]]],[11,[["6:136",["لِشُرَكَآئِهِمۡ","فَلَا","يَصِلُ","إِلَى","ٱللَّهِۖ","وَمَا","كَانَ","لِلَّهِ","فَهُوَ"]]]],[12,[["6:136",["يَصِلُ","إِلَىٰ","شُرَكَآئِهِمۡۗ","سَآءَ","مَا","يَحۡكُمُونَ"],"١٣٦"],["6:137",["وَكَذَٰلِكَ"]]]],[13,[["6:137",["زَيَّنَ","لِكَثِيرٖ","مِّنَ","ٱلۡمُشۡرِكِينَ","قَتۡلَ","أَوۡلَٰدِهِمۡ"]]]],[14,[["6:137",["شُرَكَآؤُهُمۡ","لِيُرۡدُوهُمۡ","وَلِيَلۡبِسُواْ","عَلَيۡهِمۡ","دِينَهُمۡۖ"]]]],[15,[["6:137",["وَلَوۡ","شَآءَ","ٱللَّهُ","مَا","فَعَلُوهُۖ","فَذَرۡهُمۡ","وَمَا","يَفۡتَرُونَ"],"١٣٧"]]]],"146":[[1,[["6:138",["وَقَالُواْ","هَٰذِهِۦٓ","أَنۡعَٰمٞ","وَحَرۡثٌ","حِجۡرٞ","لَّا","يَطۡعَمُهَآ","إِلَّا","مَن","نَّشَآءُ"]]]],[2,[["6:138",["بِزَعۡمِهِمۡ","وَأَنۡعَٰمٌ","حُرِّمَتۡ","ظُهُورُهَا","وَأَنۡعَٰمٞ","لَّا","يَذۡكُرُونَ"]]]],[3,[["6:138",["ٱسۡمَ","ٱللَّهِ","عَلَيۡهَا","ٱفۡتِرَآءً","عَلَيۡهِۚ","سَيَجۡزِيهِم","بِمَا","كَانُواْ"]]]],[4,[["6:138",["يَفۡتَرُونَ"],"١٣٨"],["6:139",["وَقَالُواْ","مَا","فِي","بُطُونِ","هَٰذِهِ","ٱلۡأَنۡعَٰمِ","خَالِصَةٞ"]]]],[5,[["6:139",["لِّذُكُورِنَا","وَمُحَرَّمٌ","عَلَىٰٓ","أَزۡوَٰجِنَاۖ","وَإِن","يَكُن","مَّيۡتَةٗ"]]]],[6,[["6:139",["فَهُمۡ","فِيهِ","شُرَكَآءُۚ","سَيَجۡزِيهِمۡ","وَصۡفَهُمۡۚ","إِنَّهُۥ","حَكِيمٌ"]]]],[7,[["6:139",["عَلِيمٞ"],"١٣٩"],["6:140",["قَدۡ","خَسِرَ","ٱلَّذِينَ","قَتَلُوٓاْ","أَوۡلَٰدَهُمۡ","سَفَهَۢا","بِغَيۡرِ"]]]],[8,[["6:140",["عِلۡمٖ","وَحَرَّمُواْ","مَا","رَزَقَهُمُ","ٱللَّهُ","ٱفۡتِرَآءً","عَلَى","ٱللَّهِۚ","قَدۡ","ضَلُّواْ"]]]],[9,[["6:140",["وَمَا","كَانُواْ","مُهۡتَدِينَ"],"١٤٠"],["6:141",["۞ وَهُوَ","ٱلَّذِيٓ","أَنشَأَ","جَنَّٰتٖ"]]]],[10,[["6:141",["مَّعۡرُوشَٰت