","ٱلۡإِيمَٰنَ","وَأَيَّدَهُم"]]]],[4,[["58:22",["بِرُوحٖ","مِّنۡهُۖ","وَيُدۡخِلُهُمۡ","جَنَّٰتٖ","تَجۡرِي","مِن","تَحۡتِهَا","ٱلۡأَنۡهَٰرُ"]]]],[5,[["58:22",["خَٰلِدِينَ","فِيهَاۚ","رَضِيَ","ٱللَّهُ","عَنۡهُمۡ","وَرَضُواْ","عَنۡهُۚ","أُوْلَٰٓئِكَ","حِزۡبُ"]]]],[6,[["58:22",["ٱللَّهِۚ","أَلَآ","إِنَّ","حِزۡبَ","ٱللَّهِ","هُمُ","ٱلۡمُفۡلِحُونَ"],"٢٢"]]],[9,[["59:1",["سَبَّحَ","لِلَّهِ","مَا","فِي","ٱلسَّمَٰوَٰتِ","وَمَا","فِي","ٱلۡأَرۡضِۖ","وَهُوَ","ٱلۡعَزِيزُ","ٱلۡحَكِيمُ"]]]],[10,[["59:1",[],"١"],["59:2",["هُوَ","ٱلَّذِيٓ","أَخۡرَجَ","ٱلَّذِينَ","كَفَرُواْ","مِنۡ","أَهۡلِ","ٱلۡكِتَٰبِ","مِن","دِيَٰرِهِمۡ"]]]],[11,[["59:2",["لِأَوَّلِ","ٱلۡحَشۡرِۚ","مَا","ظَنَنتُمۡ","أَن","يَخۡرُجُواْۖ","وَظَنُّوٓاْ","أَنَّهُم","مَّانِعَتُهُمۡ"]]]],[12,[["59:2",["حُصُونُهُم","مِّنَ","ٱللَّهِ","فَأَتَىٰهُمُ","ٱللَّهُ","مِنۡ","حَيۡثُ","لَمۡ","يَحۡتَسِبُواْۖ","وَقَذَفَ"]]]],[13,[["59:2",["فِي","قُلُوبِهِمُ","ٱلرُّعۡبَۚ","يُخۡرِبُونَ","بُيُوتَهُم","بِأَيۡدِيهِمۡ","وَأَيۡدِي","ٱلۡمُؤۡمِنِينَ"]]]],[14,[["59:2",["فَٱعۡتَبِرُواْ","يَٰٓأُوْلِي","ٱلۡأَبۡصَٰرِ"],"٢"],["59:3",["وَلَوۡلَآ","أَن","كَتَبَ","ٱللَّهُ","عَلَيۡهِمُ"]]]],[15,[["59:3",["ٱلۡجَلَآءَ","لَعَذَّبَهُمۡ","فِي","ٱلدُّنۡيَاۖ","وَلَهُمۡ","فِي","ٱلۡأٓخِرَةِ","عَذَابُ","ٱلنَّارِ"],"٣"]]]],"546":[[1,[["59:4",["ذَٰلِكَ","بِأَنَّهُمۡ","شَآقُّواْ","ٱللَّهَ","وَرَسُولَهُۥۖ","وَمَن","يُشَآقِّ","ٱللَّهَ","فَإِنَّ","ٱللَّهَ","شَدِيدُ"]]]],[2,[["59:4",["ٱلۡعِقَابِ"],"٤"],["59:5",["مَا","قَطَعۡتُم","مِّن","لِّينَةٍ","أَوۡ","تَرَكۡتُمُوهَا","قَآئِمَةً","عَلَىٰٓ"]]]],[3,[["59:5",["أُصُولِهَا","فَبِإِذۡنِ","ٱللَّهِ","وَلِيُخۡزِيَ","ٱلۡفَٰسِقِينَ"],"٥"],["59:6",["وَمَآ","أَفَآءَ","ٱللَّهُ"]]]],[4,[["59:6",["عَلَىٰ","رَسُولِهِۦ","مِنۡهُمۡ","فَمَآ","أَوۡجَفۡتُمۡ","عَلَيۡهِ","مِنۡ","خَيۡلٖ","وَلَا","رِكَابٖ"]]]],[5,[["59:6",["وَلَٰكِنَّ","ٱللَّهَ","يُسَلِّطُ","رُسُلَهُۥ","عَلَىٰ","مَن","يَشَآءُۚ","وَٱللَّهُ","عَلَىٰ","كُلِّ","شَيۡءٖ"]]]],[6,[["59:6",["قَدِيرٞ"],"٦"],["59:7",["مَّآ","أَفَآءَ","ٱللَّهُ","عَلَىٰ","رَسُولِهِۦ","مِنۡ","أَهۡل