,"وَٱلۡأَرۡضَ"]]]],[5,[["64:3",["بِٱلۡحَقِّ","وَصَوَّرَكُمۡ","فَأَحۡسَنَ","صُوَرَكُمۡۖ","وَإِلَيۡهِ","ٱلۡمَصِيرُ"],"٣"],["64:4",["يَعۡلَمُ"]]]],[6,[["64:4",["مَا","فِي","ٱلسَّمَٰوَٰتِ","وَٱلۡأَرۡضِ","وَيَعۡلَمُ","مَا","تُسِرُّونَ","وَمَا","تُعۡلِنُونَۚ","وَٱللَّهُ"]]]],[7,[["64:4",["عَلِيمُۢ","بِذَاتِ","ٱلصُّدُورِ"],"٤"],["64:5",["أَلَمۡ","يَأۡتِكُمۡ","نَبَؤُاْ","ٱلَّذِينَ","كَفَرُواْ","مِن","قَبۡلُ"]]]],[8,[["64:5",["فَذَاقُواْ","وَبَالَ","أَمۡرِهِمۡ","وَلَهُمۡ","عَذَابٌ","أَلِيمٞ"],"٥"],["64:6",["ذَٰلِكَ","بِأَنَّهُۥ","كَانَت","تَّأۡتِيهِمۡ"]]]],[9,[["64:6",["رُسُلُهُم","بِٱلۡبَيِّنَٰتِ","فَقَالُوٓاْ","أَبَشَرٞ","يَهۡدُونَنَا","فَكَفَرُواْ","وَتَوَلَّواْۖ","وَّٱسۡتَغۡنَى"]]]],[10,[["64:6",["ٱللَّهُۚ","وَٱللَّهُ","غَنِيٌّ","حَمِيدٞ"],"٦"],["64:7",["زَعَمَ","ٱلَّذِينَ","كَفَرُوٓاْ","أَن","لَّن","يُبۡعَثُواْۚ","قُلۡ","بَلَىٰ"]]]],[11,[["64:7",["وَرَبِّي","لَتُبۡعَثُنَّ","ثُمَّ","لَتُنَبَّؤُنَّ","بِمَا","عَمِلۡتُمۡۚ","وَذَٰلِكَ","عَلَى","ٱللَّهِ","يَسِيرٞ"],"٧"]]],[12,[["64:8",["فَـَٔامِنُواْ","بِٱللَّهِ","وَرَسُولِهِۦ","وَٱلنُّورِ","ٱلَّذِيٓ","أَنزَلۡنَاۚ","وَٱللَّهُ","بِمَا","تَعۡمَلُونَ","خَبِيرٞ"]]]],[13,[["64:8",[],"٨"],["64:9",["يَوۡمَ","يَجۡمَعُكُمۡ","لِيَوۡمِ","ٱلۡجَمۡعِۖ","ذَٰلِكَ","يَوۡمُ","ٱلتَّغَابُنِۗ","وَمَن","يُؤۡمِنۢ","بِٱللَّهِ"]]]],[14,[["64:9",["وَيَعۡمَلۡ","صَٰلِحٗا","يُكَفِّرۡ","عَنۡهُ","سَيِّـَٔاتِهِۦ","وَيُدۡخِلۡهُ","جَنَّٰتٖ","تَجۡرِي","مِن"]]]],[15,[["64:9",["تَحۡتِهَا","ٱلۡأَنۡهَٰرُ","خَٰلِدِينَ","فِيهَآ","أَبَدٗاۚ","ذَٰلِكَ","ٱلۡفَوۡزُ","ٱلۡعَظِيمُ"],"٩"]]]],"557":[[1,[["64:10",["وَٱلَّذِينَ","كَفَرُواْ","وَكَذَّبُواْ","بِـَٔايَٰتِنَآ","أُوْلَٰٓئِكَ","أَصۡحَٰبُ","ٱلنَّارِ"]]]],[2,[["64:10",["خَٰلِدِينَ","فِيهَاۖ","وَبِئۡسَ","ٱلۡمَصِيرُ"],"١٠"],["64:11",["مَآ","أَصَابَ","مِن","مُّصِيبَةٍ"]]]],[3,[["64:11",["إِلَّا","بِإِذۡنِ","ٱللَّهِۗ","وَمَن","يُؤۡمِنۢ","بِٱللَّهِ","يَهۡدِ","قَلۡبَهُۥۚ","وَٱللَّهُ","بِكُلِّ"]]]],[4,[["64:11",["شَيۡءٍ","عَلِيمٞ"],"١١"],["64:12",["وَأَطِيعُواْ","ٱللَّهَ","وَأَطِيعُواْ","ٱلرَّسُولَۚ","فَإِن"]]]],[5,[["64:12