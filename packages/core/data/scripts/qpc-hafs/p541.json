"بِكُلِّ","شَيۡءٍ","عَلِيمٌ"],"٧"],["58:8",["أَلَمۡ","تَرَ","إِلَى","ٱلَّذِينَ"]]]],[5,[["58:8",["نُهُواْ","عَنِ","ٱلنَّجۡوَىٰ","ثُمَّ","يَعُودُونَ","لِمَا","نُهُواْ","عَنۡهُ","وَيَتَنَٰجَوۡنَ","بِٱلۡإِثۡمِ"]]]],[6,[["58:8",["وَٱلۡعُدۡوَٰنِ","وَمَعۡصِيَتِ","ٱلرَّسُولِۖ","وَإِذَا","جَآءُوكَ","حَيَّوۡكَ","بِمَا","لَمۡ","يُحَيِّكَ"]]]],[7,[["58:8",["بِهِ","ٱللَّهُ","وَيَقُولُونَ","فِيٓ","أَنفُسِهِمۡ","لَوۡلَا","يُعَذِّبُنَا","ٱللَّهُ","بِمَا","نَقُولُۚ","حَسۡبُهُمۡ"]]]],[8,[["58:8",["جَهَنَّمُ","يَصۡلَوۡنَهَاۖ","فَبِئۡسَ","ٱلۡمَصِيرُ"],"٨"],["58:9",["يَٰٓأَيُّهَا","ٱلَّذِينَ","ءَامَنُوٓاْ","إِذَا"]]]],[9,[["58:9",["تَنَٰجَيۡتُمۡ","فَلَا","تَتَنَٰجَوۡاْ","بِٱلۡإِثۡمِ","وَٱلۡعُدۡوَٰنِ","وَمَعۡصِيَتِ","ٱلرَّسُولِ"]]]],[10,[["58:9",["وَتَنَٰجَوۡاْ","بِٱلۡبِرِّ","وَٱلتَّقۡوَىٰۖ","وَٱتَّقُواْ","ٱللَّهَ","ٱلَّذِيٓ","إِلَيۡهِ","تُحۡشَرُونَ"],"٩"],["58:10",["إِنَّمَا"]]]],[11,[["58:10",["ٱلنَّجۡوَىٰ","مِنَ","ٱلشَّيۡطَٰنِ","لِيَحۡزُنَ","ٱلَّذِينَ","ءَامَنُواْ","وَلَيۡسَ","بِضَآرِّهِمۡ"]]]],[12,[["58:10",["شَيۡـًٔا","إِلَّا","بِإِذۡنِ","ٱللَّهِۚ","وَعَلَى","ٱللَّهِ","فَلۡيَتَوَكَّلِ","ٱلۡمُؤۡمِنُونَ"],"١٠"],["58:11",["يَٰٓأَيُّهَا"]]]],[13,[["58:11",["ٱلَّذِينَ","ءَامَنُوٓاْ","إِذَا","قِيلَ","لَكُمۡ","تَفَسَّحُواْ","فِي","ٱلۡمَجَٰلِسِ","فَٱفۡسَحُواْ","يَفۡسَحِ"]]]],[14,[["58:11",["ٱللَّهُ","لَكُمۡۖ","وَإِذَا","قِيلَ","ٱنشُزُواْ","فَٱنشُزُواْ","يَرۡفَعِ","ٱللَّهُ","ٱلَّذِينَ","ءَامَنُواْ","مِنكُمۡ"]]]],[15,[["58:11",["وَٱلَّذِينَ","أُوتُواْ","ٱلۡعِلۡمَ","دَرَجَٰتٖۚ","وَٱللَّهُ","بِمَا","تَعۡمَلُونَ","خَبِيرٞ"],"١١"]]]],"544":[[1,[["58:12",["يَٰٓأَيُّهَا","ٱلَّذِينَ","ءَامَنُوٓاْ","إِذَا","نَٰجَيۡتُمُ","ٱلرَّسُولَ","فَقَدِّمُواْ","بَيۡنَ","يَدَيۡ","نَجۡوَىٰكُمۡ"]]]],[2,[["58:12",["صَدَقَةٗۚ","ذَٰلِكَ","خَيۡرٞ","لَّكُمۡ","وَأَطۡهَرُۚ","فَإِن","لَّمۡ","تَجِدُواْ","فَإِنَّ","ٱللَّهَ","غَفُورٞ","رَّحِيمٌ"]]]],[3,[["58:12",[],"١٢"],["58:13",["ءَأَشۡفَقۡتُمۡ","أَن","تُقَدِّمُواْ","بَيۡنَ","يَدَيۡ","نَجۡوَىٰكُمۡ","صَدَقَٰتٖۚ","فَإِذۡ","لَمۡ","تَفۡعَلُواْ"]]]],[4,[["58:13",["وَتَابَ","ٱل