,[["62:8",["إِنَّ","ٱلۡمَوۡتَ","ٱلَّذِي","تَفِرُّونَ","مِنۡهُ","فَإِنَّهُۥ","مُلَٰقِيكُمۡۖ","ثُمَّ","تُرَدُّونَ"]]]],[15,[["62:8",["إِلَىٰ","عَٰلِمِ","ٱلۡغَيۡبِ","وَٱلشَّهَٰدَةِ","فَيُنَبِّئُكُم","بِمَا","كُنتُمۡ","تَعۡمَلُونَ"],"٨"]]]],"554":[[1,[["62:9",["يَٰٓأَيُّهَا","ٱلَّذِينَ","ءَامَنُوٓاْ","إِذَا","نُودِيَ","لِلصَّلَوٰةِ","مِن","يَوۡمِ","ٱلۡجُمُعَةِ","فَٱسۡعَوۡاْ"]]]],[2,[["62:9",["إِلَىٰ","ذِكۡرِ","ٱللَّهِ","وَذَرُواْ","ٱلۡبَيۡعَۚ","ذَٰلِكُمۡ","خَيۡرٞ","لَّكُمۡ","إِن","كُنتُمۡ","تَعۡلَمُونَ"]]]],[3,[["62:9",[],"٩"],["62:10",["فَإِذَا","قُضِيَتِ","ٱلصَّلَوٰةُ","فَٱنتَشِرُواْ","فِي","ٱلۡأَرۡضِ","وَٱبۡتَغُواْ"]]]],[4,[["62:10",["مِن","فَضۡلِ","ٱللَّهِ","وَٱذۡكُرُواْ","ٱللَّهَ","كَثِيرٗا","لَّعَلَّكُمۡ","تُفۡلِحُونَ"],"١٠"]]],[5,[["62:11",["وَإِذَا","رَأَوۡاْ","تِجَٰرَةً","أَوۡ","لَهۡوًا","ٱنفَضُّوٓاْ","إِلَيۡهَا","وَتَرَكُوكَ","قَآئِمٗاۚ","قُلۡ","مَا","عِندَ"]]]],[6,[["62:11",["ٱللَّهِ","خَيۡرٞ","مِّنَ","ٱللَّهۡوِ","وَمِنَ","ٱلتِّجَٰرَةِۚ","وَٱللَّهُ","خَيۡرُ","ٱلرَّٰزِقِينَ"],"١١"]]],[9,[["63:1",["إِذَا","جَآءَكَ","ٱلۡمُنَٰفِقُونَ","قَالُواْ","نَشۡهَدُ","إِنَّكَ","لَرَسُولُ","ٱللَّهِۗ","وَٱللَّهُ","يَعۡلَمُ","إِنَّكَ"]]]],[10,[["63:1",["لَرَسُولُهُۥ","وَٱللَّهُ","يَشۡهَدُ","إِنَّ","ٱلۡمُنَٰفِقِينَ","لَكَٰذِبُونَ"],"١"],["63:2",["ٱتَّخَذُوٓاْ"]]]],[11,[["63:2",["أَيۡمَٰنَهُمۡ","جُنَّةٗ","فَصَدُّواْ","عَن","سَبِيلِ","ٱللَّهِۚ","إِنَّهُمۡ","سَآءَ","مَا","كَانُواْ"]]]],[12,[["63:2",["يَعۡمَلُونَ"],"٢"],["63:3",["ذَٰلِكَ","بِأَنَّهُمۡ","ءَامَنُواْ","ثُمَّ","كَفَرُواْ","فَطُبِعَ","عَلَىٰ","قُلُوبِهِمۡ","فَهُمۡ"]]]],[13,[["63:3",["لَا","يَفۡقَهُونَ"],"٣"],["63:4",["۞ وَإِذَا","رَأَيۡتَهُمۡ","تُعۡجِبُكَ","أَجۡسَامُهُمۡۖ","وَإِن","يَقُولُواْ"]]]],[14,[["63:4",["تَسۡمَعۡ","لِقَوۡلِهِمۡۖ","كَأَنَّهُمۡ","خُشُبٞ","مُّسَنَّدَةٞۖ","يَحۡسَبُونَ","كُلَّ","صَيۡحَةٍ"]]]],[15,[["63:4",["عَلَيۡهِمۡۚ","هُمُ","ٱلۡعَدُوُّ","فَٱحۡذَرۡهُمۡۚ","قَٰتَلَهُمُ","ٱللَّهُۖ","أَنَّىٰ","يُؤۡفَكُونَ"],"٤"]]]],"555":[[1,[["63:5",["وَإِذَا","قِيلَ","لَهُمۡ","تَعَالَوۡاْ","يَسۡتَغۡفِرۡ","لَكُمۡ",