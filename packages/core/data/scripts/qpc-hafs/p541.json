{"541":[[1,[["57:25",["لَقَدۡ","أَرۡسَلۡنَا","رُسُلَنَا","بِٱلۡبَيِّنَٰتِ","وَأَنزَلۡنَا","مَعَهُمُ","ٱلۡكِتَٰبَ"]]]],[2,[["57:25",["وَٱلۡمِيزَانَ","لِيَقُومَ","ٱلنَّاسُ","بِٱلۡقِسۡطِۖ","وَأَنزَلۡنَا","ٱلۡحَدِيدَ","فِيهِ"]]]],[3,[["57:25",["بَأۡسٞ","شَدِيدٞ","وَمَنَٰفِعُ","لِلنَّاسِ","وَلِيَعۡلَمَ","ٱللَّهُ","مَن","يَنصُرُهُۥ","وَرُسُلَهُۥ"]]]],[4,[["57:25",["بِٱلۡغَيۡبِۚ","إِنَّ","ٱللَّهَ","قَوِيٌّ","عَزِيزٞ"],"٢٥"],["57:26",["وَلَقَدۡ","أَرۡسَلۡنَا","نُوحٗا","وَإِبۡرَٰهِيمَ"]]]],[5,[["57:26",["وَجَعَلۡنَا","فِي","ذُرِّيَّتِهِمَا","ٱلنُّبُوَّةَ","وَٱلۡكِتَٰبَۖ","فَمِنۡهُم","مُّهۡتَدٖۖ"]]]],[6,[["57:26",["وَكَثِيرٞ","مِّنۡهُمۡ","فَٰسِقُونَ"],"٢٦"],["57:27",["ثُمَّ","قَفَّيۡنَا","عَلَىٰٓ","ءَاثَٰرِهِم"]]]],[7,[["57:27",["بِرُسُلِنَا","وَقَفَّيۡنَا","بِعِيسَى","ٱبۡنِ","مَرۡيَمَ","وَءَاتَيۡنَٰهُ","ٱلۡإِنجِيلَۖ","وَجَعَلۡنَا"]]]],[8,[["57:27",["فِي","قُلُوبِ","ٱلَّذِينَ","ٱتَّبَعُوهُ","رَأۡفَةٗ","وَرَحۡمَةٗۚ","وَرَهۡبَانِيَّةً"]]]],[9,[["57:27",["ٱبۡتَدَعُوهَا","مَا","كَتَبۡنَٰهَا","عَلَيۡهِمۡ","إِلَّا","ٱبۡتِغَآءَ","رِضۡوَٰنِ","ٱللَّهِ"]]]],[10,[["57:27",["فَمَا","رَعَوۡهَا","حَقَّ","رِعَايَتِهَاۖ","فَـَٔاتَيۡنَا","ٱلَّذِينَ","ءَامَنُواْ","مِنۡهُمۡ","أَجۡرَهُمۡۖ"]]]],[11,[["57:27",["وَكَثِيرٞ","مِّنۡهُمۡ","فَٰسِقُونَ"],"٢٧"],["57:28",["يَٰٓأَيُّهَا","ٱلَّذِينَ","ءَامَنُواْ","ٱتَّقُواْ","ٱللَّهَ"]]]],[12,[["57:28",["وَءَامِنُواْ","بِرَسُولِهِۦ","يُؤۡتِكُمۡ","كِفۡلَيۡنِ","مِن","رَّحۡمَتِهِۦ","وَيَجۡعَل","لَّكُمۡ","نُورٗا"]]]],[13,[["57:28",["تَمۡشُونَ","بِهِۦ","وَيَغۡفِرۡ","لَكُمۡۚ","وَٱللَّهُ","غَفُورٞ","رَّحِيمٞ"],"٢٨"],["57:29",["لِّئَلَّا","يَعۡلَمَ"]]]],[14,[["57:29",["أَهۡلُ","ٱلۡكِتَٰبِ","أَلَّا","يَقۡدِرُونَ","عَلَىٰ","شَيۡءٖ","مِّن","فَضۡلِ","ٱللَّهِ","وَأَنَّ"]]]],[15,[["57:29",["ٱلۡفَضۡلَ","بِيَدِ","ٱللَّهِ","يُؤۡتِيهِ","مَن","يَشَآءُۚ","وَٱللَّهُ","ذُو","ٱلۡفَضۡلِ","ٱلۡعَظِيمِ"],"٢٩"]]]],"542":[[3,[["58:1",["قَدۡ","سَمِعَ","ٱللَّهُ","قَوۡلَ","ٱلَّتِي","تُجَٰدِلُكَ","فِي","زَوۡجِهَا","وَتَشۡتَكِيٓ","إِلَى","ٱللَّهِ"]]]],[4,[["58:1",["وَٱللَّهُ","يَسۡمَعُ","ت