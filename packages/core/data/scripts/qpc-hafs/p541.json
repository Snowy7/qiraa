12",["وَلَئِن","نَّصَرُوهُمۡ","لَيُوَلُّنَّ","ٱلۡأَدۡبَٰرَ","ثُمَّ","لَا","يُنصَرُونَ"],"١٢"],["59:13",["لَأَنتُمۡ"]]]],[9,[["59:13",["أَشَدُّ","رَهۡبَةٗ","فِي","صُدُورِهِم","مِّنَ","ٱللَّهِۚ","ذَٰلِكَ","بِأَنَّهُمۡ","قَوۡمٞ"]]]],[10,[["59:13",["لَّا","يَفۡقَهُونَ"],"١٣"],["59:14",["لَا","يُقَٰتِلُونَكُمۡ","جَمِيعًا","إِلَّا","فِي","قُرٗى","مُّحَصَّنَةٍ"]]]],[11,[["59:14",["أَوۡ","مِن","وَرَآءِ","جُدُرِۭۚ","بَأۡسُهُم","بَيۡنَهُمۡ","شَدِيدٞۚ","تَحۡسَبُهُمۡ","جَمِيعٗا"]]]],[12,[["59:14",["وَقُلُوبُهُمۡ","شَتَّىٰۚ","ذَٰلِكَ","بِأَنَّهُمۡ","قَوۡمٞ","لَّا","يَعۡقِلُونَ"],"١٤"],["59:15",["كَمَثَلِ"]]]],[13,[["59:15",["ٱلَّذِينَ","مِن","قَبۡلِهِمۡ","قَرِيبٗاۖ","ذَاقُواْ","وَبَالَ","أَمۡرِهِمۡ","وَلَهُمۡ","عَذَابٌ"]]]],[14,[["59:15",["أَلِيمٞ"],"١٥"],["59:16",["كَمَثَلِ","ٱلشَّيۡطَٰنِ","إِذۡ","قَالَ","لِلۡإِنسَٰنِ","ٱكۡفُرۡ","فَلَمَّا"]]]],[15,[["59:16",["كَفَرَ","قَالَ","إِنِّي","بَرِيٓءٞ","مِّنكَ","إِنِّيٓ","أَخَافُ","ٱللَّهَ","رَبَّ","ٱلۡعَٰلَمِينَ"],"١٦"]]]],"548":[[1,[["59:17",["فَكَانَ","عَٰقِبَتَهُمَآ","أَنَّهُمَا","فِي","ٱلنَّارِ","خَٰلِدَيۡنِ","فِيهَاۚ","وَذَٰلِكَ","جَزَٰٓؤُاْ"]]]],[2,[["59:17",["ٱلظَّٰلِمِينَ"],"١٧"],["59:18",["يَٰٓأَيُّهَا","ٱلَّذِينَ","ءَامَنُواْ","ٱتَّقُواْ","ٱللَّهَ","وَلۡتَنظُرۡ","نَفۡسٞ"]]]],[3,[["59:18",["مَّا","قَدَّمَتۡ","لِغَدٖۖ","وَٱتَّقُواْ","ٱللَّهَۚ","إِنَّ","ٱللَّهَ","خَبِيرُۢ","بِمَا","تَعۡمَلُونَ"],"١٨"]]],[4,[["59:19",["وَلَا","تَكُونُواْ","كَٱلَّذِينَ","نَسُواْ","ٱللَّهَ","فَأَنسَىٰهُمۡ","أَنفُسَهُمۡۚ","أُوْلَٰٓئِكَ"]]]],[5,[["59:19",["هُمُ","ٱلۡفَٰسِقُونَ"],"١٩"],["59:20",["لَا","يَسۡتَوِيٓ","أَصۡحَٰبُ","ٱلنَّارِ","وَأَصۡحَٰبُ"]]]],[6,[["59:20",["ٱلۡجَنَّةِۚ","أَصۡحَٰبُ","ٱلۡجَنَّةِ","هُمُ","ٱلۡفَآئِزُونَ"],"٢٠"],["59:21",["لَوۡ","أَنزَلۡنَا","هَٰذَا"]]]],[7,[["59:21",["ٱلۡقُرۡءَانَ","عَلَىٰ","جَبَلٖ","لَّرَأَيۡتَهُۥ","خَٰشِعٗا","مُّتَصَدِّعٗا","مِّنۡ","خَشۡيَةِ"]]]],[8,[["59:21",["ٱللَّهِۚ","وَتِلۡكَ","ٱلۡأَمۡثَٰلُ","نَضۡرِبُهَا","لِلنَّاسِ","لَعَلَّهُمۡ","يَتَفَكَّرُونَ"]]]],[9,[["59:21",[],"٢١"],["59:22",["هُوَ","ٱللَّهُ","ٱلَّذِي","لَآ","إِلَٰهَ","إِلَّا","هُوَۖ","عَٰلِمُ","ٱلۡغَيۡبِ","وَٱلشَّهَٰدَةِۖ"]]]],[10,[["59:22",["هُوَ","ٱلرَّحۡمَٰنُ","ٱلرَّحِيمُ"],"٢٢"],["59:23",["هُوَ","ٱللَّهُ","ٱلَّذِي","لَآ","إِلَٰهَ","إِلَّا","هُوَ","ٱلۡمَلِكُ"]]]],[11,[["59:23",["ٱلۡقُدُّوسُ","ٱلسَّلَٰمُ","ٱلۡمُؤۡمِنُ","ٱلۡمُهَيۡمِنُ","ٱلۡعَزِيزُ","ٱلۡجَبَّارُ"]]]],[12,[["59:23",["ٱلۡمُتَكَبِّرُۚ","سُبۡحَٰنَ","ٱللَّهِ","عَمَّا","يُشۡرِكُونَ"],"٢٣"],["59:24",["هُوَ","ٱللَّهُ"]]]],[13,[["59:24",["ٱلۡخَٰلِقُ","ٱلۡبَارِئُ","ٱلۡمُصَوِّرُۖ","لَهُ","ٱلۡأَسۡمَآءُ","ٱلۡحُسۡنَىٰۚ","يُسَبِّحُ"]]]],[14,[["59:24",["لَهُۥ","مَا","فِي","ٱلسَّمَٰوَٰتِ","وَٱلۡأَرۡضِۖ","وَهُوَ","ٱلۡعَزِيزُ","ٱلۡحَكِيمُ"],"٢٤"]]]],"549":[[2,[["60:1",["يَٰٓأَيُّهَا","ٱلَّذِينَ","ءَامَنُواْ","لَا","تَتَّخِذُواْ","عَدُوِّي","وَعَدُوَّكُمۡ","أَوۡلِيَآءَ","تُلۡقُونَ"]]]],[3,[["60:1",["إِلَيۡهِم","بِٱلۡمَوَدَّةِ","وَقَدۡ","كَفَرُواْ","بِمَا","جَآءَكُم","مِّنَ","ٱلۡحَقِّ","يُخۡرِجُونَ","ٱلرَّسُولَ"]]]],[4,[["60:1",["وَإِيَّاكُمۡ","أَن","تُؤۡمِنُواْ","بِٱللَّهِ","رَبِّكُمۡ","إِن","كُنتُمۡ","خَرَجۡتُمۡ","جِهَٰدٗا","فِي","سَبِيلِي"]]]],[5,[["60:1",["وَٱبۡتِغَآءَ","مَرۡضَاتِيۚ","تُسِرُّونَ","إِلَيۡهِم","بِٱلۡمَوَدَّةِ","وَأَنَا۠","أَعۡلَمُ","بِمَآ","أَخۡفَيۡتُمۡ"]]]],[6,[["60:1",["وَمَآ","أَعۡلَنتُمۡۚ","وَمَن","يَفۡعَلۡهُ","مِنكُمۡ","فَقَدۡ","ضَلَّ","سَوَآءَ","ٱلسَّبِيلِ"],"١"],["60:2",["إِن"]]]],[7,[["60:2",["يَثۡقَفُوكُمۡ","يَكُونُواْ","لَكُمۡ","أَعۡدَآءٗ","وَيَبۡسُطُوٓاْ","إِلَيۡكُمۡ","أَيۡدِيَهُمۡ","وَأَلۡسِنَتَهُم"]]]],[8,[["60:2",["بِٱلسُّوٓءِ","وَوَدُّواْ","لَوۡ","تَكۡفُرُونَ"],"٢"],["60:3",["لَن","تَنفَعَكُمۡ","أَرۡحَامُكُمۡ","وَلَآ","أَوۡلَٰدُكُمۡۚ"]]]],[9,[["60:3",["يَوۡمَ","ٱلۡقِيَٰمَةِ","يَفۡصِلُ","بَيۡنَكُمۡۚ","وَٱللَّهُ","بِمَا","تَعۡمَلُونَ","بَصِيرٞ"],"٣"],["60:4",["قَدۡ","كَانَتۡ"]]]],[10,[["60:4",["لَكُمۡ","أُسۡوَةٌ","حَسَنَةٞ","فِيٓ","إِبۡرَٰهِيمَ","وَٱلَّذِينَ","مَعَهُۥٓ","إِذۡ","قَالُواْ","لِقَوۡمِهِمۡ","إِنَّا"]]]],[11,[["60:4",["بُرَءَٰٓؤُاْ","مِنكُمۡ","وَمِمَّا","تَعۡبُدُونَ","مِن","دُونِ","ٱللَّهِ","كَفَرۡنَا","بِكُمۡ","وَبَدَا","بَيۡنَنَا"]]]],[12,[["60:4",["وَبَيۡنَكُمُ","ٱلۡعَدَٰوَةُ","وَٱلۡبَغۡضَآءُ","أَبَدًا","حَتَّىٰ","تُؤۡمِنُواْ","بِٱللَّهِ","وَحۡدَهُۥٓ","إِلَّا","قَوۡلَ"]]]],[13,[["60:4",["إِبۡرَٰهِيمَ","لِأَبِيهِ","لَأَسۡتَغۡفِرَنَّ","لَكَ","وَمَآ","أَمۡلِكُ","لَكَ","مِنَ","ٱللَّهِ","مِن","شَيۡءٖۖ"]]]],[14,[["60:4",["رَّبَّنَا","عَلَيۡكَ","تَوَكَّلۡنَا","وَإِلَيۡكَ","أَنَبۡنَا","وَإِلَيۡكَ","ٱلۡمَصِيرُ"],"٤"],["60:5",["رَبَّنَا","لَا","تَجۡعَلۡنَا"]]]],[15,[["60:5",["فِتۡنَةٗ","لِّلَّذِينَ","كَفَرُواْ","وَٱغۡفِرۡ","لَنَا","رَبَّنَآۖ","إِنَّكَ","أَنتَ","ٱلۡعَزِيزُ","ٱلۡحَكِيمُ"],"٥"]]]],"550":[[1,[["60:6",["لَقَدۡ","كَانَ","لَكُمۡ","فِيهِمۡ","أُسۡوَةٌ","حَسَنَةٞ","لِّمَن","كَانَ","يَرۡجُواْ","ٱللَّهَ","وَٱلۡيَوۡمَ","ٱلۡأٓخِرَۚ"]]]],[2,[["60:6",["وَمَن","يَتَوَلَّ","فَإِنَّ","ٱللَّهَ","هُوَ","ٱلۡغَنِيُّ","ٱلۡحَمِيدُ"],"٦"],["60:7",["۞ عَسَى","ٱللَّهُ","أَن","يَجۡعَلَ","بَيۡنَكُمۡ"]]]],[3,[["60:7",["وَبَيۡنَ","ٱلَّذِينَ","عَادَيۡتُم","مِّنۡهُم","مَّوَدَّةٗۚ","وَٱللَّهُ","قَدِيرٞۚ","وَٱللَّهُ","غَفُورٞ","رَّحِيمٞ"]]]],[4,[["60:7",[],"٧"],["60:8",["لَّا","يَنۡهَىٰكُمُ","ٱللَّهُ","عَنِ","ٱلَّذِينَ","لَمۡ","يُقَٰتِلُوكُمۡ","فِي","ٱلدِّينِ","وَلَمۡ","يُخۡرِجُوكُم"]]]],[5,[["60:8",["مِّن","دِيَٰرِكُمۡ","أَن","تَبَرُّوهُمۡ","وَتُقۡسِطُوٓاْ","إِلَيۡهِمۡۚ","إِنَّ","ٱللَّهَ","يُحِبُّ","ٱلۡمُقۡسِطِينَ"]]]],[6,[["60:8",[],"٨"],["60:9",["إِنَّمَا","يَنۡهَىٰكُمُ","ٱللَّهُ","عَنِ","ٱلَّذِينَ","قَٰتَلُوكُمۡ","فِي","ٱلدِّينِ","وَأَخۡرَجُوكُم","مِّن"]]]],[7,[["60:9",["دِيَٰرِكُمۡ","وَظَٰهَرُواْ","عَلَىٰٓ","إِخۡرَاجِكُمۡ","أَن","تَوَلَّوۡهُمۡۚ","وَمَن","يَتَوَلَّهُمۡ","فَأُوْلَٰٓئِكَ"]]]],[8,[["60:9",["هُمُ","ٱلظَّٰلِمُونَ"],"٩"],["60:10",["يَٰٓأَيُّهَا","ٱلَّذِينَ","ءَامَنُوٓاْ","إِذَا","جَآءَكُمُ","ٱلۡمُؤۡمِنَٰتُ","مُهَٰجِرَٰتٖ"]]]],[9,[["60:10",["فَٱمۡتَحِنُوهُنَّۖ","ٱللَّهُ","أَعۡلَمُ","بِإِيمَٰنِهِنَّۖ","فَإِنۡ","عَلِمۡتُمُوهُنَّ","مُؤۡمِنَٰتٖ","فَلَا"]]]],[10,[["60:10",["تَرۡجِعُوهُنَّ","إِلَى","ٱلۡكُفَّارِۖ","لَا","هُنَّ","حِلّٞ","لَّهُمۡ","وَلَا","هُمۡ","يَحِلُّونَ","لَهُنَّۖ","وَءَاتُوهُم"]]]],[11,[["60:10",["مَّآ","أَنفَقُواْۚ","وَلَا","جُنَاحَ","عَلَيۡكُمۡ","أَن","تَنكِحُوهُنَّ","إِذَآ","ءَاتَيۡتُمُوهُنَّ","أُجُورَهُنَّۚ"]]]],[12,[["60:10",["وَلَا","تُمۡسِكُواْ","بِعِصَمِ","ٱلۡكَوَافِرِ","وَسۡـَٔلُواْ","مَآ","أَنفَقۡتُمۡ","وَلۡيَسۡـَٔلُواْ","مَآ","أَنفَقُواْۚ"]]]],[13,[["60:10",["ذَٰلِكُمۡ","حُكۡمُ","ٱللَّهِ","يَحۡكُمُ","بَيۡنَكُمۡۖ","وَٱللَّهُ","عَلِيمٌ","حَكِيمٞ"],"١٠"],["60:11",["وَإِن","فَاتَكُمۡ"]]]],[14,[["60:11",["شَيۡءٞ","مِّنۡ","أَزۡوَٰجِكُمۡ","إِلَى","ٱلۡكُفَّارِ","فَعَاقَبۡتُمۡ","فَـَٔاتُواْ","ٱلَّذِينَ","ذَهَبَتۡ"]]]],[15,[["60:11",["أَزۡوَٰجُهُم","مِّثۡلَ","مَآ","أَنفَقُواْۚ","وَٱتَّقُواْ","ٱللَّهَ","ٱلَّذِيٓ","أَنتُم","بِهِۦ","مُؤۡمِنُونَ"],"١١"]]]],"551":[[1,[["60:12",["يَٰٓأَيُّهَا","ٱلنَّبِيُّ","إِذَا","جَآءَكَ","ٱلۡمُؤۡمِنَٰتُ","يُبَايِعۡنَكَ","عَلَىٰٓ","أَن","لَّا","يُشۡرِكۡنَ","بِٱللَّهِ"]]]],[2,[["60:12",["شَيۡـٔٗا","وَلَا","يَسۡرِقۡنَ","وَلَا","يَزۡنِينَ","وَلَا","يَقۡتُلۡنَ","أَوۡلَٰدَهُنَّ","وَلَا","يَأۡتِينَ"]]]],[3,[["60:12",["بِبُهۡتَٰنٖ","يَفۡتَرِينَهُۥ","بَيۡنَ","أَيۡدِيهِنَّ","وَأَرۡجُلِهِنَّ","وَلَا","يَعۡصِينَكَ","فِي"]]]],[4,[["60:12",["مَعۡرُوفٖ","فَبَايِعۡهُنَّ","وَٱسۡتَغۡفِرۡ","لَهُنَّ","ٱللَّهَۚ","إِنَّ","ٱللَّهَ","غَفُورٞ","رَّحِيمٞ"]]]],[5,[["60:12",[],"١٢"],["60:13",["يَٰٓأَيُّهَا","ٱلَّذِينَ","ءَامَنُواْ","لَا","تَتَوَلَّوۡاْ","قَوۡمًا","غَضِبَ","ٱللَّهُ","عَلَيۡهِمۡ","قَدۡ"]]]],[6,[["60:13",["يَئِسُواْ","مِنَ","ٱلۡأٓخِرَةِ","كَمَا","يَئِسَ","ٱلۡكُفَّارُ","مِنۡ","أَصۡحَٰبِ","ٱلۡقُبُورِ"],"١٣"]]],[9,[["61:1",["سَبَّحَ","لِلَّهِ","مَا","فِي","ٱلسَّمَٰوَٰتِ","وَمَا","فِي","ٱلۡأَرۡضِۖ","وَهُوَ","ٱلۡعَزِيزُ","ٱلۡحَكِيمُ"]]]],[10,[["61:1",[],"١"],["61:2",["يَٰٓأَيُّهَا","ٱلَّذِينَ","ءَامَنُواْ","لِمَ","تَقُولُونَ","مَا","لَا","تَفۡعَلُونَ"],"٢"]]],[11,[["61:3",["كَبُرَ","مَقۡتًا","عِندَ","ٱللَّهِ","أَن","تَقُولُواْ","مَا","لَا","تَفۡعَلُونَ"],"٣"],["61:4",["إِنَّ"]]]],[12,[["61:4",["ٱللَّهَ","يُحِبُّ","ٱلَّذِينَ","يُقَٰتِلُونَ","فِي","سَبِيلِهِۦ","صَفّٗا","كَأَنَّهُم"]]]],[13,[["61:4",["بُ