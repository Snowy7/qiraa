,"18":[[1,[["2:113",["وَقَالَتِ","ٱلۡيَهُودُ","لَيۡسَتِ","ٱلنَّصَٰرَىٰ","عَلَىٰ","شَيۡءٖ","وَقَالَتِ","ٱلنَّصَٰرَىٰ"]]]],[2,[["2:113",["لَيۡسَتِ","ٱلۡيَهُودُ","عَلَىٰ","شَيۡءٖ","وَهُمۡ","يَتۡلُونَ","ٱلۡكِتَٰبَۗ","كَذَٰلِكَ"]]]],[3,[["2:113",["قَالَ","ٱلَّذِينَ","لَا","يَعۡلَمُونَ","مِثۡلَ","قَوۡلِهِمۡۚ","فَٱللَّهُ","يَحۡكُمُ","بَيۡنَهُمۡ"]]]],[4,[["2:113",["يَوۡمَ","ٱلۡقِيَٰمَةِ","فِيمَا","كَانُواْ","فِيهِ","يَخۡتَلِفُونَ"],"١١٣"],["2:114",["وَمَنۡ","أَظۡلَمُ","مِمَّن"]]]],[5,[["2:114",["مَّنَعَ","مَسَٰجِدَ","ٱللَّهِ","أَن","يُذۡكَرَ","فِيهَا","ٱسۡمُهُۥ","وَسَعَىٰ","فِي","خَرَابِهَآۚ"]]]],[6,[["2:114",["أُوْلَٰٓئِكَ","مَا","كَانَ","لَهُمۡ","أَن","يَدۡخُلُوهَآ","إِلَّا","خَآئِفِينَۚ","لَهُمۡ","فِي"]]]],[7,[["2:114",["ٱلدُّنۡيَا","خِزۡيٞ","وَلَهُمۡ","فِي","ٱلۡأٓخِرَةِ","عَذَابٌ","عَظِيمٞ"],"١١٤"],["2:115",["وَلِلَّهِ","ٱلۡمَشۡرِقُ"]]]],[8,[["2:115",["وَٱلۡمَغۡرِبُۚ","فَأَيۡنَمَا","تُوَلُّواْ","فَثَمَّ","وَجۡهُ","ٱللَّهِۚ","إِنَّ","ٱللَّهَ","وَٰسِعٌ","عَلِيمٞ"],"١١٥"]]],[9,[["2:116",["وَقَالُواْ","ٱتَّخَذَ","ٱللَّهُ","وَلَدٗاۗ","سُبۡحَٰنَهُۥۖ","بَل","لَّهُۥ","مَا","فِي","ٱلسَّمَٰوَٰتِ"]]]],[10,[["2:116",["وَٱلۡأَرۡضِۖ","كُلّٞ","لَّهُۥ","قَٰنِتُونَ"],"١١٦"],["2:117",["بَدِيعُ","ٱلسَّمَٰوَٰتِ","وَٱلۡأَرۡضِۖ"]]]],[11,[["2:117",["وَإِذَا","قَضَىٰٓ","أَمۡرٗا","فَإِنَّمَا","يَقُولُ","لَهُۥ","كُن","فَيَكُونُ"],"١١٧"],["2:118",["وَقَالَ"]]]],[12,[["2:118",["ٱلَّذِينَ","لَا","يَعۡلَمُونَ","لَوۡلَا","يُكَلِّمُنَا","ٱللَّهُ","أَوۡ","تَأۡتِينَآ","ءَايَةٞۗ"]]]],[13,[["2:118",["كَذَٰلِكَ","قَالَ","ٱلَّذِينَ","مِن","قَبۡلِهِم","مِّثۡلَ","قَوۡلِهِمۡۘ","تَشَٰبَهَتۡ"]]]],[14,[["2:118",["قُلُوبُهُمۡۗ","قَدۡ","بَيَّنَّا","ٱلۡأٓيَٰتِ","لِقَوۡمٖ","يُوقِنُونَ"],"١١٨"],["2:119",["إِنَّآ","أَرۡسَلۡنَٰكَ"]]]],[15,[["2:119",["بِٱلۡحَقِّ","بَشِيرٗا","وَنَذِيرٗاۖ","وَلَا","تُسۡـَٔلُ","عَنۡ","أَصۡحَٰبِ","ٱلۡجَحِيمِ"],"١١٩"]]]],"19":[[1,[["2:120",["وَلَن","تَرۡضَىٰ","عَنكَ","ٱلۡيَهُودُ","وَلَا","ٱلنَّصَٰرَىٰ","حَتَّىٰ","تَتَّبِعَ","مِلَّتَهُمۡۗ","قُلۡ"]]]],[2,[["2:120",["إِنَّ","هُدَى","ٱللَّهِ