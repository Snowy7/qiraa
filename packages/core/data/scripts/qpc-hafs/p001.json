,"وَٱلصَّٰبِـِٔينَ","مَنۡ"]]]],[2,[["2:62",["ءَامَنَ","بِٱللَّهِ","وَٱلۡيَوۡمِ","ٱلۡأٓخِرِ","وَعَمِلَ","صَٰلِحٗا","فَلَهُمۡ","أَجۡرُهُمۡ","عِندَ"]]]],[3,[["2:62",["رَبِّهِمۡ","وَلَا","خَوۡفٌ","عَلَيۡهِمۡ","وَلَا","هُمۡ","يَحۡزَنُونَ"],"٦٢"],["2:63",["وَإِذۡ","أَخَذۡنَا"]]]],[4,[["2:63",["مِيثَٰقَكُمۡ","وَرَفَعۡنَا","فَوۡقَكُمُ","ٱلطُّورَ","خُذُواْ","مَآ","ءَاتَيۡنَٰكُم"]]]],[5,[["2:63",["بِقُوَّةٖ","وَٱذۡكُرُواْ","مَا","فِيهِ","لَعَلَّكُمۡ","تَتَّقُونَ"],"٦٣"],["2:64",["ثُمَّ","تَوَلَّيۡتُم"]]]],[6,[["2:64",["مِّنۢ","بَعۡدِ","ذَٰلِكَۖ","فَلَوۡلَا","فَضۡلُ","ٱللَّهِ","عَلَيۡكُمۡ","وَرَحۡمَتُهُۥ","لَكُنتُم","مِّنَ"]]]],[7,[["2:64",["ٱلۡخَٰسِرِينَ"],"٦٤"],["2:65",["وَلَقَدۡ","عَلِمۡتُمُ","ٱلَّذِينَ","ٱعۡتَدَوۡاْ","مِنكُمۡ","فِي","ٱلسَّبۡتِ"]]]],[8,[["2:65",["فَقُلۡنَا","لَهُمۡ","كُونُواْ","قِرَدَةً","خَٰسِـِٔينَ"],"٦٥"],["2:66",["فَجَعَلۡنَٰهَا","نَكَٰلٗا","لِّمَا"]]]],[9,[["2:66",["بَيۡنَ","يَدَيۡهَا","وَمَا","خَلۡفَهَا","وَمَوۡعِظَةٗ","لِّلۡمُتَّقِينَ"],"٦٦"],["2:67",["وَإِذۡ","قَالَ"]]]],[10,[["2:67",["مُوسَىٰ","لِقَوۡمِهِۦٓ","إِنَّ","ٱللَّهَ","يَأۡمُرُكُمۡ","أَن","تَذۡبَحُواْ","بَقَرَةٗۖ","قَالُوٓاْ"]]]],[11,[["2:67",["أَتَتَّخِذُنَا","هُزُوٗاۖ","قَالَ","أَعُوذُ","بِٱللَّهِ","أَنۡ","أَكُونَ","مِنَ","ٱلۡجَٰهِلِينَ"]]]],[12,[["2:67",[],"٦٧"],["2:68",["قَالُواْ","ٱدۡعُ","لَنَا","رَبَّكَ","يُبَيِّن","لَّنَا","مَا","هِيَۚ","قَالَ","إِنَّهُۥ","يَقُولُ","إِنَّهَا"]]]],[13,[["2:68",["بَقَرَةٞ","لَّا","فَارِضٞ","وَلَا","بِكۡرٌ","عَوَانُۢ","بَيۡنَ","ذَٰلِكَۖ","فَٱفۡعَلُواْ","مَا"]]]],[14,[["2:68",["تُؤۡمَرُونَ"],"٦٨"],["2:69",["قَالُواْ","ٱدۡعُ","لَنَا","رَبَّكَ","يُبَيِّن","لَّنَا","مَا","لَوۡنُهَاۚ","قَالَ","إِنَّهُۥ"]]]],[15,[["2:69",["يَقُولُ","إِنَّهَا","بَقَرَةٞ","صَفۡرَآءُ","فَاقِعٞ","لَّوۡنُهَا","تَسُرُّ","ٱلنَّٰظِرِينَ"],"٦٩"]]]],"11":[[1,[["2:70",["قَالُواْ","ٱدۡعُ","لَنَا","رَبَّكَ","يُبَيِّن","لَّنَا","مَا","هِيَ","إِنَّ","ٱلۡبَقَرَ","تَشَٰبَهَ","عَلَيۡنَا","وَإِنَّآ"]]]],[2,[["2:70",["إِن","شَآءَ","ٱللَّهُ","لَمُهۡتَدُونَ"],"٧٠"],["2:71",["قَالَ","إِنَّهُۥ","يَقُولُ","إِنَّهَا","بَقَرَةٞ","لَّا","ذَلُولٞ"]]]],[3,[["2:71",["تُثِيرُ","ٱلۡأَرۡضَ","وَلَا","تَسۡقِي","ٱلۡحَرۡثَ","مُسَلَّمَةٞ","لَّا","شِيَةَ","فِيهَاۚ","قَالُواْ"]]]],[4,[["2:71",["ٱلۡـَٰٔنَ","جِئۡتَ","بِٱلۡحَقِّۚ","فَذَبَحُوهَا","وَمَا","كَادُواْ","يَفۡعَلُونَ"],"٧١"],["2:72",["وَإِذۡ"]]]],[5,[["2:72",["قَتَلۡتُمۡ","نَفۡسٗا","فَٱدَّٰرَٰءۡتُمۡ","فِيهَاۖ","وَٱللَّهُ","مُخۡرِجٞ","مَّا","كُنتُمۡ","تَكۡتُمُونَ"]]]],[6,[["2:72",[],"٧٢"],["2:73",["فَقُلۡنَا","ٱضۡرِبُوهُ","بِبَعۡضِهَاۚ","كَذَٰلِكَ","يُحۡيِ","ٱللَّهُ","ٱلۡمَوۡتَىٰ","وَيُرِيكُمۡ"]]]],[7,[["2:73",["ءَايَٰتِهِۦ","لَعَلَّكُمۡ","تَعۡقِلُونَ"],"٧٣"],["2:74",["ثُمَّ","قَسَتۡ","قُلُوبُكُم","مِّنۢ","بَعۡدِ","ذَٰلِكَ"]]]],[8,[["2:74",["فَهِيَ","كَٱلۡحِجَارَةِ","أَوۡ","أَشَدُّ","قَسۡوَةٗۚ","وَإِنَّ","مِنَ","ٱلۡحِجَارَةِ","لَمَا","يَتَفَجَّرُ"]]]],[9,[["2:74",["مِنۡهُ","ٱلۡأَنۡهَٰرُۚ","وَإِنَّ","مِنۡهَا","لَمَا","يَشَّقَّقُ","فَيَخۡرُجُ","مِنۡهُ","ٱلۡمَآءُۚ","وَإِنَّ"]]]],[10,[["2:74",["مِنۡهَا","لَمَا","يَهۡبِطُ","مِنۡ","خَشۡيَةِ","ٱللَّهِۗ","وَمَا","ٱللَّهُ","بِغَٰفِلٍ","عَمَّا","تَعۡمَلُونَ"]]]],[11,[["2:74",[],"٧٤"],["2:75",["۞ أَفَتَطۡمَعُونَ","أَن","يُؤۡمِنُواْ","لَكُمۡ","وَقَدۡ","كَانَ","فَرِيقٞ","مِّنۡهُمۡ"]]]],[12,[["2:75",["يَسۡمَعُونَ","كَلَٰمَ","ٱللَّهِ","ثُمَّ","يُحَرِّفُونَهُۥ","مِنۢ","بَعۡدِ","مَا","عَقَلُوهُ","وَهُمۡ"]]]],[13,[["2:75",["يَعۡلَمُونَ"],"٧٥"],["2:76",["وَإِذَا","لَقُواْ","ٱلَّذِينَ","ءَامَنُواْ","قَالُوٓاْ","ءَامَنَّا","وَإِذَا"]]]],[14,[["2:76",["خَلَا","بَعۡضُهُمۡ","إِلَىٰ","بَعۡضٖ","قَالُوٓاْ","أَتُحَدِّثُونَهُم","بِمَا","فَتَحَ","ٱللَّهُ"]]]],[15,[["2:76",["عَلَيۡكُمۡ","لِيُحَآجُّوكُم","بِهِۦ","عِندَ","رَبِّكُمۡۚ","أَفَلَا","تَعۡقِلُونَ"],"٧٦"]]]],"12":[[1,[["2:77",["أَوَلَا","يَعۡلَمُونَ","أَنَّ","ٱللَّهَ","يَعۡلَمُ","مَا","يُسِرُّونَ","وَمَا","يُعۡلِنُونَ"],"٧٧"]]],[2,[["2:78",["وَمِنۡهُمۡ","أُمِّيُّونَ","لَا","يَعۡلَمُونَ","ٱلۡكِتَٰبَ","إِلَّآ","أَمَانِيَّ","وَإِنۡ","هُمۡ"]]]],[3,[["2:78",["إِلَّا","يَظُنُّونَ"],"٧٨"],["2:79",["فَوَيۡلٞ","لِّلَّذِينَ","يَكۡتُبُونَ","ٱلۡكِتَٰبَ","بِأَيۡدِيهِمۡ"]]]],[4,[["2:79",["ثُمَّ","يَقُولُونَ","هَٰذَا","مِنۡ","عِندِ","ٱللَّهِ","لِيَشۡتَرُواْ","بِهِۦ","ثَمَنٗا","قَلِيلٗاۖ"]]]],[5,[["2:79",["فَوَيۡلٞ","لَّهُم","مِّمَّا","كَتَبَتۡ","أَيۡدِيهِمۡ","وَوَيۡلٞ","لَّهُم","مِّمَّا","يَكۡسِبُونَ"]]]],[6,[["2:79",[],"٧٩"],["2:80",["وَقَالُواْ","لَن","تَمَسَّنَا","ٱلنَّارُ","إِلَّآ","أَيَّامٗا","مَّعۡدُودَةٗۚ","قُلۡ"]]]],[7,[["2:80",["أَتَّخَذۡتُمۡ","عِندَ","ٱللَّهِ","عَهۡدٗا","فَلَن","يُخۡلِفَ","ٱللَّهُ","عَهۡدَهُۥٓۖ","أَمۡ"]]]],[8,[["2:80",["تَقُولُونَ","عَلَى","ٱللَّهِ","مَا","لَا","تَعۡلَمُونَ"],"٨٠"],["2:81",["بَلَىٰۚ","مَن","كَسَبَ","سَيِّئَةٗ"]]]],[9,[["2:81",["وَأَحَٰطَتۡ","بِهِۦ","خَطِيٓـَٔتُهُۥ","فَأُوْلَٰٓئِكَ","أَصۡحَٰبُ","ٱلنَّارِۖ","هُمۡ"]]]],[10,[["2:81",["فِيهَا","خَٰلِدُونَ"],"٨١"],["2:82",["وَٱلَّذِينَ","ءَامَنُواْ","وَعَمِلُواْ","ٱلصَّٰلِحَٰتِ"]]]],[11,[["2:82",["أُوْلَٰٓئِكَ","أَصۡحَٰبُ","ٱلۡجَنَّةِۖ","هُمۡ","فِيهَا","خَٰلِدُونَ"],"٨٢"],["2:83",["وَإِذۡ","أَخَذۡنَا"]]]],[12,[["2:83",["مِيثَٰقَ","بَنِيٓ","إِسۡرَٰٓءِيلَ","لَا","تَعۡبُدُونَ","إِلَّا","ٱللَّهَ","وَبِٱلۡوَٰلِدَيۡنِ"]]]],[13,[["2:83",["إِحۡسَانٗا","وَذِي","ٱلۡقُرۡبَىٰ","وَٱلۡيَتَٰمَىٰ","وَٱلۡمَسَٰكِينِ","وَقُولُواْ"]]]],[14,[["2:83",["لِلنَّاسِ","حُسۡنٗا","وَأَقِيمُواْ","ٱلصَّلَوٰةَ","وَءَاتُواْ","ٱلزَّكَوٰةَ","ثُمَّ"]]]],[15,[["2:83",["تَوَلَّيۡتُمۡ","إِلَّا","قَلِيلٗا","مِّنكُمۡ","وَأَنتُم","مُّعۡرِضُونَ"],"٨٣"]]]],"13":[[1,[["2:84",["وَإِذۡ","أَخَذۡنَا","مِيثَٰقَكُمۡ","لَا","تَسۡفِكُونَ","دِمَآءَكُمۡ","وَلَا","تُخۡرِجُونَ"]]]],[2,[["2:84",["أَنفُسَكُم","مِّن","دِيَٰرِكُمۡ","ثُمَّ","أَقۡرَرۡتُمۡ","وَأَنتُمۡ","تَشۡهَدُونَ"],"٨٤"]]],[3,[["2:85",["ثُمَّ","أَنتُمۡ","هَٰٓؤُلَآءِ","تَقۡتُلُونَ","أَنفُسَكُمۡ","وَتُخۡرِجُونَ","فَرِيقٗا"]]]],[4,[["2:85",["مِّنكُم","مِّن","دِيَٰرِهِمۡ","تَظَٰهَرُونَ","عَلَيۡهِم","بِٱلۡإِثۡمِ","وَٱلۡعُدۡوَٰنِ"]]]],[5,[["2:85",["وَإِن","يَأۡتُوكُمۡ","أُسَٰرَىٰ","تُفَٰدُوهُمۡ","وَهُوَ","مُحَرَّمٌ","عَلَيۡكُمۡ"]]]],[6,[["2:85",["إِخۡرَاجُهُمۡۚ","أَفَتُؤۡمِنُونَ","بِبَعۡضِ","ٱلۡكِتَٰبِ","وَتَكۡفُرُونَ","بِبَعۡضٖۚ"]]]],[7,[["2:85",["فَمَا","جَزَآءُ","مَن","يَفۡعَلُ","ذَٰلِكَ","مِنكُمۡ","إِلَّا","خِزۡيٞ","فِي","ٱلۡحَيَوٰةِ"]]]],[8,[["2:85",["ٱلدُّنۡيَاۖ","وَيَوۡمَ","ٱلۡقِيَٰمَةِ","يُرَدُّونَ","إِلَىٰٓ","أَشَدِّ","ٱلۡعَذَابِۗ","وَمَا","ٱللَّهُ"]]]],[9,[["2:85",["بِغَٰفِلٍ","عَمَّا","تَعۡمَلُونَ"],"٨٥"],["2:86",["أُوْلَٰٓئِكَ","ٱلَّذِينَ","ٱشۡتَرَوُاْ","ٱلۡحَيَوٰةَ"]]]],[10,[["2:86",["ٱلدُّنۡيَا","بِٱلۡأٓخِرَةِۖ","فَلَا","يُخَفَّفُ","عَنۡهُمُ","ٱلۡعَذَابُ","وَلَا","هُمۡ","يُنصَرُونَ"]]]],[11,[["2:86",[],"٨٦"],["2:87",["وَلَقَدۡ","ءَاتَيۡنَا","مُوسَى","ٱلۡكِتَٰبَ","وَقَفَّيۡنَا","مِنۢ","بَعۡدِهِۦ"]]]],[12,[["2:87",["بِٱلرُّسُلِۖ","وَءَاتَيۡنَا","عِيسَى","ٱبۡنَ","مَرۡيَمَ","ٱلۡبَيِّنَٰتِ","وَأَيَّدۡنَٰهُ","بِرُوحِ"]]]],[13,[["2:87",["ٱلۡقُدُسِۗ","أَفَكُلَّمَا","جَآءَكُمۡ","رَسُولُۢ","بِمَا","لَا","تَهۡوَىٰٓ","أَنفُسُكُمُ"]]]],[14,[["2:87",["ٱسۡتَكۡبَرۡتُمۡ","فَفَرِيقٗا","كَذَّبۡتُمۡ","وَفَرِيقٗا","تَقۡتُلُونَ"],"٨٧"],["2:88",["وَقَالُواْ","قُلُوبُنَا"]]]],[15,[["2:88",["غُلۡفُۢۚ","بَل","لَّعَنَهُمُ","ٱللَّهُ","بِكُفۡرِهِمۡ","فَقَلِيلٗا","مَّا","يُؤۡمِنُونَ"],"٨٨"]]]],"14":[[1,[["2:89",["وَلَمَّا","جَآءَهُمۡ","كِتَٰبٞ","مِّنۡ","عِندِ","ٱللَّهِ","مُصَدِّقٞ","لِّمَا","مَعَهُمۡ"]]]],[2,[["2:89",["وَكَانُواْ","مِن","قَبۡلُ","يَسۡتَفۡتِحُونَ","عَلَى","ٱلَّذِينَ","كَفَرُواْ","فَلَمَّا"]]]],[3,[["2:89",["جَآءَهُم","مَّا","عَرَفُواْ","كَفَرُواْ","بِهِۦۚ","فَلَعۡنَةُ","ٱللَّهِ","عَلَى","ٱلۡكَٰفِرِينَ"]]]],[4,[["2:89",[],"٨٩"],["2:90",["بِئۡسَمَا","ٱشۡتَرَوۡاْ","بِهِۦٓ","أَنفُسَهُمۡ","أَن","يَكۡفُرُواْ","بِمَآ","أَنزَلَ","ٱللَّهُ"]]]],[5,[["2:90",["بَغۡيًا","أَن","يُنَزِّلَ","ٱللَّهُ","مِن","فَضۡلِهِۦ","عَلَىٰ","مَن","يَشَآءُ","مِنۡ","عِبَادِهِۦۖ"]]]],[6,[["2:90",["فَبَآءُو","بِغَضَبٍ","عَلَىٰ","غَضَبٖۚ","وَلِلۡكَٰفِرِينَ","عَذَابٞ","مُّهِينٞ"]]]],[7,[["2:90",[],"٩٠"],["2:91",["وَإِذَا","قِيلَ","لَهُمۡ","ءَامِنُواْ","بِمَآ","أَنزَلَ","ٱللَّهُ","قَالُواْ","نُؤۡمِنُ","بِمَآ","أُنزِلَ"]]]],[8,[["2:91",["عَلَيۡنَا","وَيَكۡفُرُونَ","بِمَا","وَرَآءَهُۥ","وَهُوَ","ٱلۡحَقُّ","مُصَد