["2:127",["مِنَّآۖ","إِنَّكَ","أَنتَ","ٱلسَّمِيعُ","ٱلۡعَلِيمُ"],"١٢٧"],["2:128",["رَبَّنَا","وَٱجۡعَلۡنَا","مُسۡلِمَيۡنِ"]]]],[3,[["2:128",["لَكَ","وَمِن","ذُرِّيَّتِنَآ","أُمَّةٗ","مُّسۡلِمَةٗ","لَّكَ","وَأَرِنَا","مَنَاسِكَنَا","وَتُبۡ","عَلَيۡنَآۖ"]]]],[4,[["2:128",["إِنَّكَ","أَنتَ","ٱلتَّوَّابُ","ٱلرَّحِيمُ"],"١٢٨"],["2:129",["رَبَّنَا","وَٱبۡعَثۡ","فِيهِمۡ","رَسُولٗا","مِّنۡهُمۡ"]]]],[5,[["2:129",["يَتۡلُواْ","عَلَيۡهِمۡ","ءَايَٰتِكَ","وَيُعَلِّمُهُمُ","ٱلۡكِتَٰبَ","وَٱلۡحِكۡمَةَ"]]]],[6,[["2:129",["وَيُزَكِّيهِمۡۖ","إِنَّكَ","أَنتَ","ٱلۡعَزِيزُ","ٱلۡحَكِيمُ"],"١٢٩"],["2:130",["وَمَن","يَرۡغَبُ","عَن","مِّلَّةِ"]]]],[7,[["2:130",["إِبۡرَٰهِـۧمَ","إِلَّا","مَن","سَفِهَ","نَفۡسَهُۥۚ","وَلَقَدِ","ٱصۡطَفَيۡنَٰهُ","فِي","ٱلدُّنۡيَاۖ"]]]],[8,[["2:130",["وَإِنَّهُۥ","فِي","ٱلۡأٓخِرَةِ","لَمِنَ","ٱلصَّٰلِحِينَ"],"١٣٠"],["2:131",["إِذۡ","قَالَ","لَهُۥ","رَبُّهُۥٓ","أَسۡلِمۡۖ"]]]],[9,[["2:131",["قَالَ","أَسۡلَمۡتُ","لِرَبِّ","ٱلۡعَٰلَمِينَ"],"١٣١"],["2:132",["وَوَصَّىٰ","بِهَآ","إِبۡرَٰهِـۧمُ","بَنِيهِ"]]]],[10,[["2:132",["وَيَعۡقُوبُ","يَٰبَنِيَّ","إِنَّ","ٱللَّهَ","ٱصۡطَفَىٰ","لَكُمُ","ٱلدِّينَ","فَلَا","تَمُوتُنَّ"]]]],[11,[["2:132",["إِلَّا","وَأَنتُم","مُّسۡلِمُونَ"],"١٣٢"],["2:133",["أَمۡ","كُنتُمۡ","شُهَدَآءَ","إِذۡ","حَضَرَ","يَعۡقُوبَ"]]]],[12,[["2:133",["ٱلۡمَوۡتُ","إِذۡ","قَالَ","لِبَنِيهِ","مَا","تَعۡبُدُونَ","مِنۢ","بَعۡدِيۖ","قَالُواْ","نَعۡبُدُ"]]]],[13,[["2:133",["إِلَٰهَكَ","وَإِلَٰهَ","ءَابَآئِكَ","إِبۡرَٰهِـۧمَ","وَإِسۡمَٰعِيلَ","وَإِسۡحَٰقَ","إِلَٰهٗا"]]]],[14,[["2:133",["وَٰحِدٗا","وَنَحۡنُ","لَهُۥ","مُسۡلِمُونَ"],"١٣٣"],["2:134",["تِلۡكَ","أُمَّةٞ","قَدۡ","خَلَتۡۖ","لَهَا","مَا","كَسَبَتۡ"]]]],[15,[["2:134",["وَلَكُم","مَّا","كَسَبۡتُمۡۖ","وَلَا","تُسۡـَٔلُونَ","عَمَّا","كَانُواْ","يَعۡمَلُونَ"],"١٣٤"]]]]}