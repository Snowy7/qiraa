,[["7:154",1,["وَلَمَّا","سَكَتَ","عَن","مُّوسَى","ٱلۡغَضَبُ","أَخَذَ","ٱلۡأَلۡوَاحَۖ","وَفِي","نُسۡخَتِهَا"]]]],[11,[["7:154",10,["هُدٗى","وَرَحۡمَةٞ","لِّلَّذِينَ","هُمۡ","لِرَبِّهِمۡ","يَرۡهَبُونَ"],"١٥٤"],["7:155",1,["وَٱخۡتَارَ","مُوسَىٰ"]]]],[12,[["7:155",3,["قَوۡمَهُۥ","سَبۡعِينَ","رَجُلٗا","لِّمِيقَٰتِنَاۖ","فَلَمَّآ","أَخَذَتۡهُمُ","ٱلرَّجۡفَةُ","قَالَ"]]]],[13,[["7:155",11,["رَبِّ","لَوۡ","شِئۡتَ","أَهۡلَكۡتَهُم","مِّن","قَبۡلُ","وَإِيَّٰيَۖ","أَتُهۡلِكُنَا","بِمَا","فَعَلَ"]]]],[14,[["7:155",21,["ٱلسُّفَهَآءُ","مِنَّآۖ","إِنۡ","هِيَ","إِلَّا","فِتۡنَتُكَ","تُضِلُّ","بِهَا","مَن","تَشَآءُ","وَتَهۡدِي"]]]],[15,[["7:155",32,["مَن","تَشَآءُۖ","أَنتَ","وَلِيُّنَا","فَٱغۡفِرۡ","لَنَا","وَٱرۡحَمۡنَاۖ","وَأَنتَ","خَيۡرُ","ٱلۡغَٰفِرِينَ"],"١٥٥"]]]],"170":[[1,[["7:156",1,["۞ وَٱكۡتُبۡ","لَنَا","فِي","هَٰذِهِ","ٱلدُّنۡيَا","حَسَنَةٗ","وَفِي","ٱلۡأٓخِرَةِ"]]]],[2,[["7:156",9,["إِنَّا","هُدۡنَآ","إِلَيۡكَۚ","قَالَ","عَذَابِيٓ","أُصِيبُ","بِهِۦ","مَنۡ","أَشَآءُۖ","وَرَحۡمَتِي"]]]],[3,[["7:156",19,["وَسِعَتۡ","كُلَّ","شَيۡءٖۚ","فَسَأَكۡتُبُهَا","لِلَّذِينَ","يَتَّقُونَ","وَيُؤۡتُونَ"]]]],[4,[["7:156",26,["ٱلزَّكَوٰةَ","وَٱلَّذِينَ","هُم","بِـَٔايَٰتِنَا","يُؤۡمِنُونَ"],"١٥٦"],["7:157",1,["ٱلَّذِينَ","يَتَّبِعُونَ"]]]],[5,[["7:157",3,["ٱلرَّسُولَ","ٱلنَّبِيَّ","ٱلۡأُمِّيَّ","ٱلَّذِي","يَجِدُونَهُۥ","مَكۡتُوبًا","عِندَهُمۡ"]]]],[6,[["7:157",10,["فِي","ٱلتَّوۡرَىٰةِ","وَٱلۡإِنجِيلِ","يَأۡمُرُهُم","بِٱلۡمَعۡرُوفِ","وَيَنۡهَىٰهُمۡ"]]]],[7,[["7:157",16,["عَنِ","ٱلۡمُنكَرِ","وَيُحِلُّ","لَهُمُ","ٱلطَّيِّبَٰتِ","وَيُحَرِّمُ","عَلَيۡهِمُ"]]]],[8,[["7:157",23,["ٱلۡخَبَٰٓئِثَ","وَيَضَعُ","عَنۡهُمۡ","إِصۡرَهُمۡ","وَٱلۡأَغۡلَٰلَ","ٱلَّتِي","كَانَتۡ"]]]],[9,[["7:157",30,["عَلَيۡهِمۡۚ","فَٱلَّذِينَ","ءَامَنُواْ","بِهِۦ","وَعَزَّرُوهُ","وَنَصَرُوهُ","وَٱتَّبَعُواْ"]]]],[10,[["7:157",37,["ٱلنُّورَ","ٱلَّذِيٓ","أُنزِلَ","مَعَهُۥٓ","أُوْلَٰٓئِكَ","هُمُ","ٱلۡمُفۡلِحُونَ"],"١٥٧"]]],[11,[["7:158",1,["قُلۡ","يَٰٓأَيُّهَا","ٱلنَّاسُ","إِنِّي","رَسُولُ","ٱللَّهِ","إِلَيۡكُمۡ","جَمِيعًا","ٱلَّذِي"]]]],[12,[["7:158",10,["لَهُۥ","مُلۡكُ","ٱلسَّمَٰوَٰتِ","وَٱلۡأَرۡضِۖ","لَآ","إِلَٰهَ","إِلَّا","هُوَ","يُحۡيِۦ","وَيُمِيتُۖ"]]]],[13,[["7:158",20,["فَـَٔامِنُواْ","بِٱللَّهِ","وَرَسُولِهِ","ٱلنَّبِيِّ","ٱلۡأُمِّيِّ","ٱلَّذِي","يُؤۡمِنُ","بِٱللَّهِ"]]]],[14,[["7:158",28,["وَكَلِمَٰتِهِۦ","وَٱتَّبِعُوهُ","لَعَلَّكُمۡ","تَهۡتَدُونَ"],"١٥٨"],["7:159",1,["وَمِن"]]]],[15,[["7:159",2,["قَوۡمِ","مُوسَىٰٓ","أُمَّةٞ","يَهۡدُونَ","بِٱلۡحَقِّ","وَبِهِۦ","يَعۡدِلُونَ"],"١٥٩"]]]],"171":[[1,[["7:160",1,["وَقَطَّعۡنَٰهُمُ","ٱثۡنَتَيۡ","عَشۡرَةَ","أَسۡبَاطًا","أُمَمٗاۚ","وَأَوۡحَيۡنَآ","إِلَىٰ"]]]],[2,[["7:160",8,["مُوسَىٰٓ","إِذِ","ٱسۡتَسۡقَىٰهُ","قَوۡمُهُۥٓ","أَنِ","ٱضۡرِب","بِّعَصَاكَ","ٱلۡحَجَرَۖ"]]]],[3,[["7:160",16,["فَٱنۢبَجَسَتۡ","مِنۡهُ","ٱثۡنَتَا","عَشۡرَةَ","عَيۡنٗاۖ","قَدۡ","عَلِمَ","كُلُّ","أُنَاسٖ"]]]],[4,[["7:160",25,["مَّشۡرَبَهُمۡۚ","وَظَلَّلۡنَا","عَلَيۡهِمُ","ٱلۡغَمَٰمَ","وَأَنزَلۡنَا","عَلَيۡهِمُ"]]]],[5,[["7:160",31,["ٱلۡمَنَّ","وَٱلسَّلۡوَىٰۖ","كُلُواْ","مِن","طَيِّبَٰتِ","مَا","رَزَقۡنَٰكُمۡۚ","وَمَا"]]]],[6,[["7:160",39,["ظَلَمُونَا","وَلَٰكِن","كَانُوٓاْ","أَنفُسَهُمۡ","يَظۡلِمُونَ"],"١٦٠"]]],[7,[["7:161",1,["وَإِذۡ","قِيلَ","لَهُمُ","ٱسۡكُنُواْ","هَٰذِهِ","ٱلۡقَرۡيَةَ","وَكُلُواْ","مِنۡهَا"]]]],[8,[["7:161",9,["حَيۡثُ","شِئۡتُمۡ","وَقُولُواْ","حِطَّةٞ","وَٱدۡخُلُواْ","ٱلۡبَابَ","سُجَّدٗا"]]]],[9,[["7:161",16,["نَّغۡفِرۡ","لَكُمۡ","خَطِيٓـَٰٔتِكُمۡۚ","سَنَزِيدُ","ٱلۡمُحۡسِنِينَ"]]]],[10,[["7:161",21,[],"١٦١"],["7:162",1,["فَبَدَّلَ","ٱلَّذِينَ","ظَلَمُواْ","مِنۡهُمۡ","قَوۡلًا","غَيۡرَ","ٱلَّذِي","قِيلَ"]]]],[11,[["7:162",9,["لَهُمۡ","فَأَرۡسَلۡنَا","عَلَيۡهِمۡ","رِجۡزٗا","مِّنَ","ٱلسَّمَآءِ","بِمَا","كَانُواْ"]]]],[12,[["7:162",17,["يَظۡلِمُونَ"],"١٦٢"],["7:163",1,["وَسۡـَٔلۡهُمۡ","عَنِ","ٱلۡقَرۡيَةِ","ٱلَّتِي","كَانَتۡ"]]]],[13,[["7:163",6,["حَاضِرَةَ","ٱلۡبَحۡرِ","إِذۡ","يَعۡدُونَ","فِي","ٱلسَّبۡتِ","إِذۡ","تَأۡتِيهِمۡ"]]]],[14,[["7:163",14,["حِيتَانُهُمۡ","يَوۡمَ","سَبۡتِهِمۡ","شُرَّعٗا","وَيَوۡمَ","لَا","يَسۡبِتُونَ","لَا","تَأۡتِيهِمۡۚ"]]]],[15,[["7:163",23,["كَذَٰلِكَ","نَبۡلُوهُم","بِمَا","كَانُواْ","يَفۡسُقُونَ"],"١٦٣"]]]],"172":[[1,[["7:164",1,["وَإِذۡ","قَالَتۡ","أُمَّةٞ","مِّنۡهُمۡ","لِمَ","تَعِظُونَ","قَوۡمًا","ٱللَّهُ","مُهۡلِكُهُمۡ","أَوۡ","مُعَذِّبُهُمۡ"]]]],[2,[["7:164",12,["عَذَابٗا","شَدِيدٗاۖ","قَالُواْ","مَعۡذِرَةً","إِلَىٰ","رَبِّكُمۡ","وَلَعَلَّهُمۡ","يَتَّقُونَ"],"١٦٤"]]],[3,[["7:165",1,["فَلَمَّا","نَسُواْ","مَا","ذُكِّرُواْ","بِهِۦٓ","أَنجَيۡنَا","ٱلَّذِينَ","يَنۡهَوۡنَ","عَنِ","ٱلسُّوٓءِ"]]]],[4,[["7:165",11,["وَأَخَذۡنَا","ٱلَّذِينَ","ظَلَمُواْ","بِعَذَابِۭ","بَـِٔيسِۭ","بِمَا","كَانُواْ","يَفۡسُقُونَ"],"١٦٥"]]],[5,[["7:166",1,["فَلَمَّا","عَتَوۡاْ","عَن","مَّا","نُهُواْ","عَنۡهُ","قُلۡنَا","لَهُمۡ","كُونُواْ","قِرَدَةً","خَٰسِـِٔينَ"],"١٦٦"]]],[6,[["7:167",1,["وَإِذۡ","تَأَذَّنَ","رَبُّكَ","لَيَبۡعَثَنَّ","عَلَيۡهِمۡ","إِلَىٰ","يَوۡمِ","ٱلۡقِيَٰمَةِ","مَن","يَسُومُهُمۡ"]]]],[7,[["7:167",11,["سُوٓءَ","ٱلۡعَذَابِۗ","إِنَّ","رَبَّكَ","لَسَرِيعُ","ٱلۡعِقَابِ","وَإِنَّهُۥ","لَغَفُورٞ","رَّحِيمٞ"]]]],[8,[["7:167",20,[],"١٦٧"],["7:168",1,["وَقَطَّعۡنَٰهُمۡ","فِي","ٱلۡأَرۡضِ","أُمَمٗاۖ","مِّنۡهُمُ","ٱلصَّٰلِحُونَ","وَمِنۡهُمۡ"]]]],[9,[["7:168",8,["دُونَ","ذَٰلِكَۖ","وَبَلَوۡنَٰهُم","بِٱلۡحَسَنَٰتِ","وَٱلسَّيِّـَٔاتِ","لَعَلَّهُمۡ"]]]],[10,[["7:168",14,["يَرۡجِعُونَ"],"١٦٨"],["7:169",1,["فَخَلَفَ","مِنۢ","بَعۡدِهِمۡ","خَلۡفٞ","وَرِثُواْ","ٱلۡكِتَٰبَ"]]]],[11,[["7:169",7,["يَأۡخُذُونَ","عَرَضَ","هَٰذَا","ٱلۡأَدۡنَىٰ","وَيَقُولُونَ","سَيُغۡفَرُ","لَنَا","وَإِن"]]]],[12,[["7:169",15,["يَأۡتِهِمۡ","عَرَضٞ","مِّثۡلُهُۥ","يَأۡخُذُوهُۚ","أَلَمۡ","يُؤۡخَذۡ","عَلَيۡهِم","مِّيثَٰقُ","ٱلۡكِتَٰبِ"]]]],[13,[["7:169",24,["أَن","لَّا","يَقُولُواْ","عَلَى","ٱللَّهِ","إِلَّا","ٱلۡحَقَّ","وَدَرَسُواْ","مَا","فِيهِۗ","وَٱلدَّارُ","ٱلۡأٓخِرَةُ"]]]],[14,[["7:169",36,["خَيۡرٞ","لِّلَّذِينَ","يَتَّقُونَۚ","أَفَلَا","تَعۡقِلُونَ"],"١٦٩"],["7:170",1,["وَٱلَّذِينَ","يُمَسِّكُونَ"]]]],[15,[["7:170",3,["بِٱلۡكِتَٰبِ","وَأَقَامُواْ","ٱلصَّلَوٰةَ","إِنَّا","لَا","نُضِيعُ","أَجۡرَ","ٱلۡمُصۡلِحِينَ"],"١٧٠"]]]],"173":[[1,[["7:171",1,["۞ وَإِذۡ","نَتَقۡنَا","ٱلۡجَبَلَ","فَوۡقَهُمۡ","كَأَنَّهُۥ","ظُلَّةٞ","وَظَنُّوٓاْ","أَنَّهُۥ","وَاقِعُۢ","بِهِمۡ"]]]],[2,[["7:171",11,["خُذُواْ","مَآ","ءَاتَيۡنَٰكُم","بِقُوَّةٖ","وَٱذۡكُرُواْ","مَا","فِيهِ","لَعَلَّكُمۡ","تَتَّقُونَ"],"١٧١"]]],[3,[["7:172",1,["وَإِذۡ","أَخَذَ","رَبُّكَ","مِنۢ","بَنِيٓ","ءَادَمَ","مِن","ظُهُورِهِمۡ","ذُرِّيَّتَهُمۡ","وَأَشۡهَدَهُمۡ"]]]],[4,[["7:172",11,["عَلَىٰٓ","أَنفُسِهِمۡ","أَلَسۡتُ","بِرَبِّكُمۡۖ","قَالُواْ","بَلَىٰ","شَهِدۡنَآۚ","أَن","تَقُولُواْ","يَوۡمَ"]]]],[5,[["7:172",21,["ٱلۡقِيَٰمَةِ","إِنَّا","كُنَّا","عَنۡ","هَٰذَا","غَٰفِلِينَ"],"١٧٢"],["7:173",1,["أَوۡ","تَقُولُوٓاْ","إِنَّمَآ","أَشۡرَكَ"]]]],[6,[["7:173",5,["ءَابَآؤُنَا","مِن","قَبۡلُ","وَكُنَّا","ذُرِّيَّةٗ","مِّنۢ","بَعۡدِهِمۡۖ","أَفَتُهۡلِكُنَا"]]]],[7,[["7:173",13,["بِمَا","فَعَلَ","ٱلۡمُبۡطِلُونَ"],"١٧٣"],["7:174",1,["وَكَذَٰلِكَ","نُفَصِّلُ","ٱلۡأٓيَٰتِ","وَلَعَلَّهُمۡ"]]]],[8,[["7:174",5,["يَرۡجِعُونَ"],"١٧٤"],["7:175",1,["وَٱتۡلُ","عَلَيۡهِمۡ","نَبَأَ","ٱلَّذِيٓ","ءَاتَيۡنَٰهُ","ءَايَٰتِنَا","فَٱنسَلَخَ"]]]],[9,[["7:175",8,["مِنۡهَا","فَأَتۡبَعَهُ","ٱلشَّيۡطَٰنُ","فَكَانَ","مِنَ","ٱلۡغَاوِينَ"],"١٧٥"],["7:176",1,["وَلَوۡ","شِئۡنَا"]]]],[10,[["7:176",3,["لَرَفَعۡنَٰهُ","بِهَا","وَلَٰكِنَّهُۥٓ","أَخۡلَدَ","إِلَى","ٱلۡأَرۡضِ","وَٱتَّبَعَ","هَوَىٰهُۚ","فَمَثَلُهُۥ"]]]],[11,[["7:176",12,["كَمَثَلِ","ٱلۡكَلۡبِ","إِن","تَحۡمِلۡ","عَلَيۡهِ","يَلۡهَثۡ","أَوۡ","تَتۡرُكۡهُ"]]]],[12,[["7:176",20,["يَلۡهَثۚ","ذَّٰلِكَ","مَثَلُ","ٱلۡقَوۡمِ","ٱلَّذِينَ","كَذَّبُواْ","بِـَٔايَٰتِنَاۚ","فَٱقۡصُصِ"]]]],[13,[["7:176",28,["ٱلۡقَصَصَ","لَعَلَّهُمۡ","يَتَفَكَّرُونَ"],"١٧٦"],["7:177",1,["سَآءَ","مَثَلًا","ٱلۡقَوۡمُ","ٱلَّذِينَ"]]]],[14,[["7:177",5,["كَذَّبُواْ","بِـَٔايَٰتِنَا","وَأَنفُسَهُمۡ","كَانُواْ","يَظۡلِمُونَ"],"١٧٧"],["7:178",1,["مَن","يَهۡدِ","ٱللَّهُ"]]]],[15,[["7:178",4,["فَهُوَ","ٱلۡمُهۡتَدِيۖ","وَمَن","يُضۡلِلۡ","فَأُوْلَٰٓئِكَ","هُمُ","ٱلۡخَٰسِرُونَ"],"١٧٨"]]]],"174":[[1,[["7:179",1,["وَلَقَدۡ","ذَرَأۡنَا","لِجَهَنَّمَ","كَثِيرٗا","مِّنَ","ٱلۡ