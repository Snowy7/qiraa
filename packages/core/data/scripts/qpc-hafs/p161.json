َآءَكُمۡ","وَيَسۡتَحۡيُونَ","نِسَآءَكُمۡۚ","وَفِي","ذَٰلِكُم","بَلَآءٞ"]]]],[8,[["7:141",16,["مِّن","رَّبِّكُمۡ","عَظِيمٞ"],"١٤١"],["7:142",1,["۞ وَوَٰعَدۡنَا","مُوسَىٰ","ثَلَٰثِينَ","لَيۡلَةٗ"]]]],[9,[["7:142",5,["وَأَتۡمَمۡنَٰهَا","بِعَشۡرٖ","فَتَمَّ","مِيقَٰتُ","رَبِّهِۦٓ","أَرۡبَعِينَ","لَيۡلَةٗۚ","وَقَالَ"]]]],[10,[["7:142",13,["مُوسَىٰ","لِأَخِيهِ","هَٰرُونَ","ٱخۡلُفۡنِي","فِي","قَوۡمِي","وَأَصۡلِحۡ","وَلَا","تَتَّبِعۡ"]]]],[11,[["7:142",22,["سَبِيلَ","ٱلۡمُفۡسِدِينَ"],"١٤٢"],["7:143",1,["وَلَمَّا","جَآءَ","مُوسَىٰ","لِمِيقَٰتِنَا","وَكَلَّمَهُۥ"]]]],[12,[["7:143",6,["رَبُّهُۥ","قَالَ","رَبِّ","أَرِنِيٓ","أَنظُرۡ","إِلَيۡكَۚ","قَالَ","لَن","تَرَىٰنِي","وَلَٰكِنِ"]]]],[13,[["7:143",16,["ٱنظُرۡ","إِلَى","ٱلۡجَبَلِ","فَإِنِ","ٱسۡتَقَرَّ","مَكَانَهُۥ","فَسَوۡفَ","تَرَىٰنِيۚ","فَلَمَّا"]]]],[14,[["7:143",25,["تَجَلَّىٰ","رَبُّهُۥ","لِلۡجَبَلِ","جَعَلَهُۥ","دَكّٗا","وَخَرَّ","مُوسَىٰ","صَعِقٗاۚ","فَلَمَّآ"]]]],[15,[["7:143",34,["أَفَاقَ","قَالَ","سُبۡحَٰنَكَ","تُبۡتُ","إِلَيۡكَ","وَأَنَا۠","أَوَّلُ","ٱلۡمُؤۡمِنِينَ"],"١٤٣"]]]],"168":[[1,[["7:144",1,["قَالَ","يَٰمُوسَىٰٓ","إِنِّي","ٱصۡطَفَيۡتُكَ","عَلَى","ٱلنَّاسِ","بِرِسَٰلَٰتِي","وَبِكَلَٰمِي"]]]],[2,[["7:144",9,["فَخُذۡ","مَآ","ءَاتَيۡتُكَ","وَكُن","مِّنَ","ٱلشَّٰكِرِينَ"],"١٤٤"],["7:145",1,["وَكَتَبۡنَا"]]]],[3,[["7:145",2,["لَهُۥ","فِي","ٱلۡأَلۡوَاحِ","مِن","كُلِّ","شَيۡءٖ","مَّوۡعِظَةٗ","وَتَفۡصِيلٗا","لِّكُلِّ"]]]],[4,[["7:145",11,["شَيۡءٖ","فَخُذۡهَا","بِقُوَّةٖ","وَأۡمُرۡ","قَوۡمَكَ","يَأۡخُذُواْ","بِأَحۡسَنِهَاۚ","سَأُوْرِيكُمۡ"]]]],[5,[["7:145",19,["دَارَ","ٱلۡفَٰسِقِينَ"],"١٤٥"],["7:146",1,["سَأَصۡرِفُ","عَنۡ","ءَايَٰتِيَ","ٱلَّذِينَ","يَتَكَبَّرُونَ"]]]],[6,[["7:146",6,["فِي","ٱلۡأَرۡضِ","بِغَيۡرِ","ٱلۡحَقِّ","وَإِن","يَرَوۡاْ","كُلَّ","ءَايَةٖ","لَّا","يُؤۡمِنُواْ","بِهَا"]]]],[7,[["7:146",17,["وَإِن","يَرَوۡاْ","سَبِيلَ","ٱلرُّشۡدِ","لَا","يَتَّخِذُوهُ","سَبِيلٗا","وَإِن","يَرَوۡاْ","سَبِيلَ"]]]],[8,[["7:146",27,["ٱلۡغَيِّ","يَتَّخِذُوهُ","سَبِيلٗاۚ","ذَٰلِكَ","بِأَنَّهُمۡ","كَذَّبُواْ","بِـَٔايَ