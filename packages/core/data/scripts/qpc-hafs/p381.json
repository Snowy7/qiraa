{"381":[[1,[["27:45",["وَلَقَدۡ","أَرۡسَلۡنَآ","إِلَىٰ","ثَمُودَ","أَخَاهُمۡ","صَٰلِحًا","أَنِ","ٱعۡبُدُواْ","ٱللَّهَ"]]]],[2,[["27:45",["فَإِذَا","هُمۡ","فَرِيقَانِ","يَخۡتَصِمُونَ"],"٤٥"],["27:46",["قَالَ","يَٰقَوۡمِ","لِمَ","تَسۡتَعۡجِلُونَ"]]]],[3,[["27:46",["بِٱلسَّيِّئَةِ","قَبۡلَ","ٱلۡحَسَنَةِۖ","لَوۡلَا","تَسۡتَغۡفِرُونَ","ٱللَّهَ","لَعَلَّكُمۡ"]]]],[4,[["27:46",["تُرۡحَمُونَ"],"٤٦"],["27:47",["قَالُواْ","ٱطَّيَّرۡنَا","بِكَ","وَبِمَن","مَّعَكَۚ","قَالَ","طَٰٓئِرُكُمۡ"]]]],[5,[["27:47",["عِندَ","ٱللَّهِۖ","بَلۡ","أَنتُمۡ","قَوۡمٞ","تُفۡتَنُونَ"],"٤٧"],["27:48",["وَكَانَ","فِي","ٱلۡمَدِينَةِ"]]]],[6,[["27:48",["تِسۡعَةُ","رَهۡطٖ","يُفۡسِدُونَ","فِي","ٱلۡأَرۡضِ","وَلَا","يُصۡلِحُونَ"],"٤٨"]]],[7,[["27:49",["قَالُواْ","تَقَاسَمُواْ","بِٱللَّهِ","لَنُبَيِّتَنَّهُۥ","وَأَهۡلَهُۥ","ثُمَّ","لَنَقُولَنَّ","لِوَلِيِّهِۦ"]]]],[8,[["27:49",["مَا","شَهِدۡنَا","مَهۡلِكَ","أَهۡلِهِۦ","وَإِنَّا","لَصَٰدِقُونَ"],"٤٩"],["27:50",["وَمَكَرُواْ"]]]],[9,[["27:50",["مَكۡرٗا","وَمَكَرۡنَا","مَكۡرٗا","وَهُمۡ","لَا","يَشۡعُرُونَ"],"٥٠"],["27:51",["فَٱنظُرۡ"]]]],[10,[["27:51",["كَيۡفَ","كَانَ","عَٰقِبَةُ","مَكۡرِهِمۡ","أَنَّا","دَمَّرۡنَٰهُمۡ","وَقَوۡمَهُمۡ"]]]],[11,[["27:51",["أَجۡمَعِينَ"],"٥١"],["27:52",["فَتِلۡكَ","بُيُوتُهُمۡ","خَاوِيَةَۢ","بِمَا","ظَلَمُوٓاْۚ","إِنَّ"]]]],[12,[["27:52",["فِي","ذَٰلِكَ","لَأٓيَةٗ","لِّقَوۡمٖ","يَعۡلَمُونَ"],"٥٢"],["27:53",["وَأَنجَيۡنَا","ٱلَّذِينَ","ءَامَنُواْ"]]]],[13,[["27:53",["وَكَانُواْ","يَتَّقُونَ"],"٥٣"],["27:54",["وَلُوطًا","إِذۡ","قَالَ","لِقَوۡمِهِۦٓ","أَتَأۡتُونَ"]]]],[14,[["27:54",["ٱلۡفَٰحِشَةَ","وَأَنتُمۡ","تُبۡصِرُونَ"],"٥٤"],["27:55",["أَئِنَّكُمۡ","لَتَأۡتُونَ","ٱلرِّجَالَ"]]]],[15,[["27:55",["شَهۡوَةٗ","مِّن","دُونِ","ٱلنِّسَآءِۚ","بَلۡ","أَنتُمۡ","قَوۡمٞ","تَجۡهَلُونَ"],"٥٥"]]]],"382":[[1,[["27:56",["۞ فَمَا","كَانَ","جَوَابَ","قَوۡمِهِۦٓ","إِلَّآ","أَن","قَالُوٓاْ","أَخۡرِجُوٓاْ","ءَالَ"]]]],[2,[["27:56",["لُوطٖ","مِّن","قَرۡيَتِكُمۡۖ","إِنَّهُمۡ","أُنَاسٞ","يَتَطَهَّرُونَ"],"٥٦"],["27:57",["فَأَنجَيۡنَٰهُ"]]]],[3,[["27:57",["وَأَهۡلَهُۥٓ","إِلَّا","ٱمۡرَأَتَهُۥ","قَدَّرۡنَٰهَا","مِنَ","ٱلۡغَٰبِرِينَ"],"٥٧"],["27:58",["وَأَمۡطَرۡنَا"]]]],[4,[["27:58",["عَلَيۡهِم","مَّطَرٗاۖ","فَسَآءَ","مَطَرُ","ٱلۡمُنذَرِينَ"],"٥٨"],["27:59",["قُلِ","ٱلۡحَمۡدُ","لِلَّهِ"]]]],[5,[["27:59",["وَسَلَٰمٌ","عَلَىٰ","عِبَادِهِ","ٱلَّذِينَ","ٱصۡطَفَىٰٓۗ","ءَآللَّهُ","خَيۡرٌ","أَمَّا","يُشۡرِكُونَ"]]]],[6,[["27:59",[],"٥٩"],["27:60",["أَمَّنۡ","خَلَقَ","ٱلسَّمَٰوَٰتِ","وَٱلۡأَرۡضَ","وَأَنزَلَ","لَكُم","مِّنَ","ٱلسَّمَآءِ"]]]],[7,[["27:60",["مَآءٗ","فَأَنۢبَتۡنَا","بِهِۦ","حَدَآئِقَ","ذَاتَ","بَهۡجَةٖ","مَّا","كَانَ","لَكُمۡ","أَن"]]]],[8,[["27:60",["تُنۢبِتُواْ","شَجَرَهَآۗ","أَءِلَٰهٞ","مَّعَ","ٱللَّهِۚ","بَلۡ","هُمۡ","قَوۡمٞ","يَعۡدِلُونَ"],"٦٠"]]],[9,[["27:61",["أَمَّن","جَعَلَ","ٱلۡأَرۡضَ","قَرَارٗا","وَجَعَلَ","خِلَٰلَهَآ","أَنۡهَٰرٗا","وَجَعَلَ"]]]],[10,[["27:61",["لَهَا","رَوَٰسِيَ","وَجَعَلَ","بَيۡنَ","ٱلۡبَحۡرَيۡنِ","حَاجِزًاۗ","أَءِلَٰهٞ","مَّعَ","ٱللَّهِۚ"]]]],[11,[["27:61",["بَلۡ","أَكۡثَرُهُمۡ","لَا","يَعۡلَمُونَ"],"٦١"],["27:62",["أَمَّن","يُجِيبُ","ٱلۡمُضۡطَرَّ","إِذَا"]]]],[12,[["27:62",["دَعَاهُ","وَيَكۡشِفُ","ٱلسُّوٓءَ","وَيَجۡعَلُكُمۡ","خُلَفَآءَ","ٱلۡأَرۡضِۗ"]]]],[13,[["27:62",["أَءِلَٰهٞ","مَّعَ","ٱللَّهِۚ","قَلِيلٗا","مَّا","تَذَكَّرُونَ"],"٦٢"],["27:63",["أَمَّن","يَهۡدِيكُمۡ","فِي"]]]],[14,[["27:63",["ظُلُمَٰتِ","ٱلۡبَرِّ","وَٱلۡبَحۡرِ","وَمَن","يُرۡسِلُ","ٱلرِّيَٰحَ","بُشۡرَۢا","بَيۡنَ","يَدَيۡ"]]]],[15,[["27:63",["رَحۡمَتِهِۦٓۗ","أَءِلَٰهٞ","مَّعَ","ٱللَّهِۚ","تَعَٰلَى","ٱللَّهُ","عَمَّا","يُشۡرِكُونَ"],"٦٣"]]]],"383":[[1,[["27:64",["أَمَّن","يَبۡدَؤُاْ","ٱلۡخَلۡقَ","ثُمَّ","يُعِيدُهُۥ","وَمَن","يَرۡزُقُكُم","مِّنَ","ٱلسَّمَآءِ","وَٱلۡأَرۡضِۗ"]]]],[2,[["27:64",["أَءِلَٰهٞ","مَّعَ","ٱللَّهِۚ","قُلۡ","هَاتُواْ","بُرۡهَٰنَكُمۡ","إِن","كُنتُمۡ","صَٰدِقِينَ"],"٦٤"],["27:65",["قُل"]]]],[3,[["27:65",["لَّا","يَعۡلَمُ","مَن","فِي","ٱلسَّمَٰوَٰتِ","وَٱلۡأَرۡضِ","ٱلۡغَيۡبَ","إِلَّا","ٱللَّهُۚ","وَمَا","يَشۡعُرُونَ"]]]],[4,[["27:65",["أَيَّانَ","يُبۡعَثُونَ"],"٦٥"],["27:66",["بَلِ","