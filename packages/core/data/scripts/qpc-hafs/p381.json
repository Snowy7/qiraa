فۡصَحُ","مِنِّي","لِسَانٗا"]]]],[13,[["28:34",["فَأَرۡسِلۡهُ","مَعِيَ","رِدۡءٗا","يُصَدِّقُنِيٓۖ","إِنِّيٓ","أَخَافُ","أَن","يُكَذِّبُونِ"],"٣٤"]]],[14,[["28:35",["قَالَ","سَنَشُدُّ","عَضُدَكَ","بِأَخِيكَ","وَنَجۡعَلُ","لَكُمَا","سُلۡطَٰنٗا","فَلَا"]]]],[15,[["28:35",["يَصِلُونَ","إِلَيۡكُمَا","بِـَٔايَٰتِنَآۚ","أَنتُمَا","وَمَنِ","ٱتَّبَعَكُمَا","ٱلۡغَٰلِبُونَ"],"٣٥"]]]],"390":[[1,[["28:36",["فَلَمَّا","جَآءَهُم","مُّوسَىٰ","بِـَٔايَٰتِنَا","بَيِّنَٰتٖ","قَالُواْ","مَا","هَٰذَآ","إِلَّا","سِحۡرٞ"]]]],[2,[["28:36",["مُّفۡتَرٗى","وَمَا","سَمِعۡنَا","بِهَٰذَا","فِيٓ","ءَابَآئِنَا","ٱلۡأَوَّلِينَ"],"٣٦"]]],[3,[["28:37",["وَقَالَ","مُوسَىٰ","رَبِّيٓ","أَعۡلَمُ","بِمَن","جَآءَ","بِٱلۡهُدَىٰ","مِنۡ","عِندِهِۦ","وَمَن"]]]],[4,[["28:37",["تَكُونُ","لَهُۥ","عَٰقِبَةُ","ٱلدَّارِۚ","إِنَّهُۥ","لَا","يُفۡلِحُ","ٱلظَّٰلِمُونَ"],"٣٧"]]],[5,[["28:38",["وَقَالَ","فِرۡعَوۡنُ","يَٰٓأَيُّهَا","ٱلۡمَلَأُ","مَا","عَلِمۡتُ","لَكُم","مِّنۡ","إِلَٰهٍ"]]]],[6,[["28:38",["غَيۡرِي","فَأَوۡقِدۡ","لِي","يَٰهَٰمَٰنُ","عَلَى","ٱلطِّينِ","فَٱجۡعَل","لِّي","صَرۡحٗا","لَّعَلِّيٓ"]]]],[7,[["28:38",["أَطَّلِعُ","إِلَىٰٓ","إِلَٰهِ","مُوسَىٰ","وَإِنِّي","لَأَظُنُّهُۥ","مِنَ","ٱلۡكَٰذِبِينَ"],"٣٨"]]],[8,[["28:39",["وَٱسۡتَكۡبَرَ","هُوَ","وَجُنُودُهُۥ","فِي","ٱلۡأَرۡضِ","بِغَيۡرِ","ٱلۡحَقِّ","وَظَنُّوٓاْ"]]]],[9,[["28:39",["أَنَّهُمۡ","إِلَيۡنَا","لَا","يُرۡجَعُونَ"],"٣٩"],["28:40",["فَأَخَذۡنَٰهُ","وَجُنُودَهُۥ","فَنَبَذۡنَٰهُمۡ"]]]],[10,[["28:40",["فِي","ٱلۡيَمِّۖ","فَٱنظُرۡ","كَيۡفَ","كَانَ","عَٰقِبَةُ","ٱلظَّٰلِمِينَ"],"٤٠"]]],[11,[["28:41",["وَجَعَلۡنَٰهُمۡ","أَئِمَّةٗ","يَدۡعُونَ","إِلَى","ٱلنَّارِۖ","وَيَوۡمَ","ٱلۡقِيَٰمَةِ"]]]],[12,[["28:41",["لَا","يُنصَرُونَ"],"٤١"],["28:42",["وَأَتۡبَعۡنَٰهُمۡ","فِي","هَٰذِهِ","ٱلدُّنۡيَا","لَعۡنَةٗۖ"]]]],[13,[["28:42",["وَيَوۡمَ","ٱلۡقِيَٰمَةِ","هُم","مِّنَ","ٱلۡمَقۡبُوحِينَ"],"٤٢"],["28:43",["وَلَقَدۡ","ءَاتَيۡنَا"]]]],[14,[["28:43",["مُوسَى","ٱلۡكِتَٰبَ","مِنۢ","بَعۡدِ","مَآ","أَهۡلَكۡنَا","ٱلۡقُرُونَ","ٱلۡأُولَىٰ"]]]],[15,[["28:43",["بَصَآئِرَ","لِلن