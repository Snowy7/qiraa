["إِن","كُنتُمۡ","تَعۡلَمُونَ"],"٢٨٠"],["2:281",["وَٱتَّقُواْ","يَوۡمٗا","تُرۡجَعُونَ","فِيهِ","إِلَى"]]]],[15,[["2:281",["ٱللَّهِۖ","ثُمَّ","تُوَفَّىٰ","كُلُّ","نَفۡسٖ","مَّا","كَسَبَتۡ","وَهُمۡ","لَا","يُظۡلَمُونَ"],"٢٨١"]]]],"48":[[1,[["2:282",["يَٰٓأَيُّهَا","ٱلَّذِينَ","ءَامَنُوٓاْ","إِذَا","تَدَايَنتُم","بِدَيۡنٍ","إِلَىٰٓ","أَجَلٖ","مُّسَمّٗى"]]]],[2,[["2:282",["فَٱكۡتُبُوهُۚ","وَلۡيَكۡتُب","بَّيۡنَكُمۡ","كَاتِبُۢ","بِٱلۡعَدۡلِۚ","وَلَا","يَأۡبَ"]]]],[3,[["2:282",["كَاتِبٌ","أَن","يَكۡتُبَ","كَمَا","عَلَّمَهُ","ٱللَّهُۚ","فَلۡيَكۡتُبۡ","وَلۡيُمۡلِلِ"]]]],[4,[["2:282",["ٱلَّذِي","عَلَيۡهِ","ٱلۡحَقُّ","وَلۡيَتَّقِ","ٱللَّهَ","رَبَّهُۥ","وَلَا","يَبۡخَسۡ","مِنۡهُ","شَيۡـٔٗاۚ"]]]],[5,[["2:282",["فَإِن","كَانَ","ٱلَّذِي","عَلَيۡهِ","ٱلۡحَقُّ","سَفِيهًا","أَوۡ","ضَعِيفًا","أَوۡ","لَا","يَسۡتَطِيعُ"]]]],[6,[["2:282",["أَن","يُمِلَّ","هُوَ","فَلۡيُمۡلِلۡ","وَلِيُّهُۥ","بِٱلۡعَدۡلِۚ","وَٱسۡتَشۡهِدُواْ","شَهِيدَيۡنِ"]]]],[7,[["2:282",["مِن","رِّجَالِكُمۡۖ","فَإِن","لَّمۡ","يَكُونَا","رَجُلَيۡنِ","فَرَجُلٞ","وَٱمۡرَأَتَانِ"]]]],[8,[["2:282",["مِمَّن","تَرۡضَوۡنَ","مِنَ","ٱلشُّهَدَآءِ","أَن","تَضِلَّ","إِحۡدَىٰهُمَا","فَتُذَكِّرَ"]]]],[9,[["2:282",["إِحۡدَىٰهُمَا","ٱلۡأُخۡرَىٰۚ","وَلَا","يَأۡبَ","ٱلشُّهَدَآءُ","إِذَا","مَا","دُعُواْۚ","وَلَا","تَسۡـَٔمُوٓاْ"]]]],[10,[["2:282",["أَن","تَكۡتُبُوهُ","صَغِيرًا","أَوۡ","كَبِيرًا","إِلَىٰٓ","أَجَلِهِۦۚ","ذَٰلِكُمۡ","أَقۡسَطُ"]]]],[11,[["2:282",["عِندَ","ٱللَّهِ","وَأَقۡوَمُ","لِلشَّهَٰدَةِ","وَأَدۡنَىٰٓ","أَلَّا","تَرۡتَابُوٓاْ","إِلَّآ","أَن","تَكُونَ"]]]],[12,[["2:282",["تِجَٰرَةً","حَاضِرَةٗ","تُدِيرُونَهَا","بَيۡنَكُمۡ","فَلَيۡسَ","عَلَيۡكُمۡ","جُنَاحٌ"]]]],[13,[["2:282",["أَلَّا","تَكۡتُبُوهَاۗ","وَأَشۡهِدُوٓاْ","إِذَا","تَبَايَعۡتُمۡۚ","وَلَا","يُضَآرَّ","كَاتِبٞ"]]]],[14,[["2:282",["وَلَا","شَهِيدٞۚ","وَإِن","تَفۡعَلُواْ","فَإِنَّهُۥ","فُسُوقُۢ","بِكُمۡۗ","وَٱتَّقُواْ"]]]],[15,[["2:282",["ٱللَّهَۖ","وَيُعَلِّمُكُمُ","ٱللَّهُۗ","وَٱللَّهُ","بِكُلِّ","شَيۡءٍ","عَلِيمٞ"],"٢٨٢"]]]],"49":[[1,[["2:283",["۞ وَإِن","كُنتُمۡ