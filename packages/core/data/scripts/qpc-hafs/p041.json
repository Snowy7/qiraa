,"وَأَنزَلَ","ٱلتَّوۡرَىٰةَ","وَٱلۡإِنجِيلَ"],"٣"],["3:4",["مِن"]]]],[5,[["3:4",["قَبۡلُ","هُدٗى","لِّلنَّاسِ","وَأَنزَلَ","ٱلۡفُرۡقَانَۗ","إِنَّ","ٱلَّذِينَ","كَفَرُواْ","بِـَٔايَٰتِ","ٱللَّهِ"]]]],[6,[["3:4",["لَهُمۡ","عَذَابٞ","شَدِيدٞۗ","وَٱللَّهُ","عَزِيزٞ","ذُو","ٱنتِقَامٍ"],"٤"],["3:5",["إِنَّ","ٱللَّهَ","لَا","يَخۡفَىٰ"]]]],[7,[["3:5",["عَلَيۡهِ","شَيۡءٞ","فِي","ٱلۡأَرۡضِ","وَلَا","فِي","ٱلسَّمَآءِ"],"٥"],["3:6",["هُوَ","ٱلَّذِي","يُصَوِّرُكُمۡ"]]]],[8,[["3:6",["فِي","ٱلۡأَرۡحَامِ","كَيۡفَ","يَشَآءُۚ","لَآ","إِلَٰهَ","إِلَّا","هُوَ","ٱلۡعَزِيزُ","ٱلۡحَكِيمُ"],"٦"],["3:7",["هُوَ"]]]],[9,[["3:7",["ٱلَّذِيٓ","أَنزَلَ","عَلَيۡكَ","ٱلۡكِتَٰبَ","مِنۡهُ","ءَايَٰتٞ","مُّحۡكَمَٰتٌ","هُنَّ","أُمُّ"]]]],[10,[["3:7",["ٱلۡكِتَٰبِ","وَأُخَرُ","مُتَشَٰبِهَٰتٞۖ","فَأَمَّا","ٱلَّذِينَ","فِي","قُلُوبِهِمۡ","زَيۡغٞ","فَيَتَّبِعُونَ"]]]],[11,[["3:7",["مَا","تَشَٰبَهَ","مِنۡهُ","ٱبۡتِغَآءَ","ٱلۡفِتۡنَةِ","وَٱبۡتِغَآءَ","تَأۡوِيلِهِۦۖ","وَمَا","يَعۡلَمُ","تَأۡوِيلَهُۥٓ"]]]],[12,[["3:7",["إِلَّا","ٱللَّهُۗ","وَٱلرَّٰسِخُونَ","فِي","ٱلۡعِلۡمِ","يَقُولُونَ","ءَامَنَّا","بِهِۦ","كُلّٞ","مِّنۡ","عِندِ"]]]],[13,[["3:7",["رَبِّنَاۗ","وَمَا","يَذَّكَّرُ","إِلَّآ","أُوْلُواْ","ٱلۡأَلۡبَٰبِ"],"٧"],["3:8",["رَبَّنَا","لَا","تُزِغۡ","قُلُوبَنَا","بَعۡدَ"]]]],[14,[["3:8",["إِذۡ","هَدَيۡتَنَا","وَهَبۡ","لَنَا","مِن","لَّدُنكَ","رَحۡمَةًۚ","إِنَّكَ","أَنتَ","ٱلۡوَهَّابُ"],"٨"],["3:9",["رَبَّنَآ"]]]],[15,[["3:9",["إِنَّكَ","جَامِعُ","ٱلنَّاسِ","لِيَوۡمٖ","لَّا","رَيۡبَ","فِيهِۚ","إِنَّ","ٱللَّهَ","لَا","يُخۡلِفُ","ٱلۡمِيعَادَ"],"٩"]]]],"51":[[1,[["3:10",["إِنَّ","ٱلَّذِينَ","كَفَرُواْ","لَن","تُغۡنِيَ","عَنۡهُمۡ","أَمۡوَٰلُهُمۡ","وَلَآ","أَوۡلَٰدُهُم"]]]],[2,[["3:10",["مِّنَ","ٱللَّهِ","شَيۡـٔٗاۖ","وَأُوْلَٰٓئِكَ","هُمۡ","وَقُودُ","ٱلنَّارِ"],"١٠"],["3:11",["كَدَأۡبِ","ءَالِ"]]]],[3,[["3:11",["فِرۡعَوۡنَ","وَٱلَّذِينَ","مِن","قَبۡلِهِمۡۚ","كَذَّبُواْ","بِـَٔايَٰتِنَا","فَأَخَذَهُمُ","ٱللَّهُ"]]]],[4,[["3:11",["بِذُنُوبِهِمۡۗ","وَٱللَّهُ","شَدِيدُ","ٱلۡعِقَابِ"],"١١"],["3:12",["قُل","لِّل