{"41":[[1,[["2:249",["فَلَمَّا","فَصَلَ","طَالُوتُ","بِٱلۡجُنُودِ","قَالَ","إِنَّ","ٱللَّهَ","مُبۡتَلِيكُم"]]]],[2,[["2:249",["بِنَهَرٖ","فَمَن","شَرِبَ","مِنۡهُ","فَلَيۡسَ","مِنِّي","وَمَن","لَّمۡ","يَطۡعَمۡهُ"]]]],[3,[["2:249",["فَإِنَّهُۥ","مِنِّيٓ","إِلَّا","مَنِ","ٱغۡتَرَفَ","غُرۡفَةَۢ","بِيَدِهِۦۚ","فَشَرِبُواْ","مِنۡهُ"]]]],[4,[["2:249",["إِلَّا","قَلِيلٗا","مِّنۡهُمۡۚ","فَلَمَّا","جَاوَزَهُۥ","هُوَ","وَٱلَّذِينَ","ءَامَنُواْ"]]]],[5,[["2:249",["مَعَهُۥ","قَالُواْ","لَا","طَاقَةَ","لَنَا","ٱلۡيَوۡمَ","بِجَالُوتَ","وَجُنُودِهِۦۚ"]]]],[6,[["2:249",["قَالَ","ٱلَّذِينَ","يَظُنُّونَ","أَنَّهُم","مُّلَٰقُواْ","ٱللَّهِ","كَم","مِّن","فِئَةٖ"]]]],[7,[["2:249",["قَلِيلَةٍ","غَلَبَتۡ","فِئَةٗ","كَثِيرَةَۢ","بِإِذۡنِ","ٱللَّهِۗ","وَٱللَّهُ","مَعَ"]]]],[8,[["2:249",["ٱلصَّٰبِرِينَ"],"٢٤٩"],["2:250",["وَلَمَّا","بَرَزُواْ","لِجَالُوتَ","وَجُنُودِهِۦ","قَالُواْ"]]]],[9,[["2:250",["رَبَّنَآ","أَفۡرِغۡ","عَلَيۡنَا","صَبۡرٗا","وَثَبِّتۡ","أَقۡدَامَنَا","وَٱنصُرۡنَا"]]]],[10,[["2:250",["عَلَى","ٱلۡقَوۡمِ","ٱلۡكَٰفِرِينَ"],"٢٥٠"],["2:251",["فَهَزَمُوهُم","بِإِذۡنِ","ٱللَّهِ"]]]],[11,[["2:251",["وَقَتَلَ","دَاوُۥدُ","جَالُوتَ","وَءَاتَىٰهُ","ٱللَّهُ","ٱلۡمُلۡكَ"]]]],[12,[["2:251",["وَٱلۡحِكۡمَةَ","وَعَلَّمَهُۥ","مِمَّا","يَشَآءُۗ","وَلَوۡلَا","دَفۡعُ","ٱللَّهِ","ٱلنَّاسَ"]]]],[13,[["2:251",["بَعۡضَهُم","بِبَعۡضٖ","لَّفَسَدَتِ","ٱلۡأَرۡضُ","وَلَٰكِنَّ","ٱللَّهَ","ذُو"]]]],[14,[["2:251",["فَضۡلٍ","عَلَى","ٱلۡعَٰلَمِينَ"],"٢٥١"],["2:252",["تِلۡكَ","ءَايَٰتُ","ٱللَّهِ","نَتۡلُوهَا"]]]],[15,[["2:252",["عَلَيۡكَ","بِٱلۡحَقِّۚ","وَإِنَّكَ","لَمِنَ","ٱلۡمُرۡسَلِينَ"],"٢٥٢"]]]],"42":[[1,[["2:253",["۞ تِلۡكَ","ٱلرُّسُلُ","فَضَّلۡنَا","بَعۡضَهُمۡ","عَلَىٰ","بَعۡضٖۘ","مِّنۡهُم","مَّن","كَلَّمَ","ٱللَّهُۖ"]]]],[2,[["2:253",["وَرَفَعَ","بَعۡضَهُمۡ","دَرَجَٰتٖۚ","وَءَاتَيۡنَا","عِيسَى","ٱبۡنَ","مَرۡيَمَ","ٱلۡبَيِّنَٰتِ"]]]],[3,[["2:253",["وَأَيَّدۡنَٰهُ","بِرُوحِ","ٱلۡقُدُسِۗ","وَلَوۡ","شَآءَ","ٱللَّهُ","مَا","ٱقۡتَتَلَ","ٱلَّذِينَ","مِنۢ"]]]],[4,[["2:253",["بَعۡدِهِم","مِّنۢ","بَعۡدِ","مَا