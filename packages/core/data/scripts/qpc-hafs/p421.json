{"421":[[1,[["33:23",["مِّنَ","ٱلۡمُؤۡمِنِينَ","رِجَالٞ","صَدَقُواْ","مَا","عَٰهَدُواْ","ٱللَّهَ","عَلَيۡهِۖ","فَمِنۡهُم","مَّن"]]]],[2,[["33:23",["قَضَىٰ","نَحۡبَهُۥ","وَمِنۡهُم","مَّن","يَنتَظِرُۖ","وَمَا","بَدَّلُواْ","تَبۡدِيلٗا"],"٢٣"],["33:24",["لِّيَجۡزِيَ"]]]],[3,[["33:24",["ٱللَّهُ","ٱلصَّٰدِقِينَ","بِصِدۡقِهِمۡ","وَيُعَذِّبَ","ٱلۡمُنَٰفِقِينَ","إِن","شَآءَ","أَوۡ"]]]],[4,[["33:24",["يَتُوبَ","عَلَيۡهِمۡۚ","إِنَّ","ٱللَّهَ","كَانَ","غَفُورٗا","رَّحِيمٗا"],"٢٤"],["33:25",["وَرَدَّ","ٱللَّهُ","ٱلَّذِينَ"]]]],[5,[["33:25",["كَفَرُواْ","بِغَيۡظِهِمۡ","لَمۡ","يَنَالُواْ","خَيۡرٗاۚ","وَكَفَى","ٱللَّهُ","ٱلۡمُؤۡمِنِينَ"]]]],[6,[["33:25",["ٱلۡقِتَالَۚ","وَكَانَ","ٱللَّهُ","قَوِيًّا","عَزِيزٗا"],"٢٥"],["33:26",["وَأَنزَلَ","ٱلَّذِينَ","ظَٰهَرُوهُم","مِّنۡ"]]]],[7,[["33:26",["أَهۡلِ","ٱلۡكِتَٰبِ","مِن","صَيَاصِيهِمۡ","وَقَذَفَ","فِي","قُلُوبِهِمُ","ٱلرُّعۡبَ"]]]],[8,[["33:26",["فَرِيقٗا","تَقۡتُلُونَ","وَتَأۡسِرُونَ","فَرِيقٗا"],"٢٦"],["33:27",["وَأَوۡرَثَكُمۡ","أَرۡضَهُمۡ"]]]],[9,[["33:27",["وَدِيَٰرَهُمۡ","وَأَمۡوَٰلَهُمۡ","وَأَرۡضٗا","لَّمۡ","تَطَـُٔوهَاۚ","وَكَانَ","ٱللَّهُ","عَلَىٰ","كُلِّ"]]]],[10,[["33:27",["شَيۡءٖ","قَدِيرٗا"],"٢٧"],["33:28",["يَٰٓأَيُّهَا","ٱلنَّبِيُّ","قُل","لِّأَزۡوَٰجِكَ","إِن","كُنتُنَّ","تُرِدۡنَ"]]]],[11,[["33:28",["ٱلۡحَيَوٰةَ","ٱلدُّنۡيَا","وَزِينَتَهَا","فَتَعَالَيۡنَ","أُمَتِّعۡكُنَّ","وَأُسَرِّحۡكُنَّ"]]]],[12,[["33:28",["سَرَاحٗا","جَمِيلٗا"],"٢٨"],["33:29",["وَإِن","كُنتُنَّ","تُرِدۡنَ","ٱللَّهَ","وَرَسُولَهُۥ","وَٱلدَّارَ"]]]],[13,[["33:29",["ٱلۡأٓخِرَةَ","فَإِنَّ","ٱللَّهَ","أَعَدَّ","لِلۡمُحۡسِنَٰتِ","مِنكُنَّ","أَجۡرًا","عَظِيمٗا"],"٢٩"]]],[14,[["33:30",["يَٰنِسَآءَ","ٱلنَّبِيِّ","مَن","يَأۡتِ","مِنكُنَّ","بِفَٰحِشَةٖ","مُّبَيِّنَةٖ","يُضَٰعَفۡ"]]]],[15,[["33:30",["لَهَا","ٱلۡعَذَابُ","ضِعۡفَيۡنِۚ","وَكَانَ","ذَٰلِكَ","عَلَى","ٱللَّهِ","يَسِيرٗا"],"٣٠"]]]],"422":[[1,[["33:31",["۞ وَمَن","يَقۡنُتۡ","مِنكُنَّ","لِلَّهِ","وَرَسُولِهِۦ","وَتَعۡمَلۡ","صَٰلِحٗا","نُّؤۡتِهَآ"]]]],[2,[["33:31",["أَجۡرَهَا","مَرَّتَيۡنِ","وَأَعۡتَ