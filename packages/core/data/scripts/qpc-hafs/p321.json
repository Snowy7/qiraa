{"321":[[1,[["20:126",1,["قَالَ","كَذَٰلِكَ","أَتَتۡكَ","ءَايَٰتُنَا","فَنَسِيتَهَاۖ","وَكَذَٰلِكَ","ٱلۡيَوۡمَ","تُنسَىٰ"],"١٢٦"]]],[2,[["20:127",1,["وَكَذَٰلِكَ","نَجۡزِي","مَنۡ","أَسۡرَفَ","وَلَمۡ","يُؤۡمِنۢ","بِـَٔايَٰتِ","رَبِّهِۦۚ","وَلَعَذَابُ","ٱلۡأٓخِرَةِ"]]]],[3,[["20:127",11,["أَشَدُّ","وَأَبۡقَىٰٓ"],"١٢٧"],["20:128",1,["أَفَلَمۡ","يَهۡدِ","لَهُمۡ","كَمۡ","أَهۡلَكۡنَا","قَبۡلَهُم","مِّنَ","ٱلۡقُرُونِ"]]]],[4,[["20:128",9,["يَمۡشُونَ","فِي","مَسَٰكِنِهِمۡۚ","إِنَّ","فِي","ذَٰلِكَ","لَأٓيَٰتٖ","لِّأُوْلِي","ٱلنُّهَىٰ"],"١٢٨"]]],[5,[["20:129",1,["وَلَوۡلَا","كَلِمَةٞ","سَبَقَتۡ","مِن","رَّبِّكَ","لَكَانَ","لِزَامٗا","وَأَجَلٞ","مُّسَمّٗى"],"١٢٩"]]],[6,[["20:130",1,["فَٱصۡبِرۡ","عَلَىٰ","مَا","يَقُولُونَ","وَسَبِّحۡ","بِحَمۡدِ","رَبِّكَ","قَبۡلَ","طُلُوعِ","ٱلشَّمۡسِ"]]]],[7,[["20:130",11,["وَقَبۡلَ","غُرُوبِهَاۖ","وَمِنۡ","ءَانَآيِٕ","ٱلَّيۡلِ","فَسَبِّحۡ","وَأَطۡرَافَ","ٱلنَّهَارِ","لَعَلَّكَ"]]]],[8,[["20:130",20,["تَرۡضَىٰ"],"١٣٠"],["20:131",1,["وَلَا","تَمُدَّنَّ","عَيۡنَيۡكَ","إِلَىٰ","مَا","مَتَّعۡنَا","بِهِۦٓ","أَزۡوَٰجٗا","مِّنۡهُمۡ","زَهۡرَةَ"]]]],[9,[["20:131",11,["ٱلۡحَيَوٰةِ","ٱلدُّنۡيَا","لِنَفۡتِنَهُمۡ","فِيهِۚ","وَرِزۡقُ","رَبِّكَ","خَيۡرٞ","وَأَبۡقَىٰ"],"١٣١"],["20:132",1,["وَأۡمُرۡ","أَهۡلَكَ"]]]],[10,[["20:132",3,["بِٱلصَّلَوٰةِ","وَٱصۡطَبِرۡ","عَلَيۡهَاۖ","لَا","نَسۡـَٔلُكَ","رِزۡقٗاۖ","نَّحۡنُ","نَرۡزُقُكَۗ","وَٱلۡعَٰقِبَةُ"]]]],[11,[["20:132",12,["لِلتَّقۡوَىٰ"],"١٣٢"],["20:133",1,["وَقَالُواْ","لَوۡلَا","يَأۡتِينَا","بِـَٔايَةٖ","مِّن","رَّبِّهِۦٓۚ","أَوَلَمۡ","تَأۡتِهِم"]]]],[12,[["20:133",9,["بَيِّنَةُ","مَا","فِي","ٱلصُّحُفِ","ٱلۡأُولَىٰ"],"١٣٣"],["20:134",1,["وَلَوۡ","أَنَّآ","أَهۡلَكۡنَٰهُم","بِعَذَابٖ"]]]],[13,[["20:134",5,["مِّن","قَبۡلِهِۦ","لَقَالُواْ","رَبَّنَا","لَوۡلَآ","أَرۡسَلۡتَ","إِلَيۡنَا","رَسُولٗا","فَنَتَّبِعَ"]]]],[14,[["20:134",14,["ءَايَٰتِكَ","مِن","قَبۡلِ","أَن","نَّذِلَّ","وَنَخۡزَىٰ"],"١٣٤"],["20:135",1,["قُلۡ","كُلّٞ","مُّتَرَبِّصٞ","فَتَرَبَّصُواْۖ"]]]],[15,[["20:135",5,["فَسَتَعۡلَمُونَ","مَنۡ","أَصۡحَٰبُ