{"481":[[1,[["41:39",["وَمِنۡ","ءَايَٰتِهِۦٓ","أَنَّكَ","تَرَى","ٱلۡأَرۡضَ","خَٰشِعَةٗ","فَإِذَآ","أَنزَلۡنَا","عَلَيۡهَا","ٱلۡمَآءَ"]]]],[2,[["41:39",["ٱهۡتَزَّتۡ","وَرَبَتۡۚ","إِنَّ","ٱلَّذِيٓ","أَحۡيَاهَا","لَمُحۡيِ","ٱلۡمَوۡتَىٰٓۚ","إِنَّهُۥ","عَلَىٰ","كُلِّ","شَيۡءٖ"]]]],[3,[["41:39",["قَدِيرٌ"],"٣٩"],["41:40",["إِنَّ","ٱلَّذِينَ","يُلۡحِدُونَ","فِيٓ","ءَايَٰتِنَا","لَا","يَخۡفَوۡنَ","عَلَيۡنَآۗ","أَفَمَن"]]]],[4,[["41:40",["يُلۡقَىٰ","فِي","ٱلنَّارِ","خَيۡرٌ","أَم","مَّن","يَأۡتِيٓ","ءَامِنٗا","يَوۡمَ","ٱلۡقِيَٰمَةِۚ","ٱعۡمَلُواْ","مَا","شِئۡتُمۡ"]]]],[5,[["41:40",["إِنَّهُۥ","بِمَا","تَعۡمَلُونَ","بَصِيرٌ"],"٤٠"],["41:41",["إِنَّ","ٱلَّذِينَ","كَفَرُواْ","بِٱلذِّكۡرِ","لَمَّا","جَآءَهُمۡۖ"]]]],[6,[["41:41",["وَإِنَّهُۥ","لَكِتَٰبٌ","عَزِيزٞ"],"٤١"],["41:42",["لَّا","يَأۡتِيهِ","ٱلۡبَٰطِلُ","مِنۢ","بَيۡنِ","يَدَيۡهِ","وَلَا","مِنۡ"]]]],[7,[["41:42",["خَلۡفِهِۦۖ","تَنزِيلٞ","مِّنۡ","حَكِيمٍ","حَمِيدٖ"],"٤٢"],["41:43",["مَّا","يُقَالُ","لَكَ","إِلَّا","مَا","قَدۡ","قِيلَ"]]]],[8,[["41:43",["لِلرُّسُلِ","مِن","قَبۡلِكَۚ","إِنَّ","رَبَّكَ","لَذُو","مَغۡفِرَةٖ","وَذُو","عِقَابٍ","أَلِيمٖ"]]]],[9,[["41:43",[],"٤٣"],["41:44",["وَلَوۡ","جَعَلۡنَٰهُ","قُرۡءَانًا","أَعۡجَمِيّٗا","لَّقَالُواْ","لَوۡلَا","فُصِّلَتۡ","ءَايَٰتُهُۥٓۖ"]]]],[10,[["41:44",["ءَا۬عۡجَمِيّٞ","وَعَرَبِيّٞۗ","قُلۡ","هُوَ","لِلَّذِينَ","ءَامَنُواْ","هُدٗى","وَشِفَآءٞۚ","وَٱلَّذِينَ"]]]],[11,[["41:44",["لَا","يُؤۡمِنُونَ","فِيٓ","ءَاذَانِهِمۡ","وَقۡرٞ","وَهُوَ","عَلَيۡهِمۡ","عَمًىۚ","أُوْلَٰٓئِكَ"]]]],[12,[["41:44",["يُنَادَوۡنَ","مِن","مَّكَانِۭ","بَعِيدٖ"],"٤٤"],["41:45",["وَلَقَدۡ","ءَاتَيۡنَا","مُوسَى","ٱلۡكِتَٰبَ"]]]],[13,[["41:45",["فَٱخۡتُلِفَ","فِيهِۚ","وَلَوۡلَا","كَلِمَةٞ","سَبَقَتۡ","مِن","رَّبِّكَ","لَقُضِيَ"]]]],[14,[["41:45",["بَيۡنَهُمۡۚ","وَإِنَّهُمۡ","لَفِي","شَكّٖ","مِّنۡهُ","مُرِيبٖ"],"٤٥"],["41:46",["مَّنۡ","عَمِلَ","صَٰلِحٗا"]]]],[15,[["41:46",["فَلِنَفۡسِهِۦۖ","وَمَنۡ","أَسَآءَ","فَعَلَيۡهَاۗ","وَمَا","رَبُّكَ","بِظَلَّٰمٖ","لِّلۡعَبِيدِ"],"٤٦"]]]],"482":[[1,[["41:47",["۞ إ