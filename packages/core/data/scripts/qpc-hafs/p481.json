,[4,[["42:3",["ٱللَّهُ","ٱلۡعَزِيزُ","ٱلۡحَكِيمُ"],"٣"],["42:4",["لَهُۥ","مَا","فِي","ٱلسَّمَٰوَٰتِ","وَمَا","فِي","ٱلۡأَرۡضِۖ"]]]],[5,[["42:4",["وَهُوَ","ٱلۡعَلِيُّ","ٱلۡعَظِيمُ"],"٤"],["42:5",["تَكَادُ","ٱلسَّمَٰوَٰتُ","يَتَفَطَّرۡنَ","مِن","فَوۡقِهِنَّۚ"]]]],[6,[["42:5",["وَٱلۡمَلَٰٓئِكَةُ","يُسَبِّحُونَ","بِحَمۡدِ","رَبِّهِمۡ","وَيَسۡتَغۡفِرُونَ","لِمَن","فِي"]]]],[7,[["42:5",["ٱلۡأَرۡضِۗ","أَلَآ","إِنَّ","ٱللَّهَ","هُوَ","ٱلۡغَفُورُ","ٱلرَّحِيمُ"],"٥"],["42:6",["وَٱلَّذِينَ","ٱتَّخَذُواْ"]]]],[8,[["42:6",["مِن","دُونِهِۦٓ","أَوۡلِيَآءَ","ٱللَّهُ","حَفِيظٌ","عَلَيۡهِمۡ","وَمَآ","أَنتَ","عَلَيۡهِم","بِوَكِيلٖ"]]]],[9,[["42:6",[],"٦"],["42:7",["وَكَذَٰلِكَ","أَوۡحَيۡنَآ","إِلَيۡكَ","قُرۡءَانًا","عَرَبِيّٗا","لِّتُنذِرَ","أُمَّ","ٱلۡقُرَىٰ","وَمَنۡ"]]]],[10,[["42:7",["حَوۡلَهَا","وَتُنذِرَ","يَوۡمَ","ٱلۡجَمۡعِ","لَا","رَيۡبَ","فِيهِۚ","فَرِيقٞ","فِي","ٱلۡجَنَّةِ","وَفَرِيقٞ","فِي"]]]],[11,[["42:7",["ٱلسَّعِيرِ"],"٧"],["42:8",["وَلَوۡ","شَآءَ","ٱللَّهُ","لَجَعَلَهُمۡ","أُمَّةٗ","وَٰحِدَةٗ","وَلَٰكِن","يُدۡخِلُ","مَن"]]]],[12,[["42:8",["يَشَآءُ","فِي","رَحۡمَتِهِۦۚ","وَٱلظَّٰلِمُونَ","مَا","لَهُم","مِّن","وَلِيّٖ","وَلَا","نَصِيرٍ"],"٨"],["42:9",["أَمِ"]]]],[13,[["42:9",["ٱتَّخَذُواْ","مِن","دُونِهِۦٓ","أَوۡلِيَآءَۖ","فَٱللَّهُ","هُوَ","ٱلۡوَلِيُّ","وَهُوَ","يُحۡيِ","ٱلۡمَوۡتَىٰ","وَهُوَ"]]]],[14,[["42:9",["عَلَىٰ","كُلِّ","شَيۡءٖ","قَدِيرٞ"],"٩"],["42:10",["وَمَا","ٱخۡتَلَفۡتُمۡ","فِيهِ","مِن","شَيۡءٖ","فَحُكۡمُهُۥٓ"]]]],[15,[["42:10",["إِلَى","ٱللَّهِۚ","ذَٰلِكُمُ","ٱللَّهُ","رَبِّي","عَلَيۡهِ","تَوَكَّلۡتُ","وَإِلَيۡهِ","أُنِيبُ"],"١٠"]]]],"484":[[1,[["42:11",["فَاطِرُ","ٱلسَّمَٰوَٰتِ","وَٱلۡأَرۡضِۚ","جَعَلَ","لَكُم","مِّنۡ","أَنفُسِكُمۡ","أَزۡوَٰجٗا"]]]],[2,[["42:11",["وَمِنَ","ٱلۡأَنۡعَٰمِ","أَزۡوَٰجٗا","يَذۡرَؤُكُمۡ","فِيهِۚ","لَيۡسَ","كَمِثۡلِهِۦ","شَيۡءٞۖ","وَهُوَ"]]]],[3,[["42:11",["ٱلسَّمِيعُ","ٱلۡبَصِيرُ"],"١١"],["42:12",["لَهُۥ","مَقَالِيدُ","ٱلسَّمَٰوَٰتِ","وَٱلۡأَرۡضِۖ","يَبۡسُطُ"]]]],[4,[["42:12",["ٱلرِّزۡقَ","لِمَن","يَشَآءُ","وَيَقۡدِرُۚ","إِ