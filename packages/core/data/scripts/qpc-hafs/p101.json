"5:45",["قِصَاصٞۚ","فَمَن","تَصَدَّقَ","بِهِۦ","فَهُوَ","كَفَّارَةٞ","لَّهُۥۚ","وَمَن"]]]],[15,[["5:45",["لَّمۡ","يَحۡكُم","بِمَآ","أَنزَلَ","ٱللَّهُ","فَأُوْلَٰٓئِكَ","هُمُ","ٱلظَّٰلِمُونَ"],"٤٥"]]]],"116":[[1,[["5:46",["وَقَفَّيۡنَا","عَلَىٰٓ","ءَاثَٰرِهِم","بِعِيسَى","ٱبۡنِ","مَرۡيَمَ","مُصَدِّقٗا","لِّمَا","بَيۡنَ","يَدَيۡهِ"]]]],[2,[["5:46",["مِنَ","ٱلتَّوۡرَىٰةِۖ","وَءَاتَيۡنَٰهُ","ٱلۡإِنجِيلَ","فِيهِ","هُدٗى","وَنُورٞ","وَمُصَدِّقٗا"]]]],[3,[["5:46",["لِّمَا","بَيۡنَ","يَدَيۡهِ","مِنَ","ٱلتَّوۡرَىٰةِ","وَهُدٗى","وَمَوۡعِظَةٗ","لِّلۡمُتَّقِينَ"],"٤٦"]]],[4,[["5:47",["وَلۡيَحۡكُمۡ","أَهۡلُ","ٱلۡإِنجِيلِ","بِمَآ","أَنزَلَ","ٱللَّهُ","فِيهِۚ","وَمَن","لَّمۡ","يَحۡكُم"]]]],[5,[["5:47",["بِمَآ","أَنزَلَ","ٱللَّهُ","فَأُوْلَٰٓئِكَ","هُمُ","ٱلۡفَٰسِقُونَ"],"٤٧"],["5:48",["وَأَنزَلۡنَآ","إِلَيۡكَ"]]]],[6,[["5:48",["ٱلۡكِتَٰبَ","بِٱلۡحَقِّ","مُصَدِّقٗا","لِّمَا","بَيۡنَ","يَدَيۡهِ","مِنَ","ٱلۡكِتَٰبِ"]]]],[7,[["5:48",["وَمُهَيۡمِنًا","عَلَيۡهِۖ","فَٱحۡكُم","بَيۡنَهُم","بِمَآ","أَنزَلَ","ٱللَّهُۖ","وَلَا","تَتَّبِعۡ","أَهۡوَآءَهُمۡ"]]]],[8,[["5:48",["عَمَّا","جَآءَكَ","مِنَ","ٱلۡحَقِّۚ","لِكُلّٖ","جَعَلۡنَا","مِنكُمۡ","شِرۡعَةٗ","وَمِنۡهَاجٗاۚ"]]]],[9,[["5:48",["وَلَوۡ","شَآءَ","ٱللَّهُ","لَجَعَلَكُمۡ","أُمَّةٗ","وَٰحِدَةٗ","وَلَٰكِن","لِّيَبۡلُوَكُمۡ"]]]],[10,[["5:48",["فِي","مَآ","ءَاتَىٰكُمۡۖ","فَٱسۡتَبِقُواْ","ٱلۡخَيۡرَٰتِۚ","إِلَى","ٱللَّهِ","مَرۡجِعُكُمۡ","جَمِيعٗا"]]]],[11,[["5:48",["فَيُنَبِّئُكُم","بِمَا","كُنتُمۡ","فِيهِ","تَخۡتَلِفُونَ"],"٤٨"],["5:49",["وَأَنِ","ٱحۡكُم","بَيۡنَهُم"]]]],[12,[["5:49",["بِمَآ","أَنزَلَ","ٱللَّهُ","وَلَا","تَتَّبِعۡ","أَهۡوَآءَهُمۡ","وَٱحۡذَرۡهُمۡ","أَن","يَفۡتِنُوكَ","عَنۢ"]]]],[13,[["5:49",["بَعۡضِ","مَآ","أَنزَلَ","ٱللَّهُ","إِلَيۡكَۖ","فَإِن","تَوَلَّوۡاْ","فَٱعۡلَمۡ","أَنَّمَا","يُرِيدُ","ٱللَّهُ","أَن","يُصِيبَهُم"]]]],[14,[["5:49",["بِبَعۡضِ","ذُنُوبِهِمۡۗ","وَإِنَّ","كَثِيرٗا","مِّنَ","ٱلنَّاسِ","لَفَٰسِقُونَ"],"٤٩"],["5:50",["أَفَحُكۡمَ"]]]],[15,[["5:50",["ٱلۡجَٰهِلِيَّةِ","يَبۡغُونَۚ","وَمَنۡ","أَحۡسَنُ","مِ