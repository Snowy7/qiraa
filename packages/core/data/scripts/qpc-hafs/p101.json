ونَهُنَّ","مِمَّا","عَلَّمَكُمُ","ٱللَّهُۖ","فَكُلُواْ","مِمَّآ","أَمۡسَكۡنَ","عَلَيۡكُمۡ"]]]],[10,[["5:4",["وَٱذۡكُرُواْ","ٱسۡمَ","ٱللَّهِ","عَلَيۡهِۖ","وَٱتَّقُواْ","ٱللَّهَۚ","إِنَّ","ٱللَّهَ","سَرِيعُ","ٱلۡحِسَابِ"],"٤"]]],[11,[["5:5",["ٱلۡيَوۡمَ","أُحِلَّ","لَكُمُ","ٱلطَّيِّبَٰتُۖ","وَطَعَامُ","ٱلَّذِينَ","أُوتُواْ","ٱلۡكِتَٰبَ","حِلّٞ","لَّكُمۡ"]]]],[12,[["5:5",["وَطَعَامُكُمۡ","حِلّٞ","لَّهُمۡۖ","وَٱلۡمُحۡصَنَٰتُ","مِنَ","ٱلۡمُؤۡمِنَٰتِ","وَٱلۡمُحۡصَنَٰتُ"]]]],[13,[["5:5",["مِنَ","ٱلَّذِينَ","أُوتُواْ","ٱلۡكِتَٰبَ","مِن","قَبۡلِكُمۡ","إِذَآ","ءَاتَيۡتُمُوهُنَّ","أُجُورَهُنَّ"]]]],[14,[["5:5",["مُحۡصِنِينَ","غَيۡرَ","مُسَٰفِحِينَ","وَلَا","مُتَّخِذِيٓ","أَخۡدَانٖۗ","وَمَن","يَكۡفُرۡ"]]]],[15,[["5:5",["بِٱلۡإِيمَٰنِ","فَقَدۡ","حَبِطَ","عَمَلُهُۥ","وَهُوَ","فِي","ٱلۡأٓخِرَةِ","مِنَ","ٱلۡخَٰسِرِينَ"],"٥"]]]],"108":[[1,[["5:6",["يَٰٓأَيُّهَا","ٱلَّذِينَ","ءَامَنُوٓاْ","إِذَا","قُمۡتُمۡ","إِلَى","ٱلصَّلَوٰةِ","فَٱغۡسِلُواْ"]]]],[2,[["5:6",["وُجُوهَكُمۡ","وَأَيۡدِيَكُمۡ","إِلَى","ٱلۡمَرَافِقِ","وَٱمۡسَحُواْ","بِرُءُوسِكُمۡ"]]]],[3,[["5:6",["وَأَرۡجُلَكُمۡ","إِلَى","ٱلۡكَعۡبَيۡنِۚ","وَإِن","كُنتُمۡ","جُنُبٗا","فَٱطَّهَّرُواْۚ"]]]],[4,[["5:6",["وَإِن","كُنتُم","مَّرۡضَىٰٓ","أَوۡ","عَلَىٰ","سَفَرٍ","أَوۡ","جَآءَ","أَحَدٞ","مِّنكُم","مِّنَ"]]]],[5,[["5:6",["ٱلۡغَآئِطِ","أَوۡ","لَٰمَسۡتُمُ","ٱلنِّسَآءَ","فَلَمۡ","تَجِدُواْ","مَآءٗ","فَتَيَمَّمُواْ","صَعِيدٗا"]]]],[6,[["5:6",["طَيِّبٗا","فَٱمۡسَحُواْ","بِوُجُوهِكُمۡ","وَأَيۡدِيكُم","مِّنۡهُۚ","مَا","يُرِيدُ","ٱللَّهُ"]]]],[7,[["5:6",["لِيَجۡعَلَ","عَلَيۡكُم","مِّنۡ","حَرَجٖ","وَلَٰكِن","يُرِيدُ","لِيُطَهِّرَكُمۡ"]]]],[8,[["5:6",["وَلِيُتِمَّ","نِعۡمَتَهُۥ","عَلَيۡكُمۡ","لَعَلَّكُمۡ","تَشۡكُرُونَ"],"٦"]]],[9,[["5:7",["وَٱذۡكُرُواْ","نِعۡمَةَ","ٱللَّهِ","عَلَيۡكُمۡ","وَمِيثَٰقَهُ","ٱلَّذِي","وَاثَقَكُم"]]]],[10,[["5:7",["بِهِۦٓ","إِذۡ","قُلۡتُمۡ","سَمِعۡنَا","وَأَطَعۡنَاۖ","وَٱتَّقُواْ","ٱللَّهَۚ","إِنَّ","ٱللَّهَ","عَلِيمُۢ"]]]],[11,[["5:7",["بِذَاتِ","ٱلصُّدُورِ"],"٧"],["5:8",["يَٰٓأَيُّهَا","ٱلَّذِينَ","ءَامَنُواْ","كُونُواْ","قَوَّٰمِينَ"]]]],[12,[["5:8",["لِلَّهِ","شُهَدَآءَ","بِٱلۡقِسۡطِۖ","وَلَا","يَجۡرِمَنَّكُمۡ","شَنَـَٔانُ","قَوۡمٍ","عَلَىٰٓ"]]]],[13,[["5:8",["أَلَّا","تَعۡدِلُواْۚ","ٱعۡدِلُواْ","هُوَ","أَقۡرَبُ","لِلتَّقۡوَىٰۖ","وَٱتَّقُواْ","ٱللَّهَۚ","إِنَّ"]]]],[14,[["5:8",["ٱللَّهَ","خَبِيرُۢ","بِمَا","تَعۡمَلُونَ"],"٨"],["5:9",["وَعَدَ","ٱللَّهُ","ٱلَّذِينَ","ءَامَنُواْ"]]]],[15,[["5:9",["وَعَمِلُواْ","ٱلصَّٰلِحَٰتِ","لَهُم","مَّغۡفِرَةٞ","وَأَجۡرٌ","عَظِيمٞ"],"٩"]]]],"109":[[1,[["5:10",["وَٱلَّذِينَ","كَفَرُواْ","وَكَذَّبُواْ","بِـَٔايَٰتِنَآ","أُوْلَٰٓئِكَ","أَصۡحَٰبُ"]]]],[2,[["5:10",["ٱلۡجَحِيمِ"],"١٠"],["5:11",["يَٰٓأَيُّهَا","ٱلَّذِينَ","ءَامَنُواْ","ٱذۡكُرُواْ","نِعۡمَتَ"]]]],[3,[["5:11",["ٱللَّهِ","عَلَيۡكُمۡ","إِذۡ","هَمَّ","قَوۡمٌ","أَن","يَبۡسُطُوٓاْ","إِلَيۡكُمۡ","أَيۡدِيَهُمۡ"]]]],[4,[["5:11",["فَكَفَّ","أَيۡدِيَهُمۡ","عَنكُمۡۖ","وَٱتَّقُواْ","ٱللَّهَۚ","وَعَلَى","ٱللَّهِ","فَلۡيَتَوَكَّلِ"]]]],[5,[["5:11",["ٱلۡمُؤۡمِنُونَ"],"١١"],["5:12",["۞ وَلَقَدۡ","أَخَذَ","ٱللَّهُ","مِيثَٰقَ","بَنِيٓ","إِسۡرَٰٓءِيلَ"]]]],[6,[["5:12",["وَبَعَثۡنَا","مِنۡهُمُ","ٱثۡنَيۡ","عَشَرَ","نَقِيبٗاۖ","وَقَالَ","ٱللَّهُ","إِنِّي"]]]],[7,[["5:12",["مَعَكُمۡۖ","لَئِنۡ","أَقَمۡتُمُ","ٱلصَّلَوٰةَ","وَءَاتَيۡتُمُ","ٱلزَّكَوٰةَ"]]]],[8,[["5:12",["وَءَامَنتُم","بِرُسُلِي","وَعَزَّرۡتُمُوهُمۡ","وَأَقۡرَضۡتُمُ","ٱللَّهَ","قَرۡضًا"]]]],[9,[["5:12",["حَسَنٗا","لَّأُكَفِّرَنَّ","عَنكُمۡ","سَيِّـَٔاتِكُمۡ","وَلَأُدۡخِلَنَّكُمۡ"]]]],[10,[["5:12",["جَنَّٰتٖ","تَجۡرِي","مِن","تَحۡتِهَا","ٱلۡأَنۡهَٰرُۚ","فَمَن","كَفَرَ","بَعۡدَ","ذَٰلِكَ"]]]],[11,[["5:12",["مِنكُمۡ","فَقَدۡ","ضَلَّ","سَوَآءَ","ٱلسَّبِيلِ"],"١٢"],["5:13",["فَبِمَا","نَقۡضِهِم"]]]],[12,[["5:13",["مِّيثَٰقَهُمۡ","لَعَنَّٰهُمۡ","وَجَعَلۡنَا","قُلُوبَهُمۡ","قَٰسِيَةٗۖ","يُحَرِّفُونَ"]]]],[13,[["5:13",["ٱلۡكَلِمَ","عَن","مَّوَاضِعِهِۦ","وَنَسُواْ","حَظّٗا","مِّمَّا","ذُكِّرُواْ"]]]],[14,[["5:13",["بِهِۦۚ","وَلَا","تَزَالُ","تَطَّلِعُ","عَلَىٰ","خَآئِنَةٖ","مِّنۡهُمۡ","إِلَّا","قَلِيلٗا","مِّنۡهُمۡۖ"]]]],[15,[["5:13",["فَٱعۡفُ