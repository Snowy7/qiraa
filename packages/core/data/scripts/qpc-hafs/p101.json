"لَّكُمۡۚ","إِنَّمَا","ٱللَّهُ"]]]],[5,[["4:171",["إِلَٰهٞ","وَٰحِدٞۖ","سُبۡحَٰنَهُۥٓ","أَن","يَكُونَ","لَهُۥ","وَلَدٞۘ","لَّهُۥ","مَا","فِي","ٱلسَّمَٰوَٰتِ"]]]],[6,[["4:171",["وَمَا","فِي","ٱلۡأَرۡضِۗ","وَكَفَىٰ","بِٱللَّهِ","وَكِيلٗا"],"١٧١"],["4:172",["لَّن","يَسۡتَنكِفَ"]]]],[7,[["4:172",["ٱلۡمَسِيحُ","أَن","يَكُونَ","عَبۡدٗا","لِّلَّهِ","وَلَا","ٱلۡمَلَٰٓئِكَةُ","ٱلۡمُقَرَّبُونَۚ"]]]],[8,[["4:172",["وَمَن","يَسۡتَنكِفۡ","عَنۡ","عِبَادَتِهِۦ","وَيَسۡتَكۡبِرۡ","فَسَيَحۡشُرُهُمۡ"]]]],[9,[["4:172",["إِلَيۡهِ","جَمِيعٗا"],"١٧٢"],["4:173",["فَأَمَّا","ٱلَّذِينَ","ءَامَنُواْ","وَعَمِلُواْ","ٱلصَّٰلِحَٰتِ"]]]],[10,[["4:173",["فَيُوَفِّيهِمۡ","أُجُورَهُمۡ","وَيَزِيدُهُم","مِّن","فَضۡلِهِۦۖ","وَأَمَّا","ٱلَّذِينَ"]]]],[11,[["4:173",["ٱسۡتَنكَفُواْ","وَٱسۡتَكۡبَرُواْ","فَيُعَذِّبُهُمۡ","عَذَابًا","أَلِيمٗا","وَلَا"]]]],[12,[["4:173",["يَجِدُونَ","لَهُم","مِّن","دُونِ","ٱللَّهِ","وَلِيّٗا","وَلَا","نَصِيرٗا"],"١٧٣"],["4:174",["يَٰٓأَيُّهَا","ٱلنَّاسُ"]]]],[13,[["4:174",["قَدۡ","جَآءَكُم","بُرۡهَٰنٞ","مِّن","رَّبِّكُمۡ","وَأَنزَلۡنَآ","إِلَيۡكُمۡ","نُورٗا","مُّبِينٗا"]]]],[14,[["4:174",[],"١٧٤"],["4:175",["فَأَمَّا","ٱلَّذِينَ","ءَامَنُواْ","بِٱللَّهِ","وَٱعۡتَصَمُواْ","بِهِۦ","فَسَيُدۡخِلُهُمۡ","فِي"]]]],[15,[["4:175",["رَحۡمَةٖ","مِّنۡهُ","وَفَضۡلٖ","وَيَهۡدِيهِمۡ","إِلَيۡهِ","صِرَٰطٗا","مُّسۡتَقِيمٗا"],"١٧٥"]]]],"106":[[1,[["4:176",["يَسۡتَفۡتُونَكَ","قُلِ","ٱللَّهُ","يُفۡتِيكُمۡ","فِي","ٱلۡكَلَٰلَةِۚ","إِنِ","ٱمۡرُؤٌاْ","هَلَكَ"]]]],[2,[["4:176",["لَيۡسَ","لَهُۥ","وَلَدٞ","وَلَهُۥٓ","أُخۡتٞ","فَلَهَا","نِصۡفُ","مَا","تَرَكَۚ","وَهُوَ","يَرِثُهَآ","إِن"]]]],[3,[["4:176",["لَّمۡ","يَكُن","لَّهَا","وَلَدٞۚ","فَإِن","كَانَتَا","ٱثۡنَتَيۡنِ","فَلَهُمَا","ٱلثُّلُثَانِ","مِمَّا","تَرَكَۚ"]]]],[4,[["4:176",["وَإِن","كَانُوٓاْ","إِخۡوَةٗ","رِّجَالٗا","وَنِسَآءٗ","فَلِلذَّكَرِ","مِثۡلُ","حَظِّ","ٱلۡأُنثَيَيۡنِۗ"]]]],[5,[["4:176",["يُبَيِّنُ","ٱللَّهُ","لَكُمۡ","أَن","تَضِلُّواْۗ","وَٱللَّهُ","بِكُلِّ","شَيۡءٍ","عَلِيمُۢ"],"١٧٦"]]],[8,[["5:1",["يَٰٓأَيُّهَا","ٱلَّذِينَ","ءَامَ