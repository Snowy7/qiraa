{"101":[[1,[["4:141",["ٱلَّذِينَ","يَتَرَبَّصُونَ","بِكُمۡ","فَإِن","كَانَ","لَكُمۡ","فَتۡحٞ","مِّنَ","ٱللَّهِ","قَالُوٓاْ"]]]],[2,[["4:141",["أَلَمۡ","نَكُن","مَّعَكُمۡ","وَإِن","كَانَ","لِلۡكَٰفِرِينَ","نَصِيبٞ","قَالُوٓاْ"]]]],[3,[["4:141",["أَلَمۡ","نَسۡتَحۡوِذۡ","عَلَيۡكُمۡ","وَنَمۡنَعۡكُم","مِّنَ","ٱلۡمُؤۡمِنِينَۚ","فَٱللَّهُ","يَحۡكُمُ"]]]],[4,[["4:141",["بَيۡنَكُمۡ","يَوۡمَ","ٱلۡقِيَٰمَةِۚ","وَلَن","يَجۡعَلَ","ٱللَّهُ","لِلۡكَٰفِرِينَ","عَلَى","ٱلۡمُؤۡمِنِينَ"]]]],[5,[["4:141",["سَبِيلًا"],"١٤١"],["4:142",["إِنَّ","ٱلۡمُنَٰفِقِينَ","يُخَٰدِعُونَ","ٱللَّهَ","وَهُوَ","خَٰدِعُهُمۡ","وَإِذَا"]]]],[6,[["4:142",["قَامُوٓاْ","إِلَى","ٱلصَّلَوٰةِ","قَامُواْ","كُسَالَىٰ","يُرَآءُونَ","ٱلنَّاسَ","وَلَا","يَذۡكُرُونَ"]]]],[7,[["4:142",["ٱللَّهَ","إِلَّا","قَلِيلٗا"],"١٤٢"],["4:143",["مُّذَبۡذَبِينَ","بَيۡنَ","ذَٰلِكَ","لَآ","إِلَىٰ","هَٰٓؤُلَآءِ","وَلَآ","إِلَىٰ"]]]],[8,[["4:143",["هَٰٓؤُلَآءِۚ","وَمَن","يُضۡلِلِ","ٱللَّهُ","فَلَن","تَجِدَ","لَهُۥ","سَبِيلٗا"],"١٤٣"],["4:144",["يَٰٓأَيُّهَا","ٱلَّذِينَ"]]]],[9,[["4:144",["ءَامَنُواْ","لَا","تَتَّخِذُواْ","ٱلۡكَٰفِرِينَ","أَوۡلِيَآءَ","مِن","دُونِ","ٱلۡمُؤۡمِنِينَۚ"]]]],[10,[["4:144",["أَتُرِيدُونَ","أَن","تَجۡعَلُواْ","لِلَّهِ","عَلَيۡكُمۡ","سُلۡطَٰنٗا","مُّبِينًا"],"١٤٤"],["4:145",["إِنَّ"]]]],[11,[["4:145",["ٱلۡمُنَٰفِقِينَ","فِي","ٱلدَّرۡكِ","ٱلۡأَسۡفَلِ","مِنَ","ٱلنَّارِ","وَلَن","تَجِدَ","لَهُمۡ","نَصِيرًا"]]]],[12,[["4:145",[],"١٤٥"],["4:146",["إِلَّا","ٱلَّذِينَ","تَابُواْ","وَأَصۡلَحُواْ","وَٱعۡتَصَمُواْ","بِٱللَّهِ","وَأَخۡلَصُواْ"]]]],[13,[["4:146",["دِينَهُمۡ","لِلَّهِ","فَأُوْلَٰٓئِكَ","مَعَ","ٱلۡمُؤۡمِنِينَۖ","وَسَوۡفَ","يُؤۡتِ","ٱللَّهُ"]]]],[14,[["4:146",["ٱلۡمُؤۡمِنِينَ","أَجۡرًا","عَظِيمٗا"],"١٤٦"],["4:147",["مَّا","يَفۡعَلُ","ٱللَّهُ","بِعَذَابِكُمۡ"]]]],[15,[["4:147",["إِن","شَكَرۡتُمۡ","وَءَامَنتُمۡۚ","وَكَانَ","ٱللَّهُ","شَاكِرًا","عَلِيمٗا"],"١٤٧"]]]],"102":[[1,[["4:148",["۞ لَّا","يُحِبُّ","ٱللَّهُ","ٱلۡجَهۡرَ","بِٱلسُّوٓءِ","مِنَ","ٱلۡقَوۡلِ","إِلَّا","مَن","ظُلِمَۚ","وَكَانَ"]]]],[2,[["4:148",["ٱللَّهُ","سَمِيعًا","عَلِيمًا"],"١٤٨"],["4:149",["إِن","تُبۡدُواْ","خَيۡرًا","أَوۡ","تُخۡفُوهُ","أَوۡ","تَعۡفُواْ","عَن"]]]],[3,[["4:149",["سُوٓءٖ","فَإِنَّ","ٱللَّهَ","كَانَ","عَفُوّٗا","قَدِيرًا"],"١٤٩"],["4:150",["إِنَّ","ٱلَّذِينَ","يَكۡفُرُونَ"]]]],[4,[["4:150",["بِٱللَّهِ","وَرُسُلِهِۦ","وَيُرِيدُونَ","أَن","يُفَرِّقُواْ","بَيۡنَ","ٱللَّهِ","وَرُسُلِهِۦ","وَيَقُولُونَ"]]]],[5,[["4:150",["نُؤۡمِنُ","بِبَعۡضٖ","وَنَكۡفُرُ","بِبَعۡضٖ","وَيُرِيدُونَ","أَن","يَتَّخِذُواْ"]]]],[6,[["4:150",["بَيۡنَ","ذَٰلِكَ","سَبِيلًا"],"١٥٠"],["4:151",["أُوْلَٰٓئِكَ","هُمُ","ٱلۡكَٰفِرُونَ","حَقّٗاۚ","وَأَعۡتَدۡنَا"]]]],[7,[["4:151",["لِلۡكَٰفِرِينَ","عَذَابٗا","مُّهِينٗا"],"١٥١"],["4:152",["وَٱلَّذِينَ","ءَامَنُواْ","بِٱللَّهِ","وَرُسُلِهِۦ"]]]],[8,[["4:152",["وَلَمۡ","يُفَرِّقُواْ","بَيۡنَ","أَحَدٖ","مِّنۡهُمۡ","أُوْلَٰٓئِكَ","سَوۡفَ","يُؤۡتِيهِمۡ"]]]],[9,[["4:152",["أُجُورَهُمۡۚ","وَكَانَ","ٱللَّهُ","غَفُورٗا","رَّحِيمٗا"],"١٥٢"],["4:153",["يَسۡـَٔلُكَ","أَهۡلُ","ٱلۡكِتَٰبِ"]]]],[10,[["4:153",["أَن","تُنَزِّلَ","عَلَيۡهِمۡ","كِتَٰبٗا","مِّنَ","ٱلسَّمَآءِۚ","فَقَدۡ","سَأَلُواْ","مُوسَىٰٓ","أَكۡبَرَ"]]]],[11,[["4:153",["مِن","ذَٰلِكَ","فَقَالُوٓاْ","أَرِنَا","ٱللَّهَ","جَهۡرَةٗ","فَأَخَذَتۡهُمُ","ٱلصَّٰعِقَةُ","بِظُلۡمِهِمۡۚ"]]]],[12,[["4:153",["ثُمَّ","ٱتَّخَذُواْ","ٱلۡعِجۡلَ","مِنۢ","بَعۡدِ","مَا","جَآءَتۡهُمُ","ٱلۡبَيِّنَٰتُ","فَعَفَوۡنَا"]]]],[13,[["4:153",["عَن","ذَٰلِكَۚ","وَءَاتَيۡنَا","مُوسَىٰ","سُلۡطَٰنٗا","مُّبِينٗا"],"١٥٣"],["4:154",["وَرَفَعۡنَا","فَوۡقَهُمُ"]]]],[14,[["4:154",["ٱلطُّورَ","بِمِيثَٰقِهِمۡ","وَقُلۡنَا","لَهُمُ","ٱدۡخُلُواْ","ٱلۡبَابَ","سُجَّدٗا","وَقُلۡنَا"]]]],[15,[["4:154",["لَهُمۡ","لَا","تَعۡدُواْ","فِي","ٱلسَّبۡتِ","وَأَخَذۡنَا","مِنۡهُم","مِّيثَٰقًا","غَلِيظٗا"],"١٥٤"]]]],"103":[[1,[["4:155",["فَبِمَا","نَقۡضِهِم","مِّيثَٰقَهُمۡ","وَكُفۡرِهِم","بِـَٔايَٰتِ","ٱللَّهِ","وَقَتۡلِهِمُ","ٱلۡأَنۢبِيَآءَ"]]]],[2,[["4:155",["بِغَيۡرِ","حَقّٖ","وَقَوۡلِهِمۡ","قُلُوبُنَا","غُلۡفُۢۚ","بَلۡ","طَبَعَ","ٱللَّهُ","عَلَيۡهَا","بِكُفۡرِهِمۡ"]]]],[3,[["4:155",["فَلَا","يُؤۡمِنُونَ","إِلَّا","قَلِيلٗا"],"١٥٥"],["4:156",["وَبِكُفۡرِهِمۡ","وَقَوۡلِهِمۡ","عَلَىٰ","مَرۡيَمَ","بُهۡتَٰنًا"]]]],[4,[["4:156",["عَظِيمٗا"],"١٥٦"],["4:157",["وَقَوۡلِهِمۡ","إِنَّا","قَتَلۡنَا","ٱلۡمَسِيحَ","عِيسَى","ٱبۡنَ","مَرۡيَمَ","رَسُولَ"]]]],[5,[["4:157",["ٱللَّهِ","وَمَا","قَتَلُوهُ","وَمَا","صَلَبُوهُ","وَلَٰكِن","شُبِّهَ","لَهُمۡۚ","وَإِنَّ","ٱلَّذِينَ"]]]],[6,[["4:157",["ٱخۡتَلَفُواْ","فِيهِ","لَفِي","شَكّٖ","مِّنۡهُۚ","مَا","لَهُم","بِهِۦ","مِنۡ","عِلۡمٍ","إِلَّا","ٱتِّبَاعَ","ٱلظَّنِّۚ"]]]],[7,[["4:157",["وَمَا","قَتَلُوهُ","يَقِينَۢا"],"١٥٧"],["4:158",["بَل","رَّفَعَهُ","ٱللَّهُ","إِلَيۡهِۚ","وَكَانَ","ٱللَّهُ","عَزِيزًا","حَكِيمٗا"]]]],[8,[["4:158",[],"١٥٨"],["4:159",["وَإِن","مِّنۡ","أَهۡلِ","ٱلۡكِتَٰبِ","إِلَّا","لَيُؤۡمِنَنَّ","بِهِۦ","قَبۡلَ","مَوۡتِهِۦۖ","وَيَوۡمَ"]]]],[9,[["4:159",["ٱلۡقِيَٰمَةِ","يَكُونُ","عَلَيۡهِمۡ","شَهِيدٗا"],"١٥٩"],["4:160",["فَبِظُلۡمٖ","مِّنَ","ٱلَّذِينَ","هَادُواْ"]]]],[10,[["4:160",["حَرَّمۡنَا","عَلَيۡهِمۡ","طَيِّبَٰتٍ","أُحِلَّتۡ","لَهُمۡ","وَبِصَدِّهِمۡ","عَن","سَبِيلِ","ٱللَّهِ"]]]],[11,[["4:160",["كَثِيرٗا"],"١٦٠"],["4:161",["وَأَخۡذِهِمُ","ٱلرِّبَوٰاْ","وَقَدۡ","نُهُواْ","عَنۡهُ","وَأَكۡلِهِمۡ","أَمۡوَٰلَ"]]]],[12,[["4:161",["ٱلنَّاسِ","بِٱلۡبَٰطِلِۚ","وَأَعۡتَدۡنَا","لِلۡكَٰفِرِينَ","مِنۡهُمۡ","عَذَابًا","أَلِيمٗا"],"١٦١"],["4:162",["لَّٰكِنِ"]]]],[13,[["4:162",["ٱلرَّٰسِخُونَ","فِي","ٱلۡعِلۡمِ","مِنۡهُمۡ","وَٱلۡمُؤۡمِنُونَ","يُؤۡمِنُونَ","بِمَآ","أُنزِلَ","إِلَيۡكَ"]]]],[14,[["4:162",["وَمَآ","أُنزِلَ","مِن","قَبۡلِكَۚ","وَٱلۡمُقِيمِينَ","ٱلصَّلَوٰةَۚ","وَٱلۡمُؤۡتُونَ","ٱلزَّكَوٰةَ"]]]],[15,[["4:162",["وَٱلۡمُؤۡمِنُونَ","بِٱللَّهِ","وَٱلۡيَوۡمِ","ٱلۡأٓخِرِ","أُوْلَٰٓئِكَ","سَنُؤۡتِيهِمۡ","أَجۡرًا","عَظِيمًا"],"١٦٢"]]]],"104":[[1,[["4:163",["۞ إِنَّآ","أَوۡحَيۡنَآ","إِلَيۡكَ","كَمَآ","أَوۡحَيۡنَآ","إِلَىٰ","نُوحٖ","وَٱلنَّبِيِّـۧنَ","مِنۢ","بَعۡدِهِۦۚ"]]]],[2,[["4:163",["وَأَوۡحَيۡنَآ","إِلَىٰٓ","إِبۡرَٰهِيمَ","وَإِسۡمَٰعِيلَ","وَإِسۡحَٰقَ","وَيَعۡقُوبَ"]]]],[3,[["4:163",["وَٱلۡأَسۡبَاط