11:31",["إِذٗا","لَّمِنَ","ٱلظَّٰلِمِينَ"],"٣١"],["11:32",["قَالُواْ","يَٰنُوحُ","قَدۡ","جَٰدَلۡتَنَا","فَأَكۡثَرۡتَ","جِدَٰلَنَا"]]]],[8,[["11:32",["فَأۡتِنَا","بِمَا","تَعِدُنَآ","إِن","كُنتَ","مِنَ","ٱلصَّٰدِقِينَ"],"٣٢"],["11:33",["قَالَ","إِنَّمَا"]]]],[9,[["11:33",["يَأۡتِيكُم","بِهِ","ٱللَّهُ","إِن","شَآءَ","وَمَآ","أَنتُم","بِمُعۡجِزِينَ"],"٣٣"],["11:34",["وَلَا","يَنفَعُكُمۡ"]]]],[10,[["11:34",["نُصۡحِيٓ","إِنۡ","أَرَدتُّ","أَنۡ","أَنصَحَ","لَكُمۡ","إِن","كَانَ","ٱللَّهُ","يُرِيدُ","أَن"]]]],[11,[["11:34",["يُغۡوِيَكُمۡۚ","هُوَ","رَبُّكُمۡ","وَإِلَيۡهِ","تُرۡجَعُونَ"],"٣٤"],["11:35",["أَمۡ","يَقُولُونَ","ٱفۡتَرَىٰهُۖ"]]]],[12,[["11:35",["قُلۡ","إِنِ","ٱفۡتَرَيۡتُهُۥ","فَعَلَيَّ","إِجۡرَامِي","وَأَنَا۠","بَرِيٓءٞ","مِّمَّا","تُجۡرِمُونَ"]]]],[13,[["11:35",[],"٣٥"],["11:36",["وَأُوحِيَ","إِلَىٰ","نُوحٍ","أَنَّهُۥ","لَن","يُؤۡمِنَ","مِن","قَوۡمِكَ","إِلَّا","مَن","قَدۡ","ءَامَنَ"]]]],[14,[["11:36",["فَلَا","تَبۡتَئِسۡ","بِمَا","كَانُواْ","يَفۡعَلُونَ"],"٣٦"],["11:37",["وَٱصۡنَعِ","ٱلۡفُلۡكَ","بِأَعۡيُنِنَا"]]]],[15,[["11:37",["وَوَحۡيِنَا","وَلَا","تُخَٰطِبۡنِي","فِي","ٱلَّذِينَ","ظَلَمُوٓاْ","إِنَّهُم","مُّغۡرَقُونَ"],"٣٧"]]]],"226":[[1,[["11:38",["وَيَصۡنَعُ","ٱلۡفُلۡكَ","وَكُلَّمَا","مَرَّ","عَلَيۡهِ","مَلَأٞ","مِّن","قَوۡمِهِۦ","سَخِرُواْ","مِنۡهُۚ"]]]],[2,[["11:38",["قَالَ","إِن","تَسۡخَرُواْ","مِنَّا","فَإِنَّا","نَسۡخَرُ","مِنكُمۡ","كَمَا","تَسۡخَرُونَ"]]]],[3,[["11:38",[],"٣٨"],["11:39",["فَسَوۡفَ","تَعۡلَمُونَ","مَن","يَأۡتِيهِ","عَذَابٞ","يُخۡزِيهِ","وَيَحِلُّ","عَلَيۡهِ","عَذَابٞ"]]]],[4,[["11:39",["مُّقِيمٌ"],"٣٩"],["11:40",["حَتَّىٰٓ","إِذَا","جَآءَ","أَمۡرُنَا","وَفَارَ","ٱلتَّنُّورُ","قُلۡنَا","ٱحۡمِلۡ","فِيهَا"]]]],[5,[["11:40",["مِن","كُلّٖ","زَوۡجَيۡنِ","ٱثۡنَيۡنِ","وَأَهۡلَكَ","إِلَّا","مَن","سَبَقَ","عَلَيۡهِ","ٱلۡقَوۡلُ"]]]],[6,[["11:40",["وَمَنۡ","ءَامَنَۚ","وَمَآ","ءَامَنَ","مَعَهُۥٓ","إِلَّا","قَلِيلٞ"],"٤٠"],["11:41",["۞ وَقَالَ","ٱرۡكَبُواْ"]]]],[7,[["11:41",["فِيهَا","بِسۡمِ","ٱللَّهِ","مَجۡر۪ىٰهَا","وَمُرۡسَىٰهَآۚ","إِنَّ","رَ