{"221":[[1,[["10:107",["وَإِن","يَمۡسَسۡكَ","ٱللَّهُ","بِضُرّٖ","فَلَا","كَاشِفَ","لَهُۥٓ","إِلَّا","هُوَۖ","وَإِن","يُرِدۡكَ"]]]],[2,[["10:107",["بِخَيۡرٖ","فَلَا","رَآدَّ","لِفَضۡلِهِۦۚ","يُصِيبُ","بِهِۦ","مَن","يَشَآءُ","مِنۡ","عِبَادِهِۦۚ"]]]],[3,[["10:107",["وَهُوَ","ٱلۡغَفُورُ","ٱلرَّحِيمُ"],"١٠٧"],["10:108",["قُلۡ","يَٰٓأَيُّهَا","ٱلنَّاسُ","قَدۡ","جَآءَكُمُ","ٱلۡحَقُّ"]]]],[4,[["10:108",["مِن","رَّبِّكُمۡۖ","فَمَنِ","ٱهۡتَدَىٰ","فَإِنَّمَا","يَهۡتَدِي","لِنَفۡسِهِۦۖ","وَمَن","ضَلَّ"]]]],[5,[["10:108",["فَإِنَّمَا","يَضِلُّ","عَلَيۡهَاۖ","وَمَآ","أَنَا۠","عَلَيۡكُم","بِوَكِيلٖ"],"١٠٨"],["10:109",["وَٱتَّبِعۡ","مَا","يُوحَىٰٓ"]]]],[6,[["10:109",["إِلَيۡكَ","وَٱصۡبِرۡ","حَتَّىٰ","يَحۡكُمَ","ٱللَّهُۚ","وَهُوَ","خَيۡرُ","ٱلۡحَٰكِمِينَ"],"١٠٩"]]],[9,[["11:1",["الٓرۚ","كِتَٰبٌ","أُحۡكِمَتۡ","ءَايَٰتُهُۥ","ثُمَّ","فُصِّلَتۡ","مِن","لَّدُنۡ","حَكِيمٍ","خَبِيرٍ"],"١"]]],[10,[["11:2",["أَلَّا","تَعۡبُدُوٓاْ","إِلَّا","ٱللَّهَۚ","إِنَّنِي","لَكُم","مِّنۡهُ","نَذِيرٞ","وَبَشِيرٞ"],"٢"],["11:3",["وَأَنِ","ٱسۡتَغۡفِرُواْ"]]]],[11,[["11:3",["رَبَّكُمۡ","ثُمَّ","تُوبُوٓاْ","إِلَيۡهِ","يُمَتِّعۡكُم","مَّتَٰعًا","حَسَنًا","إِلَىٰٓ","أَجَلٖ","مُّسَمّٗى","وَيُؤۡتِ"]]]],[12,[["11:3",["كُلَّ","ذِي","فَضۡلٖ","فَضۡلَهُۥۖ","وَإِن","تَوَلَّوۡاْ","فَإِنِّيٓ","أَخَافُ","عَلَيۡكُمۡ","عَذَابَ","يَوۡمٖ"]]]],[13,[["11:3",["كَبِيرٍ"],"٣"],["11:4",["إِلَى","ٱللَّهِ","مَرۡجِعُكُمۡۖ","وَهُوَ","عَلَىٰ","كُلِّ","شَيۡءٖ","قَدِيرٌ"],"٤"],["11:5",["أَلَآ","إِنَّهُمۡ"]]]],[14,[["11:5",["يَثۡنُونَ","صُدُورَهُمۡ","لِيَسۡتَخۡفُواْ","مِنۡهُۚ","أَلَا","حِينَ","يَسۡتَغۡشُونَ","ثِيَابَهُمۡ"]]]],[15,[["11:5",["يَعۡلَمُ","مَا","يُسِرُّونَ","وَمَا","يُعۡلِنُونَۚ","إِنَّهُۥ","عَلِيمُۢ","بِذَاتِ","ٱلصُّدُورِ"],"٥"]]]],"222":[[1,[["11:6",["۞ وَمَا","مِن","دَآبَّةٖ","فِي","ٱلۡأَرۡضِ","إِلَّا","عَلَى","ٱللَّهِ","رِزۡقُهَا","وَيَعۡلَمُ"]]]],[2,[["11:6",["مُسۡتَقَرَّهَا","وَمُسۡتَوۡدَعَهَاۚ","كُلّٞ","فِي","كِتَٰبٖ","مُّبِينٖ"],"٦"],["11:7",["وَهُوَ"]]]],[3,[["11:7",["ٱلَّذِي","خَلَقَ","ٱلسَّمَٰوَٰتِ","وَٱلۡأَرۡ