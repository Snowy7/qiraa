إِنَّ","ٱلشَّيۡطَٰنَ","لِلۡإِنسَٰنِ","عَدُوّٞ","مُّبِينٞ"],"٥"],["12:6",["وَكَذَٰلِكَ","يَجۡتَبِيكَ"]]]],[3,[["12:6",["رَبُّكَ","وَيُعَلِّمُكَ","مِن","تَأۡوِيلِ","ٱلۡأَحَادِيثِ","وَيُتِمُّ","نِعۡمَتَهُۥ","عَلَيۡكَ"]]]],[4,[["12:6",["وَعَلَىٰٓ","ءَالِ","يَعۡقُوبَ","كَمَآ","أَتَمَّهَا","عَلَىٰٓ","أَبَوَيۡكَ","مِن","قَبۡلُ","إِبۡرَٰهِيمَ"]]]],[5,[["12:6",["وَإِسۡحَٰقَۚ","إِنَّ","رَبَّكَ","عَلِيمٌ","حَكِيمٞ"],"٦"],["12:7",["۞ لَّقَدۡ","كَانَ","فِي","يُوسُفَ"]]]],[6,[["12:7",["وَإِخۡوَتِهِۦٓ","ءَايَٰتٞ","لِّلسَّآئِلِينَ"],"٧"],["12:8",["إِذۡ","قَالُواْ","لَيُوسُفُ","وَأَخُوهُ","أَحَبُّ"]]]],[7,[["12:8",["إِلَىٰٓ","أَبِينَا","مِنَّا","وَنَحۡنُ","عُصۡبَةٌ","إِنَّ","أَبَانَا","لَفِي","ضَلَٰلٖ","مُّبِينٍ"],"٨"]]],[8,[["12:9",["ٱقۡتُلُواْ","يُوسُفَ","أَوِ","ٱطۡرَحُوهُ","أَرۡضٗا","يَخۡلُ","لَكُمۡ","وَجۡهُ","أَبِيكُمۡ"]]]],[9,[["12:9",["وَتَكُونُواْ","مِنۢ","بَعۡدِهِۦ","قَوۡمٗا","صَٰلِحِينَ"],"٩"],["12:10",["قَالَ","قَآئِلٞ","مِّنۡهُمۡ"]]]],[10,[["12:10",["لَا","تَقۡتُلُواْ","يُوسُفَ","وَأَلۡقُوهُ","فِي","غَيَٰبَتِ","ٱلۡجُبِّ","يَلۡتَقِطۡهُ","بَعۡضُ"]]]],[11,[["12:10",["ٱلسَّيَّارَةِ","إِن","كُنتُمۡ","فَٰعِلِينَ"],"١٠"],["12:11",["قَالُواْ","يَٰٓأَبَانَا","مَا","لَكَ","لَا","تَأۡمَ۬نَّا","عَلَىٰ"]]]],[12,[["12:11",["يُوسُفَ","وَإِنَّا","لَهُۥ","لَنَٰصِحُونَ"],"١١"],["12:12",["أَرۡسِلۡهُ","مَعَنَا","غَدٗا","يَرۡتَعۡ","وَيَلۡعَبۡ"]]]],[13,[["12:12",["وَإِنَّا","لَهُۥ","لَحَٰفِظُونَ"],"١٢"],["12:13",["قَالَ","إِنِّي","لَيَحۡزُنُنِيٓ","أَن","تَذۡهَبُواْ","بِهِۦ","وَأَخَافُ"]]]],[14,[["12:13",["أَن","يَأۡكُلَهُ","ٱلذِّئۡبُ","وَأَنتُمۡ","عَنۡهُ","غَٰفِلُونَ"],"١٣"],["12:14",["قَالُواْ","لَئِنۡ"]]]],[15,[["12:14",["أَكَلَهُ","ٱلذِّئۡبُ","وَنَحۡنُ","عُصۡبَةٌ","إِنَّآ","إِذٗا","لَّخَٰسِرُونَ"],"١٤"]]]],"237":[[1,[["12:15",["فَلَمَّا","ذَهَبُواْ","بِهِۦ","وَأَجۡمَعُوٓاْ","أَن","يَجۡعَلُوهُ","فِي","غَيَٰبَتِ","ٱلۡجُبِّۚ","وَأَوۡحَيۡنَآ"]]]],[2,[["12:15",["إِلَيۡهِ","لَتُنَبِّئَنَّهُم","بِأَمۡرِهِمۡ","هَٰذَا","وَهُمۡ","لَا","يَشۡعُرُونَ"],"١٥"],["12:16",["وَجَآءُوٓ"]]]],[3,[["12:16",["أَبَاهُمۡ","عِشَآءٗ","يَبۡكُونَ"],"١٦"],["12:17",["قَالُواْ","يَٰٓأَبَانَآ","إِنَّا","ذَهَبۡنَا","نَسۡتَبِقُ"]]]],[4,[["12:17",["وَتَرَكۡنَا","يُوسُفَ","عِندَ","مَتَٰعِنَا","فَأَكَلَهُ","ٱلذِّئۡبُۖ","وَمَآ","أَنتَ"]]]],[5,[["12:17",["بِمُؤۡمِنٖ","لَّنَا","وَلَوۡ","كُنَّا","صَٰدِقِينَ"],"١٧"],["12:18",["وَجَآءُو","عَلَىٰ","قَمِيصِهِۦ"]]]],[6,[["12:18",["بِدَمٖ","كَذِبٖۚ","قَالَ","بَلۡ","سَوَّلَتۡ","لَكُمۡ","أَنفُسُكُمۡ","أَمۡرٗاۖ","فَصَبۡرٞ","جَمِيلٞۖ"]]]],[7,[["12:18",["وَٱللَّهُ","ٱلۡمُسۡتَعَانُ","عَلَىٰ","مَا","تَصِفُونَ"],"١٨"],["12:19",["وَجَآءَتۡ","سَيَّارَةٞ"]]]],[8,[["12:19",["فَأَرۡسَلُواْ","وَارِدَهُمۡ","فَأَدۡلَىٰ","دَلۡوَهُۥۖ","قَالَ","يَٰبُشۡرَىٰ","هَٰذَا","غُلَٰمٞۚ","وَأَسَرُّوهُ"]]]],[9,[["12:19",["بِضَٰعَةٗۚ","وَٱللَّهُ","عَلِيمُۢ","بِمَا","يَعۡمَلُونَ"],"١٩"],["12:20",["وَشَرَوۡهُ","بِثَمَنِۭ","بَخۡسٖ"]]]],[10,[["12:20",["دَرَٰهِمَ","مَعۡدُودَةٖ","وَكَانُواْ","فِيهِ","مِنَ","ٱلزَّٰهِدِينَ"],"٢٠"],["12:21",["وَقَالَ"]]]],[11,[["12:21",["ٱلَّذِي","ٱشۡتَرَىٰهُ","مِن","مِّصۡرَ","لِٱمۡرَأَتِهِۦٓ","أَكۡرِمِي","مَثۡوَىٰهُ","عَسَىٰٓ"]]]],[12,[["12:21",["أَن","يَنفَعَنَآ","أَوۡ","نَتَّخِذَهُۥ","وَلَدٗاۚ","وَكَذَٰلِكَ","مَكَّنَّا","لِيُوسُفَ","فِي"]]]],[13,[["12:21",["ٱلۡأَرۡضِ","وَلِنُعَلِّمَهُۥ","مِن","تَأۡوِيلِ","ٱلۡأَحَادِيثِۚ","وَٱللَّهُ","غَالِبٌ","عَلَىٰٓ"]]]],[14,[["12:21",["أَمۡرِهِۦ","وَلَٰكِنَّ","أَكۡثَرَ","ٱلنَّاسِ","لَا","يَعۡلَمُونَ"],"٢١"],["12:22",["وَلَمَّا","بَلَغَ","أَشُدَّهُۥٓ"]]]],[15,[["12:22",["ءَاتَيۡنَٰهُ","حُكۡمٗا","وَعِلۡمٗاۚ","وَكَذَٰلِكَ","نَجۡزِي","ٱلۡمُحۡسِنِينَ"],"٢٢"]]]],"238":[[1,[["12:23",["وَرَٰوَدَتۡهُ","ٱلَّتِي","هُوَ","فِي","بَيۡتِهَا","عَن","نَّفۡسِهِۦ","وَغَلَّقَتِ","ٱلۡأَبۡوَٰبَ"]]]],[2,[["12:23",["وَقَالَتۡ","هَيۡتَ","لَكَۚ","قَالَ","مَعَاذَ","ٱللَّهِۖ","إِنَّهُۥ","رَبِّيٓ","أَحۡسَنَ","مَثۡوَايَۖ"]]]],[3,[["12:23",["إِنَّهُۥ","لَا","يُفۡلِحُ","ٱلظَّٰلِمُونَ"],"٢٣"],["12:24",["وَلَقَدۡ","هَمَّتۡ","بِهِۦۖ","وَهَمَّ","بِهَا"]]]],[4,[["12:24",["لَوۡلَآ","أَن","رَّءَا","بُرۡهَٰنَ","رَبِّهِۦۚ","كَذَٰلِكَ","لِنَصۡرِ