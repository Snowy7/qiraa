"11:78",["فَٱتَّقُواْ","ٱللَّهَ","وَلَا","تُخۡزُونِ","فِي","ضَيۡفِيٓۖ","أَلَيۡسَ","مِنكُمۡ","رَجُلٞ","رَّشِيدٞ"],"٧٨"]]],[11,[["11:79",["قَالُواْ","لَقَدۡ","عَلِمۡتَ","مَا","لَنَا","فِي","بَنَاتِكَ","مِنۡ","حَقّٖ","وَإِنَّكَ","لَتَعۡلَمُ","مَا","نُرِيدُ"]]]],[12,[["11:79",[],"٧٩"],["11:80",["قَالَ","لَوۡ","أَنَّ","لِي","بِكُمۡ","قُوَّةً","أَوۡ","ءَاوِيٓ","إِلَىٰ","رُكۡنٖ","شَدِيدٖ"],"٨٠"],["11:81",["قَالُواْ"]]]],[13,[["11:81",["يَٰلُوطُ","إِنَّا","رُسُلُ","رَبِّكَ","لَن","يَصِلُوٓاْ","إِلَيۡكَۖ","فَأَسۡرِ","بِأَهۡلِكَ","بِقِطۡعٖ"]]]],[14,[["11:81",["مِّنَ","ٱلَّيۡلِ","وَلَا","يَلۡتَفِتۡ","مِنكُمۡ","أَحَدٌ","إِلَّا","ٱمۡرَأَتَكَۖ","إِنَّهُۥ","مُصِيبُهَا"]]]],[15,[["11:81",["مَآ","أَصَابَهُمۡۚ","إِنَّ","مَوۡعِدَهُمُ","ٱلصُّبۡحُۚ","أَلَيۡسَ","ٱلصُّبۡحُ","بِقَرِيبٖ"],"٨١"]]]],"231":[[1,[["11:82",["فَلَمَّا","جَآءَ","أَمۡرُنَا","جَعَلۡنَا","عَٰلِيَهَا","سَافِلَهَا","وَأَمۡطَرۡنَا","عَلَيۡهَا"]]]],[2,[["11:82",["حِجَارَةٗ","مِّن","سِجِّيلٖ","مَّنضُودٖ"],"٨٢"],["11:83",["مُّسَوَّمَةً","عِندَ","رَبِّكَۖ"]]]],[3,[["11:83",["وَمَا","هِيَ","مِنَ","ٱلظَّٰلِمِينَ","بِبَعِيدٖ"],"٨٣"],["11:84",["۞ وَإِلَىٰ","مَدۡيَنَ","أَخَاهُمۡ"]]]],[4,[["11:84",["شُعَيۡبٗاۚ","قَالَ","يَٰقَوۡمِ","ٱعۡبُدُواْ","ٱللَّهَ","مَا","لَكُم","مِّنۡ","إِلَٰهٍ","غَيۡرُهُۥۖ"]]]],[5,[["11:84",["وَلَا","تَنقُصُواْ","ٱلۡمِكۡيَالَ","وَٱلۡمِيزَانَۖ","إِنِّيٓ","أَرَىٰكُم","بِخَيۡرٖ"]]]],[6,[["11:84",["وَإِنِّيٓ","أَخَافُ","عَلَيۡكُمۡ","عَذَابَ","يَوۡمٖ","مُّحِيطٖ"],"٨٤"],["11:85",["وَيَٰقَوۡمِ"]]]],[7,[["11:85",["أَوۡفُواْ","ٱلۡمِكۡيَالَ","وَٱلۡمِيزَانَ","بِٱلۡقِسۡطِۖ","وَلَا","تَبۡخَسُواْ","ٱلنَّاسَ"]]]],[8,[["11:85",["أَشۡيَآءَهُمۡ","وَلَا","تَعۡثَوۡاْ","فِي","ٱلۡأَرۡضِ","مُفۡسِدِينَ"],"٨٥"],["11:86",["بَقِيَّتُ"]]]],[9,[["11:86",["ٱللَّهِ","خَيۡرٞ","لَّكُمۡ","إِن","كُنتُم","مُّؤۡمِنِينَۚ","وَمَآ","أَنَا۠","عَلَيۡكُم"]]]],[10,[["11:86",["بِحَفِيظٖ"],"٨٦"],["11:87",["قَالُواْ","يَٰشُعَيۡبُ","أَصَلَوٰتُكَ","تَأۡمُرُكَ","أَن","نَّتۡرُكَ"]]]],[11,[["11:87",["مَا","يَعۡبُدُ","ءَابَآؤُنَآ","أَوۡ","أَن","نَّفۡعَل