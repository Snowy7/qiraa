وٰةَ"]]]],[5,[["11:15",["ٱلدُّنۡيَا","وَزِينَتَهَا","نُوَفِّ","إِلَيۡهِمۡ","أَعۡمَٰلَهُمۡ","فِيهَا","وَهُمۡ","فِيهَا"]]]],[6,[["11:15",["لَا","يُبۡخَسُونَ"],"١٥"],["11:16",["أُوْلَٰٓئِكَ","ٱلَّذِينَ","لَيۡسَ","لَهُمۡ","فِي","ٱلۡأٓخِرَةِ","إِلَّا"]]]],[7,[["11:16",["ٱلنَّارُۖ","وَحَبِطَ","مَا","صَنَعُواْ","فِيهَا","وَبَٰطِلٞ","مَّا","كَانُواْ","يَعۡمَلُونَ"],"١٦"]]],[8,[["11:17",["أَفَمَن","كَانَ","عَلَىٰ","بَيِّنَةٖ","مِّن","رَّبِّهِۦ","وَيَتۡلُوهُ","شَاهِدٞ","مِّنۡهُ","وَمِن","قَبۡلِهِۦ"]]]],[9,[["11:17",["كِتَٰبُ","مُوسَىٰٓ","إِمَامٗا","وَرَحۡمَةًۚ","أُوْلَٰٓئِكَ","يُؤۡمِنُونَ","بِهِۦۚ","وَمَن","يَكۡفُرۡ"]]]],[10,[["11:17",["بِهِۦ","مِنَ","ٱلۡأَحۡزَابِ","فَٱلنَّارُ","مَوۡعِدُهُۥۚ","فَلَا","تَكُ","فِي","مِرۡيَةٖ","مِّنۡهُۚ","إِنَّهُ"]]]],[11,[["11:17",["ٱلۡحَقُّ","مِن","رَّبِّكَ","وَلَٰكِنَّ","أَكۡثَرَ","ٱلنَّاسِ","لَا","يُؤۡمِنُونَ"],"١٧"],["11:18",["وَمَنۡ"]]]],[12,[["11:18",["أَظۡلَمُ","مِمَّنِ","ٱفۡتَرَىٰ","عَلَى","ٱللَّهِ","كَذِبًاۚ","أُوْلَٰٓئِكَ","يُعۡرَضُونَ","عَلَىٰ"]]]],[13,[["11:18",["رَبِّهِمۡ","وَيَقُولُ","ٱلۡأَشۡهَٰدُ","هَٰٓؤُلَآءِ","ٱلَّذِينَ","كَذَبُواْ","عَلَىٰ","رَبِّهِمۡۚ"]]]],[14,[["11:18",["أَلَا","لَعۡنَةُ","ٱللَّهِ","عَلَى","ٱلظَّٰلِمِينَ"],"١٨"],["11:19",["ٱلَّذِينَ","يَصُدُّونَ","عَن","سَبِيلِ"]]]],[15,[["11:19",["ٱللَّهِ","وَيَبۡغُونَهَا","عِوَجٗا","وَهُم","بِٱلۡأٓخِرَةِ","هُمۡ","كَٰفِرُونَ"],"١٩"]]]],"224":[[1,[["11:20",["أُوْلَٰٓئِكَ","لَمۡ","يَكُونُواْ","مُعۡجِزِينَ","فِي","ٱلۡأَرۡضِ","وَمَا","كَانَ","لَهُم","مِّن","دُونِ"]]]],[2,[["11:20",["ٱللَّهِ","مِنۡ","أَوۡلِيَآءَۘ","يُضَٰعَفُ","لَهُمُ","ٱلۡعَذَابُۚ","مَا","كَانُواْ","يَسۡتَطِيعُونَ"]]]],[3,[["11:20",["ٱلسَّمۡعَ","وَمَا","كَانُواْ","يُبۡصِرُونَ"],"٢٠"],["11:21",["أُوْلَٰٓئِكَ","ٱلَّذِينَ","خَسِرُوٓاْ"]]]],[4,[["11:21",["أَنفُسَهُمۡ","وَضَلَّ","عَنۡهُم","مَّا","كَانُواْ","يَفۡتَرُونَ"],"٢١"],["11:22",["لَا","جَرَمَ","أَنَّهُمۡ"]]]],[5,[["11:22",["فِي","ٱلۡأٓخِرَةِ","هُمُ","ٱلۡأَخۡسَرُونَ"],"٢٢"],["11:23",["إِنَّ","ٱلَّذِينَ","ءَامَنُواْ","وَعَمِلُواْ"]]]],[6,[["11:23",["ٱلصَّٰلِح