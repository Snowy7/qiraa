{"361":[[1,[["25:12",["إِذَا","رَأَتۡهُم","مِّن","مَّكَانِۭ","بَعِيدٖ","سَمِعُواْ","لَهَا","تَغَيُّظٗا","وَزَفِيرٗا"],"١٢"]]],[2,[["25:13",["وَإِذَآ","أُلۡقُواْ","مِنۡهَا","مَكَانٗا","ضَيِّقٗا","مُّقَرَّنِينَ","دَعَوۡاْ","هُنَالِكَ","ثُبُورٗا"]]]],[3,[["25:13",[],"١٣"],["25:14",["لَّا","تَدۡعُواْ","ٱلۡيَوۡمَ","ثُبُورٗا","وَٰحِدٗا","وَٱدۡعُواْ","ثُبُورٗا","كَثِيرٗا"],"١٤"]]],[4,[["25:15",["قُلۡ","أَذَٰلِكَ","خَيۡرٌ","أَمۡ","جَنَّةُ","ٱلۡخُلۡدِ","ٱلَّتِي","وُعِدَ","ٱلۡمُتَّقُونَۚ","كَانَتۡ"]]]],[5,[["25:15",["لَهُمۡ","جَزَآءٗ","وَمَصِيرٗا"],"١٥"],["25:16",["لَّهُمۡ","فِيهَا","مَا","يَشَآءُونَ","خَٰلِدِينَۚ"]]]],[6,[["25:16",["كَانَ","عَلَىٰ","رَبِّكَ","وَعۡدٗا","مَّسۡـُٔولٗا"],"١٦"],["25:17",["وَيَوۡمَ","يَحۡشُرُهُمۡ","وَمَا"]]]],[7,[["25:17",["يَعۡبُدُونَ","مِن","دُونِ","ٱللَّهِ","فَيَقُولُ","ءَأَنتُمۡ","أَضۡلَلۡتُمۡ","عِبَادِي"]]]],[8,[["25:17",["هَٰٓؤُلَآءِ","أَمۡ","هُمۡ","ضَلُّواْ","ٱلسَّبِيلَ"],"١٧"],["25:18",["قَالُواْ","سُبۡحَٰنَكَ","مَا","كَانَ"]]]],[9,[["25:18",["يَنۢبَغِي","لَنَآ","أَن","نَّتَّخِذَ","مِن","دُونِكَ","مِنۡ","أَوۡلِيَآءَ","وَلَٰكِن","مَّتَّعۡتَهُمۡ"]]]],[10,[["25:18",["وَءَابَآءَهُمۡ","حَتَّىٰ","نَسُواْ","ٱلذِّكۡرَ","وَكَانُواْ","قَوۡمَۢا","بُورٗا"],"١٨"]]],[11,[["25:19",["فَقَدۡ","كَذَّبُوكُم","بِمَا","تَقُولُونَ","فَمَا","تَسۡتَطِيعُونَ","صَرۡفٗا"]]]],[12,[["25:19",["وَلَا","نَصۡرٗاۚ","وَمَن","يَظۡلِم","مِّنكُمۡ","نُذِقۡهُ","عَذَابٗا","كَبِيرٗا"],"١٩"]]],[13,[["25:20",["وَمَآ","أَرۡسَلۡنَا","قَبۡلَكَ","مِنَ","ٱلۡمُرۡسَلِينَ","إِلَّآ","إِنَّهُمۡ","لَيَأۡكُلُونَ"]]]],[14,[["25:20",["ٱلطَّعَامَ","وَيَمۡشُونَ","فِي","ٱلۡأَسۡوَاقِۗ","وَجَعَلۡنَا","بَعۡضَكُمۡ"]]]],[15,[["25:20",["لِبَعۡضٖ","فِتۡنَةً","أَتَصۡبِرُونَۗ","وَكَانَ","رَبُّكَ","بَصِيرٗا"],"٢٠"]]]],"362":[[1,[["25:21",["۞ وَقَالَ","ٱلَّذِينَ","لَا","يَرۡجُونَ","لِقَآءَنَا","لَوۡلَآ","أُنزِلَ","عَلَيۡنَا","ٱلۡمَلَٰٓئِكَةُ"]]]],[2,[["25:21",["أَوۡ","نَرَىٰ","رَبَّنَاۗ","لَقَدِ","ٱسۡتَكۡبَرُواْ","فِيٓ","أَنفُسِهِمۡ","وَعَتَوۡ","عُتُوّٗا","كَبِيرٗا"]]]],[3,[["25:21",[],"٢١"],["25:22