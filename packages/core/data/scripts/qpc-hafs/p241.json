َنُفَضِّلُ","بَعۡضَهَا","عَلَىٰ","بَعۡضٖ"]]]],[12,[["13:4",["فِي","ٱلۡأُكُلِۚ","إِنَّ","فِي","ذَٰلِكَ","لَأٓيَٰتٖ","لِّقَوۡمٖ","يَعۡقِلُونَ"],"٤"],["13:5",["۞ وَإِن","تَعۡجَبۡ"]]]],[13,[["13:5",["فَعَجَبٞ","قَوۡلُهُمۡ","أَءِذَا","كُنَّا","تُرَٰبًا","أَءِنَّا","لَفِي","خَلۡقٖ","جَدِيدٍۗ"]]]],[14,[["13:5",["أُوْلَٰٓئِكَ","ٱلَّذِينَ","كَفَرُواْ","بِرَبِّهِمۡۖ","وَأُوْلَٰٓئِكَ","ٱلۡأَغۡلَٰلُ","فِيٓ"]]]],[15,[["13:5",["أَعۡنَاقِهِمۡۖ","وَأُوْلَٰٓئِكَ","أَصۡحَٰبُ","ٱلنَّارِۖ","هُمۡ","فِيهَا","خَٰلِدُونَ"],"٥"]]]],"250":[[1,[["13:6",["وَيَسۡتَعۡجِلُونَكَ","بِٱلسَّيِّئَةِ","قَبۡلَ","ٱلۡحَسَنَةِ","وَقَدۡ","خَلَتۡ","مِن"]]]],[2,[["13:6",["قَبۡلِهِمُ","ٱلۡمَثُلَٰتُۗ","وَإِنَّ","رَبَّكَ","لَذُو","مَغۡفِرَةٖ","لِّلنَّاسِ","عَلَىٰ","ظُلۡمِهِمۡۖ"]]]],[3,[["13:6",["وَإِنَّ","رَبَّكَ","لَشَدِيدُ","ٱلۡعِقَابِ"],"٦"],["13:7",["وَيَقُولُ","ٱلَّذِينَ","كَفَرُواْ","لَوۡلَآ"]]]],[4,[["13:7",["أُنزِلَ","عَلَيۡهِ","ءَايَةٞ","مِّن","رَّبِّهِۦٓۗ","إِنَّمَآ","أَنتَ","مُنذِرٞۖ","وَلِكُلِّ","قَوۡمٍ"]]]],[5,[["13:7",["هَادٍ"],"٧"],["13:8",["ٱللَّهُ","يَعۡلَمُ","مَا","تَحۡمِلُ","كُلُّ","أُنثَىٰ","وَمَا","تَغِيضُ","ٱلۡأَرۡحَامُ"]]]],[6,[["13:8",["وَمَا","تَزۡدَادُۚ","وَكُلُّ","شَيۡءٍ","عِندَهُۥ","بِمِقۡدَارٍ"],"٨"],["13:9",["عَٰلِمُ","ٱلۡغَيۡبِ"]]]],[7,[["13:9",["وَٱلشَّهَٰدَةِ","ٱلۡكَبِيرُ","ٱلۡمُتَعَالِ"],"٩"],["13:10",["سَوَآءٞ","مِّنكُم","مَّنۡ"]]]],[8,[["13:10",["أَسَرَّ","ٱلۡقَوۡلَ","وَمَن","جَهَرَ","بِهِۦ","وَمَنۡ","هُوَ","مُسۡتَخۡفِۭ","بِٱلَّيۡلِ","وَسَارِبُۢ"]]]],[9,[["13:10",["بِٱلنَّهَارِ"],"١٠"],["13:11",["لَهُۥ","مُعَقِّبَٰتٞ","مِّنۢ","بَيۡنِ","يَدَيۡهِ","وَمِنۡ","خَلۡفِهِۦ"]]]],[10,[["13:11",["يَحۡفَظُونَهُۥ","مِنۡ","أَمۡرِ","ٱللَّهِۗ","إِنَّ","ٱللَّهَ","لَا","يُغَيِّرُ","مَا","بِقَوۡمٍ","حَتَّىٰ","يُغَيِّرُواْ"]]]],[11,[["13:11",["مَا","بِأَنفُسِهِمۡۗ","وَإِذَآ","أَرَادَ","ٱللَّهُ","بِقَوۡمٖ","سُوٓءٗا","فَلَا","مَرَدَّ","لَهُۥۚ","وَمَا"]]]],[12,[["13:11",["لَهُم","مِّن","دُونِهِۦ","مِن","وَالٍ"],"١١"],["13:12",["هُوَ","ٱلَّذِي","يُرِيكُمُ","ٱلۡبَرۡقَ","خَوۡفٗا"]]]],[13,[["13:12",["وَطَمَعٗا","وَيُنشِئُ","ٱلسَّحَابَ","ٱلثِّقَالَ"],"١٢"],["13:13",["وَيُسَبِّحُ","ٱلرَّعۡدُ","بِحَمۡدِهِۦ"]]]],[14,[["13:13",["وَٱلۡمَلَٰٓئِكَةُ","مِنۡ","خِيفَتِهِۦ","وَيُرۡسِلُ","ٱلصَّوَٰعِقَ","فَيُصِيبُ","بِهَا"]]]],[15,[["13:13",["مَن","يَشَآءُ","وَهُمۡ","يُجَٰدِلُونَ","فِي","ٱللَّهِ","وَهُوَ","شَدِيدُ","ٱلۡمِحَالِ"],"١٣"]]]],"251":[[1,[["13:14",["لَهُۥ","دَعۡوَةُ","ٱلۡحَقِّۚ","وَٱلَّذِينَ","يَدۡعُونَ","مِن","دُونِهِۦ","لَا","يَسۡتَجِيبُونَ","لَهُم","بِشَيۡءٍ","إِلَّا"]]]],[2,[["13:14",["كَبَٰسِطِ","كَفَّيۡهِ","إِلَى","ٱلۡمَآءِ","لِيَبۡلُغَ","فَاهُ","وَمَا","هُوَ","بِبَٰلِغِهِۦۚ","وَمَا","دُعَآءُ","ٱلۡكَٰفِرِينَ"]]]],[3,[["13:14",["إِلَّا","فِي","ضَلَٰلٖ"],"١٤"],["13:15",["وَلِلَّهِۤ","يَسۡجُدُۤ","مَن","فِي","ٱلسَّمَٰوَٰتِ","وَٱلۡأَرۡضِ","طَوۡعٗا"]]]],[4,[["13:15",["وَكَرۡهٗا","وَظِلَٰلُهُم","بِٱلۡغُدُوِّ","وَٱلۡأٓصَالِ۩"],"١٥"],["13:16",["قُلۡ","مَن","رَّبُّ","ٱلسَّمَٰوَٰتِ"]]]],[5,[["13:16",["وَٱلۡأَرۡضِ","قُلِ","ٱللَّهُۚ","قُلۡ","أَفَٱتَّخَذۡتُم","مِّن","دُونِهِۦٓ","أَوۡلِيَآءَ","لَا","يَمۡلِكُونَ"]]]],[6,[["13:16",["لِأَنفُسِهِمۡ","نَفۡعٗا","وَلَا","ضَرّٗاۚ","قُلۡ","هَلۡ","يَسۡتَوِي","ٱلۡأَعۡمَىٰ","وَٱلۡبَصِيرُ","أَمۡ","هَلۡ"]]]],[7,[["13:16",["تَسۡتَوِي","ٱلظُّلُمَٰتُ","وَٱلنُّورُۗ","أَمۡ","جَعَلُواْ","لِلَّهِ","شُرَكَآءَ","خَلَقُواْ","كَخَلۡقِهِۦ","فَتَشَٰبَهَ"]]]],[8,[["13:16",["ٱلۡخَلۡقُ","عَلَيۡهِمۡۚ","قُلِ","ٱللَّهُ","خَٰلِقُ","كُلِّ","شَيۡءٖ","وَهُوَ","ٱلۡوَٰحِدُ","ٱلۡقَهَّٰرُ"],"١٦"],["13:17",["أَنزَلَ"]]]],[9,[["13:17",["مِنَ","ٱلسَّمَآءِ","مَآءٗ","فَسَالَتۡ","أَوۡدِيَةُۢ","بِقَدَرِهَا","فَٱحۡتَمَلَ","ٱلسَّيۡلُ","زَبَدٗا","رَّابِيٗاۖ"]]]],[10,[["13:17",["وَمِمَّا","يُوقِدُونَ","عَلَيۡهِ","فِي","ٱلنَّارِ","ٱبۡتِغَآءَ","حِلۡيَةٍ","أَوۡ","مَتَٰعٖ","زَبَدٞ","مِّثۡلُهُۥۚ"]]]],[11,[["13:17",["كَذَٰلِكَ","يَضۡرِبُ","ٱللَّهُ","ٱلۡحَقَّ","وَٱلۡبَٰطِلَۚ","فَأَمَّا","ٱلزَّبَدُ","فَيَذۡهَبُ","جُفَآءٗۖ"]]]],[12,[["13:17",["وَأَمَّا","مَا","يَنفَعُ","ٱلنَّاسَ","فَيَمۡكُثُ","فِي","ٱلۡأَرۡضِۚ","كَذَٰلِكَ","يَضۡرِبُ","ٱللَّهُ"]]]],[13,[["13:17",["ٱلۡأَمۡثَالَ"],"١٧"],["13:18",["لِلَّذِينَ","ٱسۡتَجَابُواْ","لِرَبِّهِمُ","ٱلۡحُسۡنَىٰۚ","وَٱلَّذِينَ","لَمۡ","يَسۡتَجِيبُواْ"]]]],[14,[["13:18",["لَهُۥ","لَوۡ","أَنَّ","لَهُم","مَّا","فِي","ٱلۡأَرۡضِ","جَمِيعٗا","وَمِثۡلَهُۥ","مَعَهُۥ","لَٱفۡتَدَوۡاْ","بِهِۦٓۚ"]]]],[15,[["13:18",["أُوْلَٰٓئِكَ","لَهُمۡ","سُوٓءُ","ٱلۡحِسَابِ","وَمَأۡوَىٰهُمۡ","جَهَنَّمُۖ","وَبِئۡسَ","ٱلۡمِهَادُ"],"١٨"]]]],"252":[[1,[["13:19",["۞ أَفَمَن","يَعۡلَمُ","أَنَّمَآ","أُنزِلَ","إِلَيۡكَ","مِن","رَّبِّكَ","ٱلۡحَقُّ","كَمَنۡ","هُوَ","أَعۡمَىٰٓۚ","إِنَّمَا","يَتَذَكَّرُ"]]]],[2,[["13:19",["أُوْلُواْ","ٱلۡأَلۡبَٰبِ"],"١٩"],["13:20",["ٱلَّذِينَ","يُوفُونَ","بِعَهۡدِ","ٱللَّهِ","وَلَا","يَنقُضُونَ","ٱلۡمِيثَٰقَ"]]]],[3,[["13:20",[],"٢٠"],["13:21",["وَٱلَّذِينَ","يَصِلُونَ","مَآ","أَمَرَ","ٱللَّهُ","بِهِۦٓ","أَن","يُوصَلَ","وَيَخۡشَوۡنَ","رَبَّهُمۡ"]]]],[4,[["13:21",["وَيَخَافُونَ","سُوٓءَ","ٱلۡحِسَابِ"],"٢١"],["13:22",["وَٱلَّذِينَ","صَبَرُواْ","ٱبۡتِغَآءَ","وَجۡهِ","رَبِّهِمۡ"]]]],[5,[["13:22",["وَأَقَامُواْ","ٱلصَّلَوٰةَ","وَأَنفَقُواْ","مِمَّا","رَزَقۡنَٰهُمۡ","سِرّٗا","وَعَلَانِيَةٗ","وَيَدۡرَءُونَ"]]]],[6,[["13:22",["بِٱلۡحَسَنَةِ","ٱلسَّيِّئَةَ","أُوْلَٰٓئِكَ","لَهُمۡ","عُقۡبَى","ٱلدَّارِ"],"٢٢"],["13:23",["جَنَّٰتُ","عَدۡنٖ","يَدۡخُلُونَهَا"]]]],[7,[["13:23",["وَمَن","صَلَحَ","مِنۡ","ءَابَآئِهِمۡ","وَأَزۡوَٰجِهِمۡ","وَذُرِّيَّٰتِهِمۡۖ","وَٱلۡمَلَٰٓئِكَةُ","يَدۡخُلُونَ"]]]],[8,[["13:23",["عَلَيۡهِم","مِّن","كُلِّ","بَابٖ"],"٢٣"],["13:24",["سَلَٰمٌ","عَلَيۡكُم","بِمَا","صَبَرۡتُمۡۚ","فَنِعۡمَ","عُقۡبَى","ٱلدَّارِ"],"٢٤"]]],[9,[["13:25",["وَٱلَّذِينَ","يَنقُضُونَ","عَهۡدَ","ٱللَّهِ","مِنۢ","بَعۡدِ","مِيثَٰقِهِۦ","وَيَقۡطَعُونَ"]]]],[10,[["13:25",["مَآ","أَمَرَ","ٱللَّهُ","بِهِۦٓ","أَن","يُوصَلَ","وَيُفۡسِدُونَ","فِي","ٱلۡأَرۡضِ","أُوْلَٰٓئِكَ","لَهُمُ"]]]],[11,[["13:25",["ٱللَّعۡنَةُ","وَلَهُمۡ","سُوٓءُ","ٱلدَّارِ"],"٢٥"],["13:26",["ٱللَّهُ","يَبۡسُطُ","ٱلرِّزۡقَ","لِمَن","يَشَآءُ"]]]],[12,[["13:26",["وَيَقۡدِرُۚ","وَفَرِحُواْ","بِٱلۡحَيَوٰةِ","ٱلدُّنۡيَا","وَمَا","ٱلۡحَيَوٰةُ","ٱلدُّنۡيَا","فِي"