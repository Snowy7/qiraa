أۡوِيلُ","رُءۡيَٰيَ","مِن","قَبۡلُ","قَدۡ","جَعَلَهَا"]]]],[8,[["12:100",["رَبِّي","حَقّٗاۖ","وَقَدۡ","أَحۡسَنَ","بِيٓ","إِذۡ","أَخۡرَجَنِي","مِنَ","ٱلسِّجۡنِ","وَجَآءَ","بِكُم"]]]],[9,[["12:100",["مِّنَ","ٱلۡبَدۡوِ","مِنۢ","بَعۡدِ","أَن","نَّزَغَ","ٱلشَّيۡطَٰنُ","بَيۡنِي","وَبَيۡنَ","إِخۡوَتِيٓۚ","إِنَّ"]]]],[10,[["12:100",["رَبِّي","لَطِيفٞ","لِّمَا","يَشَآءُۚ","إِنَّهُۥ","هُوَ","ٱلۡعَلِيمُ","ٱلۡحَكِيمُ"],"١٠٠"],["12:101",["۞ رَبِّ"]]]],[11,[["12:101",["قَدۡ","ءَاتَيۡتَنِي","مِنَ","ٱلۡمُلۡكِ","وَعَلَّمۡتَنِي","مِن","تَأۡوِيلِ","ٱلۡأَحَادِيثِۚ"]]]],[12,[["12:101",["فَاطِرَ","ٱلسَّمَٰوَٰتِ","وَٱلۡأَرۡضِ","أَنتَ","وَلِيِّۦ","فِي","ٱلدُّنۡيَا","وَٱلۡأٓخِرَةِۖ"]]]],[13,[["12:101",["تَوَفَّنِي","مُسۡلِمٗا","وَأَلۡحِقۡنِي","بِٱلصَّٰلِحِينَ"],"١٠١"],["12:102",["ذَٰلِكَ","مِنۡ","أَنۢبَآءِ"]]]],[14,[["12:102",["ٱلۡغَيۡبِ","نُوحِيهِ","إِلَيۡكَۖ","وَمَا","كُنتَ","لَدَيۡهِمۡ","إِذۡ","أَجۡمَعُوٓاْ","أَمۡرَهُمۡ"]]]],[15,[["12:102",["وَهُمۡ","يَمۡكُرُونَ"],"١٠٢"],["12:103",["وَمَآ","أَكۡثَرُ","ٱلنَّاسِ","وَلَوۡ","حَرَصۡتَ","بِمُؤۡمِنِينَ"],"١٠٣"]]]],"248":[[1,[["12:104",["وَمَا","تَسۡـَٔلُهُمۡ","عَلَيۡهِ","مِنۡ","أَجۡرٍۚ","إِنۡ","هُوَ","إِلَّا","ذِكۡرٞ","لِّلۡعَٰلَمِينَ"]]]],[2,[["12:104",[],"١٠٤"],["12:105",["وَكَأَيِّن","مِّنۡ","ءَايَةٖ","فِي","ٱلسَّمَٰوَٰتِ","وَٱلۡأَرۡضِ","يَمُرُّونَ","عَلَيۡهَا"]]]],[3,[["12:105",["وَهُمۡ","عَنۡهَا","مُعۡرِضُونَ"],"١٠٥"],["12:106",["وَمَا","يُؤۡمِنُ","أَكۡثَرُهُم","بِٱللَّهِ","إِلَّا"]]]],[4,[["12:106",["وَهُم","مُّشۡرِكُونَ"],"١٠٦"],["12:107",["أَفَأَمِنُوٓاْ","أَن","تَأۡتِيَهُمۡ","غَٰشِيَةٞ","مِّنۡ","عَذَابِ"]]]],[5,[["12:107",["ٱللَّهِ","أَوۡ","تَأۡتِيَهُمُ","ٱلسَّاعَةُ","بَغۡتَةٗ","وَهُمۡ","لَا","يَشۡعُرُونَ"],"١٠٧"],["12:108",["قُلۡ"]]]],[6,[["12:108",["هَٰذِهِۦ","سَبِيلِيٓ","أَدۡعُوٓاْ","إِلَى","ٱللَّهِۚ","عَلَىٰ","بَصِيرَةٍ","أَنَا۠","وَمَنِ","ٱتَّبَعَنِيۖ"]]]],[7,[["12:108",["وَسُبۡحَٰنَ","ٱللَّهِ","وَمَآ","أَنَا۠","مِنَ","ٱلۡمُشۡرِكِينَ"],"١٠٨"],["12:109",["وَمَآ","أَرۡسَلۡنَا","مِن"]]]],[8,[["12:109",["قَبۡلِكَ","إِلَّا","رِجَ