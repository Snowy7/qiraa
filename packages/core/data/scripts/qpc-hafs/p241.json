{"241":[[1,[["12:44",["قَالُوٓاْ","أَضۡغَٰثُ","أَحۡلَٰمٖۖ","وَمَا","نَحۡنُ","بِتَأۡوِيلِ","ٱلۡأَحۡلَٰمِ","بِعَٰلِمِينَ"],"٤٤"]]],[2,[["12:45",["وَقَالَ","ٱلَّذِي","نَجَا","مِنۡهُمَا","وَٱدَّكَرَ","بَعۡدَ","أُمَّةٍ","أَنَا۠","أُنَبِّئُكُم","بِتَأۡوِيلِهِۦ"]]]],[3,[["12:45",["فَأَرۡسِلُونِ"],"٤٥"],["12:46",["يُوسُفُ","أَيُّهَا","ٱلصِّدِّيقُ","أَفۡتِنَا","فِي","سَبۡعِ","بَقَرَٰتٖ"]]]],[4,[["12:46",["سِمَانٖ","يَأۡكُلُهُنَّ","سَبۡعٌ","عِجَافٞ","وَسَبۡعِ","سُنۢبُلَٰتٍ","خُضۡرٖ"]]]],[5,[["12:46",["وَأُخَرَ","يَابِسَٰتٖ","لَّعَلِّيٓ","أَرۡجِعُ","إِلَى","ٱلنَّاسِ","لَعَلَّهُمۡ","يَعۡلَمُونَ"],"٤٦"],["12:47",["قَالَ"]]]],[6,[["12:47",["تَزۡرَعُونَ","سَبۡعَ","سِنِينَ","دَأَبٗا","فَمَا","حَصَدتُّمۡ","فَذَرُوهُ","فِي","سُنۢبُلِهِۦٓ","إِلَّا"]]]],[7,[["12:47",["قَلِيلٗا","مِّمَّا","تَأۡكُلُونَ"],"٤٧"],["12:48",["ثُمَّ","يَأۡتِي","مِنۢ","بَعۡدِ","ذَٰلِكَ","سَبۡعٞ","شِدَادٞ","يَأۡكُلۡنَ"]]]],[8,[["12:48",["مَا","قَدَّمۡتُمۡ","لَهُنَّ","إِلَّا","قَلِيلٗا","مِّمَّا","تُحۡصِنُونَ"],"٤٨"],["12:49",["ثُمَّ","يَأۡتِي","مِنۢ","بَعۡدِ","ذَٰلِكَ"]]]],[9,[["12:49",["عَامٞ","فِيهِ","يُغَاثُ","ٱلنَّاسُ","وَفِيهِ","يَعۡصِرُونَ"],"٤٩"],["12:50",["وَقَالَ","ٱلۡمَلِكُ","ٱئۡتُونِي"]]]],[10,[["12:50",["بِهِۦۖ","فَلَمَّا","جَآءَهُ","ٱلرَّسُولُ","قَالَ","ٱرۡجِعۡ","إِلَىٰ","رَبِّكَ","فَسۡـَٔلۡهُ","مَا","بَالُ"]]]],[11,[["12:50",["ٱلنِّسۡوَةِ","ٱلَّٰتِي","قَطَّعۡنَ","أَيۡدِيَهُنَّۚ","إِنَّ","رَبِّي","بِكَيۡدِهِنَّ","عَلِيمٞ"],"٥٠"]]],[12,[["12:51",["قَالَ","مَا","خَطۡبُكُنَّ","إِذۡ","رَٰوَدتُّنَّ","يُوسُفَ","عَن","نَّفۡسِهِۦۚ","قُلۡنَ","حَٰشَ"]]]],[13,[["12:51",["لِلَّهِ","مَا","عَلِمۡنَا","عَلَيۡهِ","مِن","سُوٓءٖۚ","قَالَتِ","ٱمۡرَأَتُ","ٱلۡعَزِيزِ","ٱلۡـَٰٔنَ","حَصۡحَصَ"]]]],[14,[["12:51",["ٱلۡحَقُّ","أَنَا۠","رَٰوَدتُّهُۥ","عَن","نَّفۡسِهِۦ","وَإِنَّهُۥ","لَمِنَ","ٱلصَّٰدِقِينَ"],"٥١"],["12:52",["ذَٰلِكَ"]]]],[15,[["12:52",["لِيَعۡلَمَ","أَنِّي","لَمۡ","أَخُنۡهُ","بِٱلۡغَيۡبِ","وَأَنَّ","ٱللَّهَ","لَا","يَهۡدِي","كَيۡدَ","ٱلۡخَآئِنِينَ"],"٥٢"]]]],"242":[[1,[["12:53",["۞ وَمَآ","أُبَرِّئُ","نَفۡسِ