]],"503":[[1,[["46:6",1,["وَإِذَا","حُشِرَ","ٱلنَّاسُ","كَانُواْ","لَهُمۡ","أَعۡدَآءٗ","وَكَانُواْ","بِعِبَادَتِهِمۡ","كَٰفِرِينَ"],"٦"],["46:7",1,["وَإِذَا"]]]],[2,[["46:7",2,["تُتۡلَىٰ","عَلَيۡهِمۡ","ءَايَٰتُنَا","بَيِّنَٰتٖ","قَالَ","ٱلَّذِينَ","كَفَرُواْ","لِلۡحَقِّ","لَمَّا","جَآءَهُمۡ","هَٰذَا"]]]],[3,[["46:7",13,["سِحۡرٞ","مُّبِينٌ"],"٧"],["46:8",1,["أَمۡ","يَقُولُونَ","ٱفۡتَرَىٰهُۖ","قُلۡ","إِنِ","ٱفۡتَرَيۡتُهُۥ","فَلَا","تَمۡلِكُونَ"]]]],[4,[["46:8",9,["لِي","مِنَ","ٱللَّهِ","شَيۡـًٔاۖ","هُوَ","أَعۡلَمُ","بِمَا","تُفِيضُونَ","فِيهِۚ","كَفَىٰ","بِهِۦ","شَهِيدَۢا","بَيۡنِي"]]]],[5,[["46:8",22,["وَبَيۡنَكُمۡۖ","وَهُوَ","ٱلۡغَفُورُ","ٱلرَّحِيمُ"],"٨"],["46:9",1,["قُلۡ","مَا","كُنتُ","بِدۡعٗا","مِّنَ","ٱلرُّسُلِ"]]]],[6,[["46:9",7,["وَمَآ","أَدۡرِي","مَا","يُفۡعَلُ","بِي","وَلَا","بِكُمۡۖ","إِنۡ","أَتَّبِعُ","إِلَّا","مَا","يُوحَىٰٓ","إِلَيَّ","وَمَآ","أَنَا۠"]]]],[7,[["46:9",22,["إِلَّا","نَذِيرٞ","مُّبِينٞ"],"٩"],["46:10",1,["قُلۡ","أَرَءَيۡتُمۡ","إِن","كَانَ","مِنۡ","عِندِ","ٱللَّهِ","وَكَفَرۡتُم","بِهِۦ"]]]],[8,[["46:10",10,["وَشَهِدَ","شَاهِدٞ","مِّنۢ","بَنِيٓ","إِسۡرَٰٓءِيلَ","عَلَىٰ","مِثۡلِهِۦ","فَـَٔامَنَ","وَٱسۡتَكۡبَرۡتُمۡۚ"]]]],[9,[["46:10",19,["إِنَّ","ٱللَّهَ","لَا","يَهۡدِي","ٱلۡقَوۡمَ","ٱلظَّٰلِمِينَ"],"١٠"],["46:11",1,["وَقَالَ","ٱلَّذِينَ","كَفَرُواْ"]]]],[10,[["46:11",4,["لِلَّذِينَ","ءَامَنُواْ","لَوۡ","كَانَ","خَيۡرٗا","مَّا","سَبَقُونَآ","إِلَيۡهِۚ","وَإِذۡ","لَمۡ","يَهۡتَدُواْ","بِهِۦ"]]]],[11,[["46:11",16,["فَسَيَقُولُونَ","هَٰذَآ","إِفۡكٞ","قَدِيمٞ"],"١١"],["46:12",1,["وَمِن","قَبۡلِهِۦ","كِتَٰبُ","مُوسَىٰٓ"]]]],[12,[["46:12",5,["إِمَامٗا","وَرَحۡمَةٗۚ","وَهَٰذَا","كِتَٰبٞ","مُّصَدِّقٞ","لِّسَانًا","عَرَبِيّٗا","لِّيُنذِرَ"]]]],[13,[["46:12",13,["ٱلَّذِينَ","ظَلَمُواْ","وَبُشۡرَىٰ","لِلۡمُحۡسِنِينَ"],"١٢"],["46:13",1,["إِنَّ","ٱلَّذِينَ","قَالُواْ","رَبُّنَا"]]]],[14,[["46:13",5,["ٱللَّهُ","ثُمَّ","ٱسۡتَقَٰمُواْ","فَلَا","خَوۡفٌ","عَلَيۡهِمۡ","وَلَا","هُمۡ","يَحۡزَنُونَ"],"١٣"]]],[15,[["46:14",1,["أُوْلَٰٓئِكَ","أَصۡحَٰبُ","ٱلۡجَنّ