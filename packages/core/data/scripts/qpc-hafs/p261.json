,[12,[["16:25",["أَوۡزَارَهُمۡ","كَامِلَةٗ","يَوۡمَ","ٱلۡقِيَٰمَةِ","وَمِنۡ","أَوۡزَارِ","ٱلَّذِينَ","يُضِلُّونَهُم"]]]],[13,[["16:25",["بِغَيۡرِ","عِلۡمٍۗ","أَلَا","سَآءَ","مَا","يَزِرُونَ"],"٢٥"],["16:26",["قَدۡ","مَكَرَ","ٱلَّذِينَ","مِن","قَبۡلِهِمۡ"]]]],[14,[["16:26",["فَأَتَى","ٱللَّهُ","بُنۡيَٰنَهُم","مِّنَ","ٱلۡقَوَاعِدِ","فَخَرَّ","عَلَيۡهِمُ","ٱلسَّقۡفُ"]]]],[15,[["16:26",["مِن","فَوۡقِهِمۡ","وَأَتَىٰهُمُ","ٱلۡعَذَابُ","مِنۡ","حَيۡثُ","لَا","يَشۡعُرُونَ"],"٢٦"]]]],"270":[[1,[["16:27",["ثُمَّ","يَوۡمَ","ٱلۡقِيَٰمَةِ","يُخۡزِيهِمۡ","وَيَقُولُ","أَيۡنَ","شُرَكَآءِيَ","ٱلَّذِينَ"]]]],[2,[["16:27",["كُنتُمۡ","تُشَٰٓقُّونَ","فِيهِمۡۚ","قَالَ","ٱلَّذِينَ","أُوتُواْ","ٱلۡعِلۡمَ","إِنَّ","ٱلۡخِزۡيَ"]]]],[3,[["16:27",["ٱلۡيَوۡمَ","وَٱلسُّوٓءَ","عَلَى","ٱلۡكَٰفِرِينَ"],"٢٧"],["16:28",["ٱلَّذِينَ","تَتَوَفَّىٰهُمُ","ٱلۡمَلَٰٓئِكَةُ"]]]],[4,[["16:28",["ظَالِمِيٓ","أَنفُسِهِمۡۖ","فَأَلۡقَوُاْ","ٱلسَّلَمَ","مَا","كُنَّا","نَعۡمَلُ","مِن","سُوٓءِۭۚ","بَلَىٰٓۚ"]]]],[5,[["16:28",["إِنَّ","ٱللَّهَ","عَلِيمُۢ","بِمَا","كُنتُمۡ","تَعۡمَلُونَ"],"٢٨"],["16:29",["فَٱدۡخُلُوٓاْ","أَبۡوَٰبَ","جَهَنَّمَ"]]]],[6,[["16:29",["خَٰلِدِينَ","فِيهَاۖ","فَلَبِئۡسَ","مَثۡوَى","ٱلۡمُتَكَبِّرِينَ"],"٢٩"],["16:30",["۞ وَقِيلَ"]]]],[7,[["16:30",["لِلَّذِينَ","ٱتَّقَوۡاْ","مَاذَآ","أَنزَلَ","رَبُّكُمۡۚ","قَالُواْ","خَيۡرٗاۗ","لِّلَّذِينَ","أَحۡسَنُواْ","فِي"]]]],[8,[["16:30",["هَٰذِهِ","ٱلدُّنۡيَا","حَسَنَةٞۚ","وَلَدَارُ","ٱلۡأٓخِرَةِ","خَيۡرٞۚ","وَلَنِعۡمَ","دَارُ","ٱلۡمُتَّقِينَ"]]]],[9,[["16:30",[],"٣٠"],["16:31",["جَنَّٰتُ","عَدۡنٖ","يَدۡخُلُونَهَا","تَجۡرِي","مِن","تَحۡتِهَا","ٱلۡأَنۡهَٰرُۖ"]]]],[10,[["16:31",["لَهُمۡ","فِيهَا","مَا","يَشَآءُونَۚ","كَذَٰلِكَ","يَجۡزِي","ٱللَّهُ","ٱلۡمُتَّقِينَ"],"٣١"]]],[11,[["16:32",["ٱلَّذِينَ","تَتَوَفَّىٰهُمُ","ٱلۡمَلَٰٓئِكَةُ","طَيِّبِينَ","يَقُولُونَ","سَلَٰمٌ","عَلَيۡكُمُ"]]]],[12,[["16:32",["ٱدۡخُلُواْ","ٱلۡجَنَّةَ","بِمَا","كُنتُمۡ","تَعۡمَلُونَ"],"٣٢"],["16:33",["هَلۡ","يَنظُرُونَ","إِلَّآ","أَن"]]]],[13,[["16:33",["تَأۡتِيَهُمُ","ٱلۡمَلَٰٓئِك