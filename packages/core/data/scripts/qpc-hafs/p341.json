"]]],[7,[["24:31",["وَقُل","لِّلۡمُؤۡمِنَٰتِ","يَغۡضُضۡنَ","مِنۡ","أَبۡصَٰرِهِنَّ","وَيَحۡفَظۡنَ"]]]],[8,[["24:31",["فُرُوجَهُنَّ","وَلَا","يُبۡدِينَ","زِينَتَهُنَّ","إِلَّا","مَا","ظَهَرَ","مِنۡهَاۖ","وَلۡيَضۡرِبۡنَ"]]]],[9,[["24:31",["بِخُمُرِهِنَّ","عَلَىٰ","جُيُوبِهِنَّۖ","وَلَا","يُبۡدِينَ","زِينَتَهُنَّ","إِلَّا","لِبُعُولَتِهِنَّ"]]]],[10,[["24:31",["أَوۡ","ءَابَآئِهِنَّ","أَوۡ","ءَابَآءِ","بُعُولَتِهِنَّ","أَوۡ","أَبۡنَآئِهِنَّ","أَوۡ","أَبۡنَآءِ","بُعُولَتِهِنَّ"]]]],[11,[["24:31",["أَوۡ","إِخۡوَٰنِهِنَّ","أَوۡ","بَنِيٓ","إِخۡوَٰنِهِنَّ","أَوۡ","بَنِيٓ","أَخَوَٰتِهِنَّ","أَوۡ","نِسَآئِهِنَّ"]]]],[12,[["24:31",["أَوۡ","مَا","مَلَكَتۡ","أَيۡمَٰنُهُنَّ","أَوِ","ٱلتَّٰبِعِينَ","غَيۡرِ","أُوْلِي","ٱلۡإِرۡبَةِ","مِنَ"]]]],[13,[["24:31",["ٱلرِّجَالِ","أَوِ","ٱلطِّفۡلِ","ٱلَّذِينَ","لَمۡ","يَظۡهَرُواْ","عَلَىٰ","عَوۡرَٰتِ","ٱلنِّسَآءِۖ"]]]],[14,[["24:31",["وَلَا","يَضۡرِبۡنَ","بِأَرۡجُلِهِنَّ","لِيُعۡلَمَ","مَا","يُخۡفِينَ","مِن","زِينَتِهِنَّۚ","وَتُوبُوٓاْ"]]]],[15,[["24:31",["إِلَى","ٱللَّهِ","جَمِيعًا","أَيُّهَ","ٱلۡمُؤۡمِنُونَ","لَعَلَّكُمۡ","تُفۡلِحُونَ"],"٣١"]]]],"354":[[1,[["24:32",["وَأَنكِحُواْ","ٱلۡأَيَٰمَىٰ","مِنكُمۡ","وَٱلصَّٰلِحِينَ","مِنۡ","عِبَادِكُمۡ","وَإِمَآئِكُمۡۚ","إِن"]]]],[2,[["24:32",["يَكُونُواْ","فُقَرَآءَ","يُغۡنِهِمُ","ٱللَّهُ","مِن","فَضۡلِهِۦۗ","وَٱللَّهُ","وَٰسِعٌ","عَلِيمٞ"],"٣٢"]]],[3,[["24:33",["وَلۡيَسۡتَعۡفِفِ","ٱلَّذِينَ","لَا","يَجِدُونَ","نِكَاحًا","حَتَّىٰ","يُغۡنِيَهُمُ","ٱللَّهُ","مِن","فَضۡلِهِۦۗ"]]]],[4,[["24:33",["وَٱلَّذِينَ","يَبۡتَغُونَ","ٱلۡكِتَٰبَ","مِمَّا","مَلَكَتۡ","أَيۡمَٰنُكُمۡ","فَكَاتِبُوهُمۡ","إِنۡ"]]]],[5,[["24:33",["عَلِمۡتُمۡ","فِيهِمۡ","خَيۡرٗاۖ","وَءَاتُوهُم","مِّن","مَّالِ","ٱللَّهِ","ٱلَّذِيٓ","ءَاتَىٰكُمۡۚ","وَلَا","تُكۡرِهُواْ"]]]],[6,[["24:33",["فَتَيَٰتِكُمۡ","عَلَى","ٱلۡبِغَآءِ","إِنۡ","أَرَدۡنَ","تَحَصُّنٗا","لِّتَبۡتَغُواْ","عَرَضَ","ٱلۡحَيَوٰةِ"]]]],[7,[["24:33",["ٱلدُّنۡيَاۚ","وَمَن","يُكۡرِههُّنَّ","فَإِنَّ","ٱللَّهَ","مِنۢ","بَعۡدِ","إِكۡرَٰهِهِنَّ","غَفُورٞ","رَّحِيمٞ"]]]],[8,[["24:33",[],"٣٣"],["24:34",["وَلَقَدۡ","أَنزَلۡنَآ","إِلَيۡكُمۡ","ءَايَٰتٖ","مُّبَيِّنَٰتٖ","وَمَثَلٗا","مِّنَ","ٱلَّذِينَ","خَلَوۡاْ"]]]],[9,[["24:34",["مِن","قَبۡلِكُمۡ","وَمَوۡعِظَةٗ","لِّلۡمُتَّقِينَ"],"٣٤"],["24:35",["۞ ٱللَّهُ","نُورُ","ٱلسَّمَٰوَٰتِ","وَٱلۡأَرۡضِۚ"]]]],[10,[["24:35",["مَثَلُ","نُورِهِۦ","كَمِشۡكَوٰةٖ","فِيهَا","مِصۡبَاحٌۖ","ٱلۡمِصۡبَاحُ","فِي","زُجَاجَةٍۖ"]]]],[11,[["24:35",["ٱلزُّجَاجَةُ","كَأَنَّهَا","كَوۡكَبٞ","دُرِّيّٞ","يُوقَدُ","مِن","شَجَرَةٖ","مُّبَٰرَكَةٖ","زَيۡتُونَةٖ"]]]],[12,[["24:35",["لَّا","شَرۡقِيَّةٖ","وَلَا","غَرۡبِيَّةٖ","يَكَادُ","زَيۡتُهَا","يُضِيٓءُ","وَلَوۡ","لَمۡ","تَمۡسَسۡهُ","نَارٞۚ"]]]],[13,[["24:35",["نُّورٌ","عَلَىٰ","نُورٖۚ","يَهۡدِي","ٱللَّهُ","لِنُورِهِۦ","مَن","يَشَآءُۚ","وَيَضۡرِبُ","ٱللَّهُ","ٱلۡأَمۡثَٰلَ"]]]],[14,[["24:35",["لِلنَّاسِۗ","وَٱللَّهُ","بِكُلِّ","شَيۡءٍ","عَلِيمٞ"],"٣٥"],["24:36",["فِي","بُيُوتٍ","أَذِنَ","ٱللَّهُ","أَن","تُرۡفَعَ"]]]],[15,[["24:36",["وَيُذۡكَرَ","فِيهَا","ٱسۡمُهُۥ","يُسَبِّحُ","لَهُۥ","فِيهَا","بِٱلۡغُدُوِّ","وَٱلۡأٓصَالِ"],"٣٦"]]]],"355":[[1,[["24:37",["رِجَالٞ","لَّا","تُلۡهِيهِمۡ","تِجَٰرَةٞ","وَلَا","بَيۡعٌ","عَن","ذِكۡرِ","ٱللَّهِ","وَإِقَامِ","ٱلصَّلَوٰةِ"]]]],[2,[["24:37",["وَإِيتَآءِ","ٱلزَّكَوٰةِ","يَخَافُونَ","يَوۡمٗا","تَتَقَلَّبُ","فِيهِ","ٱلۡقُلُوبُ","وَٱلۡأَبۡصَٰرُ"],"٣٧"]]],[3,[["24:38",["لِيَجۡزِيَهُمُ","ٱللَّهُ","أَحۡسَنَ","مَا","عَمِلُواْ","وَيَزِيدَهُم","مِّن","فَضۡلِهِۦۗ","وَٱللَّهُ"]]]],[4,[["24:38",["يَرۡزُقُ","مَن","يَشَآءُ","بِغَيۡرِ","حِسَابٖ"],"٣٨"],["24:39",["وَٱلَّذِينَ","كَفَرُوٓاْ","أَعۡمَٰلُهُمۡ","كَسَرَابِۭ"]]]],[5,[["24:39",["بِقِيعَةٖ","يَحۡسَبُهُ","ٱلظَّمۡـَٔانُ","مَآءً","حَتَّىٰٓ","إِذَا","جَآءَهُۥ","لَمۡ","يَجِدۡهُ","شَيۡـٔٗا"]]]],[6,[["24:39",["وَوَجَدَ","ٱللَّهَ","عِندَهُۥ","فَوَفَّىٰهُ","حِسَابَهُۥۗ","وَٱللَّهُ","سَرِيعُ","ٱلۡحِسَابِ"],"٣٩"]]],[7,[["24:40",["أَوۡ","كَظُلُمَٰتٖ","فِي","بَحۡرٖ","لُّجِّيّٖ","يَغۡشَىٰهُ","مَوۡجٞ","مِّن","فَوۡقِهِۦ","مَوۡجٞ","مِّن","فَوۡقِهِۦ"]]]],[8,[["24:40",["سَحَابٞۚ","ظُلُمَٰتُۢ","بَعۡضُهَا","فَوۡقَ","بَعۡضٍ","إِذَآ","أَخۡرَجَ","يَدَهُۥ","لَمۡ","يَكَدۡ"]]]],[9,[["24:40",["يَرَىٰهَاۗ","وَمَن","لَّمۡ","يَجۡعَلِ","ٱللَّهُ","لَهُۥ","نُورٗا","فَمَا","لَهُۥ","مِن","نُّورٍ"],"٤٠"],["24:41",["أَلَمۡ","تَرَ","أَنَّ"]]]],[10,[["24:41",["ٱللَّهَ","يُسَبِّحُ","لَهُۥ","مَن","فِي","ٱلسَّمَٰوَٰتِ","وَٱلۡأَرۡضِ","وَٱلطَّيۡرُ","صَٰٓفَّٰتٖۖ","كُلّٞ"]]]],[11,[["24:41",["قَدۡ","عَلِمَ","صَلَاتَهُۥ","وَتَسۡبِيحَهُۥۗ","وَٱللَّهُ","عَلِيمُۢ","بِمَا","يَفۡعَلُونَ"],"٤١"],["24:42",["وَلِلَّهِ","مُلۡكُ"]]]],[12,[["24:42",["ٱلسَّمَٰوَٰتِ","وَٱلۡأَرۡضِۖ","وَإِلَى","ٱللَّهِ","ٱلۡمَصِيرُ"],"٤٢"],["24:43",["أَلَمۡ","تَرَ","أَنَّ","ٱللَّهَ","يُزۡجِي"]]]],[13,[["24:43",["سَحَابٗا","ثُمَّ","يُؤَلِّفُ","بَيۡنَهُۥ","ثُمَّ","يَجۡعَلُهُۥ","رُكَامٗا","فَتَرَى","ٱلۡوَدۡقَ","يَخۡرُجُ","مِنۡ"]]]],[14,[["24:43",["خِلَٰلِهِۦ","وَيُنَزِّلُ","مِنَ","ٱلسَّمَآءِ","مِن","جِبَالٖ","فِيهَا","مِنۢ","بَرَدٖ","فَيُصِيبُ","بِهِۦ","مَن","يَشَآءُ"]]]],[15,[["24:43",["وَيَصۡرِفُهُۥ","عَن","مَّن","يَشَآءُۖ","يَكَادُ","سَنَا","بَرۡقِهِۦ","يَذۡهَبُ","بِٱلۡأَبۡصَٰرِ"],"٤٣"]]]],"356":[[1,[["24:44",["يُقَلِّبُ","ٱللَّهُ","ٱلَّيۡلَ","وَٱلنَّهَارَۚ","إِنَّ","فِي","ذَٰلِكَ","لَعِبۡرَةٗ","لِّأُوْلِي","ٱلۡأَبۡصَٰرِ"],"٤٤"]]],[2,[["24:45",["وَٱللَّهُ","خَلَقَ","كُلَّ","دَآبَّةٖ","مِّن","مَّآءٖۖ","فَمِنۡهُم","مَّن","يَمۡشِي","عَلَىٰ","بَطۡنِهِۦ","وَمِنۡهُم","مَّن"]]]],[3,[["24:45",["يَمۡشِي","عَلَىٰ","رِجۡلَيۡنِ","وَمِنۡهُم","مَّن","يَمۡشِي","عَلَىٰٓ","أَرۡبَعٖۚ","يَخۡلُقُ","ٱللَّهُ","مَا","يَشَآءُۚ"]]]],[4,[["24:45",["إِنَّ","ٱللَّهَ","عَلَىٰ","كُلِّ","شَيۡءٖ","قَدِيرٞ"],"٤٥"],["24:46",["لَّقَدۡ","أَنزَلۡنَآ","ءَايَٰتٖ","مُّبَيِّنَٰتٖۚ"]]]],[5,[["24:46",["وَٱللَّهُ","يَهۡدِي","مَن","يَشَآءُ","إِلَىٰ","صِرَٰطٖ","مُّسۡتَقِيمٖ"],"٤٦"],["24:47",["وَيَقُولُونَ"]]]],[6,[["24:47",["ءَامَنَّا","بِٱللَّهِ","وَبِٱلرَّسُولِ","وَأَطَعۡنَا","ثُمَّ","يَتَوَلَّىٰ","فَرِيقٞ","مِّنۡهُم","مِّنۢ","بَعۡدِ"]]]],[7,[["24:47",["ذَٰلِكَۚ","وَمَآ","أُوْلَٰٓئِكَ","بِٱلۡمُؤۡمِنِينَ"],"٤٧"],["24:48",["وَإِذَا","دُعُوٓاْ","إِلَى","ٱللَّهِ","وَرَسُول