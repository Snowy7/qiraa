{"301":[[1,[["18:63",["قَالَ","اَرَءَيۡتَ","اِذۡ","اَوَيۡنَاۤ","اِلَى","الصَّخۡرَةِ","فَاِنِّىۡ","نَسِيۡتُ","الۡحُوۡتَ"]]]],[2,[["18:63",["وَ مَاۤ","اَنۡسٰٮنِيۡهُ","اِلَّا","الشَّيۡطٰنُ","اَنۡ","اَذۡكُرَهٗ​ ​ۚ","وَاتَّخَذَ","سَبِيۡلَهٗ","فِىۡ"]]]],[3,[["18:63",["الۡبَحۡر​ِ ​ۖ ","عَجَبًا‏"],"٦٣"],["18:64",["قَالَ","ذٰ لِكَ","مَا","كُنَّا","نَبۡغِ ​​ۖ ","فَارۡتَدَّا","عَلٰٓى","اٰثَارِهِمَا"]]]],[4,[["18:64",["قَصَصًا ۙ‏"],"٦٤"],["18:65",["فَوَجَدَا","عَبۡدًا","مِّنۡ","عِبَادِنَاۤ","اٰتَيۡنٰهُ","رَحۡمَةً","مِّنۡ"]]]],[5,[["18:65",["عِنۡدِنَا","وَعَلَّمۡنٰهُ","مِنۡ","لَّدُنَّا","عِلۡمًا‏"],"٦٥"],["18:66",["قَالَ","لَهٗ","مُوۡسٰى","هَلۡ"]]]],[6,[["18:66",["اَتَّبِعُكَ","عَلٰٓى","اَنۡ","تُعَلِّمَنِ","مِمَّا","عُلِّمۡتَ","رُشۡدًا‏"],"٦٦"],["18:67",["قَالَ","اِنَّكَ","لَنۡ"]]]],[7,[["18:67",["تَسۡتَطِيۡعَ","مَعِىَ","صَبۡرًا‏"],"٦٧"],["18:68",["وَكَيۡفَ","تَصۡبِرُ","عَلٰى","مَا","لَمۡ","تُحِطۡ","بِهٖ"]]]],[8,[["18:68",["خُبۡرًا‏"],"٦٨"],["18:69",["قَالَ","سَتَجِدُنِىۡۤ","اِنۡ","شَآءَ","اللّٰهُ","صَابِرًا","وَّلَاۤ","اَعۡصِىۡ"]]]],[9,[["18:69",["لَكَ","اَمۡرًا‏ ﻿﻿"],"٦٩"],["18:70",["قَالَ","فَاِنِ","اتَّبَعۡتَنِىۡ","فَلَا","تَسۡـَٔـلۡنِىۡ","عَنۡ","شَىۡءٍ","حَتّٰٓى"]]]],[10,[["18:70",["اُحۡدِثَ","لَـكَ","مِنۡهُ","ذِكۡرًا‏"],"٧٠"],["18:71",["فَانْطَلَقَا","حَتّٰۤى","اِذَا","رَكِبَا","فِى"]]]],[11,[["18:71",["السَّفِيۡنَةِ","خَرَقَهَا​ ؕ","قَالَ","اَخَرَقۡتَهَا","لِتُغۡرِقَ","اَهۡلَهَا​ ۚ","لَقَدۡ","جِئۡتَ"]]]],[12,[["18:71",["شَيۡــًٔـا","اِمۡرًا‏"],"٧١"],["18:72",["قَالَ","اَلَمۡ","اَقُلۡ","اِنَّكَ","لَنۡ","تَسۡتَطِيۡعَ","مَعِىَ","صَبۡرًا‏"],"٧٢"]]],[13,[["18:73",["قَالَ","لَا","تُؤَاخِذۡنِىۡ","بِمَا","نَسِيۡتُ","وَلَا","تُرۡهِقۡنِىۡ","مِنۡ","اَمۡرِىۡ"]]]],[14,[["18:73",["عُسۡرًا‏ ﻿﻿"],"٧٣"],["18:74",["فَانْطَلَقَا","حَتّٰۤى","اِذَا","لَقِيَا","غُلٰمًا","فَقَتَلَهٗ ۙ","قَالَ"]]]],[15,[["18:74",["اَقَتَلۡتَ","نَـفۡسًا","زَكِيَّةً ۢ","بِغَيۡرِ","نَـفۡسٍ ؕ","لَـقَدۡ","جِئۡتَ","شَيۡــًٔـا","نُّـكۡرًا‏"],"٧٤"]]]],"302":[[1,[["18:75",["۞ قَالَ","اَ لَمۡ","اَ قُلْ","لَّكَ","اِ