{"21":[[1,[["2:135",["وَقَالُوۡا","کُوۡنُوۡا","هُوۡدًا","اَوۡ","نَصٰرٰى","تَهۡتَدُوۡا ​ؕ","قُلۡ","بَلۡ","مِلَّةَ"]]]],[2,[["2:135",["اِبۡرٰهٖمَ","حَنِيۡفًا ​ؕ","وَمَا","كَانَ","مِنَ","الۡمُشۡرِكِيۡنَ‏"],"١٣٥"],["2:136",["قُوۡلُوۡٓا","اٰمَنَّا","بِاللّٰهِ"]]]],[3,[["2:136",["وَمَآ","اُنۡزِلَ","اِلَيۡنَا","وَمَآ","اُنۡزِلَ","اِلٰٓى","اِبۡرٰهٖمَ","وَاِسۡمٰعِيۡلَ","وَاِسۡحٰقَ"]]]],[4,[["2:136",["وَيَعۡقُوۡبَ","وَ الۡاَسۡبَاطِ","وَمَآ","اُوۡتِىَ","مُوۡسٰى","وَعِيۡسٰى","وَمَآ","اُوۡتِىَ"]]]],[5,[["2:136",["النَّبِيُّوۡنَ","مِنۡ","رَّبِّهِمۡ​ۚ","لَا","نُفَرِّقُ","بَيۡنَ","اَحَدٍ","مِّنۡهُمۡ","وَنَحۡنُ","لَهٗ"]]]],[6,[["2:136",["مُسۡلِمُوۡنَ‏"],"١٣٦"],["2:137",["فَاِنۡ","اٰمَنُوۡا","بِمِثۡلِ","مَآ","اٰمَنۡتُمۡ","بِهٖ","فَقَدِ","اهۡتَدَوْا ​ۚ"]]]],[7,[["2:137",["وَاِنۡ","تَوَلَّوۡا","فَاِنَّمَا","هُمۡ","فِىۡ","شِقَاقٍ​ ۚ","فَسَيَكۡفِيۡکَهُمُ","اللّٰهُ ​ۚ","وَهُوَ","السَّمِيۡعُ"]]]],[8,[["2:137",["الۡعَلِيۡمُؕ‏"],"١٣٧"],["2:138",["صِبۡغَةَ","اللّٰهِ ​ۚ","وَمَنۡ","اَحۡسَنُ","مِنَ","اللّٰهِ","صِبۡغَةً ","وَّنَحۡنُ","لَهٗ"]]]],[9,[["2:138",["عٰبِدُوۡنَ‏"],"١٣٨"],["2:139",["قُلۡ","اَ تُحَآجُّوۡنَـنَا","فِى","اللّٰهِ","وَهُوَ","رَبُّنَا","وَرَبُّکُمۡۚ"]]]],[10,[["2:139",["وَلَنَآ","اَعۡمَالُـنَا","وَلَـكُمۡ","اَعۡمَالُكُمۡۚ","وَنَحۡنُ","لَهٗ","مُخۡلِصُوۡنَۙ‏"],"١٣٩"],["2:140",["اَمۡ"]]]],[11,[["2:140",["تَقُوۡلُوۡنَ","اِنَّ","اِبۡرٰهٖمَ","وَاِسۡمٰعِيۡلَ","وَاِسۡحٰقَ","وَيَعۡقُوۡبَ","وَالۡاَسۡبَاطَ"]]]],[12,[["2:140",["كَانُوۡا","هُوۡدًا","اَوۡ","نَصٰرٰى​ؕ","قُلۡ","ءَاَنۡـتُمۡ","اَعۡلَمُ","اَمِ","اللّٰهُ​ ؕ","وَمَنۡ"]]]],[13,[["2:140",["اَظۡلَمُ","مِمَّنۡ","كَتَمَ","شَهَادَةً","عِنۡدَهٗ","مِنَ","اللّٰهِ​ؕ","وَمَا","اللّٰهُ","بِغَافِلٍ"]]]],[14,[["2:140",["عَمَّا","تَعۡمَلُوۡنَ‏"],"١٤٠"],["2:141",["تِلۡكَ","اُمَّةٌ","قَدۡ","خَلَتۡ​ۚ","لَهَا","مَا","كَسَبَتۡ"]]]],[15,[["2:141",["وَلَـكُمۡ","مَّا","كَسَبۡتُمۡ​ۚ","وَلَا","تُسۡـَٔـلُوۡنَ","عَمَّا","كَانُوۡا","يَعۡمَلُوۡنَ‏"],"١٤١"]]]],"22":[[1,[["2:142",["۞ سَيَقُوۡلُ","السُّفَهَآءُ","مِنَ","النَّاسِ","مَا","وَلّٰٮهُمۡ","عَنۡ