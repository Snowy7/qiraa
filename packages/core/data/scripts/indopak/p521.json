],[4,[["57:19",["وَ الَّذِيۡنَ","كَفَرُوۡا","وَكَذَّبُوۡا","بِاٰيٰتِنَاۤ","اُولٰٓٮِٕكَ","اَصۡحٰبُ","الۡجَحِيۡمِ‏"],"١٩"],["57:20",["اِعۡلَمُوۡۤا"]]]],[5,[["57:20",["اَنَّمَا","الۡحَيٰوةُ","الدُّنۡيَا","لَعِبٌ","وَّلَهۡوٌ","وَّزِيۡنَةٌ","وَّتَفَاخُرٌۢ","بَيۡنَكُمۡ","وَتَكَاثُرٌ"]]]],[6,[["57:20",["فِى","الۡاَمۡوَالِ","وَالۡاَوۡلَادِ​ؕ","كَمَثَلِ","غَيۡثٍ","اَعۡجَبَ","الۡكُفَّارَ","نَبَاتُهٗ","ثُمَّ","يَهِيۡجُ"]]]],[7,[["57:20",["فَتَرٰٮهُ","مُصۡفَرًّا","ثُمَّ","يَكُوۡنُ","حُطٰمًا​ؕ","وَفِى","الۡاٰخِرَةِ","عَذَابٌ","شَدِيۡدٌ ۙ"]]]],[8,[["57:20",["وَّمَغۡفِرَةٌ","مِّنَ","اللّٰهِ","وَرِضۡوَانٌ​ؕ","وَمَا","الۡحَيٰوةُ","الدُّنۡيَاۤ","اِلَّا","مَتَاعُ","الۡغُرُوۡرِ‏"],"٢٠"]]],[9,[["57:21",["سَابِقُوۡۤا","اِلٰى","مَغۡفِرَةٍ","مِّنۡ","رَّبِّكُمۡ","وَجَنَّةٍ","عَرۡضُهَا","كَعَرۡضِ","السَّمَآءِ"]]]],[10,[["57:21",["وَالۡاَرۡضِۙ","اُعِدَّتۡ","لِلَّذِيۡنَ","اٰمَنُوۡا","بِاللّٰهِ","وَرُسُلِهٖ​ؕ","ذٰلِكَ","فَضۡلُ","اللّٰهِ"]]]],[11,[["57:21",["يُؤۡتِيۡهِ","مَنۡ","يَّشَآءُ​ؕ","وَاللّٰهُ","ذُو","الۡفَضۡلِ","الۡعَظِيۡمِ‏"],"٢١"],["57:22",["مَاۤ","اَصَابَ","مِنۡ","مُّصِيۡبَةٍ"]]]],[12,[["57:22",["فِى","الۡاَرۡضِ","وَلَا","فِىۡۤ","اَنۡفُسِكُمۡ","اِلَّا","فِىۡ","كِتٰبٍ","مِّنۡ","قَبۡلِ","اَنۡ","نَّبۡـرَاَهَا ؕ","اِنَّ"]]]],[13,[["57:22",["ذٰ لِكَ","عَلَى","اللّٰهِ","يَسِيۡرٌۚ  ۖ‏"],"٢٢"],["57:23",["لِّـكَيۡلَا","تَاۡسَوۡا","عَلٰى","مَا","فَاتَكُمۡ","وَلَا","تَفۡرَحُوۡا","بِمَاۤ"]]]],[14,[["57:23",["اٰتٰٮكُمۡ​ؕ","وَاللّٰهُ","لَا","يُحِبُّ","كُلَّ","مُخۡتَالٍ","فَخُوۡرِۙ‏"],"٢٣"],["57:24",["اۨلَّذِيۡنَ","يَبۡخَلُوۡنَ","وَيَاۡمُرُوۡنَ"]]]],[15,[["57:24",["النَّاسَ","بِالۡبُخۡلِ​ؕ","وَمَنۡ","يَّتَوَلَّ","فَاِنَّ","اللّٰهَ","هُوَ","الۡغَنِىُّ","الۡحَمِيۡدُ‏"],"٢٤"]]]]}