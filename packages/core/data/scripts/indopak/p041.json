{"41":[[1,[["2:248",["وَقَالَ","لَهُمۡ","نَبِيُّهُمۡ","اِنَّ","اٰيَةَ","مُلۡکِهٖۤ","اَنۡ","يَّاۡتِيَکُمُ","التَّابُوۡتُ","فِيۡهِ"]]]],[2,[["2:248",["سَکِيۡنَةٌ","مِّنۡ","رَّبِّکُمۡ","وَبَقِيَّةٌ","مِّمَّا","تَرَكَ","اٰلُ","مُوۡسٰى","وَاٰلُ","هٰرُوۡنَ"]]]],[3,[["2:248",["تَحۡمِلُهُ","الۡمَلٰٓٮِٕكَةُ​ ؕ","اِنَّ","فِىۡ","ذٰلِكَ","لَاٰيَةً","لَّـکُمۡ","اِنۡ","كُنۡتُمۡ","مُّؤۡمِنِيۡنَ‏"],"٢٤٨"]]],[4,[["2:249",["فَلَمَّا","فَصَلَ","طَالُوۡتُ","بِالۡجُـنُوۡدِۙ","قَالَ","اِنَّ","اللّٰهَ","مُبۡتَلِيۡکُمۡ","بِنَهَرٍ​ۚ"]]]],[5,[["2:249",["فَمَنۡ","شَرِبَ","مِنۡهُ","فَلَيۡسَ","مِنِّىۡ​ۚ","وَمَنۡ","لَّمۡ","يَطۡعَمۡهُ","فَاِنَّهٗ","مِنِّىۡٓ","اِلَّا"]]]],[6,[["2:249",["مَنِ","اغۡتَرَفَ","غُرۡفَةً ۢ","بِيَدِهٖ​​ۚ","فَشَرِبُوۡا","مِنۡهُ","اِلَّا","قَلِيۡلًا","مِّنۡهُمۡ​ؕ","فَلَمَّا"]]]],[7,[["2:249",["جَاوَزَهٗ","هُوَ","وَالَّذِيۡنَ","اٰمَنُوۡا","مَعَهٗ ۙ","قَالُوۡا","لَا","طَاقَةَ","لَنَا","الۡيَوۡمَ","بِجَالُوۡتَ"]]]],[8,[["2:249",["وَجُنُوۡدِهٖ​ؕ","قَالَ","الَّذِيۡنَ","يَظُنُّوۡنَ","اَنَّهُمۡ","مُّلٰقُوا","اللّٰهِۙ","کَمۡ","مِّنۡ","فِئَةٍ"]]]],[9,[["2:249",["قَلِيۡلَةٍ","غَلَبَتۡ","فِئَةً","کَثِيۡرَةً ۢ","بِاِذۡنِ","اللّٰهِ​ؕ","وَاللّٰهُ","مَعَ","الصّٰبِرِيۡنَ‏"],"٢٤٩"]]],[10,[["2:250",["وَلَمَّا","بَرَزُوۡا","لِجَـالُوۡتَ","وَجُنُوۡدِهٖ","قَالُوۡا","رَبَّنَآ","اَفۡرِغۡ","عَلَيۡنَا","صَبۡرًا"]]]],[11,[["2:250",["وَّثَبِّتۡ","اَقۡدَامَنَا","وَانۡصُرۡنَا","عَلَى","الۡقَوۡمِ","الۡکٰفِرِيۡنَؕ‏"],"٢٥٠"],["2:251",["فَهَزَمُوۡهُمۡ"]]]],[12,[["2:251",["بِاِذۡنِ","اللّٰهِ ۙ","وَقَتَلَ","دَاوٗدُ","جَالُوۡتَ","وَاٰتٰٮهُ","اللّٰهُ","الۡمُلۡكَ","وَالۡحِکۡمَةَ"]]]],[13,[["2:251",["وَعَلَّمَهٗ","مِمَّا","يَشَآءُ ​ؕ","وَلَوۡلَا","دَفۡعُ","اللّٰهِ","النَّاسَ","بَعۡضَهُمۡ","بِبَعۡضٍ"]]]],[14,[["2:251",["لَّفَسَدَتِ","الۡاَرۡضُ","وَلٰـکِنَّ","اللّٰهَ","ذُوۡ","فَضۡلٍ","عَلَى","الۡعٰلَمِيۡنَ‏"],"٢٥١"],["2:252",["تِلۡكَ"]]]],[15,[["2:252",["اٰيٰتُ","اللّٰهِ","نَـتۡلُوۡهَا","عَلَيۡكَ","بِالۡحَـقِّ​ؕ","وَاِنَّكَ","لَمِنَ","الۡمُرۡسَلِيۡنَ‏"],"٢٥٢"]]]],"42":[[1,[["2:253",["۞ تِلۡكَ","الرُّسُلُ","فَض