{"241":[[1,[["12:44",["قَالُوۡۤا","اَضۡغَاثُ","اَحۡلَامٍۚ","وَمَا","نَحۡنُ","بِتَاۡوِيۡلِ","الۡاَحۡلَامِ","بِعٰلِمِيۡنَ‏ ﻿﻿"],"٤٤"]]],[2,[["12:45",["وَقَالَ","الَّذِىۡ","نَجَا","مِنۡهُمَا","وَادَّكَرَ","بَعۡدَ","اُمَّةٍ","اَنَا","اُنَـبِّئُكُمۡ","بِتَاۡوِيۡلِهٖ"]]]],[3,[["12:45",["فَاَرۡسِلُوۡنِ‏"],"٤٥"],["12:46",["يُوۡسُفُ","اَيُّهَا","الصِّدِّيۡقُ","اَ فۡتِنَا","فِىۡ","سَبۡعِ","بَقَرٰتٍ"]]]],[4,[["12:46",["سِمَانٍ","يَّاۡكُلُهُنَّ","سَبۡعٌ","عِجَافٌ","وَّسَبۡعِ","سُنۡۢبُلٰتٍ","خُضۡرٍ","وَّاُخَرَ"]]]],[5,[["12:46",["يٰبِسٰتٍ ۙ","لَّعَلِّىۡۤ","اَرۡجِعُ","اِلَى","النَّاسِ","لَعَلَّهُمۡ","يَعۡلَمُوۡنَ‏"],"٤٦"],["12:47",["قَالَ","تَزۡرَعُوۡنَ"]]]],[6,[["12:47",["سَبۡعَ","سِنِيۡنَ","دَاَبًا​ۚ","فَمَا","حَصَدْتُّمۡ","فَذَرُوۡهُ","فِىۡ","سُنۡۢبُلِهٖۤ","اِلَّا","قَلِيۡلًا"]]]],[7,[["12:47",["مِّمَّا","تَاۡكُلُوۡنَ‏"],"٤٧"],["12:48",["ثُمَّ","يَاۡتِىۡ","مِنۡۢ","بَعۡدِ","ذٰلِكَ","سَبۡعٌ","شِدَادٌ","يَّاۡكُلۡنَ","مَا"]]]],[8,[["12:48",["قَدَّمۡتُمۡ","لَهُنَّ","اِلَّا","قَلِيۡلًا","مِّمَّا","تُحۡصِنُوۡنَ‏"],"٤٨"],["12:49",["ثُمَّ","يَاۡتِىۡ","مِنۡۢ","بَعۡدِ","ذٰلِكَ"]]]],[9,[["12:49",["عَامٌ","فِيۡهِ","يُغَاثُ","النَّاسُ","وَفِيۡهِ","يَعۡصِرُوۡنَ‏"],"٤٩"],["12:50",["وَقَالَ","الۡمَلِكُ","ائۡتُوۡنِىۡ"]]]],[10,[["12:50",["بِهٖ​ۚ","فَلَمَّا","جَآءَهُ","الرَّسُوۡلُ","قَالَ","ارۡجِعۡ","اِلٰى","رَبِّكَ","فَسۡــَٔلۡهُ","مَا","بَالُ"]]]],[11,[["12:50",["النِّسۡوَةِ","الّٰتِىۡ","قَطَّعۡنَ","اَيۡدِيَهُنَّ​ؕ","اِنَّ","رَبِّىۡ","بِكَيۡدِهِنَّ","عَلِيۡمٌ‏"],"٥٠"]]],[12,[["12:51",["قَالَ","مَا","خَطۡبُكُنَّ","اِذۡ","رَاوَدْتُّنَّ","يُوۡسُفَ","عَنۡ","نَّـفۡسِهٖ​ؕ","قُلۡنَ","حَاشَ","لِلّٰهِ"]]]],[13,[["12:51",["مَا","عَلِمۡنَا","عَلَيۡهِ","مِنۡ","سُوۡۤءٍ​ ؕ","قَالَتِ","امۡرَاَتُ","الۡعَزِيۡزِ","الۡــٰٔنَ","حَصۡحَصَ","الۡحَقُّ"]]]],[14,[["12:51",["اَنَا","رَاوَدْتُّهٗ","عَنۡ","نَّـفۡسِهٖ","وَاِنَّهٗ","لَمِنَ","الصّٰدِقِيۡنَ‏"],"٥١"],["12:52",["ذٰ لِكَ","لِيَـعۡلَمَ"]]]],[15,[["12:52",["اَنِّىۡ","لَمۡ","اَخُنۡهُ","بِالۡغَيۡبِ","وَاَنَّ","اللّٰهَ","لَا","يَهۡدِىۡ","كَيۡدَ","الۡخَـآٮِٕنِيۡنَ‏