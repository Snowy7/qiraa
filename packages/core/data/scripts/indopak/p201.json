,["اِلَّا","عَنۡ","مَّوۡعِدَةٍ","وَّعَدَهَاۤ","اِيَّاهُ​ ۚ","فَلَمَّا","تَبَيَّنَ","لَهٗۤ","اَنَّهٗ"]]]],[8,[["9:114",["عَدُوٌّ","لِّلّٰهِ","تَبَرَّاَ","مِنۡهُ​ ؕ","اِنَّ","اِبۡرٰهِيۡمَ","لَاَوَّاهٌ","حَلِيۡمٌ‏"],"١١٤"],["9:115",["وَمَا"]]]],[9,[["9:115",["كَانَ","اللّٰهُ","لِيُـضِلَّ","قَوۡمًۢا","بَعۡدَ","اِذۡ","هَدٰٮهُمۡ","حَتّٰى","يُبَيِّنَ"]]]],[10,[["9:115",["لَهُمۡ","مَّا","يَتَّقُوۡنَ​ؕ","اِنَّ","اللّٰهَ","بِكُلِّ","شَىۡءٍ","عَلِيۡمٌ‏"],"١١٥"],["9:116",["اِنَّ","اللّٰهَ"]]]],[11,[["9:116",["لَهٗ","مُلۡكُ","السَّمٰوٰتِ","وَالۡاَرۡضِ​ؕ","يُحۡىٖ","وَيُمِيۡتُ​ؕ","وَمَا","لَـكُمۡ"]]]],[12,[["9:116",["مِّنۡ","دُوۡنِ","اللّٰهِ","مِنۡ","وَّلِىٍّ","وَّلَا","نَصِيۡرٍ‏"],"١١٦"],["9:117",["لَـقَدْ","تَّابَ","اللّٰهُ"]]]],[13,[["9:117",["عَلَى","النَّبِىِّ","وَالۡمُهٰجِرِيۡنَ","وَالۡاَنۡصَارِ","الَّذِيۡنَ","اتَّبَعُوۡهُ","فِىۡ"]]]],[14,[["9:117",["سَاعَةِ","الۡعُسۡرَةِ","مِنۡۢ","بَعۡدِ","مَا","كَادَ","يَزِيۡغُ","قُلُوۡبُ","فَرِيۡقٍ"]]]],[15,[["9:117",["مِّنۡهُمۡ","ثُمَّ","تَابَ","عَلَيۡهِمۡ​ؕ","اِنَّهٗ","بِهِمۡ","رَءُوۡفٌ","رَّحِيۡمٌۙ ‏"],"١١٧"]]]],"206":[[1,[["9:118",["وَّعَلَى","الثَّلٰثَةِ","الَّذِيۡنَ","خُلِّفُوۡا ؕ","حَتّٰۤى","اِذَا","ضَاقَتۡ","عَلَيۡهِمُ"]]]],[2,[["9:118",["الۡاَرۡضُ","بِمَا","رَحُبَتۡ","وَضَاقَتۡ","عَلَيۡهِمۡ","اَنۡفُسُهُمۡ","وَظَنُّوۡۤا","اَنۡ"]]]],[3,[["9:118",["لَّا","مَلۡجَاَ","مِنَ","اللّٰهِ","اِلَّاۤ","اِلَيۡهِ ؕ","ثُمَّ","تَابَ","عَلَيۡهِمۡ","لِيَتُوۡبُوۡا ​ ؕ","اِنَّ"]]]],[4,[["9:118",["اللّٰهَ","هُوَ","التَّوَّابُ","الرَّحِيۡمُ‏"],"١١٨"],["9:119",["يٰۤـاَيُّهَا","الَّذِيۡنَ","اٰمَنُوا","اتَّقُوا"]]]],[5,[["9:119",["اللّٰهَ","وَكُوۡنُوۡا","مَعَ","الصّٰدِقِيۡنَ‏ ﻿﻿"],"١١٩"],["9:120",["مَا","كَانَ","لِاَهۡلِ","الۡمَدِيۡنَةِ"]]]],[6,[["9:120",["وَمَنۡ","حَوۡلَهُمۡ","مِّنَ","الۡاَعۡرَابِ","اَنۡ","يَّتَخَلَّفُوۡا","عَنۡ","رَّسُوۡلِ","اللّٰهِ"]]]],[7,[["9:120",["وَ لَا","يَرۡغَبُوۡا","بِاَنۡفُسِهِمۡ","عَنۡ","نَّـفۡسِهٖ ​ؕ","ذٰ لِكَ","بِاَنَّهُمۡ","لَا","يُصِيۡبُهُمۡ"]]]],[8,[["9:120",["ظَمَاٌ","وَّلَا","نَصَبٌ","وَّلَا","مَخۡمَصَةٌ","فِىۡ","سَبِ