{"201":[[1,[["9:87",["رَضُوۡا","بِاَنۡ","يَّكُوۡنُوۡا","مَعَ","الۡخَوَالِفِ","وَطُبِعَ","عَلٰى","قُلُوۡبِهِمۡ"]]]],[2,[["9:87",["فَهُمۡ","لَا","يَفۡقَهُوۡنَ‏"],"٨٧"],["9:88",["لٰـكِنِ","الرَّسُوۡلُ","وَالَّذِيۡنَ","اٰمَنُوۡا","مَعَهٗ"]]]],[3,[["9:88",["جَاهَدُوۡا","بِاَمۡوَالِهِمۡ","وَاَنۡفُسِهِمۡ​ؕ","وَاُولٰۤٮِٕكَ","لَهُمُ","الۡخَيۡـرٰتُ​"]]]],[4,[["9:88",["وَاُولٰۤٮِٕكَ","هُمُ","الۡمُفۡلِحُوۡنَ‏ ﻿﻿"],"٨٨"],["9:89",["اَعَدَّ","اللّٰهُ","لَهُمۡ","جَنّٰتٍ","تَجۡرِىۡ"]]]],[5,[["9:89",["مِنۡ","تَحۡتِهَا","الۡاَنۡهٰرُ","خٰلِدِيۡنَ","فِيۡهَا​ ؕ","ذٰ لِكَ","الۡـفَوۡزُ","الۡعَظِيۡمُ‏"],"٨٩"]]],[6,[["9:90",["وَ جَآءَ","الۡمُعَذِّرُوۡنَ","مِنَ","الۡاَعۡرَابِ","لِيُؤۡذَنَ","لَهُمۡ","وَقَعَدَ","الَّذِيۡنَ"]]]],[7,[["9:90",["كَذَبُوا","اللّٰهَ","وَرَسُوۡلَهٗ​ ؕ","سَيُصِيۡبُ","الَّذِيۡنَ","كَفَرُوۡا","مِنۡهُمۡ"]]]],[8,[["9:90",["عَذَابٌ","اَ لِيۡمٌ‏"],"٩٠"],["9:91",["لَـيۡسَ","عَلَى","الضُّعَفَآءِ","وَلَا","عَلَى","الۡمَرۡضٰى","وَلَا"]]]],[9,[["9:91",["عَلَى","الَّذِيۡنَ","لَا","يَجِدُوۡنَ","مَا","يُنۡفِقُوۡنَ","حَرَجٌ","اِذَا","نَصَحُوۡا","لِلّٰهِ"]]]],[10,[["9:91",["وَ رَسُوۡلِهٖ​ؕ","مَا","عَلَى","الۡمُحۡسِنِيۡنَ","مِنۡ","سَبِيۡلٍ​ؕ","وَاللّٰهُ","غَفُوۡرٌ"]]]],[11,[["9:91",["رَّحِيۡمٌۙ‏"],"٩١"],["9:92",["وَّلَا","عَلَى","الَّذِيۡنَ","اِذَا","مَاۤ","اَتَوۡكَ","لِتَحۡمِلَهُمۡ","قُلۡتَ"]]]],[12,[["9:92",["لَاۤ","اَجِدُ","مَاۤ","اَحۡمِلُكُمۡ","عَلَيۡهِ","تَوَلَّوْا","وَّاَعۡيُنُهُمۡ","تَفِيۡضُ","مِنَ"]]]],[13,[["9:92",["الدَّمۡعِ","حَزَنًا","اَلَّا","يَجِدُوۡا","مَا","يُنۡفِقُوۡنَؕ‏"],"٩٢"],["9:93",["۞ اِنَّمَا","السَّبِيۡلُ","عَلَى"]]]],[14,[["9:93",["الَّذِيۡنَ","يَسۡتَاْذِنُوۡنَكَ","وَهُمۡ","اَغۡنِيَآءُ​ۚ","رَضُوۡا","بِاَنۡ","يَّكُوۡنُوۡا"]]]],[15,[["9:93",["مَعَ","الۡخَـوَالِفِۙ","وَطَبَعَ","اللّٰهُ","عَلٰى","قُلُوۡبِهِمۡ","فَهُمۡ","لَا","يَعۡلَمُوۡنَ‏"],"٩٣"]]]],"202":[[1,[["9:94",["يَعۡتَذِرُوۡنَ","اِلَيۡكُمۡ","اِذَا","رَجَعۡتُمۡ","اِلَيۡهِمۡ​ ؕ","قُلْ","لَّا"]]]],[2,[["9:94",["تَعۡتَذِرُوۡا","لَنۡ","نُّـؤۡمِنَ","لَـكُمۡ","قَدۡ","نَـبَّاَنَا","اللّٰهُ","مِنۡ","اَخۡبَار