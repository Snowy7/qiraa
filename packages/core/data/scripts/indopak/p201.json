,[11,[["9:127",["ثُمَّ","انْصَرَفُوۡا​ ؕ","صَرَفَ","اللّٰهُ","قُلُوۡبَهُمۡ","بِاَنَّهُمۡ","قَوۡمٌ","لَّا"]]]],[12,[["9:127",["يَفۡقَهُوۡنَ‏"],"١٢٧"],["9:128",["لَـقَدۡ","جَآءَكُمۡ","رَسُوۡلٌ","مِّنۡ","اَنۡفُسِكُمۡ","عَزِيۡزٌ"]]]],[13,[["9:128",["عَلَيۡهِ","مَا","عَنِتُّمۡ","حَرِيۡصٌ","عَلَيۡكُمۡ","بِالۡمُؤۡمِنِيۡنَ","رَءُوۡفٌ"]]]],[14,[["9:128",["رَّحِيۡمٌ‏"],"١٢٨"],["9:129",["فَاِنۡ","تَوَلَّوۡا","فَقُلۡ","حَسۡبِىَ","اللّٰهُ ۖ ","لَاۤ","اِلٰهَ","اِلَّا"]]]],[15,[["9:129",["هُوَ ؕ","عَلَيۡهِ","تَوَكَّلۡتُ​ ؕ","وَهُوَ","رَبُّ","الۡعَرۡشِ","الۡعَظِيۡمِ‏"],"١٢٩"]]]],"208":[[3,[["10:1",["الٓر​","تِلۡكَ","اٰيٰتُ","الۡكِتٰبِ","الۡحَكِيۡمِ‏"],"١"],["10:2",["اَكَانَ","لِلنَّاسِ","عَجَبًا","اَنۡ","اَوۡحَيۡنَاۤ"]]]],[4,[["10:2",["اِلٰى","رَجُلٍ","مِّنۡهُمۡ","اَنۡ","اَنۡذِرِ","النَّاسَ","وَبَشِّرِ","الَّذِيۡنَ","اٰمَنُوۡۤا","اَنَّ","لَهُمۡ"]]]],[5,[["10:2",["قَدَمَ","صِدۡقٍ","عِنۡدَ","رَبِّهِمۡ​ؕ","قَالَ","الۡكٰفِرُوۡنَ","اِنَّ","هٰذَا","لَسٰحِرٌ","مُّبِيۡنٌ‏"],"٢"]]],[6,[["10:3",["اِنَّ","رَبَّكُمُ","اللّٰهُ","الَّذِىۡ","خَلَقَ","السَّمٰوٰتِ","وَالۡاَرۡضَ","فِىۡ","سِتَّةِ","اَيَّامٍ"]]]],[7,[["10:3",["ثُمَّ","اسۡتَوٰى","عَلَى","الۡعَرۡشِ​","يُدَبِّرُ","الۡاَمۡرَ​ؕ","مَا","مِنۡ","شَفِيۡعٍ","اِلَّا","مِنۡۢ"]]]],[8,[["10:3",["بَعۡدِ","اِذۡنِهٖ​ ؕ","ذٰ لِكُمُ","اللّٰهُ","رَبُّكُمۡ","فَاعۡبُدُوۡهُ​ ؕ","اَفَلَا","تَذَكَّرُوۡنَ‏"],"٣"],["10:4",["اِلَيۡهِ"]]]],[9,[["10:4",["مَرۡجِعُكُمۡ","جَمِيۡعًا ​ؕ","وَعۡدَ","اللّٰهِ","حَقًّا​ ؕ","اِنَّهٗ","يَـبۡدَؤُا","الۡخَـلۡقَ","ثُمَّ","يُعِيۡدُهٗ"]]]],[10,[["10:4",["لِيَجۡزِىَ","الَّذِيۡنَ","اٰمَنُوۡا","وَعَمِلُوا","الصّٰلِحٰتِ","بِالۡقِسۡطِ​ؕ","وَالَّذِيۡنَ","كَفَرُوۡا"]]]],[11,[["10:4",["لَهُمۡ","شَرَابٌ","مِّنۡ","حَمِيۡمٍ","وَّعَذَابٌ","اَلِيۡمٌۢ","بِمَا","كَانُوۡا","يَكۡفُرُوۡنَ‏"],"٤"]]],[12,[["10:5",["هُوَ","الَّذِىۡ","جَعَلَ","الشَّمۡسَ","ضِيَآءً","وَّالۡقَمَرَ","نُوۡرًا","وَّقَدَّرَهٗ","مَنَازِلَ"]]]],[13,[["10:5",["لِتَعۡلَمُوۡا","عَدَدَ","السِّنِيۡنَ","وَالۡحِسَابَ​ؕ","مَا","خَلَقَ","اللّٰهُ","ذٰلِكَ","اِلَّا","بِالۡحَـقِّ​ۚ"]]