,[5,[["59:6",["اللّٰهَ","يُسَلِّطُ","رُسُلَهٗ","عَلٰى","مَنۡ","يَّشَآءُ ​ؕ","وَاللّٰهُ","عَلٰى","كُلِّ","شَىۡءٍ","قَدِيۡرٌ‏"],"٦"]]],[6,[["59:7",["مَاۤ","اَفَآءَ","اللّٰهُ","عَلٰى","رَسُوۡلِهٖ","مِنۡ","اَهۡلِ","الۡقُرٰى","فَلِلّٰهِ","وَلِلرَّسُوۡلِ"]]]],[7,[["59:7",["وَلِذِى","الۡقُرۡبٰى","وَالۡيَتٰمٰى","وَالۡمَسٰكِيۡنِ","وَابۡنِ","السَّبِيۡلِۙ","كَىۡ","لَا","يَكُوۡنَ"]]]],[8,[["59:7",["دُوۡلَةًۢ","بَيۡنَ","الۡاَغۡنِيَآءِ","مِنۡكُمۡ​ ؕ","وَمَاۤ","اٰتٰٮكُمُ","الرَّسُوۡلُ","فَخُذُوْهُ","وَ مَا"]]]],[9,[["59:7",["نَهٰٮكُمۡ","عَنۡهُ","فَانْتَهُوۡا​ ۚ","وَاتَّقُوا","اللّٰهَ ​ؕ","اِنَّ","اللّٰهَ","شَدِيۡدُ","الۡعِقَابِ​ۘ‏"],"٧"]]],[10,[["59:8",["لِلۡفُقَرَآءِ","الۡمُهٰجِرِيۡنَ","الَّذِيۡنَ","اُخۡرِجُوۡا","مِنۡ","دِيَارِهِمۡ","وَاَمۡوَالِهِمۡ"]]]],[11,[["59:8",["يَبۡتَغُوۡنَ","فَضۡلًا","مِّنَ","اللّٰهِ","وَرِضۡوَانًا","وَّيَنۡصُرُوۡنَ","اللّٰهَ","وَرَسُوۡلَهٗ​ؕ"]]]],[12,[["59:8",["اُولٰٓٮِٕكَ","هُمُ","الصّٰدِقُوۡنَ​ۚ‏"],"٨"],["59:9",["وَالَّذِيۡنَ","تَبَوَّؤُ","الدَّارَ","وَالۡاِيۡمَانَ","مِنۡ"]]]],[13,[["59:9",["قَبۡلِهِمۡ","يُحِبُّوۡنَ","مَنۡ","هَاجَرَ","اِلَيۡهِمۡ","وَلَا","يَجِدُوۡنَ","فِىۡ","صُدُوۡرِهِمۡ"]]]],[14,[["59:9",["حَاجَةً","مِّمَّاۤ","اُوۡتُوۡا","وَيُـؤۡثِرُوۡنَ","عَلٰٓى","اَنۡفُسِهِمۡ","وَلَوۡ","كَانَ","بِهِمۡ"]]]],[15,[["59:9",["خَصَاصَةٌ ؕ","وَمَنۡ","يُّوۡقَ","شُحَّ","نَـفۡسِهٖ","فَاُولٰٓٮِٕكَ","هُمُ","الۡمُفۡلِحُوۡنَ​ۚ‏"],"٩"]]]],"547":[[1,[["59:10",["وَالَّذِيۡنَ","جَآءُوۡ","مِنۡۢ","بَعۡدِهِمۡ","يَقُوۡلُوۡنَ","رَبَّنَا","اغۡفِرۡ","لَـنَا","وَلِاِخۡوَانِنَا"]]]],[2,[["59:10",["الَّذِيۡنَ","سَبَقُوۡنَا","بِالۡاِيۡمَانِ","وَلَا","تَجۡعَلۡ","فِىۡ","قُلُوۡبِنَا","غِلًّا","لِّلَّذِيۡنَ"]]]],[3,[["59:10",["اٰمَنُوۡا","رَبَّنَاۤ","اِنَّكَ","رَءُوۡفٌ","رَّحِيۡمٌ‏"],"١٠"],["59:11",["۞ اَلَمۡ","تَرَ","اِلَى","الَّذِيۡنَ","نَافَقُوۡا"]]]],[4,[["59:11",["يَقُوۡلُوۡنَ","لِاِخۡوَانِهِمُ","الَّذِيۡنَ","كَفَرُوۡا","مِنۡ","اَهۡلِ","الۡكِتٰبِ","لَٮِٕنۡ"]]]],[5,[["59:11",["اُخۡرِجۡتُمۡ","لَنَخۡرُجَنَّ","مَعَكُمۡ","وَلَا","نُطِيۡعُ","فِيۡكُمۡ","اَحَدًا","اَبَدًاۙ"]]]],[6,[["59:11",["وَّاِنۡ","قُوۡتِلۡتُمۡ","لَـنَـنۡصُرَنَّكُمۡ ؕ","وَاللّٰهُ","يَشۡهَدُ","اِنَّهُمۡ","لَـكٰذِبُوۡنَ‏"],"١١"]]],[7,[["59:12",["لَٮِٕنۡ","اُخۡرِجُوۡا","لَا","يَخۡرُجُوۡنَ","مَعَهُمۡ​ۚ","وَلَٮِٕنۡ","قُوۡتِلُوۡا","لَا","يَنۡصُرُوۡنَهُمۡ​ۚ"]]]],[8,[["59:12",["وَلَٮِٕنۡ","نَّصَرُوۡهُمۡ","لَيُوَلُّنَّ","الۡاَدۡبَارَ","ثُمَّ","لَا","يُنۡصَرُوۡنَ‏"],"١٢"],["59:13",["لَاَنۡتُمۡ"]]]],[9,[["59:13",["اَشَدُّ","رَهۡبَةً","فِىۡ","صُدُوۡرِهِمۡ","مِّنَ","اللّٰهِ​ؕ","ذٰلِكَ","بِاَنَّهُمۡ","قَوۡمٌ","لَّا"]]]],[10,[["59:13",["يَفۡقَهُوۡنَ‏"],"١٣"],["59:14",["لَا","يُقَاتِلُوۡنَكُمۡ","جَمِيۡعًا","اِلَّا","فِىۡ","قُرًى","مُّحَصَّنَةٍ"]]]],[11,[["59:14",["اَوۡ","مِنۡ","وَّرَآءِ","جُدُرٍؕ","بَاۡسُهُمۡ","بَيۡنَهُمۡ","شَدِيۡدٌ ​ؕ","تَحۡسَبُهُمۡ","جَمِيۡعًا"]]]],[12,[["59:14",["وَّقُلُوۡبُهُمۡ","شَتّٰى​ؕ","ذٰلِكَ","بِاَنَّهُمۡ","قَوۡمٌ","لَّا","يَعۡقِلُوۡنَ​ۚ‏"],"١٤"],["59:15",["كَمَثَلِ"]]]],[13,[["59:15",["الَّذِيۡنَ","مِنۡ","قَبۡلِهِمۡ","قَرِيۡبًا​","ذَاقُوۡا","وَبَالَ","اَمۡرِهِمۡ​ۚ","وَلَهُمۡ","عَذَابٌ"]]]],[14,[["59:15",["اَلِيۡمٌ​ۚ‏"],"١٥"],["59:16",["كَمَثَلِ","الشَّيۡطٰنِ","اِذۡ","قَالَ","لِلۡاِنۡسَانِ","اكۡفُرۡ​ۚ","فَلَمَّا","كَفَرَ"]]]],[15,[["59:16",["قَالَ","اِنِّىۡ","بَرِىۡٓءٌ","مِّنۡكَ","اِنِّىۡۤ","اَخَافُ","اللّٰهَ","رَبَّ","الۡعٰلَمِيۡنَ‏"],"١٦"]]]],"548":[[1,[["59:17",["فَكَانَ","عَاقِبَتَهُمَاۤ","اَنَّهُمَا","فِى","النَّارِ","خَالِدَيۡنِ","فِيۡهَا​ ؕ","وَذٰ لِكَ"]]]],[2,[["59:17",["جَزٰٓؤُا","الظّٰلِمِيۡن‏"],"١٧"],["59:18",["يٰۤاَيُّهَا","الَّذِيۡنَ","اٰمَنُوۡا","اتَّقُوا","اللّٰهَ"]]]],[3,[["59:18",["وَلۡتَـنۡظُرۡ","نَـفۡسٌ","مَّا","قَدَّمَتۡ","لِغَدٍ​ ۚ","وَاتَّقُوا","اللّٰهَ​ؕ","اِنَّ","اللّٰهَ"]]]],[4,[["59:18",["خَبِيۡرٌۢ","بِمَا","تَعۡمَلُوۡنَ‏ ﻿﻿"],"١٨"],["59:19",["وَلَا","تَكُوۡنُوۡا","كَالَّذِيۡنَ","نَسُوا","اللّٰهَ"]]]],[5,[["59:19",["فَاَنۡسٰٮهُمۡ","اَنۡفُسَهُمۡ​ؕ","اُولٰٓٮِٕكَ","هُمُ","الۡفٰسِقُوۡنَ‏"],"١٩"],["59:20",["لَا","يَسۡتَوِىۡۤ"]]]],[6,[["59:20",["اَصۡحٰبُ","النَّارِ","وَاَصۡحٰبُ","الۡجَـنَّةِ​ؕ","اَصۡحٰبُ","الۡجَـنَّةِ","هُمُ"]]]],[7,[["59:20",["الۡفَآٮِٕزُوۡنَ‏"],"٢٠"],["59:21",["لَوۡ","اَنۡزَلۡنَا","هٰذَا","الۡقُرۡاٰنَ","عَلٰى","جَبَلٍ","لَّرَاَيۡتَهٗ"]]]],[8,[["59:21",["خَاشِعًا","مُّتَصَدِّعًا","مِّنۡ","خَشۡيَةِ","اللّٰهِ​ؕ","وَتِلۡكَ","الۡاَمۡثَالُ"]]]],[9,[["59:21",["نَضۡرِبُهَا","لِلنَّاسِ","لَعَلَّهُمۡ","يَتَفَكَّرُوۡنَ‏"],"٢١"],["59:22",["هُوَ","اللّٰهُ","الَّذِىۡ"]]]],[10,[["59:22",["لَاۤ","اِلٰهَ","اِلَّا","هُوَ​ ۚ","عٰلِمُ","الۡغَيۡبِ","وَالشَّهَادَةِ​ ۚ","هُوَ","الرَّحۡمٰنُ"]]]],[11,[["59:22",["الرَّحِيۡمُ‏"],"٢٢"],["59:23",["هُوَ","اللّٰهُ","الَّذِىۡ","لَاۤ","اِلٰهَ","اِلَّا","هُوَ​ۚ","اَلۡمَلِكُ","الۡقُدُّوۡسُ"]]]],[12,[["59:23",["السَّلٰمُ","الۡمُؤۡمِنُ","الۡمُهَيۡمِنُ","الۡعَزِيۡزُ","الۡجَـبَّارُ","الۡمُتَكَبِّرُ​ؕ"]]]],[13,[["59:23",["سُبۡحٰنَ","اللّٰهِ","عَمَّا","يُشۡرِكُوۡنَ‏"],"٢٣"],["59:24",["هُوَ","اللّٰهُ","الۡخَـالِـقُ","الۡبَارِئُ"]]]],[14,[["59:24",["الۡمُصَوِّرُ​","لَـهُ","الۡاَسۡمَآءُ","الۡحُسۡنٰى​ؕ","يُسَبِّحُ","لَهٗ","مَا","فِى","السَّمٰوٰتِ"]]]],[15,[["59:24",["وَالۡاَرۡضِ​ۚ","وَهُوَ","الۡعَزِيۡزُ","الۡحَكِيۡمُ‏ ﻿﻿"],"٢٤"]]]],"549":[[3,[["60:1",["يٰۤاَيُّهَا","الَّذِيۡنَ","اٰمَنُوۡا","لَا","تَتَّخِذُوۡا","عَدُوِّىۡ","وَعَدُوَّكُمۡ","اَوۡلِيَآءَ","تُلۡقُوۡنَ"]]]],[4,[["60:1",["اِلَيۡهِمۡ","بِالۡمَوَدَّةِ","وَقَدۡ","كَفَرُوۡا","بِمَا","جَآءَكُمۡ","مِّنَ","الۡحَـقِّ​ ۚ","يُخۡرِجُوۡنَ","الرَّسُوۡلَ"]]]],[5,[["60:1",["وَاِيَّاكُمۡ​","اَنۡ","تُؤۡمِنُوۡا","بِاللّٰهِ","رَبِّكُمۡ ؕ","اِنۡ","كُنۡـتُمۡ","خَرَجۡتُمۡ","جِهَادًا","فِىۡ","سَبِيۡلِىۡ"]]]],[6,[["60:1",["وَ ابۡتِغَآءَ","مَرۡضَاتِىۡ ​ۖ ","تُسِرُّوۡنَ","اِلَيۡهِمۡ","بِالۡمَوَدَّةِ ​ۖ ","وَاَنَا","اَعۡلَمُ","بِمَاۤ","اَخۡفَيۡتُمۡ"]]]],[7,[["60:1",["وَمَاۤ","اَعۡلَنۡتُمۡ​ؕ","وَمَنۡ","يَّفۡعَلۡهُ","مِنۡكُمۡ","فَقَدۡ","ضَلَّ","سَوَآءَ","السَّبِيۡلِ‏ ﻿﻿"],"١"],["60:2",["اِنۡ"]]]],[8,[["60:2",["يَّثۡقَفُوۡكُمۡ","يَكُوۡنُوۡا","لَـكُمۡ","اَعۡدَآءً","وَّيَبۡسُطُوۡۤا","اِلَيۡكُمۡ","اَيۡدِيَهُمۡ","وَاَلۡسِنَتَهُمۡ"]]]],[9,[["60:2",["بِالسُّوۡٓءِ","وَوَدُّوۡا","لَوۡ","تَكۡفُرُوۡنَؕ‏"],"٢"],["60:3",["لَنۡ","تَـنۡفَعَكُمۡ","اَرۡحَامُكُمۡ","وَلَاۤ","اَوۡلَادُكُمۡ ۛۚ"]]]],[10,[["60:3",["يَوۡمَ","الۡقِيٰمَةِ ۛۚ","يَفۡصِلُ","بَيۡنَكُمۡ​ؕ","وَاللّٰهُ","بِمَا","تَعۡمَلُوۡنَ","بَصِيۡرٌ‏"],"٣"],["60:4",["قَدۡ","كَانَتۡ","لَـكُمۡ"]]]],[11,[["60:4",["اُسۡوَةٌ","حَسَنَةٌ","فِىۡۤ","اِبۡرٰهِيۡمَ","وَالَّذِيۡنَ","مَعَهٗ​ۚ","اِذۡ","قَالُوۡا","لِقَوۡمِهِمۡ","اِنَّا"]]]],[12,[["60:4",["بُرَءٰٓؤُا","مِنۡكُمۡ","وَمِمَّا","تَعۡبُدُوۡنَ","مِنۡ","دُوۡنِ","اللّٰهِ","كَفَرۡنَا","بِكُمۡ","وَبَدَا","بَيۡنَنَا"]]]],[13,[["60:4",["وَبَيۡنَكُمُ","الۡعَدَاوَةُ","وَالۡبَغۡضَآءُ","اَبَدًا","حَتّٰى","تُؤۡمِنُوۡا","بِاللّٰهِ","وَحۡدَهٗۤ","اِلَّا"]]]],[14,[["60:4",["قَوۡلَ","اِبۡرٰهِيۡمَ","لِاَبِيۡهِ","لَاَسۡتَغۡفِرَنَّ","لَـكَ","وَمَاۤ","اَمۡلِكُ","لَـكَ","مِنَ","اللّٰهِ"]]]],[15,[["60:4",["مِنۡ","شَىۡءٍ ​ؕ","رَبَّنَا","عَلَيۡكَ","تَوَكَّلۡنَا","وَاِلَيۡكَ","اَنَـبۡنَا","وَاِلَيۡكَ","الۡمَصِيۡرُ‏"],"٤"]]]],"550":[[1,[["60:5",["رَبَّنَا","لَا","تَجۡعَلۡنَا","فِتۡنَةً","لِّلَّذِيۡنَ","كَفَرُوۡا","وَاغۡفِرۡ","لَـنَا","رَبَّنَا​ ۚ","اِنَّكَ","اَنۡتَ"]]]],[2,[["60:5",["الۡعَزِيۡزُ","الۡحَكِيۡمُ‏"],"٥"],["60:6",["لَقَدۡ","كَانَ","لَـكُمۡ","فِيۡهِمۡ","اُسۡوَةٌ","حَسَنَةٌ","لِّمَنۡ","كَانَ"]]]],[3,[["60:6",["يَرۡجُوا","اللّٰهَ","وَالۡيَوۡمَ","الۡاٰخِرَ​ ؕ","وَمَنۡ","يَّتَوَلَّ","فَاِنَّ","اللّٰهَ","هُوَ","الۡغَنِىُّ","الۡحَمِيۡدُ‏ ﻿﻿"],"٦"]]],[4,[["60:7",["۞ عَسَى","اللّٰهُ","اَنۡ","يَّجۡعَلَ","بَيۡنَكُمۡ","وَبَيۡنَ","الَّذِيۡنَ","عَادَيۡتُمۡ","مِّنۡهُمۡ","مَّوَدَّةً ؕ"]]]],[5,[["60:7",["وَاللّٰهُ","قَدِيۡرٌ​ؕ","وَاللّٰهُ","غَفُوۡرٌ","رَّحِيۡمٌ‏"],"٧"],["60:8",["لَا","يَنۡهٰٮكُمُ","اللّٰهُ","عَنِ","الَّذِيۡنَ"]]]],[6,[["60:8",["لَمۡ","يُقَاتِلُوۡكُمۡ","فِى","الدِّيۡنِ","وَلَمۡ","يُخۡرِجُوۡكُمۡ","مِّنۡ","دِيَارِكُمۡ","اَنۡ","تَبَرُّوۡهُمۡ"]]]],[7,[["60:8",["وَ تُقۡسِطُوۡۤا","اِلَيۡهِمۡ​ؕ","اِنَّ","اللّٰهَ","يُحِبُّ","الۡمُقۡسِطِيۡنَ‏"],"٨"],["60:9",["اِنَّمَا","يَنۡهٰٮكُمُ","اللّٰهُ","عَنِ"]]]],[8,[["60:9",["الَّذِيۡنَ","قَاتَلُوۡكُمۡ","فِى","الدِّيۡنِ","وَاَخۡرَجُوۡكُمۡ","مِّنۡ","دِيَارِكُمۡ","وَظَاهَرُوۡا","عَلٰٓى"]]]],[9,[["60:9",["اِخۡرَاجِكُمۡ","اَنۡ","تَوَلَّوۡهُمۡ​ۚ","وَمَنۡ","يَّتَوَلَّهُمۡ","فَاُولٰٓٮِٕكَ","هُمُ","الظّٰلِمُوۡنَ‏"],"٩"]]],[10,[["60:10",["يٰۤاَيُّهَا","الَّذِيۡنَ","اٰمَنُوۡۤا","اِذَا","جَآءَكُمُ","الۡمُؤۡمِنٰتُ","مُهٰجِرٰتٍ","فَامۡتَحِنُوۡهُنَّ​ ؕ"]]]],[11,[["60:10",["اَللّٰهُ","اَعۡلَمُ","بِاِيۡمَانِهِنَّ​ ۚ","فَاِنۡ","عَلِمۡتُمُوۡهُنَّ","مُؤۡمِنٰتٍ","فَلَا","تَرۡجِعُوۡهُنَّ"]]]],[12,[["60:10",["اِلَى","الۡكُفَّارِ​ ؕ","لَا","هُنَّ","حِلٌّ","لَّهُمۡ","وَلَا","هُمۡ","يَحِلُّوۡنَ","لَهُنَّ​ ۚ","وَاٰ تُوۡهُمۡ","مَّاۤ"]]]],[13,[["60:10",["اَنۡفَقُوۡا​ ؕ","وَلَا","جُنَاحَ","عَلَيۡكُمۡ","اَنۡ","تَنۡكِحُوۡهُنَّ","اِذَاۤ","اٰ تَيۡتُمُوۡهُنَّ","اُجُوۡرَهُنَّ​ ؕ"]]]],[14,[["60:10",["وَلَا","تُمۡسِكُوۡا","بِعِصَمِ","الۡكَوَافِرِ","وَسۡــَٔـلُوۡا","مَاۤ","اَنۡفَقۡتُمۡ","وَلۡيَسۡــَٔـلُوۡا","مَاۤ"]]]],[15,[["60:10",["اَنۡفَقُوۡا​ ؕ","ذٰ لِكُمۡ","حُكۡمُ","اللّٰهِ​ ؕ","يَحۡكُمُ","بَيۡنَكُمۡ​ ؕ","وَاللّٰهُ","عَلِيۡمٌ","حَكِيۡمٌ‏ ﻿﻿"],"١٠"]]]],"551":[[1,[["60:11",["وَاِنۡ","فَاتَكُمۡ","شَىۡءٌ","مِّنۡ","اَزۡوَاجِكُمۡ","اِلَى","الۡكُفَّارِ","فَعَاقَبۡتُمۡ","فَاٰ تُوا"]]]],[2,[["60:11",["الَّذِيۡنَ","ذَهَبَتۡ","اَزۡوَاجُهُمۡ","مِّثۡلَ","مَاۤ","اَنۡفَقُوۡا​ ؕ","وَاتَّقُوا","اللّٰهَ"]]]],[3,[["60:11",["الَّذِىۡۤ","اَنۡـتُمۡ","بِهٖ","مُؤۡمِنُوۡنَ‏"],"١١"],["60:12",["يٰۤاَيُّهَا","النَّبِىُّ","اِذَا","جَآءَكَ","الۡمُؤۡمِنٰتُ"]]]],[4,[["60:12",["يُبَايِعۡنَكَ","عَلٰٓى","اَنۡ","لَّا","يُشۡرِكۡنَ","بِاللّٰهِ","شَيۡــًٔا","وَّلَا","يَسۡرِقۡنَ","وَلَا"]]]],[5,[["60:12",["يَزۡنِيۡنَ","وَلَا","يَقۡتُلۡنَ","اَوۡلَادَهُنَّ","وَلَا","يَاۡتِيۡنَ","بِبُهۡتَانٍ","يَّفۡتَرِيۡنَهٗ"]]]],[6,[["60:12",["بَيۡنَ","اَيۡدِيۡهِنَّ","وَاَرۡجُلِهِنَّ","وَلَا","يَعۡصِيۡنَكَ","فِىۡ","مَعۡرُوۡفٍ​"]]]],[7,[["60:12",["فَبَايِعۡهُنَّ","وَاسۡتَغۡفِرۡ","لَهُنَّ","اللّٰهَ​ؕ","اِنَّ","اللّٰهَ","غَفُوۡرٌ","رَّحِيۡمٌ‏"],"١٢"]]],[8,[["60:13",["يٰۤاَيُّهَا","الَّذِيۡنَ","اٰمَنُوۡا","لَا","تَتَوَلَّوۡا","قَوۡمًا","غَضِبَ","اللّٰهُ","عَلَيۡهِمۡ","قَدۡ"]]]],[9,[["60:13",["يَــٮِٕـسُوۡا","مِنَ","الۡاٰخِرَةِ","كَمَا","يَـ