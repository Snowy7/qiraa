{"541":[[1,[["57:25",["لَـقَدۡ","اَرۡسَلۡنَا","رُسُلَنَا","بِالۡبَيِّنٰتِ","وَاَنۡزَلۡنَا","مَعَهُمُ","الۡكِتٰبَ"]]]],[2,[["57:25",["وَالۡمِيۡزَانَ","لِيَقُوۡمَ","النَّاسُ","بِالۡقِسۡطِ​ۚ","وَاَنۡزَلۡنَا","الۡحَـدِيۡدَ","فِيۡهِ"]]]],[3,[["57:25",["بَاۡسٌ","شَدِيۡدٌ","وَّمَنَافِعُ","لِلنَّاسِ","وَلِيَـعۡلَمَ","اللّٰهُ","مَنۡ","يَّنۡصُرُهٗ"]]]],[4,[["57:25",["وَ رُسُلَهٗ","بِالۡغَيۡبِ​ ؕ","اِنَّ","اللّٰهَ","قَوِىٌّ","عَزِيۡزٌ‏"],"٢٥"],["57:26",["وَلَقَدۡ","اَرۡسَلۡنَا","نُوۡحًا"]]]],[5,[["57:26",["وَّ اِبۡرٰهِيۡمَ","وَجَعَلۡنَا","فِىۡ","ذُرِّيَّتِهِمَا","النُّبُوَّةَ","وَالۡـكِتٰبَ​","فَمِنۡهُمۡ","مُّهۡتَدٍ​ۚ"]]]],[6,[["57:26",["وَكَثِيۡرٌ","مِّنۡهُمۡ","فٰسِقُوۡنَ‏ ﻿﻿"],"٢٦"],["57:27",["ثُمَّ","قَفَّيۡنَا","عَلٰٓى","اٰثَارِهِمۡ","بِرُسُلِنَا"]]]],[7,[["57:27",["وَقَفَّيۡنَا","بِعِيۡسَى","ابۡنِ","مَرۡيَمَ","وَاٰتَيۡنٰهُ","الۡاِنۡجِيۡلَ ۙ","وَجَعَلۡنَا","فِىۡ"]]]],[8,[["57:27",["قُلُوۡبِ","الَّذِيۡنَ","اتَّبَعُوۡهُ","رَاۡفَةً","وَّرَحۡمَةً  ؕ","وَرَهۡبَانِيَّةَ","اۨبۡتَدَعُوۡهَا"]]]],[9,[["57:27",["مَا","كَتَبۡنٰهَا","عَلَيۡهِمۡ","اِلَّا","ابۡتِغَآءَ","رِضۡوَانِ","اللّٰهِ","فَمَا","رَعَوۡهَا","حَقَّ"]]]],[10,[["57:27",["رِعَايَتِهَا​ ۚ","فَاٰتَيۡنَا","الَّذِيۡنَ","اٰمَنُوۡا","مِنۡهُمۡ","اَجۡرَهُمۡ​ۚ","وَكَثِيۡرٌ","مِّنۡهُمۡ"]]]],[11,[["57:27",["فٰسِقُوۡنَ‏"],"٢٧"],["57:28",["يٰۤاَيُّهَا","الَّذِيۡنَ","اٰمَنُوا","اتَّقُوا","اللّٰهَ","وَاٰمِنُوۡا","بِرَسُوۡلِهٖ"]]]],[12,[["57:28",["يُؤۡتِكُمۡ","كِفۡلَيۡنِ","مِنۡ","رَّحۡمَتِهٖ","وَيَجۡعَلْ","لَّـكُمۡ","نُوۡرًا","تَمۡشُوۡنَ"]]]],[13,[["57:28",["بِهٖ","وَيَغۡفِرۡ","لَـكُمۡ​ؕ","وَاللّٰهُ","غَفُوۡرٌ","رَّحِيۡمٌ ۙۚ‏"],"٢٨"],["57:29",["لِّـئَلَّا","يَعۡلَمَ","اَهۡلُ"]]]],[14,[["57:29",["الۡكِتٰبِ","اَلَّا","يَقۡدِرُوۡنَ","عَلٰى","شَىۡءٍ","مِّنۡ","فَضۡلِ","اللّٰهِ​","وَاَنَّ","الۡفَضۡلَ"]]]],[15,[["57:29",["بِيَدِ","اللّٰهِ","يُؤۡتِيۡهِ","مَنۡ","يَّشَآءُ​ ؕ","وَاللّٰهُ","ذُوۡ","الۡفَضۡلِ","الۡعَظِيۡمِ‏"],"٢٩"]]]],"542":[[3,[["58:1",["قَدۡ","سَمِعَ","اللّٰهُ","قَوۡلَ","الَّتِىۡ","تُجَادِلُكَ","فِىۡ","زَوۡجِهَا","وَ تَشۡتَكِىۡ