{"61":[[1,[["3:84",["قُلۡ","اٰمَنَّا","بِاللّٰهِ","وَمَاۤ","اُنۡزِلَ","عَلَيۡنَا","وَمَاۤ","اُنۡزِلَ","عَلٰٓى","اِبۡرٰهِيۡمَ"]]]],[2,[["3:84",["وَ اِسۡمٰعِيۡلَ","وَاِسۡحٰقَ","وَيَعۡقُوۡبَ","وَالۡاَسۡبَاطِ","وَمَاۤ","اُوۡتِىَ","مُوۡسٰى"]]]],[3,[["3:84",["وَ عِيۡسٰى","وَالنَّبِيُّوۡنَ","مِنۡ","رَّبِّهِمۡ","لَا","نُفَرِّقُ","بَيۡنَ","اَحَدٍ","مِّنۡهُمۡ"]]]],[4,[["3:84",["وَنَحۡنُ","لَهٗ","مُسۡلِمُوۡنَ‏"],"٨٤"],["3:85",["وَمَنۡ","يَّبۡتَغِ","غَيۡرَ","الۡاِسۡلَامِ","دِيۡنًا","فَلَنۡ"]]]],[5,[["3:85",["يُّقۡبَلَ","مِنۡهُ​ ۚ","وَهُوَ","فِى","الۡاٰخِرَةِ","مِنَ","الۡخٰسِرِيۡنَ‏"],"٨٥"],["3:86",["كَيۡفَ","يَهۡدِى"]]]],[6,[["3:86",["اللّٰهُ","قَوۡمًا","كَفَرُوۡا","بَعۡدَ","اِيۡمَانِهِمۡ","وَشَهِدُوۡۤا","اَنَّ","الرَّسُوۡلَ"]]]],[7,[["3:86",["حَقٌّ","وَّجَآءَهُمُ","الۡبَيِّنٰتُ​ؕ","وَاللّٰهُ","لَا","يَهۡدِى","الۡقَوۡمَ","الظّٰلِمِيۡنَ‏"],"٨٦"]]],[8,[["3:87",["اُولٰٓٮِٕكَ","جَزَآؤُهُمۡ","اَنَّ","عَلَيۡهِمۡ","لَعۡنَةَ","اللّٰهِ","وَالۡمَلٰٓٮِٕكَةِ"]]]],[9,[["3:87",["وَالنَّاسِ","اَجۡمَعِيۡنَۙ‏"],"٨٧"],["3:88",["خٰلِدِيۡنَ","فِيۡهَا ​ۚ","لَا","يُخَفَّفُ","عَنۡهُمُ","الۡعَذَابُ"]]]],[10,[["3:88",["وَلَا","هُمۡ","يُنۡظَرُوۡنَۙ‏ ﻿﻿"],"٨٨"],["3:89",["اِلَّا","الَّذِيۡنَ","تَابُوۡا","مِنۡۢ","بَعۡدِ","ذٰ لِكَ"]]]],[11,[["3:89",["وَاَصۡلَحُوۡا ","فَاِنَّ","اللّٰهَ","غَفُوۡرٌ","رَّحِيۡمٌ‏"],"٨٩"],["3:90",["اِنَّ","الَّذِيۡنَ","كَفَرُوۡا","بَعۡدَ"]]]],[12,[["3:90",["اِيۡمَانِهِمۡ","ثُمَّ","ازۡدَادُوۡا","كُفۡرًا","لَّنۡ","تُقۡبَلَ","تَوۡبَتُهُمۡ​ۚ","وَاُولٰٓٮِٕكَ"]]]],[13,[["3:90",["هُمُ","الضَّآ لُّوۡنَ‏"],"٩٠"],["3:91",["اِنَّ","الَّذِيۡنَ","كَفَرُوۡا","وَمَاتُوۡا","وَهُمۡ","كُفَّارٌ"]]]],[14,[["3:91",["فَلَنۡ","يُّقۡبَلَ","مِنۡ","اَحَدِهِمۡ","مِّلۡءُ","الۡاَرۡضِ","ذَهَبًا","وَّلَوِ","افۡتَدٰى"]]]],[15,[["3:91",["بِهٖ ؕ","اُولٰٓٮِٕكَ","لَـهُمۡ","عَذَابٌ","اَلِـيۡمٌۙ","وَّمَا","لَـهُمۡ","مِّــنۡ","نّٰصِــرِيۡنَ‏"],"٩١"]]]],"62":[[1,[["3:92",["لَنۡ","تَنَالُوا","الۡبِرَّ","حَتّٰى","تُنۡفِقُوۡا","مِمَّا","تُحِبُّوۡنَ ؕ ","وَمَا","تُنۡفِقُوۡا"]]]],[2,[["3:92",["مِنۡ","شَىۡءٍ","فَاِنّ