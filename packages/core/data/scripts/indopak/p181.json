{"181":[[1,[["8:34",["وَمَا","لَهُمۡ","اَلَّا","يُعَذِّبَهُمُ","اللّٰهُ","وَهُمۡ","يَصُدُّوۡنَ","عَنِ","الۡمَسۡجِدِ"]]]],[2,[["8:34",["الۡحَـرَامِ","وَمَا","كَانُوۡۤا","اَوۡلِيَآءَهٗ​ ؕ","اِنۡ","اَوۡلِيَآؤُهٗۤ","اِلَّا","الۡمُتَّقُوۡنَ"]]]],[3,[["8:34",["وَلٰـكِنَّ","اَكۡثَرَهُمۡ","لَا","يَعۡلَمُوۡنَ‏"],"٣٤"],["8:35",["وَمَا","كَانَ","صَلَاتُهُمۡ"]]]],[4,[["8:35",["عِنۡدَ","الۡبَيۡتِ","اِلَّا","مُكَآءً","وَّتَصۡدِيَةً​  ؕ","فَذُوۡقُوا","الۡعَذَابَ"]]]],[5,[["8:35",["بِمَا","كُنۡتُمۡ","تَكۡفُرُوۡنَ‏"],"٣٥"],["8:36",["اِنَّ","الَّذِيۡنَ","كَفَرُوۡا","يُنۡفِقُوۡنَ"]]]],[6,[["8:36",["اَمۡوَالَهُمۡ","لِيَـصُدُّوۡا","عَنۡ","سَبِيۡلِ","اللّٰهِ​ ؕ","فَسَيُنۡفِقُوۡنَهَا","ثُمَّ"]]]],[7,[["8:36",["تَكُوۡنُ","عَلَيۡهِمۡ","حَسۡرَةً","ثُمَّ","يُغۡلَبُوۡنَ ؕ","وَالَّذِيۡنَ","كَفَرُوۡۤا"]]]],[8,[["8:36",["اِلٰى","جَهَـنَّمَ","يُحۡشَرُوۡنَۙ‏"],"٣٦"],["8:37",["لِيَمِيۡزَ","اللّٰهُ","الۡخَبِيۡثَ","مِنَ","الطَّيِّبِ"]]]],[9,[["8:37",["وَ يَجۡعَلَ","الۡخَبِيۡثَ","بَعۡضَهٗ","عَلٰى","بَعۡضٍ","فَيَرۡكُمَهٗ","جَمِيۡعًا"]]]],[10,[["8:37",["فَيَجۡعَلَهٗ","فِىۡ","جَهَـنَّمَ​ؕ","اُولٰٓٮِٕكَ","هُمُ","الۡخٰسِرُوۡنَ‏"],"٣٧"],["8:38",["قُلْ"]]]],[11,[["8:38",["لِّـلَّذِيۡنَ","كَفَرُوۡۤا","اِنۡ","يَّنۡتَهُوۡا","يُغۡفَرۡ","لَهُمۡ","مَّا","قَدۡ","سَلَفَۚ","وَاِنۡ"]]]],[12,[["8:38",["يَّعُوۡدُوۡا","فَقَدۡ","مَضَتۡ","سُنَّتُ","الۡاَوَّلِيۡنَ‏"],"٣٨"],["8:39",["وَقَاتِلُوۡهُمۡ","حَتّٰى"]]]],[13,[["8:39",["لَا","تَكُوۡنَ","فِتۡنَةٌ","وَّيَكُوۡنَ","الدِّيۡنُ","كُلُّهٗ","لِلّٰهِ​ۚ","فَاِنِ","انْـتَهَوۡا"]]]],[14,[["8:39",["فَاِنَّ","اللّٰهَ","بِمَا","يَعۡمَلُوۡنَ","بَصِيۡرٌ‏"],"٣٩"],["8:40",["وَاِنۡ","تَوَلَّوۡا","فَاعۡلَمُوۡۤا"]]]],[15,[["8:40",["اَنَّ","اللّٰهَ","مَوۡلٰٮكُمۡ​ؕ","نِعۡمَ","الۡمَوۡلٰى","وَنِعۡمَ","النَّصِيۡرُ‏"],"٤٠"]]]],"182":[[1,[["8:41",["۞ وَاعۡلَمُوۡۤا","اَنَّمَا","غَنِمۡتُمۡ","مِّنۡ","شَىۡءٍ","فَاَنَّ","لِلّٰهِ","خُمُسَهٗ"]]]],[2,[["8:41",["وَ لِلرَّسُوۡلِ","وَلِذِى","الۡقُرۡبٰى","وَالۡيَتٰمٰى","وَالۡمَسٰكِيۡنِ","وَابۡنِ"]]]],[3,[["8:41",["السَّبِيۡلِ ۙ","اِنۡ","كُنۡتُمۡ","اٰمَنۡ