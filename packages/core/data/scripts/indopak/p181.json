َدًا","فَاَتِمُّوۡۤا","اِلَيۡهِمۡ","عَهۡدَهُمۡ","اِلٰى"]]]],[10,[["9:4",["مُدَّتِهِمۡ​ؕ","اِنَّ","اللّٰهَ","يُحِبُّ","الۡمُتَّقِيۡنَ‏"],"٤"],["9:5",["فَاِذَا","انْسَلَخَ","الۡاَشۡهُرُ","الۡحُـرُمُ"]]]],[11,[["9:5",["فَاقۡتُلُوا","الۡمُشۡرِكِيۡنَ","حَيۡثُ","وَجَدْتُّمُوۡهُمۡ","وَخُذُوۡهُمۡ","وَاحۡصُرُوۡهُمۡ"]]]],[12,[["9:5",["وَاقۡعُدُوۡا","لَهُمۡ","كُلَّ","مَرۡصَدٍ​ ۚ","فَاِنۡ","تَابُوۡا","وَاَقَامُوا","الصَّلٰوةَ","وَ اٰتَوُا"]]]],[13,[["9:5",["الزَّكٰوةَ","فَخَلُّوۡا","سَبِيۡلَهُمۡ​ ؕ","اِنَّ","اللّٰهَ","غَفُوۡرٌ","رَّحِيۡمٌ‏"],"٥"],["9:6",["وَاِنۡ"]]]],[14,[["9:6",["اَحَدٌ","مِّنَ","الۡمُشۡرِكِيۡنَ","اسۡتَجَارَكَ","فَاَجِرۡهُ","حَتّٰى","يَسۡمَعَ","كَلَامَ"]]]],[15,[["9:6",["اللّٰهِ","ثُمَّ","اَبۡلِغۡهُ","مَاۡمَنَهٗ​ ؕ","ذٰ لِكَ","بِاَنَّهُمۡ","قَوۡمٌ","لَّا","يَعۡلَمُوۡنَ‏ ﻿﻿"],"٦"]]]],"188":[[1,[["9:7",["كَيۡفَ","يَكُوۡنُ","لِلۡمُشۡرِكِيۡنَ","عَهۡدٌ","عِنۡدَ","اللّٰهِ","وَعِنۡدَ","رَسُوۡلِهٖۤ"]]]],[2,[["9:7",["اِلَّا","الَّذِيۡنَ","عَاهَدتُّمۡ","عِنۡدَ","الۡمَسۡجِدِ","الۡحَـرَامِ​ ۚ","فَمَا","اسۡتَقَامُوۡا"]]]],[3,[["9:7",["لَـكُمۡ","فَاسۡتَقِيۡمُوۡا","لَهُمۡ​ ؕ","اِنَّ","اللّٰهَ","يُحِبُّ","الۡمُتَّقِيۡنَ‏"],"٧"],["9:8",["كَيۡفَ"]]]],[4,[["9:8",["وَاِنۡ","يَّظۡهَرُوۡا","عَلَيۡكُمۡ","لَا","يَرۡقُبُوۡا","فِيۡكُمۡ","اِلًّا","وَّلَا","ذِمَّةً​ ؕ"]]]],[5,[["9:8",["يُرۡضُوۡنَـكُمۡ","بِاَفۡوَاهِهِمۡ","وَتَاۡبٰى","قُلُوۡبُهُمۡ​ۚ","وَاَكۡثَرُهُمۡ"]]]],[6,[["9:8",["فٰسِقُوۡنَ​ۚ‏"],"٨"],["9:9",["اِشۡتَرَوۡا","بِاٰيٰتِ","اللّٰهِ","ثَمَنًا","قَلِيۡلًا","فَصَدُّوۡا"]]]],[7,[["9:9",["عَنۡ","سَبِيۡلِهٖ​ ؕ","اِنَّهُمۡ","سَآءَ","مَا","كَانُوۡا","يَعۡمَلُوۡنَ‏"],"٩"],["9:10",["لَا","يَرۡقُبُوۡنَ"]]]],[8,[["9:10",["فِىۡ","مُؤۡمِنٍ","اِلًّا","وَّلَا","ذِمَّةً​ ؕ","وَاُولٰۤٮِٕكَ","هُمُ","الۡمُعۡتَدُوۡنَ‏"],"١٠"]]],[9,[["9:11",["فَاِنۡ","تَابُوۡا","وَاَقَامُوا","الصَّلٰوةَ","وَاٰتَوُا","الزَّكٰوةَ","فَاِخۡوَانُكُمۡ"]]]],[10,[["9:11",["فِى","الدِّيۡنِ​ؕ","وَنُفَصِّلُ","الۡاٰيٰتِ","لِقَوۡمٍ","يَّعۡلَمُوۡنَ‏"],"١١"],["9:12",["وَاِنۡ"]]]],[11,[["9:12",["نَّكَثُوۡۤا","اَيۡمَانَهُمۡ","مِّنۡۢ","بَعۡدِ","عَهۡدِهِمۡ","وَطَعَنُوۡا","فِىۡ","دِيۡـنِكُمۡ"]]]],[12,[["9:12",["فَقَاتِلُوۡۤا","اَٮِٕمَّةَ","الۡـكُفۡرِ​ۙ","اِنَّهُمۡ","لَاۤ","اَيۡمَانَ","لَهُمۡ","لَعَلَّهُمۡ"]]]],[13,[["9:12",["يَنۡتَهُوۡنَ‏"],"١٢"],["9:13",["اَلَا","تُقَاتِلُوۡنَ","قَوۡمًا","نَّكَثُوۡۤا","اَيۡمَانَهُمۡ","وَهَمُّوۡا"]]]],[14,[["9:13",["بِاِخۡرَاجِ","الرَّسُوۡلِ","وَهُمۡ","بَدَءُوۡكُمۡ","اَوَّلَ","مَرَّةٍ​ ؕ","اَتَخۡشَوۡنَهُمۡ​ ۚ"]]]],[15,[["9:13",["فَاللّٰهُ","اَحَقُّ","اَنۡ","تَخۡشَوۡهُ","اِنۡ","كُنۡتُمۡ","مُّؤۡمِنِيۡنَ‏"],"١٣"]]]],"189":[[1,[["9:14",["قَاتِلُوۡهُمۡ","يُعَذِّبۡهُمُ","اللّٰهُ","بِاَيۡدِيۡكُمۡ","وَيُخۡزِهِمۡ","وَيَنۡصُرۡكُمۡ"]]]],[2,[["9:14",["عَلَيۡهِمۡ","وَيَشۡفِ","صُدُوۡرَ","قَوۡمٍ","مُّؤۡمِنِيۡنَۙ‏"],"١٤"],["9:15",["وَيُذۡهِبۡ","غَيۡظَ"]]]],[3,[["9:15",["قُلُوۡبِهِمۡ​ ؕ","وَ يَتُوۡبُ","اللّٰهُ","عَلٰى","مَنۡ","يَّشَآءُ ؕ","وَاللّٰهُ","عَلِيۡمٌ","حَكِيۡمٌ‏"],"١٥"]]],[4,[["9:16",["اَمۡ","حَسِبۡتُمۡ","اَنۡ","تُتۡرَكُوۡا","وَلَـمَّا","يَعۡلَمِ","اللّٰهُ","الَّذِيۡنَ","جَاهَدُوۡا","مِنۡكُمۡ"]]]],[5,[["9:16",["وَلَمۡ","يَتَّخِذُوۡا","مِنۡ","دُوۡنِ","اللّٰهِ","وَلَا","رَسُوۡلِهٖ","وَلَا","الۡمُؤۡمِنِيۡنَ"]]]],[6,[["9:16",["وَلِيۡجَةً​ ؕ","وَاللّٰهُ","خَبِيۡرٌۢ","بِمَا","تَعۡمَلُوۡنَ‏"],"١٦"],["9:17",["مَا","كَانَ","لِلۡمُشۡرِكِيۡنَ","اَنۡ"]]]],[7,[["9:17",["يَّعۡمُرُوۡا","مَسٰجِدَ","اللّٰهِ","شٰهِدِيۡنَ","عَلٰٓى","اَنۡفُسِهِمۡ","بِالـكُفۡرِ​ؕ","اُولٰۤٮِٕكَ"]]]],[8,[["9:17",["حَبِطَتۡ","اَعۡمَالُهُمۡ ۖۚ","وَ فِى","النَّارِ","هُمۡ","خٰلِدُوۡنَ‏"],"١٧"],["9:18",["اِنَّمَا","يَعۡمُرُ","مَسٰجِدَ"]]]],[9,[["9:18",["اللّٰهِ","مَنۡ","اٰمَنَ","بِاللّٰهِ","وَالۡيَوۡمِ","الۡاٰخِرِ","وَاَ قَامَ","الصَّلٰوةَ","وَاٰتَى"]]]],[10,[["9:18",["الزَّكٰوةَ","وَلَمۡ","يَخۡشَ","اِلَّا","اللّٰهَ​","فَعَسٰٓى","اُولٰۤٮِٕكَ","اَنۡ","يَّكُوۡنُوۡا","مِنَ"]]]],[11,[["9:18",["الۡمُهۡتَدِيۡنَ‏"],"١٨"],["9:19",["۞ اَجَعَلۡتُمۡ","سِقَايَةَ","الۡحَـآجِّ","وَعِمَارَةَ","الۡمَسۡجِدِ"]]]],[12,[["9:19",["الۡحَـرَامِ","كَمَنۡ","اٰمَنَ","بِاللّٰهِ","وَالۡيَوۡمِ","الۡاٰخِرِ","وَجَاهَدَ","فِىۡ","سَبِيۡلِ"]]]],[13,[["9:19",["اللّٰهِ​ ؕ","لَا","يَسۡتَوٗنَ","عِنۡدَ","اللّٰهِ ​ؕ","وَ اللّٰهُ","لَا","يَهۡدِى","الۡقَوۡمَ","الظّٰلِمِيۡنَ​ۘ‏"],"١٩"]]],[14,[["9:20",["اَلَّذِيۡنَ","اٰمَنُوۡا","وَ هَاجَرُوۡا","وَجَاهَدُوۡا","فِىۡ","سَبِيۡلِ","اللّٰهِ","بِاَمۡوَالِهِمۡ"]]]],[15,[["9:20",["وَاَنۡفُسِهِمۡۙ","اَعۡظَمُ","دَرَجَةً","عِنۡدَ","اللّٰهِ​ؕ","وَاُولٰٓٮِٕكَ","هُمُ","الۡفَآٮِٕزُوۡنَ‏ ﻿﻿"],"٢٠"]]]],"190":[[1,[["9:21",["يُبَشِّرُهُمۡ","رَبُّهُمۡ","بِرَحۡمَةٍ","مِّنۡهُ","وَرِضۡوَانٍ","وَّجَنّٰتٍ","لَّهُمۡ"]]]],[2,[["9:21",["فِيۡهَا","نَعِيۡمٌ","مُّقِيۡمٌ ۙ‏"],"٢١"],["9:22",["خٰلِدِيۡنَ","فِيۡهَاۤ","اَبَدًا​ ؕ","اِنَّ","اللّٰهَ"]]]],[3,[["9:22",["عِنۡدَهٗۤ","اَجۡرٌ","عَظِيۡمٌ‏"],"٢٢"],["9:23",["يٰۤاَ يُّهَا","الَّذِيۡنَ","اٰمَنُوۡا","لَا","تَتَّخِذُوۡۤا"]]]],[4,[["9:23",["اٰبَآءَكُمۡ","وَاِخۡوَانَـكُمۡ","اَوۡلِيَآءَ","اِنِ","اسۡتَحَبُّوا","الۡـكُفۡرَ","عَلَى"]]]],[5,[["9:23",["الۡاِيۡمَانِ​ ؕ","وَمَنۡ","يَّتَوَلَّهُمۡ","مِّنۡكُمۡ","فَاُولٰۤٮِٕكَ","هُمُ","الظّٰلِمُوۡنَ‏"],"٢٣"]]],[6,[["9:24",["قُلۡ","اِنۡ","كَانَ","اٰبَآؤُكُمۡ","وَاَبۡنَآؤُكُمۡ","وَاِخۡوَانُكُمۡ"]]]],[7,[["9:24",["وَاَزۡوَاجُكُمۡ","وَعَشِيۡرَتُكُمۡ","وَ اَمۡوَالُ ۨ","اقۡتَرَفۡتُمُوۡهَا","وَتِجَارَةٌ"]]]],[8,[["9:24",["تَخۡشَوۡنَ","كَسَادَهَا","وَ مَسٰكِنُ","تَرۡضَوۡنَهَاۤ","اَحَبَّ","اِلَيۡكُمۡ","مِّنَ"]]]],[9,[["9:24",["اللّٰهِ","وَرَسُوۡلِهٖ","وَ جِهَادٍ","فِىۡ","سَبِيۡلِهٖ","فَتَرَ بَّصُوۡا","حَتّٰى","يَاۡتِىَ","اللّٰهُ"]]]],[10,[["9:24",["بِاَمۡرِهٖ​ ؕ","وَاللّٰهُ","لَا","يَهۡدِى","الۡقَوۡمَ","الۡفٰسِقِيۡنَ‏"],"٢٤"],["9:25",["لَـقَدۡ","نَصَرَكُمُ"]]]],[11,[["9:25",["اللّٰهُ","فِىۡ","مَوَاطِنَ","كَثِيۡرَةٍ​ ۙ","وَّيَوۡمَ","حُنَيۡنٍ​ ۙ","اِذۡ","اَعۡجَبَـتۡكُمۡ"]]]],[12,[["9:25",["كَثۡرَتُكُمۡ","فَلَمۡ","تُغۡنِ","عَنۡكُمۡ","شَيۡـًٔـا","وَّضَاقَتۡ","عَلَيۡكُمُ","الۡاَرۡضُ"]]]],[13,[["9:25",["بِمَا","رَحُبَتۡ","ثُمَّ","وَلَّـيۡتُمۡ","مُّدۡبِرِيۡنَ​ۚ‏"],"٢٥"],["9:26",["ثُمَّ","اَنۡزَلَ","اللّٰهُ"]]]],[14,[["9:26",["سَكِيۡنَـتَهٗ","عَلٰى","رَسُوۡلِهٖ","وَعَلَى","الۡمُؤۡمِنِيۡنَ","وَاَنۡزَلَ","جُنُوۡدًا","لَّم