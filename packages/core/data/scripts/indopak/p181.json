33",["هُوَ"]]]],[3,[["9:33",["الَّذِىۡۤ","اَرۡسَلَ","رَسُوۡلَهٗ","بِالۡهُدٰى","وَدِيۡنِ","الۡحَـقِّ","لِيُظۡهِرَهٗ"]]]],[4,[["9:33",["عَلَى","الدِّيۡنِ","كُلِّهٖۙ","وَلَوۡ","كَرِهَ","الۡمُشۡرِكُوۡنَ‏"],"٣٣"],["9:34",["۞ يٰۤاَيُّهَا","الَّذِيۡنَ"]]]],[5,[["9:34",["اٰمَنُوۡۤا","اِنَّ","كَثِيۡرًا","مِّنَ","الۡاَحۡبَارِ","وَالرُّهۡبَانِ","لَيَاۡكُلُوۡنَ"]]]],[6,[["9:34",["اَمۡوَالَ","النَّاسِ","بِالۡبَاطِلِ","وَيَصُدُّوۡنَ","عَنۡ","سَبِيۡلِ","اللّٰهِ​ؕ"]]]],[7,[["9:34",["وَالَّذِيۡنَ","يَكۡنِزُوۡنَ","الذَّهَبَ","وَالۡفِضَّةَ","وَلَا","يُنۡفِقُوۡنَهَا"]]]],[8,[["9:34",["فِىۡ","سَبِيۡلِ","اللّٰهِۙ","فَبَشِّرۡهُمۡ","بِعَذَابٍ","اَلِيۡمٍۙ‏"],"٣٤"],["9:35",["يَّومَ","يُحۡمٰى"]]]],[9,[["9:35",["عَلَيۡهَا","فِىۡ","نَارِ","جَهَـنَّمَ","فَتُكۡوٰى","بِهَا","جِبَاهُهُمۡ","وَجُنُوۡبُهُمۡ"]]]],[10,[["9:35",["وَظُهُوۡرُهُمۡ​ؕ","هٰذَا","مَا","كَنَزۡتُمۡ","لِاَنۡفُسِكُمۡ","فَذُوۡقُوۡا","مَا"]]]],[11,[["9:35",["كُنۡتُمۡ","تَكۡنِزُوۡنَ‏"],"٣٥"],["9:36",["اِنَّ","عِدَّةَ","الشُّهُوۡرِ","عِنۡدَ","اللّٰهِ","اثۡنَا"]]]],[12,[["9:36",["عَشَرَ","شَهۡرًا","فِىۡ","كِتٰبِ","اللّٰهِ","يَوۡمَ","خَلَقَ","السَّمٰوٰتِ","وَالۡاَرۡضَ"]]]],[13,[["9:36",["مِنۡهَاۤ","اَرۡبَعَةٌ","حُرُمٌ​ ؕ","ذٰ لِكَ","الدِّيۡنُ","الۡقَيِّمُ ۙ","فَلَا","تَظۡلِمُوۡا"]]]],[14,[["9:36",["فِيۡهِنَّ","اَنۡفُسَكُمۡ​ ؕ","وَقَاتِلُوا","الۡمُشۡرِكِيۡنَ","كَآفَّةً","كَمَا"]]]],[15,[["9:36",["يُقَاتِلُوۡنَكُمۡ","كَآفَّةً​  ؕ","وَاعۡلَمُوۡۤا","اَنَّ","اللّٰهَ","مَعَ","الۡمُتَّقِيۡنَ‏"],"٣٦"]]]],"193":[[1,[["9:37",["اِنَّمَا","النَّسِىۡٓءُ","زِيَادَةٌ","فِى","الۡكُفۡرِ​","يُضَلُّ","بِهِ","الَّذِيۡنَ","كَفَرُوۡا"]]]],[2,[["9:37",["يُحِلُّوۡنَهٗ","عَامًا","وَّيُحَرِّمُوۡنَهٗ","عَامًا","لِّيُوَاطِــُٔــوۡا","عِدَّةَ","مَا"]]]],[3,[["9:37",["حَرَّمَ","اللّٰهُ","فَيُحِلُّوۡا","مَا","حَرَّمَ","اللّٰهُ​ ؕ","زُيِّنَ","لَهُمۡ","سُوۡۤءُ","اَعۡمَالِهِمۡ​ ؕ"]]]],[4,[["9:37",["وَاللّٰهُ","لَا","يَهۡدِى","الۡقَوۡمَ","الۡـكٰفِرِيۡنَ‏"],"٣٧"],["9:38",["يٰۤـاَيُّهَا","الَّذِيۡنَ","اٰمَنُوۡا"]]]],[5,[["9:38",["مَا","لَـكُمۡ","اِذَا","قِيۡلَ","لَـكُمُ