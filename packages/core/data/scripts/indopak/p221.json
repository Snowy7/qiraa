‏"],"٢٠"]]],[11,[["12:21",["وَقَالَ","الَّذِى","اشۡتَرٰٮهُ","مِنۡ","مِّصۡرَ","لِامۡرَاَتِهٖۤ","اَكۡرِمِىۡ","مَثۡوٰٮهُ","عَسٰٓى"]]]],[12,[["12:21",["اَنۡ","يَّـنۡفَعَنَاۤ","اَوۡ","نَـتَّخِذَهٗ","وَلَدًا​ ؕ","وَكَذٰلِكَ","مَكَّنَّا","لِيُوۡسُفَ","فِى"]]]],[13,[["12:21",["الۡاَرۡضِ","وَلِنُعَلِّمَهٗ","مِنۡ","تَاۡوِيۡلِ","الۡاَحَادِيۡثِ​ؕ","وَاللّٰهُ","غَالِبٌ","عَلٰٓى"]]]],[14,[["12:21",["اَمۡرِهٖ","وَلٰـكِنَّ","اَكۡثَرَ","النَّاسِ","لَا","يَعۡلَمُوۡنَ‏"],"٢١"],["12:22",["وَلَمَّا","بَلَغَ","اَشُدَّهٗۤ"]]]],[15,[["12:22",["اٰتَيۡنٰهُ","حُكۡمًا","وَّعِلۡمًا​ ؕ","وَكَذٰلِكَ","نَجۡزِى","الۡمُحۡسِنِيۡنَ‏"],"٢٢"]]]],"238":[[1,[["12:23",["وَرَاوَدَتۡهُ","الَّتِىۡ","هُوَ","فِىۡ","بَيۡتِهَا","عَنۡ","نَّـفۡسِهٖ","وَغَلَّقَتِ","الۡاَبۡوَابَ"]]]],[2,[["12:23",["وَقَالَتۡ","هَيۡتَ","لَـكَ​ؕ","قَالَ","مَعَاذَ","اللّٰهِ​","اِنَّهٗ","رَبِّىۡۤ","اَحۡسَنَ","مَثۡوَاىَ​ؕ"]]]],[3,[["12:23",["اِنَّهٗ","لَا","يُفۡلِحُ","الظّٰلِمُوۡنَ‏"],"٢٣"],["12:24",["وَلَـقَدۡ","هَمَّتۡ","بِهٖ​ۚ","وَهَمَّ","بِهَا​","لَوۡلَاۤ"]]]],[4,[["12:24",["اَنۡ","رَّاٰ","بُرۡهَانَ","رَبِّهٖ​ؕ","كَذٰلِكَ","لِنَصۡرِفَ","عَنۡهُ","السُّۤوۡءَ","وَالۡـفَحۡشَآءَ​ؕ"]]]],[5,[["12:24",["اِنَّهٗ","مِنۡ","عِبَادِنَا","الۡمُخۡلَصِيۡنَ‏"],"٢٤"],["12:25",["وَاسۡتَبَقَا","الۡبَابَ","وَقَدَّتۡ"]]]],[6,[["12:25",["قَمِيۡصَهٗ","مِنۡ","دُبُرٍ","وَّاَلۡفَيَا","سَيِّدَهَا","لَدَا","الۡبَابِ​ؕ","قَالَتۡ","مَا","جَزَآءُ"]]]],[7,[["12:25",["مَنۡ","اَرَادَ","بِاَهۡلِكَ","سُوۡۤءًا","اِلَّاۤ","اَنۡ","يُّسۡجَنَ","اَوۡ","عَذَابٌ","اَلِيۡمٌ‏"],"٢٥"]]],[8,[["12:26",["قَالَ","هِىَ","رَاوَدَتۡنِىۡ","عَنۡ","نَّـفۡسِىۡ​","وَشَهِدَ","شَاهِدٌ","مِّنۡ","اَهۡلِهَا​ۚ","اِنۡ"]]]],[9,[["12:26",["كَانَ","قَمِيۡصُهٗ","قُدَّ","مِنۡ","قُبُلٍ","فَصَدَقَتۡ","وَهُوَ","مِنَ","الۡكٰذِبِيۡنَ‏"],"٢٦"]]],[10,[["12:27",["وَاِنۡ","كَانَ","قَمِيۡصُهٗ","قُدَّ","مِنۡ","دُبُرٍ","فَكَذَبَتۡ","وَهُوَ","مِنَ"]]]],[11,[["12:27",["الصّٰدِقِيۡنَ‏ ﻿﻿"],"٢٧"],["12:28",["فَلَمَّا","رَاٰ","قَمِيۡصَهٗ","قُدَّ","مِنۡ","دُبُرٍ","قَالَ","اِنَّهٗ","مِنۡ"]]]],[12,[["12:28",["كَيۡدِكُنَّ​ؕ