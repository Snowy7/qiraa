{"221":[[1,[["10:107",["وَاِنۡ","يَّمۡسَسۡكَ","اللّٰهُ","بِضُرٍّ","فَلَا","كَاشِفَ","لَهٗۤ","اِلَّا","هُوَ ​ۚ","وَاِنۡ"]]]],[2,[["10:107",["يُّرِدۡكَ","بِخَيۡرٍ","فَلَا","رَآدَّ","لِفَضۡلِهٖ​ ؕ","يُصِيۡبُ","بِهٖ","مَنۡ","يَّشَآءُ","مِنۡ"]]]],[3,[["10:107",["عِبَادِهٖ​ ؕ","وَهُوَ","الۡغَفُوۡرُ","الرَّحِيۡمُ‏"],"١٠٧"],["10:108",["قُلۡ","يٰۤاَيُّهَا","النَّاسُ","قَدۡ","جَآءَكُمُ"]]]],[4,[["10:108",["الۡحَـقُّ","مِنۡ","رَّبِّكُمۡ​ۚ","فَمَنِ","اهۡتَدٰى","فَاِنَّمَا","يَهۡتَدِىۡ","لِنَفۡسِهٖ​ۚ","وَمَنۡ"]]]],[5,[["10:108",["ضَلَّ","فَاِنَّمَا","يَضِلُّ","عَلَيۡهَا​ۚ","وَمَاۤ","اَنَا","عَلَيۡكُمۡ","بِوَكِيۡلٍؕ‏"],"١٠٨"],["10:109",["وَاتَّبِعۡ"]]]],[6,[["10:109",["مَا","يُوۡحٰۤى","اِلَيۡكَ","وَاصۡبِرۡ","حَتّٰى","يَحۡكُمَ","اللّٰهُ​​ ۖۚ","وَهُوَ","خَيۡرُ","الۡحٰكِمِيۡنَ‏"],"١٠٩"]]],[9,[["11:1",["الٓرٰ​","كِتٰبٌ","اُحۡكِمَتۡ","اٰيٰـتُهٗ","ثُمَّ","فُصِّلَتۡ","مِنۡ","لَّدُنۡ","حَكِيۡمٍ","خَبِيۡرٍۙ‏"],"١"],["11:2",["اَلَّا"]]]],[10,[["11:2",["تَعۡبُدُوۡۤا","اِلَّا","اللّٰهَ​ ؕ","اِنَّنِىۡ","لَـكُمۡ","مِّنۡهُ","نَذِيۡرٌ","وَّبَشِيۡرٌ ۙ‏"],"٢"],["11:3",["وَّاَنِ","اسۡتَغۡفِرُوۡا"]]]],[11,[["11:3",["رَبَّكُمۡ","ثُمَّ","تُوۡبُوۡۤا","اِلَيۡهِ","يُمَتِّعۡكُمۡ","مَّتَاعًا","حَسَنًا","اِلٰٓى","اَجَلٍ","مُّسَمًّى","وَ يُؤۡتِ"]]]],[12,[["11:3",["كُلَّ","ذِىۡ","فَضۡلٍ","فَضۡلَهٗ ​ؕ","وَاِنۡ","تَوَلَّوۡا","فَاِنِّىۡۤ","اَخَافُ","عَلَيۡكُمۡ","عَذَابَ","يَوۡمٍ"]]]],[13,[["11:3",["كَبِيۡرٍ‏"],"٣"],["11:4",["اِلَى","اللّٰهِ","مَرۡجِعُكُمۡ​ۚ","وَهُوَ","عَلٰى","كُلِّ","شَىۡءٍ","قَدِيۡرٌ‏"],"٤"],["11:5",["اَلَاۤ","اِنَّهُمۡ"]]]],[14,[["11:5",["يَثۡنُوۡنَ","صُدُوۡرَهُمۡ","لِيَسۡتَخۡفُوۡا","مِنۡهُ​ؕ","اَلَا","حِيۡنَ","يَسۡتَغۡشُوۡنَ","ثِيَابَهُمۡۙ"]]]],[15,[["11:5",["يَعۡلَمُ","مَا","يُسِرُّوۡنَ","وَمَا","يُعۡلِنُوۡنَ​ۚ","اِنَّهٗ","عَلِيۡمٌۢ","بِذَاتِ","الصُّدُوۡرِ‏"],"٥"]]]],"222":[[1,[["11:6",["۞ وَمَا","مِنۡ","دَآ بَّةٍ","فِى","الۡاَرۡضِ","اِلَّا","عَلَى","اللّٰهِ","رِزۡقُهَا"]]]],[2,[["11:6",["وَ يَعۡلَمُ","مُسۡتَقَرَّهَا","وَمُسۡتَوۡدَعَهَا​ؕ","كُلٌّ","فِىۡ","كِتٰبٍ","مُّبِيۡنٍ‏"],"٦"]]],[