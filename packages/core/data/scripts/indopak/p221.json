ُلُ","الطَّيۡرُ","مِنۡهُ​ ؕ","نَبِّئۡنَا","بِتَاۡوِيۡلِهٖ ۚ","اِنَّا","نَرٰٮكَ"]]]],[13,[["12:36",["مِنَ","الۡمُحۡسِنِيۡنَ‏"],"٣٦"],["12:37",["قَالَ","لَا","يَاۡتِيۡكُمَا","طَعَامٌ","تُرۡزَقٰنِهٖۤ","اِلَّا","نَـبَّاۡتُكُمَا"]]]],[14,[["12:37",["بِتَاۡوِيۡلِهٖ","قَبۡلَ","اَنۡ","يَّاۡتِيَكُمَا​ ؕ","ذٰ لِكُمَا","مِمَّا","عَلَّمَنِىۡ","رَبِّىۡ ؕ","اِنِّىۡ","تَرَكۡتُ"]]]],[15,[["12:37",["مِلَّةَ","قَوۡمٍ","لَّا","يُؤۡمِنُوۡنَ","بِاللّٰهِ","وَهُمۡ","بِالۡاٰخِرَةِ","هُمۡ","كٰفِرُوۡنَ‏ ﻿﻿"],"٣٧"]]]],"240":[[1,[["12:38",["وَاتَّبَعۡتُ","مِلَّةَ","اٰبَآءِىۡۤ","اِبۡرٰهِيۡمَ","وَاِسۡحٰقَ","وَيَعۡقُوۡبَ​ؕ","مَا","كَانَ"]]]],[2,[["12:38",["لَنَاۤ","اَنۡ","نُّشۡرِكَ","بِاللّٰهِ","مِنۡ","شَىۡءٍ​ؕ","ذٰلِكَ","مِنۡ","فَضۡلِ","اللّٰهِ","عَلَيۡنَا"]]]],[3,[["12:38",["وَعَلَى","النَّاسِ","وَلٰـكِنَّ","اَكۡثَرَ","النَّاسِ","لَا","يَشۡكُرُوۡنَ‏"],"٣٨"],["12:39",["يٰصَاحِبَىِ"]]]],[4,[["12:39",["السِّجۡنِ","ءَاَرۡبَابٌ","مُّتَفَرِّقُوۡنَ","خَيۡرٌ","اَمِ","اللّٰهُ","الۡوَاحِدُ","الۡقَهَّارُؕ‏"],"٣٩"]]],[5,[["12:40",["مَا","تَعۡبُدُوۡنَ","مِنۡ","دُوۡنِهٖۤ","اِلَّاۤ","اَسۡمَآءً","سَمَّيۡتُمُوۡهَاۤ","اَنۡـتُمۡ"]]]],[6,[["12:40",["وَ اٰبَآؤُكُمۡ","مَّاۤ","اَنۡزَلَ","اللّٰهُ","بِهَا","مِنۡ","سُلۡطٰنٍ​ؕ","اِنِ","الۡحُكۡمُ","اِلَّا"]]]],[7,[["12:40",["لِلّٰهِ​ؕ","اَمَرَ","اَلَّا","تَعۡبُدُوۡۤا","اِلَّاۤ","اِيَّاهُ​ؕ","ذٰلِكَ","الدِّيۡنُ","الۡقَيِّمُ","وَلٰـكِنَّ"]]]],[8,[["12:40",["اَكۡثَرَ","النَّاسِ","لَا","يَعۡلَمُوۡنَ‏"],"٤٠"],["12:41",["يٰصَاحِبَىِ","السِّجۡنِ","اَمَّاۤ","اَحَدُكُمَا"]]]],[9,[["12:41",["فَيَسۡقِىۡ","رَبَّهٗ","خَمۡرًا​ۚ","وَاَمَّا","الۡاٰخَرُ","فَيُصۡلَبُ","فَتَاۡكُلُ","الطَّيۡرُ"]]]],[10,[["12:41",["مِنۡ","رَّاۡسِهٖ​ؕ","قُضِىَ","الۡاَمۡرُ","الَّذِىۡ","فِيۡهِ","تَسۡتَفۡتِيٰنِؕ‏"],"٤١"],["12:42",["وَقَالَ"]]]],[11,[["12:42",["لِلَّذِىۡ","ظَنَّ","اَنَّهٗ","نَاجٍ","مِّنۡهُمَا","اذۡكُرۡنِىۡ","عِنۡدَ","رَبِّكَ","فَاَنۡسٰٮهُ"]]]],[12,[["12:42",["الشَّيۡطٰنُ","ذِكۡرَ","رَبِّهٖ","فَلَبِثَ","فِى","السِّجۡنِ","بِضۡعَ","سِنِيۡنَ‏ ﻿﻿"],"٤٢"]]],[13,[["12:43",["وَقَالَ","الۡمَلِكُ","اِن