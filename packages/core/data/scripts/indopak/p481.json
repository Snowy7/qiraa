{"481":[[1,[["41:39",["وَمِنۡ","اٰيٰتِهٖۤ","اَنَّكَ","تَرَى","الۡاَرۡضَ","خَاشِعَةً","فَاِذَاۤ","اَنۡزَلۡنَا","عَلَيۡهَا"]]]],[2,[["41:39",["الۡمَآءَ","اهۡتَزَّتۡ","وَرَبَتۡ​ؕ","اِنَّ","الَّذِىۡۤ","اَحۡيَاهَا","لَمُحۡىِ","الۡمَوۡتٰى ؕ","اِنَّهٗ","عَلٰى"]]]],[3,[["41:39",["كُلِّ","شَىۡءٍ","قَدِيۡرٌ‏"],"٣٩"],["41:40",["اِنَّ","الَّذِيۡنَ","يُلۡحِدُوۡنَ","فِىۡۤ","اٰيٰتِنَا","لَا","يَخۡفَوۡنَ"]]]],[4,[["41:40",["عَلَيۡنَا ؕ","اَفَمَنۡ","يُّلۡقٰى","فِى","النَّارِ","خَيۡرٌ","اَمۡ","مَّنۡ","يَّاۡتِىۡۤ","اٰمِنًا","يَّوۡمَ","الۡقِيٰمَةِ​ ؕ"]]]],[5,[["41:40",["اِعۡمَلُوۡا","مَا","شِئۡتُمۡ​ ۙ","اِنَّهٗ","بِمَا","تَعۡمَلُوۡنَ","بَصِيۡرٌ‏"],"٤٠"],["41:41",["اِنَّ","الَّذِيۡنَ","كَفَرُوۡا"]]]],[6,[["41:41",["بِالذِّكۡرِ","لَمَّا","جَآءَهُمۡ​ۚ","وَاِنَّهٗ","لَـكِتٰبٌ","عَزِيۡزٌۙ‏"],"٤١"],["41:42",["لَّا","يَاۡتِيۡهِ","الۡبَاطِلُ","مِنۡۢ"]]]],[7,[["41:42",["بَيۡنِ","يَدَيۡهِ","وَلَا","مِنۡ","خَلۡفِهٖ​ؕ","تَنۡزِيۡلٌ","مِّنۡ","حَكِيۡمٍ","حَمِيۡدٍ‏"],"٤٢"],["41:43",["مَا","يُقَالُ"]]]],[8,[["41:43",["لَـكَ","اِلَّا","مَا","قَدۡ","قِيۡلَ","لِلرُّسُلِ","مِنۡ","قَبۡلِكَ ​ؕ","اِنَّ","رَبَّكَ","لَذُوۡ","مَغۡفِرَةٍ"]]]],[9,[["41:43",["وَّذُوۡ","عِقَابٍ","اَ لِيۡمٍ‏"],"٤٣"],["41:44",["وَلَوۡ","جَعَلۡنٰهُ","قُرۡاٰنًا","اَعۡجَمِيًّا","لَّقَالُوۡا","لَوۡلَا"]]]],[10,[["41:44",["فُصِّلَتۡ","اٰيٰتُهٗ ؕ","ءَؔاَعۡجَمِىٌّ","وَّعَرَبِىٌّ​  ؕ","قُلۡ","هُوَ","لِلَّذِيۡنَ","اٰمَنُوۡا","هُدًى"]]]],[11,[["41:44",["وَشِفَآءٌ​  ؕ","وَ الَّذِيۡنَ","لَا","يُؤۡمِنُوۡنَ","فِىۡۤ","اٰذَانِهِمۡ","وَقۡرٌ","وَّهُوَ","عَلَيۡهِمۡ"]]]],[12,[["41:44",["عَمًى​ ؕ","اُولٰٓٮِٕكَ","يُنَادَوۡنَ","مِنۡ","مَّكَانٍۢ","بَعِيۡدٍ‏"],"٤٤"],["41:45",["وَلَقَدۡ","اٰتَيۡنَا","مُوۡسَى"]]]],[13,[["41:45",["الۡكِتٰبَ","فَاخۡتُلِفَ","فِيۡهِ​ؕ","وَلَوۡلَا","كَلِمَةٌ","سَبَقَتۡ","مِنۡ","رَّبِّكَ","لَـقُضِىَ"]]]],[14,[["41:45",["بَيۡنَهُمۡ​ؕ","وَاِنَّهُمۡ","لَفِىۡ","شَكٍّ","مِّنۡهُ","مُرِيۡبٍ‏ ﻿﻿"],"٤٥"],["41:46",["مَنۡ","عَمِلَ","صَالِحًـا"]]]],[15,[["41:46",["فَلِنَفۡسِهٖ​","وَمَنۡ","اَسَآءَ","فَعَلَيۡهَا​ؕ","وَمَا","رَبُّكَ","بِظَلَّا