{"141":[[1,[["6:102",["ذٰ لِكُمُ","اللّٰهُ","رَبُّكُمۡ​ۚ","لَاۤ","اِلٰهَ","اِلَّا","هُوَ​ۚ","خَالِقُ","كُلِّ","شَىۡءٍ","فَاعۡبُدُوۡهُ​ۚ"]]]],[2,[["6:102",["وَهُوَ","عَلٰى","كُلِّ","شَىۡءٍ","وَّكِيۡلٌ‏"],"١٠٢"],["6:103",["لَا","تُدۡرِكُهُ","الۡاَبۡصَارُ","وَهُوَ","يُدۡرِكُ"]]]],[3,[["6:103",["الۡاَبۡصَارَ​ۚ","وَهُوَ","اللَّطِيۡفُ","الۡخَبِيۡرُ‏"],"١٠٣"],["6:104",["قَدۡ","جَآءَكُمۡ","بَصَآٮِٕرُ","مِنۡ"]]]],[4,[["6:104",["رَّبِّكُمۡ​ۚ","فَمَنۡ","اَبۡصَرَ","فَلِنَفۡسِهٖ​ ۚ","وَمَنۡ","عَمِىَ","فَعَلَيۡهَا​ ؕ","وَمَاۤ","اَنَا"]]]],[5,[["6:104",["عَلَيۡكُمۡ","بِحَفِيۡظٍ‏"],"١٠٤"],["6:105",["وَكَذٰلِكَ","نُصَرِّفُ","الۡاٰيٰتِ","وَلِيَقُوۡلُوۡا","دَرَسۡتَ"]]]],[6,[["6:105",["وَلِنُبَيِّنَهٗ","لِقَوۡمٍ","يَّعۡلَمُوۡنَ‏"],"١٠٥"],["6:106",["اِتَّبِعۡ","مَاۤ","اُوۡحِىَ","اِلَيۡكَ","مِنۡ","رَّبِّكَ​​ۚ"]]]],[7,[["6:106",["لَاۤ","اِلٰهَ","اِلَّا","هُوَ​ۚ","وَاَعۡرِضۡ","عَنِ","الۡمُشۡرِكِيۡنَ‏"],"١٠٦"],["6:107",["وَلَوۡ","شَآءَ","اللّٰهُ"]]]],[8,[["6:107",["مَاۤ","اَشۡرَكُوۡا ​ؕ","وَمَا","جَعَلۡنٰكَ","عَلَيۡهِمۡ","حَفِيۡظًا​ ۚ","وَمَاۤ","اَنۡتَ","عَلَيۡهِمۡ"]]]],[9,[["6:107",["بِوَكِيۡلٍ‏"],"١٠٧"],["6:108",["وَلَا","تَسُبُّوا","الَّذِيۡنَ","يَدۡعُوۡنَ","مِنۡ","دُوۡنِ","اللّٰهِ","فَيَسُبُّوا"]]]],[10,[["6:108",["اللّٰهَ","عَدۡوًاۢ","بِغَيۡرِ","عِلۡمٍ ​ؕ","كَذٰلِكَ","زَيَّنَّا","لِكُلِّ","اُمَّةٍ","عَمَلَهُمۡ","ثُمَّ"]]]],[11,[["6:108",["اِلٰى","رَبِّهِمۡ","مَّرۡجِعُهُمۡ","فَيُنَبِّئُهُمۡ","بِمَا","كَانُوۡا","يَعۡمَلُوۡنَ‏"],"١٠٨"],["6:109",["وَاَقۡسَمُوۡا"]]]],[12,[["6:109",["بِاللّٰهِ","جَهۡدَ","اَيۡمَانِهِمۡ","لَٮِٕنۡ","جَآءَتۡهُمۡ","اٰيَةٌ","لَّيُؤۡمِنُنَّ","بِهَا​ ؕ","قُلۡ"]]]],[13,[["6:109",["اِنَّمَا","الۡاٰيٰتُ","عِنۡدَ","اللّٰهِ​","وَمَا","يُشۡعِرُكُمۙۡ","اَنَّهَاۤ","اِذَا","جَآءَتۡ"]]]],[14,[["6:109",["لَا","يُؤۡمِنُوۡنَ‏"],"١٠٩"],["6:110",["وَنُقَلِّبُ","اَفۡـــِٕدَتَهُمۡ","وَاَبۡصَارَهُمۡ","كَمَا","لَمۡ"]]]],[15,[["6:110",["يُؤۡمِنُوۡا","بِهٖۤ","اَوَّلَ","مَرَّةٍ","وَّنَذَرُهُمۡ","فِىۡ","طُغۡيَانِهِمۡ","يَعۡمَهُوۡنَ‏"],"١١٠"]]]],"142":[[1,[["6:111",["۞ وَلَوۡ","اَن