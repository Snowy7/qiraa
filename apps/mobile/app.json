{
  "expo": {
    "name": "Qiraa",
    "slug": "qiraa",
    "version": "1.0.0",
    "description": "Read, listen to and memorise the Quran. Offline-first, in five mushaf scripts.",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "qiraa",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "app.qiraa",
      "icon": "./assets/qiraa.icon",
      "supportsTablet": true,
      "associatedDomains": [
        "applinks:qiraa.app"
      ],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "app.qiraa",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png",
        "backgroundColor": "#925727"
      },
      "predictiveBackGestureEnabled": true,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "qiraa.app"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-light.png",
          "imageWidth": 88,
          "backgroundColor": "#FBF9F4",
          "dark": {
            "image": "./assets/images/splash-dark.png",
            "backgroundColor": "#0E0D0C"
          }
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/Figtree-Regular.ttf",
            "./assets/fonts/Figtree-Medium.ttf",
            "./assets/fonts/Figtree-SemiBold.ttf",
            "./assets/fonts/Figtree-Bold.ttf",
            "./assets/fonts/Almarai-Regular.ttf",
            "./assets/fonts/Almarai-Bold.ttf",
            "./assets/fonts/Almarai-ExtraBold.ttf"
          ]
        }
      ],
      [
        "expo-localization",
        {
          "supportedLocales": [
            "en",
            "ar"
          ]
        }
      ],
      "expo-sqlite",
      [
        "expo-audio",
        {
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Qiraa uses your location to calculate prayer times and the Qibla direction on your device.",
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#8A511E"
        }
      ],
      "expo-quick-actions"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
